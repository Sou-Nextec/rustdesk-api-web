@@ -70,3 +70,11 @@ func CommonEnable() func(db *gorm.DB) *gorm.DB {
 		return db.Where("status = ?", model.COMMON_STATUS_ENABLE)
 	}
 }
+
+// UpdateFields grava os campos listados mesmo quando vazios (zero value).
+// Updates(struct) do GORM ignora valores vazios, o que impedia apagar um campo pela tela de administração
+// (ex.: o apelido de um dispositivo). Usado só pelos controladores de administração; o cliente RustDesk
+// e o LDAP continuam com o comportamento original, que envia dados parciais. (patch Nextec)
+func UpdateFields(m interface{}, fields ...string) error {
+	return DB.Model(m).Select(fields).Updates(m).Error
+}
