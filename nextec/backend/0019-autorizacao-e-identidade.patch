diff --git a/service/nextec_security_test.go b/service/nextec_security_test.go
new file mode 100644
--- /dev/null
+++ b/service/nextec_security_test.go
@@ -0,0 +1,99 @@
+package service
+
+import (
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+	"testing"
+)
+
+func securityDB(t *testing.T) *gorm.DB {
+	t.Helper()
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&model.Peer{}, &model.User{}, &model.DeviceGroup{}, &model.AddressBook{}, &model.AddressBookCollection{}, &model.AddressBookCollectionRule{}); err != nil {
+		t.Fatal(err)
+	}
+	oldDB, oldService := DB, AllService
+	DB, AllService = db, &Service{}
+	t.Cleanup(func() { DB, AllService = oldDB, oldService; sqlDB, _ := db.DB(); sqlDB.Close() })
+	return db
+}
+
+func TestVaultAuthorization(t *testing.T) {
+	db := securityDB(t)
+	admin, ordinary := true, false
+	u := &model.User{IdModel: model.IdModel{Id: 7}, Username: "tech", GroupId: 42, IsAdmin: &ordinary}
+	db.Create(u)
+	db.Create(&model.User{IdModel: model.IdModel{Id: 9}, Username: "admin", IsAdmin: &admin})
+	db.Create(&model.DeviceGroup{IdModel: model.IdModel{Id: 10}, Name: "Client A"})
+	db.Create(&model.DeviceGroup{IdModel: model.IdModel{Id: 11}, Name: "Client B"})
+	db.Create(&model.Peer{Id: "target", Uuid: "device", UserId: 8, GroupId: 10})
+	db.Create(&model.AddressBook{Id: "target", UserId: u.Id})
+	if NextecUserCanReadVault(u, "target") {
+		t.Fatal("personal bookmark granted vault access")
+	}
+	password, allowed := NextecConnectPassword(u, "target")
+	if password != "" || !allowed {
+		t.Fatal("manual bookmark connection must remain available without vault password")
+	}
+	col := &model.AddressBookCollection{UserId: u.Id, Name: "Cliente: Client A"}
+	db.Create(col)
+	db.Create(&model.AddressBook{Id: "target", UserId: u.Id, CollectionId: col.Id})
+	rule := &model.AddressBookCollectionRule{UserId: u.Id, CollectionId: col.Id, Type: model.ShareAddressBookRuleTypeGroup, ToId: 42, Rule: 3}
+	db.Create(rule)
+	if NextecUserCanReadVault(u, "target") {
+		t.Fatal("self-authored shared list granted vault access")
+	}
+	db.Model(col).Update("user_id", 9)
+	db.Model(&model.AddressBook{}).Where("collection_id = ?", col.Id).Update("user_id", 9)
+	if NextecUserCanReadVault(u, "target") {
+		t.Fatal("forged non-owner share granted access")
+	}
+	db.Model(rule).Update("user_id", 9)
+	if !NextecUserCanReadVault(u, "target") {
+		t.Fatal("administrator client share denied")
+	}
+	db.Model(&model.Peer{}).Where("id = ?", "target").Update("group_id", 11)
+	if NextecUserCanReadVault(u, "target") {
+		t.Fatal("editable list granted cross-client access")
+	}
+	db.Model(&model.Peer{}).Where("id = ?", "target").Update("group_id", 10)
+	db.Model(rule).Updates(map[string]interface{}{"type": model.ShareAddressBookRuleTypePersonal, "to_id": u.Id})
+	if !NextecUserCanReadVault(u, "target") {
+		t.Fatal("personal administrator share denied")
+	}
+	db.Model(rule).Update("rule", 0)
+	if NextecUserCanReadVault(u, "target") {
+		t.Fatal("revoked share still granted access")
+	}
+	db.Model(&model.Peer{}).Where("id = ?", "target").Update("user_id", u.Id)
+	if !NextecUserCanReadVault(u, "target") {
+		t.Fatal("real device owner denied")
+	}
+	if NextecUserCanReadVault(u, "missing") || NextecUserCanReadVault(nil, "target") {
+		t.Fatal("unknown identity allowed")
+	}
+}
+
+func TestDeviceBindingCannotTransferOwnership(t *testing.T) {
+	db := securityDB(t)
+	db.Create(&model.Peer{Id: "target", Uuid: "device", UserId: 8})
+	ps := &PeerService{}
+	ps.UuidBindUserId("target", "device", 7)
+	if ps.FindById("target").UserId != 8 {
+		t.Fatal("device transferred to another user")
+	}
+	db.Model(&model.Peer{}).Where("id = ?", "target").Update("user_id", 0)
+	ps.UuidBindUserId("different-id", "device", 7)
+	if ps.FindById("target").UserId != 0 {
+		t.Fatal("UUID alone bound a different ID")
+	}
+	ps.UuidBindUserId("target", "device", 7)
+	if ps.FindById("target").UserId != 7 {
+		t.Fatal("unowned matching device could not bind")
+	}
+}
