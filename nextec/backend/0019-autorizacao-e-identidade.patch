@@ -0,0 +1,69 @@
+package router
+
+import (
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/global"
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+	"github.com/nicksnyder/go-i18n/v2/i18n"
+	log "github.com/sirupsen/logrus"
+	"golang.org/x/text/language"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	"io"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestServerCommandsRequireAdministrator(t *testing.T) {
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&model.ServerCmd{}); err != nil {
+		t.Fatal(err)
+	}
+	oldDB, oldService, oldLocalizer, oldLogger := service.DB, service.AllService, global.Localizer, global.Logger
+	service.DB, service.AllService = db, &service.Service{}
+	global.Logger = log.New()
+	global.Logger.SetOutput(io.Discard)
+	bundle := i18n.NewBundle(language.English)
+	global.Localizer = func(string) *i18n.Localizer { return i18n.NewLocalizer(bundle, "en") }
+	t.Cleanup(func() {
+		service.DB, service.AllService, global.Localizer, global.Logger = oldDB, oldService, oldLocalizer, oldLogger
+		sqlDB, _ := db.DB()
+		sqlDB.Close()
+	})
+	admin := false
+	r := gin.New()
+	g := r.Group("/api/admin")
+	g.Use(func(c *gin.Context) { c.Set("curUser", &model.User{IsAdmin: &admin}); c.Next() })
+	RustdeskCmdBind(g)
+	for _, path := range []string{"sendCmd", "cmdList", "cmdDelete", "cmdCreate"} {
+		method := "POST"
+		if path == "cmdList" {
+			method = "GET"
+		}
+		w := httptest.NewRecorder()
+		req := httptest.NewRequest(method, "/api/admin/rustdesk/"+path, strings.NewReader(`{}`))
+		req.Header.Set("Content-Type", "application/json")
+		r.ServeHTTP(w, req)
+		var result struct {
+			Code int `json:"code"`
+		}
+		if err := json.Unmarshal(w.Body.Bytes(), &result); err != nil || result.Code != 403 {
+			t.Fatalf("ordinary user reached %s: %s", path, w.Body.String())
+		}
+	}
+	admin = true
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest("GET", "/api/admin/rustdesk/cmdList", nil))
+	var result struct {
+		Code int `json:"code"`
+	}
+	if err := json.Unmarshal(w.Body.Bytes(), &result); err != nil || result.Code != 0 {
+		t.Fatal("administrator command list denied")
+	}
+}
