+func TestPersonalCollectionCannotForgeAdministratorOwner(t *testing.T) {
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&model.AddressBookCollection{}); err != nil {
+		t.Fatal(err)
+	}
+	oldDB, oldService, oldValidator := service.DB, service.AllService, global.Validator.ValidStruct
+	service.DB, service.AllService = db, &service.Service{}
+	global.Validator.ValidStruct = func(*gin.Context, interface{}) []string { return nil }
+	t.Cleanup(func() {
+		service.DB, service.AllService, global.Validator.ValidStruct = oldDB, oldService, oldValidator
+		sqlDB, _ := db.DB()
+		sqlDB.Close()
+	})
+	col := &model.AddressBookCollection{IdModel: model.IdModel{Id: 1}, UserId: 7, Name: "personal"}
+	if err := db.Create(col).Error; err != nil {
+		t.Fatal(err)
+	}
+	r := gin.New()
+	r.POST("/update", func(c *gin.Context) { c.Set("curUser", &model.User{IdModel: model.IdModel{Id: 7}}) }, (&AddressBookCollection{}).Update)
+	w := httptest.NewRecorder()
+	req := httptest.NewRequest("POST", "/update", strings.NewReader(`{"id":1,"user_id":9,"name":"Cliente: Client A"}`))
+	req.Header.Set("Content-Type", "application/json")
+	r.ServeHTTP(w, req)
+	db.First(col, 1)
+	if w.Code != 200 || col.UserId != 7 || col.Name != "Cliente: Client A" {
+		t.Fatal("personal update changed collection ownership")
+	}
+}
