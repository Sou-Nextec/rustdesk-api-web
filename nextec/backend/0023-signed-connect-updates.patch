diff --git a/service/nextec_update_signature.go b/service/nextec_update_signature.go
new file mode 100644
index 0000000..6c28916
--- /dev/null
+++ b/service/nextec_update_signature.go
@@ -0,0 +1,99 @@
+package service
+
+import (
+	"crypto"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"math/big"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/global"
+	"github.com/lejianwen/rustdesk-api/v2/model"
+)
+
+var ErrNextecReleaseSignature = errors.New("A atualizaÃ§Ã£o precisa de um manifesto Connect vÃ¡lido, assinado pela Nextec, correspondente ao MSI enviado.")
+
+// Public trust anchor shared with Nextec monitoring. No private key is on this server.
+const nextecMonitoringRSAModulus = ""
+
+type NextecSignedRelease struct {
+	Manifest  string `json:"manifesto"`
+	Signature string `json:"assinatura"`
+}
+
+type nextecSignedManifest struct {
+	Product  string    `json:"produto"`
+	Format   int       `json:"formato"`
+	Sequence int64     `json:"sequencia"`
+	Version  string    `json:"versao"`
+	Issued   time.Time `json:"publicado_em"`
+	Expires  time.Time `json:"valido_ate"`
+	Windows  struct {
+		File string `json:"arquivo"`
+		Hash string `json:"sha256"`
+		Size int64  `json:"tamanho"`
+	} `json:"windows"`
+}
+
+func nextecVerifySignedRelease(r *model.NextecAppRelease, envelope NextecSignedRelease, key *rsa.PublicKey, now time.Time) error {
+	if r == nil || len(envelope.Manifest) > 88000 || len(envelope.Signature) > 4096 {
+		return ErrNextecReleaseSignature
+	}
+	raw, err := base64.StdEncoding.DecodeString(envelope.Manifest)
+	if err != nil || len(raw) == 0 || len(raw) > 65536 {
+		return ErrNextecReleaseSignature
+	}
+	signature, err := base64.StdEncoding.DecodeString(envelope.Signature)
+	if err != nil {
+		return ErrNextecReleaseSignature
+	}
+	digest := sha256.Sum256(raw)
+	if key.N.BitLen() < 3072 || rsa.VerifyPKCS1v15(key, crypto.SHA256, digest[:], signature) != nil {
+		return ErrNextecReleaseSignature
+	}
+	var m nextecSignedManifest
+	if json.Unmarshal(raw, &m) != nil || m.Product != "nextec-connect" || m.Format != 1 || m.Sequence < 1 || m.Sequence > 9007199254740991 {
+		return ErrNextecReleaseSignature
+	}
+	if m.Issued.After(now.Add(5*time.Minute)) || !m.Expires.After(now) || !m.Expires.After(m.Issued) || m.Expires.Sub(m.Issued) > 30*24*time.Hour {
+		return ErrNextecReleaseSignature
+	}
+	if m.Version != r.Version || m.Windows.File != "files/"+r.FileName || m.Windows.Hash != r.Sha256 || m.Windows.Size != r.Size || r.FileName != "nextec-acesso-"+r.Version+".msi" {
+		return ErrNextecReleaseSignature
+	}
+	return nil
+}
+
+func nextecReleaseTrustKey() *rsa.PublicKey {
+	n, _ := new(big.Int).SetString(nextecMonitoringRSAModulus, 16)
+	return &rsa.PublicKey{N: n, E: 65537}
+}
+
+func NextecReleaseSignatureSave(version string, envelope NextecSignedRelease) error {
+	r := NextecReleaseByVersion(version)
+	if err := nextecVerifySignedRelease(r, envelope, nextecReleaseTrustKey(), time.Now()); err != nil {
+		return err
+	}
+	encoded, err := json.Marshal(envelope)
+	if err != nil {
+		return err
+	}
+	return global.NextecSettingSet("app_signature_"+r.Version, string(encoded))
+}
+
+func NextecReleaseSignature(r *model.NextecAppRelease) *NextecSignedRelease {
+	if r == nil {
+		return nil
+	}
+	var envelope NextecSignedRelease
+	if json.Unmarshal([]byte(global.NextecSettingGet("app_signature_"+r.Version)), &envelope) != nil {
+		return nil
+	}
+	if nextecVerifySignedRelease(r, envelope, nextecReleaseTrustKey(), time.Now()) != nil {
+		return nil
+	}
+	return &envelope
+}
diff --git a/service/nextec_update_signature_test.go b/service/nextec_update_signature_test.go
new file mode 100644
index 0000000..bcfca48
--- /dev/null
+++ b/service/nextec_update_signature_test.go
@@ -0,0 +1,74 @@
+package service
+
+import (
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestNextecSignedRelease(t *testing.T) {
+	key, err := rsa.GenerateKey(rand.Reader, 3072)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now().UTC().Truncate(time.Second)
+	release := &model.NextecAppRelease{Version: "2.0.3", FileName: "nextec-acesso-2.0.3.msi", Sha256: strings.Repeat("a", 64), Size: 100}
+	m := nextecSignedManifest{Product: "nextec-connect", Format: 1, Sequence: 5, Version: release.Version, Issued: now, Expires: now.Add(time.Hour)}
+	m.Windows.File = "files/" + release.FileName
+	m.Windows.Hash = release.Sha256
+	m.Windows.Size = release.Size
+	sign := func(m nextecSignedManifest) NextecSignedRelease {
+		raw, err := json.Marshal(m)
+		if err != nil {
+			t.Fatal(err)
+		}
+		hash := sha256.Sum256(raw)
+		signature, err := rsa.SignPKCS1v15(rand.Reader, key, crypto.SHA256, hash[:])
+		if err != nil {
+			t.Fatal(err)
+		}
+		return NextecSignedRelease{Manifest: base64.StdEncoding.EncodeToString(raw), Signature: base64.StdEncoding.EncodeToString(signature)}
+	}
+	valid := sign(m)
+	if err := nextecVerifySignedRelease(release, valid, &key.PublicKey, now); err != nil {
+		t.Fatal(err)
+	}
+	if err := nextecVerifySignedRelease(release, valid, nextecReleaseTrustKey(), now); err == nil {
+		t.Fatal("Untrusted signer accepted")
+	}
+	tests := []struct {
+		name   string
+		mutate func(*nextecSignedManifest)
+	}{
+		{"other product", func(m *nextecSignedManifest) { m.Product = "monitoramento" }},
+		{"expired", func(m *nextecSignedManifest) { m.Expires = now.Add(-time.Second) }},
+		{"future", func(m *nextecSignedManifest) { m.Issued = now.Add(time.Hour) }},
+		{"long validity", func(m *nextecSignedManifest) { m.Expires = now.Add(31 * 24 * time.Hour) }},
+		{"other file", func(m *nextecSignedManifest) { m.Windows.File = "files/other.exe" }},
+		{"hash mismatch", func(m *nextecSignedManifest) { m.Windows.Hash = strings.Repeat("b", 64) }},
+		{"size mismatch", func(m *nextecSignedManifest) { m.Windows.Size = 101 }},
+		{"version mismatch", func(m *nextecSignedManifest) { m.Version = "2.0.4" }},
+		{"negative sequence", func(m *nextecSignedManifest) { m.Sequence = -1 }},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			bad := m
+			tc.mutate(&bad)
+			if nextecVerifySignedRelease(release, sign(bad), &key.PublicKey, now) == nil {
+				t.Fatal("Invalid manifest accepted")
+			}
+		})
+	}
+	raw, _ := base64.StdEncoding.DecodeString(valid.Manifest)
+	valid.Manifest = base64.StdEncoding.EncodeToString(append(raw, ' '))
+	if nextecVerifySignedRelease(release, valid, &key.PublicKey, now) == nil {
+		t.Fatal("Tampered bytes accepted")
+	}
+}
