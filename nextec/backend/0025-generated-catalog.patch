@@ -0,0 +1,105 @@
+package service
+
+import (
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"strings"
+	"testing"
+)
+
+func TestInternalDownloadPreservesClientIsolation(t *testing.T) {
+	db := securityDB(t)
+	if err := db.AutoMigrate(&model.NextecAppRelease{}); err != nil {
+		t.Fatal(err)
+	}
+	first := &model.NextecAppRelease{Version: "2.0.7", Profile: "default", Internal: true}
+	next := &model.NextecAppRelease{Version: "2.0.8", Profile: "analysts"}
+	client := &model.NextecAppRelease{Version: "2.0.9", Profile: "client", ClientName: "Carteira Bruno"}
+	for _, r := range []*model.NextecAppRelease{first, next, client} {
+		if err := db.Create(r).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := NextecReleaseInternal(next.Id, true); err != nil {
+		t.Fatal(err)
+	}
+	if r := NextecAvailableApp(); r == nil || r.Id != next.Id {
+		t.Fatal("new internal release unavailable")
+	}
+	var count int64
+	db.Model(&model.NextecAppRelease{}).Where("internal = ?", true).Count(&count)
+	if count != 1 {
+		t.Fatal("more than one current internal release")
+	}
+	if err := NextecReleaseInternal(client.Id, true); err == nil {
+		t.Fatal("client-specific package exposed to all analysts")
+	}
+	if err := NextecRolloutSet(client.Version, NextecRolloutAll, nil, nil); err == nil {
+		t.Fatal("client-specific package published globally")
+	}
+	if r := NextecAvailableApp(); r == nil || r.Id != next.Id {
+		t.Fatal("rejected change replaced current download")
+	}
+	if err := NextecReleaseInternal(next.Id, false); err != nil {
+		t.Fatal(err)
+	}
+	if NextecAvailableApp() != nil {
+		t.Fatal("suspended internal download remained available")
+	}
+}
+
+func TestGeneratedEndpoint(t *testing.T) {
+	uuid := "aaaaaaaa-0000-0000-0000-000000000001"
+	endpoint, err := generatedEndpoint("http://rdgen:8000", uuid, true)
+	if err != nil || endpoint != "http://rdgen:8000/api/artifact?file=1&uuid="+uuid {
+		t.Fatalf("unexpected endpoint: %s %v", endpoint, err)
+	}
+	for _, base := range []string{"file:///etc/passwd", "https://user:secret@host", "https://host?redirect=evil", "https://host#fragment"} {
+		if _, err := generatedEndpoint(base, uuid, false); err == nil {
+			t.Errorf("accepted invalid configured URL: %s", base)
+		}
+	}
+	if _, err := generatedEndpoint("http://rdgen:8000", "../escape", true); err == nil {
+		t.Fatal("accepted invalid UUID")
+	}
+}
+func TestGeneratedArtifactValidation(t *testing.T) {
+	a := generatedArtifact{UUID: "aaaaaaaa-0000-0000-0000-000000000001", Filename: "Nextec-Connect.msi", Version: "2.0.7", Hash: strings.Repeat("a", 64), Size: 100, Profile: "client"}
+	if !validGeneratedArtifact(a, a.UUID) {
+		t.Fatal("valid artifact rejected")
+	}
+	b := a
+	b.Size = NextecUpdateMaxSize + 1
+	if validGeneratedArtifact(b, a.UUID) {
+		t.Fatal("oversized artifact accepted")
+	}
+	b = a
+	b.Hash = "wrong"
+	if validGeneratedArtifact(b, a.UUID) {
+		t.Fatal("invalid hash accepted")
+	}
+	b = a
+	b.Version = ""
+	if validGeneratedArtifact(b, a.UUID) {
+		t.Fatal("unversioned artifact accepted")
+	}
+	b = a
+	b.UUID = "different"
+	if validGeneratedArtifact(b, a.UUID) {
+		t.Fatal("wrong generation accepted")
+	}
+}
+func TestScopedChoice(t *testing.T) {
+	rows := []NextecRollout{{Version: "2.0.7", Mode: NextecRolloutPilot, Groups: []uint{3}}, {Version: "2.0.8", Mode: NextecRolloutPilot, Peers: []string{"123456"}}}
+	if scopedChoice(rows, "654321", 3) != "2.0.7" {
+		t.Fatal("client target missing")
+	}
+	if scopedChoice(rows, "123456", 4) != "2.0.8" {
+		t.Fatal("machine target missing")
+	}
+	if scopedChoice(rows, "654321", 4) != "" {
+		t.Fatal("another client received targeted release")
+	}
+	if rolloutContains(NextecRollout{Version: "2.0.7", Mode: NextecRolloutOff}, "123456", 3) {
+		t.Fatal("suspended target matched")
+	}
+}
diff --git a/service/nextec_scoped_updates.go b/service/nextec_scoped_updates.go
new file mode 100644
index 0000000..f4f7277
--- /dev/null
+++ b/service/nextec_scoped_updates.go
@@ -0,0 +1,142 @@
+package service
+
+import (
+	"encoding/json"
+	"errors"
+	"github.com/lejianwen/rustdesk-api/v2/global"
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+	"sort"
+	"sync"
+)
+
+var scopedRolloutMu sync.Mutex
+
+// Preserve the original default rollout for old clients; specific targets override it.
+func NextecScopedRollouts() []NextecRollout {
+	rows := []NextecRollout{}
+	_ = json.Unmarshal([]byte(global.NextecSettingGet("app_scoped_rollouts")), &rows)
+	return rows
+}
+
+func rolloutContains(ro NextecRollout, peerID string, group uint) bool {
+	if ro.Mode == NextecRolloutOff || ro.Version == "" {
+		return false
+	}
+	if ro.Mode == NextecRolloutAll {
+		return true
+	}
+	for _, id := range ro.Peers {
+		if id == peerID && peerID != "" {
+			return true
+		}
+	}
+	for _, id := range ro.Groups {
+		if id == group && group != 0 {
+			return true
+		}
+	}
+	return false
+}
+
+func scopedChoice(rows []NextecRollout, peerID string, group uint) string {
+	for _, ro := range rows {
+		if rolloutContains(ro, peerID, group) {
+			return ro.Version
+		}
+	}
+	return ""
+}
+
+func NextecScopedRolloutSet(version, mode string, groups []uint, peers []string) error {
+	scopedRolloutMu.Lock()
+	defer scopedRolloutMu.Unlock()
+	release := NextecReleaseByVersion(version)
+	if release == nil {
+		return ErrNextecNoRelease
+	}
+	if mode != NextecRolloutOff && (mode != NextecRolloutPilot || NextecReleaseSignature(release) == nil) {
+		return errors.New("Uma publicação específica exige assinatura e destino por cliente ou máquina.")
+	}
+	next := NextecRollout{Version: version, Mode: mode, Groups: []uint{}, Peers: []string{}}
+	seenGroups, seenPeers := map[uint]bool{}, map[string]bool{}
+	for _, g := range groups {
+		if g != 0 && !seenGroups[g] {
+			next.Groups = append(next.Groups, g)
+			seenGroups[g] = true
+		}
+	}
+	for _, p := range peers {
+		if nextecPeerPattern.MatchString(p) && !seenPeers[p] {
+			next.Peers = append(next.Peers, p)
+			seenPeers[p] = true
+		}
+	}
+	if mode != NextecRolloutOff && len(next.Groups)+len(next.Peers) == 0 {
+		return errors.New("Escolha os clientes ou as máquinas que receberão esta versão.")
+	}
+	kept := []NextecRollout{}
+	for _, ro := range NextecScopedRollouts() {
+		if ro.Version == version {
+			continue
+		}
+		if mode != NextecRolloutOff {
+			for _, g := range ro.Groups {
+				if seenGroups[g] {
+					return errors.New("Este cliente já possui outra publicação específica. Suspenda a anterior primeiro.")
+				}
+			}
+			for _, p := range ro.Peers {
+				if seenPeers[p] {
+					return errors.New("Esta máquina já possui outra publicação específica. Suspenda a anterior primeiro.")
+				}
+			}
+			// Group-vs-device overlaps are also rejected, avoiding ambiguous destinations.
+			for _, p := range next.Peers {
+				if peer := AllService.PeerService.FindById(p); peer != nil && rolloutContains(ro, p, peer.GroupId) {
+					return errors.New("Destino já incluído em outra publicação específica.")
+				}
+			}
+			for _, p := range ro.Peers {
+				if peer := AllService.PeerService.FindById(p); peer != nil && rolloutContains(next, p, peer.GroupId) {
+					return errors.New("Destino já incluído em outra publicação específica.")
+				}
+			}
+		}
+		kept = append(kept, ro)
+	}
+	if mode != NextecRolloutOff {
+		kept = append(kept, next)
+	}
+	sort.Slice(kept, func(i, j int) bool { return kept[i].Version < kept[j].Version })
+	raw, _ := json.Marshal(kept)
+	return global.NextecSettingSet("app_scoped_rollouts", string(raw))
+}
+
+func NextecAvailableApp() *model.NextecAppRelease {
+	r := &model.NextecAppRelease{}
+	if DB.Where("internal = ? AND profile IN ?", true, []string{"analysts", "default", ""}).Order("id desc").First(r).Error != nil {
+		return nil
+	}
+	return r
+}
+
+func NextecReleaseInternal(id uint, enabled bool) error {
+	r := &model.NextecAppRelease{}
+	if DB.First(r, id).Error != nil {
+		return ErrNextecNoRelease
+	}
+	if r.Profile == "client" {
+		return errors.New("Use a publicação específica para distribuir o pacote de um cliente.")
+	}
+	if enabled {
+		// Change the active internal download atomically, preserving the previous one on failure.
+		return DB.Transaction(func(tx *gorm.DB) error {
+			if err := tx.Model(&model.NextecAppRelease{}).Where("internal = ?", true).Update("internal", false).Error; err != nil {
+				return err
+			}
+			return tx.Model(r).Update("internal", true).Error
+		})
+	}
+	return DB.Model(r).Update("internal", enabled).Error
+}
