+package admin
+
+import (
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/http/response"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+	"net/http"
+)
+
+func (n *NextecUpdate) ImportGenerated(c *gin.Context) {
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 4096)
+	var input struct {
+		UUID string `json:"uuid" binding:"required"`
+	}
+	if c.ShouldBindJSON(&input) != nil {
+		response.Fail(c, 101, "Informe uma geração válida.")
+		return
+	}
+	user := service.AllService.UserService.CurUser(c)
+	release, err := service.NextecGeneratedImport(user, input.UUID)
+	if err != nil {
+		response.Fail(c, 101, nextecUpdateMsg(err))
+		return
+	}
+	service.NextecSecretAuditAdd(user, "", "update_import", nextecIP(c), release.Version)
+	response.Success(c, release)
+}
+
+func (n *NextecUpdate) Internal(c *gin.Context) {
+	var input struct {
+		ID      uint `json:"id" binding:"required"`
+		Enabled bool `json:"enabled"`
+	}
+	if c.ShouldBindJSON(&input) != nil {
+		response.Fail(c, 101, "Informe uma versão válida.")
+		return
+	}
+	if err := service.NextecReleaseInternal(input.ID, input.Enabled); err != nil {
+		response.Fail(c, 101, err.Error())
+		return
+	}
+	service.NextecSecretAuditAdd(service.AllService.UserService.CurUser(c), "", "update_internal", nextecIP(c), "")
+	response.Success(c, nil)
+}
