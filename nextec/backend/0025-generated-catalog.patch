+package my
+
+import (
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/http/response"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+	"net/http"
+)
+
+type NextecApp struct{}
+
+// BackendUserAuth protects these routes; they never grant publication privileges.
+func (n *NextecApp) Info(c *gin.Context) {
+	r := service.NextecAvailableApp()
+	c.Header("Cache-Control", "no-store")
+	if r == nil {
+		response.Success(c, gin.H{"available": false})
+		return
+	}
+	response.Success(c, gin.H{"available": true, "version": r.Version, "base_version": r.BaseVersion, "filename": r.FileName, "sha256": r.Sha256, "size": r.Size})
+}
+func (n *NextecApp) Download(c *gin.Context) {
+	r := service.NextecAvailableApp()
+	if r == nil {
+		c.Status(http.StatusNotFound)
+		return
+	}
+	if c.Query("version") != r.Version {
+		c.Status(http.StatusConflict)
+		return
+	}
+	c.Header("Cache-Control", "no-store")
+	c.FileAttachment(service.NextecReleasePath(r), r.FileName)
+}
