+package api
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+func TestHeartbeatRequestsInventoryOnlyForUnknownIdentity(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&model.Peer{}); err != nil {
+		t.Fatal(err)
+	}
+	oldDB, oldService := service.DB, service.AllService
+	service.DB, service.AllService = db, &service.Service{}
+	t.Cleanup(func() {
+		service.DB, service.AllService = oldDB, oldService
+		sqlDB, _ := db.DB()
+		_ = sqlDB.Close()
+	})
+	if err := db.Create(&model.Peer{Id: "matched", Uuid: "known"}).Error; err != nil {
+		t.Fatal(err)
+	}
+	r := gin.New()
+	r.POST("/heartbeat", (&Index{}).Heartbeat)
+	call := func(body string) map[string]interface{} {
+		t.Helper()
+		w := httptest.NewRecorder()
+		req := httptest.NewRequest("POST", "/heartbeat", strings.NewReader(body))
+		req.Header.Set("Content-Type", "application/json")
+		r.ServeHTTP(w, req)
+		if w.Code != 200 {
+			t.Fatalf("heartbeat status = %d", w.Code)
+		}
+		response := map[string]interface{}{}
+		if err := json.Unmarshal(w.Body.Bytes(), &response); err != nil {
+			t.Fatalf("decode heartbeat response: %v", err)
+		}
+		return response
+	}
+
+	for _, body := range []string{
+		`{}`, `{"uuid":"unknown"}`, `{"id":"unknown"}`,
+		`{"id":"","uuid":"unknown"}`, `{"id":"unknown","uuid":""}`,
+	} {
+		if response := call(body); len(response) != 0 {
+			t.Fatalf("incomplete identity got response %#v for %s", response, body)
+		}
+	}
+
+	response := call(`{"id":"not-registered","uuid":"new-device"}`)
+	if response["sysinfo"] != true || len(response) != 1 {
+		t.Fatalf("unknown device response = %#v; want only sysinfo=true", response)
+	}
+	var count int64
+	if err := db.Model(&model.Peer{}).Where("id = ?", "not-registered").Count(&count).Error; err != nil || count != 0 {
+		t.Fatalf("heartbeat created device row: count=%d err=%v", count, err)
+	}
+
+	response = call(`{"id":"matched","uuid":"different","conns":[99]}`)
+	peer := service.AllService.PeerService.FindById("matched")
+	if _, requested := response["sysinfo"]; requested || peer.LastOnlineTime != 0 {
+		t.Fatalf("mismatched identity response=%#v, peer=%#v", response, peer)
+	}
+	for _, session := range service.NextecSessionsActive() {
+		if session.PeerId == "matched" {
+			t.Fatal("mismatched identity registered an active session")
+		}
+	}
+
+	response = call(`{"id":"matched","uuid":"known"}`)
+	peer = service.AllService.PeerService.FindById("matched")
+	if _, requested := response["sysinfo"]; requested || peer.LastOnlineTime == 0 {
+		t.Fatalf("matched identity behavior changed: response=%#v, peer=%#v", response, peer)
+	}
+}
