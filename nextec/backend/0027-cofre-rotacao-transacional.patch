+func TestAgentTransactionRecoversSamePendingAndConfirmIsIdempotent(t *testing.T) {
+	db, peerID, token := transactionTestDB(t, 0, 3, true)
+	ip := "transaction-recovery-test"
+	capabilities := []string{"transaction_v1"}
+	first, err := NextecAgentSyncStateWithCapabilities(ip, peerID, token, capabilities)
+	if err != nil || !first.Rotate || first.Operation == nil || first.Operation.PendingVersion != 4 || first.Operation.PendingPassword != "" {
+		t.Fatalf("initial transaction sync = %#v, err=%v", first, err)
+	}
+	retry, err := NextecAgentSyncStateWithCapabilities(ip, peerID, token, capabilities)
+	if err != nil || retry.Operation == nil || retry.Operation.OperationID != first.Operation.OperationID || retry.Operation.PendingVersion != 4 {
+		t.Fatalf("operation changed on repeated sync: first=%#v retry=%#v err=%v", first, retry, err)
+	}
+
+	password := "NewPassword987654321"
+	if err := NextecAgentProposeTransaction(ip, peerID, token, first.Operation.OperationID, 4, password); err != nil {
+		t.Fatal(err)
+	}
+	// A proposal retry after a lost HTTP response is idempotent only for the same password.
+	if err := NextecAgentProposeTransaction(ip, peerID, token, first.Operation.OperationID, 4, password); err != nil {
+		t.Fatalf("same proposal retry failed: %v", err)
+	}
+	recovered, err := NextecAgentSyncStateWithCapabilities(ip, peerID, token, capabilities)
+	if err != nil || !recovered.Recovery || recovered.Operation == nil || recovered.Operation.OperationID != first.Operation.OperationID ||
+		recovered.Operation.PendingVersion != 4 || recovered.Operation.PendingPassword != password {
+		t.Fatalf("sync did not recover the same pending operation: %#v err=%v", recovered, err)
+	}
+
+	if err := NextecAgentConfirmTransaction(ip, peerID, token, first.Operation.OperationID, 4); err != nil {
+		t.Fatal(err)
+	}
+	beforeRetry := &model.NextecDeviceSecret{}
+	if err := db.Where("peer_id = ?", peerID).First(beforeRetry).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := NextecAgentConfirmTransaction(ip, peerID, token, first.Operation.OperationID, 4); err != nil {
+		t.Fatalf("repeat confirmation was not idempotent: %v", err)
+	}
+	afterRetry := &model.NextecDeviceSecret{}
+	if err := db.Where("peer_id = ?", peerID).First(afterRetry).Error; err != nil {
+		t.Fatal(err)
+	}
+	active, err := vaultDecrypt(afterRetry.ActiveEnc)
+	if err != nil || active != password || afterRetry.Version != 4 || afterRetry.LastOperationID != first.Operation.OperationID ||
+		afterRetry.ActiveAt != beforeRetry.ActiveAt {
+		t.Fatalf("confirmation retry changed active state: %#v active=%q err=%v", afterRetry, active, err)
+	}
+	var rotatedAudits int64
+	if err := db.Model(&model.NextecSecretAudit{}).Where("peer_id = ? AND action = ?", peerID, "rotated").Count(&rotatedAudits).Error; err != nil || rotatedAudits != 1 {
+		t.Fatalf("confirm audit count=%d err=%v", rotatedAudits, err)
+	}
+}
