+func transactionTestDB(t *testing.T, protocolVersion, activeVersion int, policyEnabled bool) (*gorm.DB, string, string) {
+	t.Helper()
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&model.Peer{}, &model.DeviceGroup{}, &model.NextecSecretPolicy{}, &model.NextecDeviceSecret{}, &model.NextecSecretAudit{}); err != nil {
+		t.Fatal(err)
+	}
+	sqlDB, err := db.DB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sqlDB.SetMaxOpenConns(1)
+	oldDB, oldService, oldLogger := DB, AllService, Logger
+	oldVaultOnce, oldVaultKey, oldVaultErr := nextecVaultKeyOnce, nextecVaultKeyValue, nextecVaultKeyErr
+	DB, AllService, Logger = db, &Service{}, logrus.New()
+	nextecVaultKeyOnce, nextecVaultKeyValue, nextecVaultKeyErr = sync.Once{}, nil, nil
+	t.Setenv("NEXTEC_VAULT_KEY", base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x27}, 32)))
+	t.Cleanup(func() {
+		DB, AllService, Logger = oldDB, oldService, oldLogger
+		nextecVaultKeyOnce, nextecVaultKeyValue, nextecVaultKeyErr = oldVaultOnce, oldVaultKey, oldVaultErr
+		_ = sqlDB.Close()
+	})
+	peerID, token := "transaction-peer", "valid-agent-token"
+	activeEnc := ""
+	if activeVersion > 0 {
+		activeEnc, err = vaultEncrypt("CurrentPassword123456")
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := db.Create(&model.Peer{Id: peerID, Uuid: "device-uuid"}).Error; err != nil {
+		t.Fatal(err)
+	}
+	device := &model.NextecDeviceSecret{
+		PeerId: peerID, TokenHash: sha256Hex(token), ActiveEnc: activeEnc,
+		Version: activeVersion, ProtocolVersion: protocolVersion,
+	}
+	if err := db.Create(device).Error; err != nil {
+		t.Fatal(err)
+	}
+	policy := &model.NextecSecretPolicy{Kind: "peer", Ref: peerID, Enabled: policyEnabled, IntervalMinutes: 15}
+	if err := db.Create(policy).Error; err != nil {
+		t.Fatal(err)
+	}
+	// GORM may omit a zero-valued bool on INSERT when the column has `default:true`.
+	// Write it explicitly so disabled-policy tests actually exercise the off state.
+	if err := db.Model(&model.NextecSecretPolicy{}).Where("id = ?", policy.Id).Update("enabled", policyEnabled).Error; err != nil {
+		t.Fatal(err)
+	}
+	storedPolicy := &model.NextecSecretPolicy{}
+	if err := db.Where("id = ?", policy.Id).First(storedPolicy).Error; err != nil {
+		t.Fatal(err)
+	}
+	if storedPolicy.Enabled != policyEnabled {
+		t.Fatalf("test policy fixture enabled=%v, want %v", storedPolicy.Enabled, policyEnabled)
+	}
+	return db, peerID, token
+}
