+func TestAgentTransactionCASRejectsCompetingProposalAndStaleConfirm(t *testing.T) {
+	db, peerID, token := transactionTestDB(t, 0, 2, true)
+	ip := "transaction-cas-test"
+	state, err := NextecAgentSyncStateWithCapabilities(ip, peerID, token, []string{"transaction_v1"})
+	if err != nil || state.Operation == nil || state.Operation.PendingVersion != 3 {
+		t.Fatalf("transaction sync = %#v err=%v", state, err)
+	}
+	operationID := state.Operation.OperationID
+	firstPassword := "FirstPassword123456"
+	if err := NextecAgentProposeTransaction(ip, peerID, token, operationID, 3, firstPassword); err != nil {
+		t.Fatal(err)
+	}
+	if err := NextecAgentProposeTransaction(ip, peerID, token, operationID, 3, "OtherPassword123456"); !errors.Is(err, ErrNextecOperationConflict) {
+		t.Fatalf("competing proposal error = %v", err)
+	}
+	if err := NextecAgentConfirmTransaction(ip, peerID, token, "old-operation", 3); !errors.Is(err, ErrNextecOperationConflict) {
+		t.Fatalf("stale operation confirmation error = %v", err)
+	}
+	device := &model.NextecDeviceSecret{}
+	if err := db.Where("peer_id = ?", peerID).First(device).Error; err != nil {
+		t.Fatal(err)
+	}
+	active, _ := vaultDecrypt(device.ActiveEnc)
+	pending, _ := vaultDecrypt(device.PendingEnc)
+	if device.Version != 2 || active != "CurrentPassword123456" || pending != firstPassword {
+		t.Fatalf("competing/stale request changed secrets: version=%d active=%q pending=%q", device.Version, active, pending)
+	}
+	if err := NextecAgentConfirmTransaction(ip, peerID, token, operationID, 3); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Model(&model.NextecDeviceSecret{}).Where("peer_id = ?", peerID).Update("force_rotate", true).Error; err != nil {
+		t.Fatal(err)
+	}
+	next, err := NextecAgentSyncStateWithCapabilities(ip, peerID, token, []string{"transaction_v1"})
+	if err != nil || next.Operation == nil || next.Operation.OperationID == operationID || next.Operation.PendingVersion != 4 {
+		t.Fatalf("next operation = %#v err=%v", next, err)
+	}
+	if err := NextecAgentConfirmTransaction(ip, peerID, token, operationID, 4); !errors.Is(err, ErrNextecOperationConflict) {
+		t.Fatalf("old operation promoted newer pending secret: %v", err)
+	}
+	device = &model.NextecDeviceSecret{}
+	if err := db.Where("peer_id = ?", peerID).First(device).Error; err != nil {
+		t.Fatal(err)
+	}
+	if device.Version != 3 || device.PendingOperation != next.Operation.OperationID || device.PendingVersion != 4 {
+		t.Fatalf("stale confirm changed newer operation: %#v", device)
+	}
+}
