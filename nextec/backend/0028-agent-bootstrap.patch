+package admin
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+)
+
+type NextecBootstrap struct{}
+
+type bootstrapIssueForm struct {
+	ID       string          `json:"id"`
+	ClientID json.RawMessage `json:"client_id"`
+}
+
+func (n *NextecBootstrap) Issue(c *gin.Context) {
+	var form bootstrapIssueForm
+	if c.ShouldBindJSON(&form) != nil || strings.TrimSpace(form.ID) == "" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "bad request"})
+		return
+	}
+	clientID := ""
+	if len(form.ClientID) != 0 && string(form.ClientID) != "null" {
+		var text string
+		if json.Unmarshal(form.ClientID, &text) == nil {
+			clientID = text
+		} else {
+			var number json.Number
+			if json.Unmarshal(form.ClientID, &number) != nil {
+				c.JSON(http.StatusBadRequest, gin.H{"error": "bad request"})
+				return
+			}
+			clientID = number.String()
+		}
+		if _, err := strconv.ParseUint(clientID, 10, 32); err != nil {
+			c.JSON(http.StatusBadRequest, gin.H{"error": "bad request"})
+			return
+		}
+	}
+	user := service.AllService.UserService.CurUser(c)
+	token, err := service.NextecAgentBootstrapIssue(form.ID, clientID, nextecIP(c), user.Id)
+	if err != nil {
+		c.JSON(http.StatusConflict, gin.H{"error": "bootstrap denied"})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"bootstrap": token, "expires_in": 900})
+}
