+package model
+
+// NextecAgentBootstrap armazena somente o hash de um código de uso único.
+type NextecAgentBootstrap struct {
+	Id         uint   `gorm:"primaryKey" json:"id"`
+	TokenHash  string `gorm:"not null;uniqueIndex;size:64" json:"-"`
+	PeerId     string `gorm:"not null;index;size:64" json:"peer_id"`
+	Uuid       string `gorm:"not null;size:128" json:"uuid"`
+	GroupId    uint   `gorm:"not null" json:"group_id"`
+	ExpiresAt  int64  `gorm:"not null;index" json:"expires_at"`
+	UsedAt     int64  `gorm:"not null;default:0;index" json:"used_at"`
+	IssuedBy   uint   `gorm:"not null;default:0" json:"issued_by"`
+	CreatedAt  int64  `gorm:"not null" json:"created_at"`
+}
diff --git a/service/nextec_bootstrap.go b/service/nextec_bootstrap.go
new file mode 100644
index 0000000..2b5de31
--- /dev/null
+++ b/service/nextec_bootstrap.go
@@ -0,0 +1,163 @@
+package service
+
+import (
+	"crypto/rand"
+	"encoding/base64"
+	"errors"
+	"net"
+	"strconv"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+)
+
+const nextecBootstrapTTL = 15 * time.Minute
+
+var ErrNextecBootstrapDenied = errors.New("bootstrap denied")
+
+func nextecBootstrapAuditIP(ip string) string {
+	parsed := net.ParseIP(ip)
+	if parsed == nil {
+		return ""
+	}
+	return parsed.String()
+}
+
+// NextecAgentBootstrapIssue cria um código vinculado a um peer já inventariado.
+func NextecAgentBootstrapIssue(peerID, clientID, ip string, issuedBy uint) (string, error) {
+	ip = nextecBootstrapAuditIP(ip)
+	if peerID == "" || len(peerID) > 64 {
+		return "", ErrNextecBootstrapDenied
+	}
+	var peers []model.Peer
+	if err := DB.Where("id = ?", peerID).Limit(2).Find(&peers).Error; err != nil || len(peers) != 1 {
+		return "", ErrNextecBootstrapDenied
+	}
+	peer := peers[0]
+	if peer.Uuid == "" || peer.GroupId == 0 {
+		return "", ErrNextecBootstrapDenied
+	}
+	if clientID != "" && clientID != strconv.FormatUint(uint64(peer.GroupId), 10) {
+		return "", ErrNextecBootstrapDenied
+	}
+	var group model.DeviceGroup
+	if err := DB.First(&group, peer.GroupId).Error; err != nil || group.Id == 0 {
+		return "", ErrNextecBootstrapDenied
+	}
+	var active int64
+	if err := DB.Model(&model.NextecDeviceSecret{}).Where("peer_id = ? AND token_hash <> ''", peerID).Count(&active).Error; err != nil {
+		return "", err
+	}
+	if active != 0 {
+		return "", ErrNextecAlreadyEnroll
+	}
+
+	raw := make([]byte, 32)
+	if _, err := rand.Read(raw); err != nil {
+		return "", err
+	}
+	token := base64.RawURLEncoding.EncodeToString(raw)
+	now := time.Now().Unix()
+	row := &model.NextecAgentBootstrap{
+		TokenHash: sha256Hex(token), PeerId: peer.Id, Uuid: peer.Uuid, GroupId: peer.GroupId,
+		ExpiresAt: time.Now().Add(nextecBootstrapTTL).Unix(), IssuedBy: issuedBy, CreatedAt: now,
+	}
+	if err := DB.Transaction(func(tx *gorm.DB) error {
+		if err := tx.Create(row).Error; err != nil {
+			return err
+		}
+		return tx.Create(&model.NextecSecretAudit{At: now, UserId: issuedBy, PeerId: peer.Id, Action: "agent_bootstrap_issue", Ip: nextecBootstrapAuditIP(ip)}).Error
+	}); err != nil {
+		return "", err
+	}
+	return token, nil
+}
+
+// NextecAgentBootstrapConsume valida o código uma vez e cadastra um novo token do dispositivo atomicamente.
+func NextecAgentBootstrapConsume(ip, peerID, uuid, bootstrapToken string) (string, error) {
+	ip = nextecBootstrapAuditIP(ip)
+	if !nextecFailCheck(ip) {
+		return "", ErrNextecTooManyFails
+	}
+	if peerID == "" || uuid == "" || bootstrapToken == "" || len(bootstrapToken) > 128 {
+		nextecFailAdd(ip)
+		return "", ErrNextecBootstrapDenied
+	}
+	deviceBytes := make([]byte, 32)
+	if _, err := rand.Read(deviceBytes); err != nil {
+		return "", err
+	}
+	deviceToken := base64.RawURLEncoding.EncodeToString(deviceBytes)
+	now := time.Now().Unix()
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		var boot model.NextecAgentBootstrap
+		if err := tx.Where("token_hash = ?", sha256Hex(bootstrapToken)).First(&boot).Error; err != nil {
+			return ErrNextecBootstrapDenied
+		}
+		if boot.UsedAt != 0 || boot.ExpiresAt <= now || boot.PeerId != peerID || boot.Uuid != uuid {
+			return ErrNextecBootstrapDenied
+		}
+		var peers []model.Peer
+		if err := tx.Where("id = ?", peerID).Limit(2).Find(&peers).Error; err != nil || len(peers) != 1 {
+			return ErrNextecBootstrapDenied
+		}
+		peer := peers[0]
+		if peer.Uuid != boot.Uuid || peer.Uuid != uuid || peer.GroupId != boot.GroupId {
+			return ErrNextecBootstrapDenied
+		}
+		var group model.DeviceGroup
+		if err := tx.First(&group, boot.GroupId).Error; err != nil || group.Id == 0 {
+			return ErrNextecBootstrapDenied
+		}
+		var existing model.NextecDeviceSecret
+		err := tx.Where("peer_id = ?", peerID).First(&existing).Error
+		if err == nil && existing.TokenHash != "" {
+			return ErrNextecAlreadyEnroll
+		}
+		if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
+			return err
+		}
+		used := tx.Model(&model.NextecAgentBootstrap{}).
+			Where("id = ? AND token_hash = ? AND peer_id = ? AND uuid = ? AND group_id = ? AND used_at = 0 AND expires_at > ?",
+				boot.Id, boot.TokenHash, peerID, uuid, boot.GroupId, now).
+			Update("used_at", now)
+		if used.Error != nil {
+			return used.Error
+		}
+		if used.RowsAffected != 1 {
+			return ErrNextecBootstrapDenied
+		}
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			existing.PeerId = peerID
+			existing.TokenHash = sha256Hex(deviceToken)
+			existing.LastSeenAt = now
+			if err := tx.Create(&existing).Error; err != nil {
+				return err
+			}
+		} else {
+			updated := tx.Model(&model.NextecDeviceSecret{}).
+				Where("id = ? AND peer_id = ? AND token_hash = ''", existing.Id, peerID).
+				Updates(map[string]interface{}{
+					"token_hash": sha256Hex(deviceToken), "active_enc": "", "pending_enc": "",
+					"version": 0, "protocol_version": 0, "pending_operation": "", "pending_version": 0,
+					"last_operation_id": "", "active_at": 0, "next_rotation_at": 0,
+					"force_rotate": false, "last_seen_at": now,
+				})
+			if updated.Error != nil {
+				return updated.Error
+			}
+			if updated.RowsAffected != 1 {
+				return ErrNextecAlreadyEnroll
+			}
+		}
+		return tx.Create(&model.NextecSecretAudit{At: now, PeerId: peerID, Action: "agent_bootstrap_enroll", Ip: nextecBootstrapAuditIP(ip)}).Error
+	})
+	if err != nil {
+		if errors.Is(err, ErrNextecBootstrapDenied) || errors.Is(err, ErrNextecAlreadyEnroll) {
+			nextecFailAdd(ip)
+		}
+		return "", err
+	}
+	return deviceToken, nil
+}
diff --git a/service/nextec_bootstrap_test.go b/service/nextec_bootstrap_test.go
new file mode 100644
index 0000000..ff73e40
--- /dev/null
+++ b/service/nextec_bootstrap_test.go
@@ -0,0 +1,172 @@
+package service
+
+import (
+	"bytes"
+	"encoding/base64"
+	"errors"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/global"
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"github.com/sirupsen/logrus"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+func bootstrapTestSetup(t *testing.T) (*gorm.DB, string) {
+	t.Helper()
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&model.Peer{}, &model.DeviceGroup{}, &model.NextecDeviceSecret{}, &model.NextecSecretAudit{}, &model.NextecAgentBootstrap{}); err != nil {
+		t.Fatal(err)
+	}
+	sqlDB, err := db.DB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sqlDB.SetMaxOpenConns(1)
+	oldDB, oldService, oldLogger := DB, AllService, Logger
+	oldKeyOnce, oldKey, oldKeyErr := nextecVaultKeyOnce, nextecVaultKeyValue, nextecVaultKeyErr
+	DB, AllService, Logger = db, &Service{}, logrus.New()
+	nextecVaultKeyOnce, nextecVaultKeyValue, nextecVaultKeyErr = sync.Once{}, nil, nil
+	t.Setenv("NEXTEC_VAULT_KEY", base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x42}, 32)))
+	t.Cleanup(func() {
+		DB, AllService, Logger = oldDB, oldService, oldLogger
+		nextecVaultKeyOnce, nextecVaultKeyValue, nextecVaultKeyErr = oldKeyOnce, oldKey, oldKeyErr
+		_ = sqlDB.Close()
+	})
+	if err := db.Create(&model.DeviceGroup{IdModel: model.IdModel{Id: 7}, Name: "Cliente"}).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Create(&model.Peer{Id: "registered-peer", Uuid: "uuid-original", GroupId: 7}).Error; err != nil {
+		t.Fatal(err)
+	}
+	return db, "registered-peer"
+}
+
+func issueBootstrap(t *testing.T, peerID string) string {
+	t.Helper()
+	token, err := NextecAgentBootstrapIssue(peerID, "7", "admin-test-ip", 44)
+	if err != nil {
+		t.Fatalf("issue bootstrap: %v", err)
+	}
+	return token
+}
+
+func TestAgentBootstrapEnrollmentIsBoundOneUseAndDoesNotAuditSecrets(t *testing.T) {
+	db, peerID := bootstrapTestSetup(t)
+	bootstrap := issueBootstrap(t, peerID)
+	unused := issueBootstrap(t, peerID)
+	var row model.NextecAgentBootstrap
+	if err := db.First(&row).Error; err != nil {
+		t.Fatal(err)
+	}
+	if row.TokenHash != sha256Hex(bootstrap) || row.TokenHash == bootstrap || row.ExpiresAt-time.Now().Unix() > int64(nextecBootstrapTTL.Seconds()) {
+		t.Fatalf("unsafe or invalid bootstrap persistence: %#v", row)
+	}
+	deviceToken, err := NextecAgentBootstrapConsume(bootstrap, peerID, "uuid-original", bootstrap)
+	if err != nil || deviceToken == "" || deviceToken == bootstrap {
+		t.Fatalf("consume bootstrap: token=%t err=%v", deviceToken != "", err)
+	}
+	if _, err := NextecAgentBootstrapConsume("consume-test-ip", peerID, "uuid-original", bootstrap); !errors.Is(err, ErrNextecBootstrapDenied) {
+		t.Fatalf("replay accepted: %v", err)
+	}
+	if _, err := NextecAgentBootstrapIssue(peerID, "7", "admin-test-ip", 44); !errors.Is(err, ErrNextecAlreadyEnroll) {
+		t.Fatalf("active enrollment allowed a new bootstrap: %v", err)
+	}
+	if _, err := NextecAgentBootstrapConsume("active-test-ip", peerID, "uuid-original", unused); !errors.Is(err, ErrNextecAlreadyEnroll) {
+		t.Fatalf("active token overwritten: %v", err)
+	}
+	var unusedRow model.NextecAgentBootstrap
+	if err := db.Where("token_hash = ?", sha256Hex(unused)).First(&unusedRow).Error; err != nil || unusedRow.UsedAt != 0 {
+		t.Fatalf("failed enrollment did not roll back bootstrap consumption: row=%#v err=%v", unusedRow, err)
+	}
+	var audits []model.NextecSecretAudit
+	if err := db.Find(&audits).Error; err != nil {
+		t.Fatal(err)
+	}
+	for _, audit := range audits {
+		if strings.Contains(audit.Detail, bootstrap) || strings.Contains(audit.Detail, deviceToken) || strings.Contains(audit.Ip, bootstrap) || audit.Ip != "" {
+			t.Fatal("bootstrap or device token leaked into audit")
+		}
+	}
+}
+
+func TestAgentBootstrapRejectsExpiredMismatchAndChangedIdentity(t *testing.T) {
+	t.Run("expired", func(t *testing.T) {
+		db, peerID := bootstrapTestSetup(t)
+		token := issueBootstrap(t, peerID)
+		if err := db.Model(&model.NextecAgentBootstrap{}).Where("peer_id = ?", peerID).Update("expires_at", time.Now().Add(-time.Second).Unix()).Error; err != nil {
+			t.Fatal(err)
+		}
+		if _, err := NextecAgentBootstrapConsume("expired-test-ip", peerID, "uuid-original", token); !errors.Is(err, ErrNextecBootstrapDenied) {
+			t.Fatalf("expired token accepted: %v", err)
+		}
+	})
+	t.Run("uuid mismatch", func(t *testing.T) {
+		_, peerID := bootstrapTestSetup(t)
+		token := issueBootstrap(t, peerID)
+		if _, err := NextecAgentBootstrapConsume("uuid-test-ip", peerID, "attacker-uuid", token); !errors.Is(err, ErrNextecBootstrapDenied) {
+			t.Fatalf("mismatched UUID accepted: %v", err)
+		}
+	})
+	t.Run("group changed", func(t *testing.T) {
+		db, peerID := bootstrapTestSetup(t)
+		token := issueBootstrap(t, peerID)
+		if err := db.Create(&model.DeviceGroup{IdModel: model.IdModel{Id: 8}, Name: "Outro"}).Error; err != nil {
+			t.Fatal(err)
+		}
+		if err := db.Model(&model.Peer{}).Where("id = ?", peerID).Update("group_id", 8).Error; err != nil {
+			t.Fatal(err)
+		}
+		if _, err := NextecAgentBootstrapConsume("group-test-ip", peerID, "uuid-original", token); !errors.Is(err, ErrNextecBootstrapDenied) {
+			t.Fatalf("changed group accepted: %v", err)
+		}
+	})
+	t.Run("uuid changed", func(t *testing.T) {
+		db, peerID := bootstrapTestSetup(t)
+		token := issueBootstrap(t, peerID)
+		if err := db.Model(&model.Peer{}).Where("id = ?", peerID).Update("uuid", "uuid-replaced").Error; err != nil {
+			t.Fatal(err)
+		}
+		if _, err := NextecAgentBootstrapConsume("uuid-change-test-ip", peerID, "uuid-original", token); !errors.Is(err, ErrNextecBootstrapDenied) {
+			t.Fatalf("changed UUID accepted: %v", err)
+		}
+	})
+	t.Run("unregistered and client mismatch", func(t *testing.T) {
+		_, peerID := bootstrapTestSetup(t)
+		if _, err := NextecAgentBootstrapIssue("not-in-inventory", "7", "admin-test-ip", 44); !errors.Is(err, ErrNextecBootstrapDenied) {
+			t.Fatalf("unregistered peer accepted: %v", err)
+		}
+		if _, err := NextecAgentBootstrapIssue(peerID, "8", "admin-test-ip", 44); !errors.Is(err, ErrNextecBootstrapDenied) {
+			t.Fatalf("mismatched client accepted: %v", err)
+		}
+	})
+}
+
