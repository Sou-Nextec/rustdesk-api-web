+package router
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/global"
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+	"github.com/nicksnyder/go-i18n/v2/i18n"
+	"golang.org/x/text/language"
+	"github.com/sirupsen/logrus"
+)
+
+func TestNextecBootstrapIssueRequiresAdmin(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	old := service.AllService
+	oldLocalizer := global.Localizer
+	oldLogger := global.Logger
+	global.Logger = logrus.New()
+	service.AllService = &service.Service{UserService: &service.UserService{}}
+	global.Localizer = func(string) *i18n.Localizer { return i18n.NewLocalizer(i18n.NewBundle(language.English)) }
+	t.Cleanup(func() { service.AllService, global.Localizer, global.Logger = old, oldLocalizer, oldLogger })
+	engine := gin.New()
+	adminUser := false
+	group := engine.Group("/api/admin")
+	group.Use(func(c *gin.Context) {
+		c.Set("curUser", &model.User{IsAdmin: &adminUser})
+		c.Next()
+	})
+	NextecBind(group)
+	request := httptest.NewRequest(http.MethodPost, "/api/admin/nextec/secrets/bootstrap", strings.NewReader(`{"id":"peer"}`))
+	request.Header.Set("Content-Type", "application/json")
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, request)
+	if response.Code != http.StatusOK || !strings.Contains(response.Body.String(), `"code":403`) {
+		t.Fatalf("non-admin bootstrap request was not denied: %d %s", response.Code, response.Body.String())
+	}
+}
