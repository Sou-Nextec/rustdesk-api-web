+package api
+
+import (
+	"net/http"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+)
+
+type bootstrapConsumeForm struct {
+	Bootstrap string `json:"bootstrap"`
+	ID        string `json:"id"`
+	UUID      string `json:"uuid"`
+}
+
+func (a *NextecAgent) Bootstrap(c *gin.Context) {
+	var form bootstrapConsumeForm
+	if c.ShouldBindJSON(&form) != nil || strings.TrimSpace(form.ID) == "" || strings.TrimSpace(form.UUID) == "" || form.Bootstrap == "" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "bad request"})
+		return
+	}
+	token, err := service.NextecAgentBootstrapConsume(agentIP(c), form.ID, form.UUID, form.Bootstrap)
+	if err != nil {
+		if err == service.ErrNextecAlreadyEnroll {
+			c.JSON(http.StatusConflict, gin.H{"error": "already enrolled"})
+			return
+		}
+		c.JSON(http.StatusUnauthorized, gin.H{"error": "bootstrap denied"})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"token": token})
+}
