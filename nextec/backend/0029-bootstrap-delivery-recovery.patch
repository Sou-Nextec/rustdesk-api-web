diff --git a/service/nextec_bootstrap_delivery_test.go b/service/nextec_bootstrap_delivery_test.go
new file mode 100644
index 0000000..a1b103b
--- /dev/null
+++ b/service/nextec_bootstrap_delivery_test.go
@@ -0,0 +1,74 @@
+package service
+
+import (
+	"bytes"
+	"encoding/base64"
+	"errors"
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"testing"
+	"time"
+)
+
+func TestBootstrapDeliveryRetryKeepsDeviceTokenAndRejectsAnotherToken(t *testing.T) {
+	db, peerID := bootstrapTestSetup(t)
+	code := issueBootstrap(t, peerID)
+	token := base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{9}, 32))
+	other := base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{8}, 32))
+	first, err := NextecAgentBootstrapDeliver("127.0.0.1", peerID, "uuid-original", code, token)
+	if err != nil || first != token {
+		t.Fatalf("first delivery failed: %v", err)
+	}
+	retry, err := NextecAgentBootstrapDeliver("127.0.0.1", peerID, "uuid-original", code, token)
+	if err != nil || retry != token {
+		t.Fatalf("lost-response recovery failed: %v", err)
+	}
+	if _, err := NextecAgentBootstrapDeliver("127.0.0.1", peerID, "uuid-original", code, other); !errors.Is(err, ErrNextecBootstrapDenied) {
+		t.Fatalf("replay changed token: %v", err)
+	}
+	if _, err := NextecAgentBootstrapConsume("127.0.0.1", peerID, "uuid-original", code); !errors.Is(err, ErrNextecBootstrapDenied) {
+		t.Fatalf("legacy replay accepted: %v", err)
+	}
+	var audits int64
+	db.Model(&model.NextecSecretAudit{}).Where("action = ?", "agent_bootstrap_enroll").Count(&audits)
+	if audits != 1 {
+		t.Fatal("retry duplicated enrollment")
+	}
+}
+
+func TestBootstrapDeliveryCannotRecoverAfterRevokeExpiryOrIdentityChange(t *testing.T) {
+	for _, change := range []string{"revoke", "expire", "group", "uuid"} {
+		t.Run(change, func(t *testing.T) {
+			db, peerID := bootstrapTestSetup(t)
+			code := issueBootstrap(t, peerID)
+			token := base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{7}, 32))
+			if _, err := NextecAgentBootstrapDeliver("127.0.0.1", peerID, "uuid-original", code, token); err != nil {
+				t.Fatal(err)
+			}
+			switch change {
+			case "revoke":
+				if err := NextecSecretUnenroll(peerID); err != nil {
+					t.Fatal(err)
+				}
+			case "expire":
+				db.Model(&model.NextecAgentBootstrap{}).Where("peer_id = ?", peerID).Update("expires_at", time.Now().Add(-time.Second).Unix())
+			case "group":
+				db.Model(&model.Peer{}).Where("id = ?", peerID).Update("group_id", 8)
+			case "uuid":
+				db.Model(&model.Peer{}).Where("id = ?", peerID).Update("uuid", "replaced")
+			}
+			if _, err := NextecAgentBootstrapDeliver("127.0.0.1", peerID, "uuid-original", code, token); !errors.Is(err, ErrNextecBootstrapDenied) {
+				t.Fatalf("stale delivery accepted: %v", err)
+			}
+		})
+	}
+}
+
+func TestBootstrapDeliveryRejectsMalformedClientToken(t *testing.T) {
+	_, peerID := bootstrapTestSetup(t)
+	code := issueBootstrap(t, peerID)
+	for _, token := range []string{"short", string(bytes.Repeat([]byte{'x'}, 100))} {
+		if _, err := NextecAgentBootstrapDeliver("127.0.0.1", peerID, "uuid-original", code, token); !errors.Is(err, ErrNextecBootstrapDenied) {
+			t.Fatalf("invalid token accepted: %v", err)
+		}
+	}
+}
