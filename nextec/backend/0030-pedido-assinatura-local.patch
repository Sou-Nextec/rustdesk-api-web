+package admin
+
+import (
+	"fmt"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/http/response"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+)
+
+type nextecSignRequestForm struct {
+	Version string `json:"version" binding:"required"`
+}
+
+// SignRequest builds the manifest payload from the release already stored on the server.
+func (n *NextecUpdate) SignRequest(c *gin.Context) {
+	var form nextecSignRequestForm
+	if err := c.ShouldBindJSON(&form); err != nil {
+		response.Fail(c, 101, response.TranslateMsg(c, "ParamsError"))
+		return
+	}
+	request, err := service.NextecReleaseSignRequest(form.Version)
+	if err != nil {
+		response.Fail(c, 101, nextecUpdateMsg(err))
+		return
+	}
+	service.NextecSecretAuditAdd(service.AllService.UserService.CurUser(c), "", "update_sign_request", nextecIP(c), fmt.Sprintf("%s %d", request.Version, request.Sequence))
+	response.Success(c, request)
+}
