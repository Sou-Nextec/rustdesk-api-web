+package service
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"crypto/subtle"
+	"encoding/hex"
+	"errors"
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/global"
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+)
+
+// Inscrição global (Nextec): o instalador é o mesmo para todos os clientes e leva uma credencial de inscrição
+// (nx1.<época>.<HMAC>). A máquina se inscreve sozinha como PENDENTE: sem senha, sem regra e sem acesso.
+// O admin atribui a máquina a um cliente no painel e só então o cofre passa a gerar e liberar a senha.
+
+const (
+	settingEnrollEpoch    = "enroll_epoch"
+	settingEnrollMinEpoch = "enroll_min_epoch"
+	nextecEnrollPrefix    = "nx1"
+
+	nextecEnrollSeenWindow  = 10 * time.Minute
+	nextecEnrollHourSecs    = int64(3600)
+	nextecEnrollIPPerHour   = 30
+	nextecEnrollAllPerHour  = 100
+	nextecEnrollPendingMax  = 500
+	nextecEnrollMaxEpoch    = 1_000_000_000
+	nextecEnrollKeyMaxBytes = 160
+
+	NextecStatePending  = "pending"
+	NextecStateAssigned = "assigned"
+)
+
+var (
+	ErrNextecEnrollKeyInvalid  = errors.New("enroll key invalid")
+	ErrNextecEnrollBadRequest  = errors.New("bad request")
+	ErrNextecEnrollBlocked     = errors.New("enrollment blocked")
+	ErrNextecPeerNotRegistered = errors.New("peer not registered")
+	ErrNextecIdentityConflict  = errors.New("identity conflict")
+	ErrNextecPendingLimit      = errors.New("pending limit")
+	ErrNextecEnrollNotFound    = errors.New("pending machine not found")
+	ErrNextecClientConflict    = errors.New("machine already belongs to another client")
+	ErrNextecNoGroupRule       = errors.New("client has no password rule")
+	ErrNextecBadRule           = errors.New("invalid rule")
+
+	nextecEnrollPeerPattern  = regexp.MustCompile(`^\d{6,64}$`)
+	nextecEnrollTokenPattern = regexp.MustCompile(`^[A-Za-z0-9_-]{43,128}$`)
+	nextecEnrollUUIDPattern  = regexp.MustCompile(`^[\x21-\x7e]{1,128}$`)
+	nextecEnrollKeyMu        sync.Mutex
+)
+
+// ---------- credencial de inscrição ----------
+
+func nextecEnrollEpochs() (cur, min int) {
+	cur, min = 1, 1
+	if n, err := strconv.Atoi(global.NextecSettingGet(settingEnrollEpoch)); err == nil && n > 0 {
+		cur = n
+	}
+	if n, err := strconv.Atoi(global.NextecSettingGet(settingEnrollMinEpoch)); err == nil && n > 0 {
+		min = n
+	}
+	if min > cur {
+		min = cur
+	}
+	return cur, min
+}
+
+func nextecEnrollMac(epoch int) (string, error) {
+	k, err := vaultKey()
+	if err != nil {
+		return "", err
+	}
+	m := hmac.New(sha256.New, k)
+	m.Write([]byte("enroll:" + strconv.Itoa(epoch)))
+	return hex.EncodeToString(m.Sum(nil)), nil
+}
+
+func nextecEnrollBuild(epoch int) (string, error) {
+	mac, err := nextecEnrollMac(epoch)
+	if err != nil {
+		return "", err
+	}
+	return nextecEnrollPrefix + "." + strconv.Itoa(epoch) + "." + mac, nil
+}
+
+// NextecEnrollKeyInfo devolve a credencial vigente e as épocas (somente admin).
+func NextecEnrollKeyInfo() (key string, epoch, minEpoch int, err error) {
+	epoch, minEpoch = nextecEnrollEpochs()
+	key, err = nextecEnrollBuild(epoch)
+	return key, epoch, minEpoch, err
+}
+
+// NextecEnrollKeyRotate sobe a época: toda credencial anterior deixa de valer.
+func NextecEnrollKeyRotate() (key string, epoch, minEpoch int, err error) {
+	nextecEnrollKeyMu.Lock()
+	defer nextecEnrollKeyMu.Unlock()
+	cur, _ := nextecEnrollEpochs()
+	next := cur + 1
+	if err = global.NextecSettingSet(settingEnrollEpoch, strconv.Itoa(next)); err != nil {
+		return "", 0, 0, err
+	}
+	if err = global.NextecSettingSet(settingEnrollMinEpoch, strconv.Itoa(next)); err != nil {
+		return "", 0, 0, err
+	}
+	key, err = nextecEnrollBuild(next)
+	return key, next, next, err
+}
+
+// nextecEnrollKeyEpoch valida a credencial em tempo constante e devolve a época dela.
+func nextecEnrollKeyEpoch(key string) (int, bool) {
+	cur, min := nextecEnrollEpochs()
+	parts := strings.Split(key, ".")
+	epoch := 0
+	shapeOK := len(key) <= nextecEnrollKeyMaxBytes && len(parts) == 3 && parts[0] == nextecEnrollPrefix
+	if shapeOK {
+		n, err := strconv.Atoi(parts[1])
+		if err != nil || n <= 0 || n > nextecEnrollMaxEpoch || strconv.Itoa(n) != parts[1] {
+			shapeOK = false
+		} else {
+			epoch = n
+		}
+	}
+	// A comparação roda sempre, mesmo com formato ruim, para não variar o tempo de resposta.
+	probe := epoch
+	if !shapeOK {
+		probe = cur
+	}
+	want, err := nextecEnrollBuild(probe)
+	if err != nil {
+		return 0, false
+	}
+	match := subtle.ConstantTimeCompare([]byte(key), []byte(want)) == 1
+	// Nunca aceita época abaixo da mínima nem acima da vigente.
+	if !shapeOK || !match || epoch < min || epoch > cur {
+		return 0, false
+	}
+	return epoch, true
+}
+
+// ---------- bloqueio por id + uuid ----------
+
+func nextecEnrollBlocked(db *gorm.DB, peerID, uuid string) bool {
+	var n int64
+	return db.Model(&model.NextecEnrollBlock{}).Where("peer_id = ? AND uuid = ?", peerID, uuid).Count(&n).Error != nil || n > 0
+}
+
+// ---------- inscrição pela máquina ----------
+
+type NextecSelfEnrollResult struct {
+	Token string
+	State string // pending | assigned
+}
+
+func nextecEnrollState(d *model.NextecDeviceSecret) string {
+	if d.AwaitingApproval {
+		return NextecStatePending
+	}
+	return NextecStateAssigned
+}
+
+// NextecSelfEnroll registra a máquina como pendente. Idempotente para o mesmo token proposto; nunca sobrescreve
+// outro token nem um agente já aprovado; nunca entrega senha.
+func NextecSelfEnroll(ip, enrollKey, peerID, uuid, proposedToken string) (*NextecSelfEnrollResult, error) {
+	ip = nextecBootstrapAuditIP(ip)
+	if !nextecFailCheck(ip) {
+		return nil, ErrNextecTooManyFails
+	}
+	if !nextecEnrollPeerPattern.MatchString(peerID) || !nextecEnrollUUIDPattern.MatchString(uuid) ||
+		!nextecEnrollTokenPattern.MatchString(proposedToken) || enrollKey == "" {
+		return nil, ErrNextecEnrollBadRequest
+	}
+	epoch, ok := nextecEnrollKeyEpoch(enrollKey)
+	if !ok {
+		nextecFailAdd(ip)
+		return nil, ErrNextecEnrollKeyInvalid
+	}
+	if nextecEnrollBlocked(DB, peerID, uuid) {
+		return nil, ErrNextecEnrollBlocked
+	}
+	proposedHash := sha256Hex(proposedToken)
+	var result *NextecSelfEnrollResult
+	var lastErr error
+	for attempt := 0; attempt < 3; attempt++ {
+		result, lastErr = nil, nil
+		err := DB.Transaction(func(tx *gorm.DB) error {
+			var peers []model.Peer
+			if err := tx.Where("id = ?", peerID).Limit(2).Find(&peers).Error; err != nil {
+				return err
+			}
+			if len(peers) != 1 || peers[0].Uuid == "" {
+				return ErrNextecPeerNotRegistered
+			}
+			peer := peers[0]
+			if peer.Uuid != uuid {
+				return ErrNextecIdentityConflict
+			}
+			now := time.Now().Unix()
+			var existing model.NextecDeviceSecret
+			found := true
+			if err := tx.Where("peer_id = ?", peerID).First(&existing).Error; err != nil {
+				if !errors.Is(err, gorm.ErrRecordNotFound) {
+					return err
+				}
+				found = false
+			}
+			if found && existing.TokenHash != "" {
+				if existing.Uuid != "" && existing.Uuid != uuid {
+					return ErrNextecIdentityConflict
+				}
+				if subtle.ConstantTimeCompare([]byte(existing.TokenHash), []byte(proposedHash)) == 1 {
+					result = &NextecSelfEnrollResult{Token: proposedToken, State: nextecEnrollState(&existing)}
+					return nil
+				}
+				if existing.AwaitingApproval {
+					return ErrNextecIdentityConflict
+				}
+				return ErrNextecAlreadyEnroll
+			}
+			// Só uma máquina vista agora (heartbeat) pode abrir uma inscrição nova.
+			if now-peer.LastOnlineTime > int64(nextecEnrollSeenWindow.Seconds()) {
+				return ErrNextecPeerNotRegistered
+			}
+			var n int64
+			if err := tx.Model(&model.NextecDeviceSecret{}).Where("awaiting_approval = ?", true).Count(&n).Error; err != nil {
+				return err
+			}
+			if n >= nextecEnrollPendingMax {
+				return ErrNextecPendingLimit
+			}
+			since := now - nextecEnrollHourSecs
+			if err := tx.Model(&model.NextecDeviceSecret{}).
+				Where("enrolled_via = ? AND enrolled_at > ?", "self", since).Count(&n).Error; err != nil {
+				return err
+			}
+			if n >= nextecEnrollAllPerHour {
+				return ErrNextecPendingLimit
+			}
+			if err := tx.Model(&model.NextecDeviceSecret{}).
+				Where("enrolled_via = ? AND enrolled_at > ? AND enrolled_ip = ?", "self", since, ip).Count(&n).Error; err != nil {
+				return err
+			}
+			if n >= nextecEnrollIPPerHour {
+				return ErrNextecPendingLimit
+			}
+			row := &model.NextecDeviceSecret{
+				PeerId: peerID, TokenHash: proposedHash, LastSeenAt: now, AwaitingApproval: true,
+				EnrolledVia: "self", EnrolledAt: now, EnrolledIp: ip, EnrollEpoch: epoch, Uuid: uuid,
+			}
+			if found {
+				// Linha sem agente (token vazio): reaproveita preservando o histórico e zerando o estado da senha.
+				res := tx.Model(&model.NextecDeviceSecret{}).
+					Where("id = ? AND peer_id = ? AND token_hash = ''", existing.Id, peerID).
+					Updates(map[string]interface{}{
+						"token_hash": proposedHash, "active_enc": "", "pending_enc": "", "version": 0,
+						"protocol_version": 0, "pending_operation": "", "pending_version": 0, "last_operation_id": "",
+						"active_at": 0, "next_rotation_at": 0, "force_rotate": false, "last_seen_at": now,
+						"awaiting_approval": true, "enrolled_via": "self", "enrolled_at": now, "enrolled_ip": ip,
+						"enroll_epoch": epoch, "approved_at": 0, "approved_by": 0, "uuid": uuid,
+					})
+				if res.Error != nil {
+					return res.Error
+				}
+				if res.RowsAffected != 1 {
+					return errNextecCASRetry
+				}
+			} else if err := tx.Create(row).Error; err != nil {
+				// Corrida com outra inscrição do mesmo ID: relê e decide na próxima volta.
+				return errNextecCASRetry
+			}
+			if err := tx.Create(&model.NextecSecretAudit{At: now, PeerId: peerID, Action: "self_enroll", Ip: ip}).Error; err != nil {
+				return err
+			}
+			result = &NextecSelfEnrollResult{Token: proposedToken, State: NextecStatePending}
+			return nil
+		})
+		if errors.Is(err, errNextecCASRetry) {
+			lastErr = err
+			continue
+		}
+		if err != nil {
+			return nil, err
+		}
+		return result, nil
+	}
+	if lastErr != nil {
+		return nil, ErrNextecOperationConflict
+	}
+	return result, nil
+}
+
+// ---------- administração ----------
+
+type NextecAssignOptions struct {
+	PeerID   string
+	ClientID uint
+	Rule     string // group | peer | none
+	Interval int
+	Move     bool
+	UserID   uint
+	Username string
+	IP       string
+}
+
+type NextecAssignResult struct {
+	PeerID   string `json:"id"`
+	State    string `json:"state"`
+	ClientID uint   `json:"client_id"`
+	Already  bool   `json:"already"`
+	Moved    bool   `json:"moved"`
+	Managed  bool   `json:"managed"`
+	Interval int    `json:"interval_minutes"`
+}
+
+// NextecEnrollAssign atribui uma máquina pendente a um cliente e libera o cofre. Tudo em uma transação.
+func NextecEnrollAssign(o NextecAssignOptions) (*NextecAssignResult, error) {
+	if o.PeerID == "" || len(o.PeerID) > 64 || o.ClientID == 0 {
+		return nil, ErrNextecEnrollBadRequest
+	}
+	switch o.Rule {
+	case "":
+		o.Rule = "group"
+	case "group", "peer", "none":
+	default:
+		return nil, ErrNextecBadRule
+	}
+	interval := o.Interval
+	if o.Rule == "peer" {
+		if interval == 0 {
+			interval = NextecSecretDefaultInterval
+		}
+		if interval < NextecSecretMinInterval || interval > NextecSecretMaxInterval {
+			return nil, errors.New("intervalo fora do limite")
+		}
+	}
+	var out *NextecAssignResult
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		var group model.DeviceGroup
+		if err := tx.First(&group, o.ClientID).Error; err != nil || group.Id == 0 {
+			return ErrNextecNoGroup
+		}
+		var d model.NextecDeviceSecret
+		if err := tx.Where("peer_id = ?", o.PeerID).First(&d).Error; err != nil || d.TokenHash == "" {
+			return ErrNextecEnrollNotFound
+		}
+		var peers []model.Peer
+		if err := tx.Where("id = ?", o.PeerID).Limit(2).Find(&peers).Error; err != nil || len(peers) != 1 {
+			return ErrNextecPeerNotRegistered
+		}
+		peer := peers[0]
+		if d.AwaitingApproval && d.EnrollEpoch != 0 {
+			if _, min := nextecEnrollEpochs(); d.EnrollEpoch < min {
+				return ErrNextecEnrollNotFound // inscrita com credencial revogada: fora da lista
+			}
+		}
+		if peer.GroupId != 0 && peer.GroupId != o.ClientID && !o.Move {
+			return ErrNextecClientConflict
+		}
+		enabled, ruleInterval := effectivePolicyTx(tx, o.PeerID, o.ClientID)
+		if !d.AwaitingApproval && peer.GroupId == o.ClientID {
+			// Repetição do mesmo pedido: nada muda.
+			out = &NextecAssignResult{PeerID: o.PeerID, State: NextecStateAssigned, ClientID: o.ClientID, Already: true, Managed: enabled, Interval: ruleInterval}
+			return nil
+		}
+		if o.Rule == "group" {
+			var gp model.NextecSecretPolicy
+			if tx.Where("kind = ? AND ref = ? AND enabled = ?", "group", strconv.FormatUint(uint64(o.ClientID), 10), true).First(&gp).Error != nil {
+				return ErrNextecNoGroupRule
+			}
+		}
+		now := time.Now().Unix()
+		moved := peer.GroupId != 0 && peer.GroupId != o.ClientID
+		if err := tx.Model(&model.Peer{}).Where("row_id = ?", peer.RowId).Update("group_id", o.ClientID).Error; err != nil {
+			return err
+		}
+		if o.Rule == "peer" {
+			p := &model.NextecSecretPolicy{}
+			tx.Where("kind = ? AND ref = ?", "peer", o.PeerID).First(p)
+			p.Kind, p.Ref, p.Enabled, p.IntervalMinutes = "peer", o.PeerID, true, interval
+			if err := tx.Save(p).Error; err != nil {
+				return err
+			}
+		}
+		updates := map[string]interface{}{"force_rotate": true}
+		if d.AwaitingApproval {
+			updates["awaiting_approval"] = false
+			updates["approved_at"] = now
+			updates["approved_by"] = o.UserID
+		}
+		res := tx.Model(&model.NextecDeviceSecret{}).
+			Where("id = ? AND peer_id = ? AND token_hash = ?", d.Id, o.PeerID, d.TokenHash).
+			Updates(updates)
+		if res.Error != nil {
+			return res.Error
+		}
+		if res.RowsAffected != 1 {
+			return ErrNextecEnrollNotFound
+		}
+		detail := "cliente " + strconv.FormatUint(uint64(o.ClientID), 10) + ", regra " + o.Rule
+		if moved {
+			detail += ", movida"
+		}
+		if err := tx.Create(&model.NextecSecretAudit{At: now, UserId: o.UserID, Username: o.Username, PeerId: o.PeerID, Action: "enroll_assign", Ip: o.IP, Detail: detail}).Error; err != nil {
+			return err
+		}
+		enabled, ruleInterval = effectivePolicyTx(tx, o.PeerID, o.ClientID)
+		out = &NextecAssignResult{PeerID: o.PeerID, State: NextecStateAssigned, ClientID: o.ClientID, Moved: moved, Managed: enabled, Interval: ruleInterval}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+func effectivePolicyTx(tx *gorm.DB, peerID string, groupID uint) (bool, int) {
+	p := &model.NextecSecretPolicy{}
+	if tx.Where("kind = ? and ref = ?", "peer", peerID).First(p).Error == nil {
+		return p.Enabled, p.IntervalMinutes
+	}
+	if groupID != 0 && tx.Where("kind = ? and ref = ?", "group", strconv.FormatUint(uint64(groupID), 10)).First(p).Error == nil {
+		return p.Enabled, p.IntervalMinutes
+	}
+	return false, 0
+}
+
+// NextecEnrollReject remove uma inscrição pendente; com block, o par id+uuid não consegue voltar.
+func NextecEnrollReject(peerID string, block bool, userID uint, username, ip string) error {
+	if peerID == "" || len(peerID) > 64 {
+		return ErrNextecEnrollBadRequest
+	}
+	return DB.Transaction(func(tx *gorm.DB) error {
+		var d model.NextecDeviceSecret
+		if err := tx.Where("peer_id = ? AND awaiting_approval = ?", peerID, true).First(&d).Error; err != nil {
+			return ErrNextecEnrollNotFound
+		}
+		now := time.Now().Unix()
+		if block {
+			uuid := d.Uuid
+			if uuid == "" {
+				var peer model.Peer
+				if tx.Where("id = ?", peerID).First(&peer).Error == nil {
+					uuid = peer.Uuid
+				}
+			}
+			var n int64
+			if err := tx.Model(&model.NextecEnrollBlock{}).Where("peer_id = ? AND uuid = ?", peerID, uuid).Count(&n).Error; err != nil {
+				return err
+			}
+			if n == 0 {
+				if err := tx.Create(&model.NextecEnrollBlock{PeerId: peerID, Uuid: uuid, BlockedAt: now, BlockedBy: userID}).Error; err != nil {
+					return err
+				}
+			}
+		}
+		res := tx.Where("id = ? AND peer_id = ? AND awaiting_approval = ?", d.Id, peerID, true).Delete(&model.NextecDeviceSecret{})
+		if res.Error != nil {
+			return res.Error
+		}
+		if res.RowsAffected != 1 {
+			return ErrNextecEnrollNotFound
+		}
+		action := "enroll_reject"
+		if block {
+			action = "enroll_block"
+		}
+		return tx.Create(&model.NextecSecretAudit{At: now, UserId: userID, Username: username, PeerId: peerID, Action: action, Ip: ip}).Error
+	})
+}
+
+// NextecEnrollUnblock libera um par bloqueado (uuid vazio libera todos os pares do ID).
+func NextecEnrollUnblock(peerID, uuid string, userID uint, username, ip string) (int64, error) {
+	if peerID == "" || len(peerID) > 64 {
+		return 0, ErrNextecEnrollBadRequest
+	}
+	q := DB.Where("peer_id = ?", peerID)
+	if uuid != "" {
+		q = q.Where("uuid = ?", uuid)
+	}
+	res := q.Delete(&model.NextecEnrollBlock{})
+	if res.Error != nil {
+		return 0, res.Error
+	}
+	if res.RowsAffected > 0 {
+		NextecSecretAuditAdd(&model.User{IdModel: model.IdModel{Id: userID}, Username: username}, peerID, "enroll_unblock", ip, "")
+	}
+	return res.RowsAffected, nil
+}
+
+type NextecEnrollBlockInfo struct {
+	PeerId    string `json:"peer_id"`
+	Uuid      string `json:"uuid"`
+	BlockedAt int64  `json:"blocked_at"`
+}
+
+func NextecEnrollBlocks() []*NextecEnrollBlockInfo {
+	var rows []*model.NextecEnrollBlock
+	DB.Order("id desc").Limit(500).Find(&rows)
+	out := make([]*NextecEnrollBlockInfo, 0, len(rows))
+	for _, r := range rows {
+		out = append(out, &NextecEnrollBlockInfo{PeerId: r.PeerId, Uuid: r.Uuid, BlockedAt: r.BlockedAt})
+	}
+	return out
+}
+
+// NextecEnrollPendingCount conta as pendentes visíveis (inscritas com credencial ainda válida).
+func NextecEnrollPendingCount() int {
+	_, min := nextecEnrollEpochs()
+	var n int64
+	DB.Model(&model.NextecDeviceSecret{}).Where("awaiting_approval = ? AND enroll_epoch >= ?", true, min).Count(&n)
+	return int(n)
+}
