+package service
+
+import (
+	"bytes"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"github.com/sirupsen/logrus"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+const (
+	enrollPeer = "123456789"
+	enrollUUID = "uuid-enroll-original"
+)
+
+var enrollTokenSeq int
+
+// enrollToken devolve um token proposto válido (base64url de 32 bytes), diferente a cada chamada.
+func enrollToken() string {
+	enrollTokenSeq++
+	raw := bytes.Repeat([]byte{byte(enrollTokenSeq)}, 32)
+	raw[0], raw[1] = byte(enrollTokenSeq>>8), byte(enrollTokenSeq)
+	return base64.RawURLEncoding.EncodeToString(raw)
+}
+
+func enrollSetup(t *testing.T) *gorm.DB {
+	t.Helper()
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&model.Peer{}, &model.DeviceGroup{}, &model.NextecSecretPolicy{}, &model.NextecDeviceSecret{},
+		&model.NextecSecretAudit{}, &model.NextecAgentBootstrap{}, &model.NextecEnrollBlock{}); err != nil {
+		t.Fatal(err)
+	}
+	sqlDB, err := db.DB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sqlDB.SetMaxOpenConns(1)
+	oldDB, oldService, oldLogger := DB, AllService, Logger
+	oldKeyOnce, oldKey, oldKeyErr := nextecVaultKeyOnce, nextecVaultKeyValue, nextecVaultKeyErr
+	DB, AllService, Logger = db, &Service{}, logrus.New()
+	nextecVaultKeyOnce, nextecVaultKeyValue, nextecVaultKeyErr = sync.Once{}, nil, nil
+	t.Setenv("NEXTEC_VAULT_KEY", base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x33}, 32)))
+	// nextec-settings.json fica em ./data: isola cada teste numa pasta temporária.
+	wd, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chdir(t.TempDir()); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		_ = os.Chdir(wd)
+		DB, AllService, Logger = oldDB, oldService, oldLogger
+		nextecVaultKeyOnce, nextecVaultKeyValue, nextecVaultKeyErr = oldKeyOnce, oldKey, oldKeyErr
+		_ = sqlDB.Close()
+	})
+	nextecFailMu.Lock()
+	nextecFailures = map[string][]int64{}
+	nextecFailMu.Unlock()
+	if err := db.Create(&model.DeviceGroup{IdModel: model.IdModel{Id: 7}, Name: "Cliente A"}).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Create(&model.DeviceGroup{IdModel: model.IdModel{Id: 8}, Name: "Cliente B"}).Error; err != nil {
+		t.Fatal(err)
+	}
+	// Máquina que já se registrou via sysinfo e está no ar, ainda sem cliente.
+	if err := db.Create(&model.Peer{Id: enrollPeer, Uuid: enrollUUID, LastOnlineTime: time.Now().Unix(), Hostname: "PC-01", Os: "windows", Username: "ana"}).Error; err != nil {
+		t.Fatal(err)
+	}
+	return db
+}
