+func TestPendingListHiddenAfterKeyRotation(t *testing.T) {
+	db := enrollSetup(t)
+	if _, err := NextecSelfEnroll("10.8.0.1", enrollKey(t), enrollPeer, enrollUUID, enrollToken()); err != nil {
+		t.Fatal(err)
+	}
+	if NextecEnrollPendingCount() != 1 {
+		t.Fatal("pendente não contado")
+	}
+	var found *NextecSecretDevice
+	for _, d := range NextecSecretDevices() {
+		if d.PeerId == enrollPeer {
+			found = d
+		}
+	}
+	if found == nil || found.State != NextecStatePending || found.EnrolledVia != "self" || found.Os != "windows" || found.Username != "ana" || found.Managed {
+		t.Fatalf("item pendente: %#v", found)
+	}
+	if _, _, _, err := NextecEnrollKeyRotate(); err != nil {
+		t.Fatal(err)
+	}
+	if NextecEnrollPendingCount() != 0 {
+		t.Fatal("pendente de credencial revogada continuou contado")
+	}
+	for _, d := range NextecSecretDevices() {
+		if d.PeerId == enrollPeer {
+			t.Fatal("pendente de credencial revogada continuou listado")
+		}
+	}
+	if _, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "none"}); !errors.Is(err, ErrNextecEnrollNotFound) {
+		t.Fatalf("atribuiu pendente revogado: %v", err)
+	}
+	_ = db
+}
