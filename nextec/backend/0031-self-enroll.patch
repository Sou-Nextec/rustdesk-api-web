+	// Cliente inexistente e máquina inexistente.
+	if _, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 99, Rule: "none"}); !errors.Is(err, ErrNextecNoGroup) {
