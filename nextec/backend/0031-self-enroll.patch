+func TestAssignConcurrentIsSingleWinner(t *testing.T) {
+	db := enrollSetup(t)
+	if _, err := NextecSelfEnroll("10.6.2.1", enrollKey(t), enrollPeer, enrollUUID, enrollToken()); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := NextecSecretUpsertPolicy("group", "7", true, 60); err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	results := make([]*NextecAssignResult, 8)
+	errs := make([]error, 8)
+	for i := range results {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			results[i], errs[i] = NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "group", UserID: uint(i + 1)})
+		}(i)
+	}
+	wg.Wait()
+	fresh := 0
+	for i := range results {
+		if errs[i] != nil {
+			t.Fatalf("goroutine %d: %v", i, errs[i])
+		}
+		if !results[i].Already {
+			fresh++
+		}
+	}
+	if fresh != 1 {
+		t.Fatalf("atribuições efetivas: %d", fresh)
+	}
+	var audits int64
+	db.Model(&model.NextecSecretAudit{}).Where("action = ?", "enroll_assign").Count(&audits)
+	if audits != 1 {
+		t.Fatalf("auditorias: %d", audits)
+	}
+}
