+func TestSelfEnrollValidationAndIdentity(t *testing.T) {
+	db := enrollSetup(t)
+	key := enrollKey(t)
+	ip := "10.1.2.1"
+	cases := []struct {
+		name          string
+		key, id, uuid string
+		token         string
+		want          error
+	}{
+		{"id curto", key, "123", enrollUUID, enrollToken(), ErrNextecEnrollBadRequest},
+		{"id com letras", key, "abcdef12", enrollUUID, enrollToken(), ErrNextecEnrollBadRequest},
+		{"uuid vazio", key, enrollPeer, "", enrollToken(), ErrNextecEnrollBadRequest},
+		{"token curto", key, enrollPeer, enrollUUID, "abc", ErrNextecEnrollBadRequest},
+		{"chave vazia", "", enrollPeer, enrollUUID, enrollToken(), ErrNextecEnrollBadRequest},
+		{"chave errada", "nx1.1.deadbeef", enrollPeer, enrollUUID, enrollToken(), ErrNextecEnrollKeyInvalid},
+		{"peer ausente", key, "987654321", "u", enrollToken(), ErrNextecPeerNotRegistered},
+		{"uuid diferente", key, enrollPeer, "outro-uuid", enrollToken(), ErrNextecIdentityConflict},
+	}
+	for _, c := range cases {
+		if _, err := NextecSelfEnroll(ip, c.key, c.id, c.uuid, c.token); !errors.Is(err, c.want) {
+			t.Fatalf("%s: err=%v quer %v", c.name, err, c.want)
+		}
+	}
+	var n int64
+	db.Model(&model.NextecDeviceSecret{}).Count(&n)
+	if n != 0 {
+		t.Fatalf("linhas criadas por pedidos inválidos: %d", n)
+	}
+	// Máquina não vista há mais de 10 minutos.
+	db.Model(&model.Peer{}).Where("id = ?", enrollPeer).Update("last_online_time", time.Now().Add(-11*time.Minute).Unix())
+	if _, err := NextecSelfEnroll(ip, key, enrollPeer, enrollUUID, enrollToken()); !errors.Is(err, ErrNextecPeerNotRegistered) {
+		t.Fatalf("peer antigo: %v", err)
+	}
+	db.Model(&model.Peer{}).Where("id = ?", enrollPeer).Update("last_online_time", time.Now().Unix())
+	// Replay idempotente com o mesmo token; outro token em pendente é conflito.
+	token := enrollToken()
+	for i := 0; i < 3; i++ {
+		res, err := NextecSelfEnroll(ip, key, enrollPeer, enrollUUID, token)
+		if err != nil || res.State != NextecStatePending {
+			t.Fatalf("replay %d: %#v %v", i, res, err)
+		}
+	}
+	db.Model(&model.NextecDeviceSecret{}).Count(&n)
+	var audits int64
+	db.Model(&model.NextecSecretAudit{}).Where("action = ?", "self_enroll").Count(&audits)
+	if n != 1 || audits != 1 {
+		t.Fatalf("replay duplicou: linhas=%d auditorias=%d", n, audits)
+	}
+	if _, err := NextecSelfEnroll(ip, key, enrollPeer, enrollUUID, enrollToken()); !errors.Is(err, ErrNextecIdentityConflict) {
+		t.Fatalf("outro token em pendente: %v", err)
+	}
+	if deviceRow(t, db, enrollPeer).TokenHash != sha256Hex(token) {
+		t.Fatal("token do pendente foi sobrescrito")
+	}
+	// Peer trocou de uuid depois de pendente: conflito, não adota a linha.
+	db.Model(&model.Peer{}).Where("id = ?", enrollPeer).Update("uuid", "novo-uuid")
+	if _, err := NextecSelfEnroll(ip, key, enrollPeer, "novo-uuid", token); !errors.Is(err, ErrNextecIdentityConflict) {
+		t.Fatalf("uuid mudou: %v", err)
+	}
+}
