new file mode 100644
index 0000000..8c00013
--- /dev/null
+++ b/http/controller/api/nextec_enroll_test.go
@@ -0,0 +1,130 @@
+package api
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+func TestSelfEnrollHTTPContract(t *testing.T) {
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&model.Peer{}, &model.DeviceGroup{}, &model.NextecSecretPolicy{}, &model.NextecDeviceSecret{}, &model.NextecSecretAudit{}, &model.NextecAgentBootstrap{}, &model.NextecEnrollBlock{}); err != nil {
+		t.Fatal(err)
+	}
+	sqlDB, _ := db.DB()
+	sqlDB.SetMaxOpenConns(1)
+	oldDB, oldService := service.DB, service.AllService
+	service.DB, service.AllService = db, &service.Service{}
+	t.Setenv("NEXTEC_VAULT_KEY", base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x51}, 32)))
+	wd, _ := os.Getwd()
+	if err := os.Chdir(t.TempDir()); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chdir(wd); service.DB, service.AllService = oldDB, oldService; sqlDB.Close() })
+	db.Create(&model.Peer{Id: "424242424", Uuid: "uuid-http", LastOnlineTime: time.Now().Unix()})
+	key, _, _, err := service.NextecEnrollKeyInfo()
+	if err != nil {
+		t.Fatal(err)
+	}
+	token := base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{7}, 32))
+
+	r := gin.New()
+	ag := &NextecAgent{}
+	r.POST("/self-enroll", ag.SelfEnroll)
+	r.POST("/sync", ag.Sync)
+	r.POST("/password", ag.Password)
+	r.POST("/confirm", ag.Confirm)
+	call := func(path string, body map[string]interface{}, ip string) (int, map[string]interface{}) {
+		raw, _ := json.Marshal(body)
+		req := httptest.NewRequest("POST", path, strings.NewReader(string(raw)))
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("CF-Connecting-IP", ip)
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, req)
+		out := map[string]interface{}{}
+		_ = json.Unmarshal(w.Body.Bytes(), &out)
+		return w.Code, out
+	}
+	good := map[string]interface{}{"enroll_key": key, "id": "424242424", "uuid": "uuid-http", "proposed_token": token}
+	with := func(k string, v interface{}) map[string]interface{} {
+		m := map[string]interface{}{}
+		for a, b := range good {
+			m[a] = b
+		}
+		m[k] = v
+		return m
+	}
+	cases := []struct {
+		name string
+		body map[string]interface{}
+		code int
+		err  string
+	}{
+		{"id invalido", with("id", "12"), 400, "bad_request"},
+		{"chave errada", with("enroll_key", "nx1.1.00"), 401, "enroll_key_invalid"},
+		{"peer inexistente", with("id", "555555555"), 404, "peer_not_registered"},
+		{"uuid diferente", with("uuid", "intruso"), 409, "identity_conflict"},
+	}
+	for _, c := range cases {
+		code, out := call("/self-enroll", c.body, "10.20.0.1")
+		if code != c.code || out["error"] != c.err {
+			t.Fatalf("%s: %d %v", c.name, code, out)
+		}
+	}
+	code, out := call("/self-enroll", good, "10.20.0.1")
+	if code != 200 || out["state"] != "pending" || out["token"] != token {
+		t.Fatalf("inscrição: %d %v", code, out)
+	}
+	code, out = call("/self-enroll", good, "10.20.0.1")
+	if code != 200 || out["state"] != "pending" {
+		t.Fatalf("replay: %d %v", code, out)
+	}
+	code, out = call("/self-enroll", with("proposed_token", base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{8}, 32))), "10.20.0.1")
+	if code != 409 || out["error"] != "identity_conflict" {
+		t.Fatalf("token diferente: %d %v", code, out)
+	}
+	// Sync do pendente e recusa de senha.
+	code, out = call("/sync", map[string]interface{}{"id": "424242424", "token": token, "capabilities": []string{"transaction_v1"}}, "10.20.0.1")
+	if code != 200 || out["pending_approval"] != true || out["managed"] != false || out["operation"] != nil {
+		t.Fatalf("sync do pendente: %d %v", code, out)
+	}
+	code, out = call("/password", map[string]interface{}{"id": "424242424", "token": token, "password": "ValidPassword123456", "operation_id": "x", "pending_version": 1}, "10.20.0.1")
+	if code != 403 || out["error"] != "pending_approval" {
+		t.Fatalf("password do pendente: %d %v", code, out)
+	}
+	code, out = call("/confirm", map[string]interface{}{"id": "424242424", "token": token}, "10.20.0.1")
+	if code != 403 || out["error"] != "pending_approval" {
+		t.Fatalf("confirm do pendente: %d %v", code, out)
+	}
+	// Bloqueio.
+	if err := service.NextecEnrollReject("424242424", true, 1, "admin", ""); err != nil {
+		t.Fatal(err)
+	}
+	code, out = call("/self-enroll", good, "10.20.0.1")
+	if code != 403 || out["error"] != "blocked" {
+		t.Fatalf("bloqueada: %d %v", code, out)
+	}
+	// Muitas chaves erradas.
+	for i := 0; i < 10; i++ {
+		call("/self-enroll", with("enroll_key", "nx1.1.00"), "10.20.0.2")
+	}
+	code, out = call("/self-enroll", good, "10.20.0.2")
+	if code != 429 || out["error"] != "too_many_failures" {
+		t.Fatalf("falhas: %d %v", code, out)
+	}
+}
