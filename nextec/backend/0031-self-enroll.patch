+		t.Fatal(err)
+	}
+	r2, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "none"})
+	if err != nil || r2.Managed {
+		t.Fatalf("rule none: %#v %v", r2, err)
