+	}
+	// Repetir é idempotente e não rearma a troca.
+	db.Model(d).Update("force_rotate", false)
+	again, err := NextecEnrollAssign(opt)
+	if err != nil || !again.Already {
+		t.Fatalf("repetição: %#v %v", again, err)
+	}
+	if deviceRow(t, db, enrollPeer).ForceRotate {
+		t.Fatal("repetição rearmou force_rotate")
+	}
+	var audits int64
+	db.Model(&model.NextecSecretAudit{}).Where("action = ?", "enroll_assign").Count(&audits)
+	if audits != 1 {
+		t.Fatalf("auditorias de atribuição: %d", audits)
+	}
+	// Outro cliente exige move.
+	other := opt
+	other.ClientID = 8
+	if _, err := NextecEnrollAssign(other); !errors.Is(err, ErrNextecClientConflict) {
+		t.Fatalf("mover sem flag: %v", err)
+	}
+	db.Where("id = ?", enrollPeer).First(&peer)
+	if peer.GroupId != 7 {
+		t.Fatal("máquina movida sem move")
+	}
+	// Agora o agente recebe operação normal, sem pending_approval.
+	s, err := NextecAgentSyncStateWithCapabilities("10.6.0.1", enrollPeer, token, []string{"transaction_v1"})
+	if err != nil || s.PendingApproval || !s.Managed || s.Operation == nil || !s.Rotate {
+		t.Fatalf("sync após aprovar: %#v %v", s, err)
+	}
+}
