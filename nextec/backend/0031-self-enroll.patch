+func TestRejectBlockAndUnblock(t *testing.T) {
+	db := enrollSetup(t)
+	key := enrollKey(t)
+	token := enrollToken()
+	if _, err := NextecSelfEnroll("10.7.0.1", key, enrollPeer, enrollUUID, token); err != nil {
+		t.Fatal(err)
+	}
+	// Rejeitar sem bloquear remove a linha; a máquina pode se inscrever de novo.
+	if err := NextecEnrollReject(enrollPeer, false, 1, "admin", "10.9.9.9"); err != nil {
+		t.Fatal(err)
+	}
+	if err := NextecEnrollReject(enrollPeer, false, 1, "admin", "10.9.9.9"); !errors.Is(err, ErrNextecEnrollNotFound) {
+		t.Fatalf("rejeitar de novo: %v", err)
+	}
+	if _, err := NextecSelfEnroll("10.7.0.1", key, enrollPeer, enrollUUID, token); err != nil {
+		t.Fatalf("reinscrição após rejeitar: %v", err)
+	}
+	// Bloquear impede a volta, mesmo com chave válida.
+	if err := NextecEnrollReject(enrollPeer, true, 1, "admin", "10.9.9.9"); err != nil {
+		t.Fatal(err)
+	}
+	var n int64
+	db.Model(&model.NextecDeviceSecret{}).Count(&n)
+	if n != 0 {
+		t.Fatal("linha ficou depois de bloquear")
+	}
+	if _, err := NextecSelfEnroll("10.7.0.1", key, enrollPeer, enrollUUID, token); !errors.Is(err, ErrNextecEnrollBlocked) {
+		t.Fatalf("máquina bloqueada se inscreveu: %v", err)
+	}
+	if len(NextecEnrollBlocks()) != 1 {
+		t.Fatal("lista de bloqueios")
+	}
+	// O bloqueio é por id+uuid: outro uuid no mesmo id não é bloqueado pela tabela (o Peer exige o uuid dele).
+	if removed, err := NextecEnrollUnblock(enrollPeer, "", 1, "admin", "10.9.9.9"); err != nil || removed != 1 {
+		t.Fatalf("desbloquear: %d %v", removed, err)
+	}
+	if _, err := NextecSelfEnroll("10.7.0.1", key, enrollPeer, enrollUUID, token); err != nil {
+		t.Fatalf("após desbloquear: %v", err)
+	}
+	// Agente aprovado não é rejeitável (use remover agente).
+	if _, err := NextecSecretUpsertPolicy("peer", enrollPeer, true, 60); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "peer", Interval: 60}); err != nil {
+		t.Fatal(err)
+	}
+	if err := NextecEnrollReject(enrollPeer, true, 1, "admin", ""); !errors.Is(err, ErrNextecEnrollNotFound) {
+		t.Fatalf("rejeitou agente aprovado: %v", err)
+	}
+}
