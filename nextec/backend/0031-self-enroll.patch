new file mode 100644
index 0000000..b9bdc26
--- /dev/null
+++ b/http/controller/admin/nextec_enroll.go
@@ -0,0 +1,142 @@
+package admin
+
+import (
+	"strconv"
+	"errors"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/http/response"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+)
+
+// NextecEnroll: aprovação das máquinas que se inscreveram sozinhas e credencial de inscrição (somente admin).
+// Erros usam o código 101 do envelope: o código 403 do envelope derruba a sessão do painel.
+type NextecEnroll struct{}
+
+type nextecAssignForm struct {
+	Id       string `json:"id"`
+	ClientId uint   `json:"client_id"`
+	Rule     string `json:"rule"`
+	Interval int    `json:"interval_minutes"`
+	Move     bool   `json:"move"`
+}
+
+type nextecRejectForm struct {
+	Id    string `json:"id"`
+	Block bool   `json:"block"`
+}
+
+type nextecUnblockForm struct {
+	Id   string `json:"id"`
+	Uuid string `json:"uuid"`
+}
+
+func enrollFail(c *gin.Context, err error) {
+	msg := "Não foi possível concluir. Tente de novo."
+	switch {
+	case errors.Is(err, service.ErrNextecEnrollNotFound):
+		msg = "Esta máquina não está mais pendente. Atualize a lista."
+	case errors.Is(err, service.ErrNextecClientConflict):
+		msg = "Esta máquina já pertence a outro cliente. Marque a opção de mover para trocar."
+	case errors.Is(err, service.ErrNextecNoGroupRule):
+		msg = "O cliente não tem regra de senha automática ligada. Escolha a regra da máquina ou ligue a regra do cliente em Regras."
+	case errors.Is(err, service.ErrNextecNoGroup):
+		msg = "Cliente não encontrado."
+	case errors.Is(err, service.ErrNextecBadRule), errors.Is(err, service.ErrNextecEnrollBadRequest):
+		msg = "Pedido inválido."
+	case errors.Is(err, service.ErrNextecPeerNotRegistered):
+		msg = "A máquina ainda não se registrou no servidor."
+	default:
+		if err != nil && err.Error() == "intervalo fora do limite" {
+			msg = "Intervalo fora do limite (15 minutos a 24 horas)."
+		}
+	}
+	response.Fail(c, 101, msg)
+}
+
+// Assign atribui a máquina pendente a um cliente e libera a senha automática
+// @Router /admin/nextec/secrets/assign [post]
+func (n *NextecEnroll) Assign(c *gin.Context) {
+	f := &nextecAssignForm{}
+	if err := c.ShouldBindJSON(f); err != nil || f.Id == "" || f.ClientId == 0 {
+		response.Fail(c, 101, "Pedido inválido.")
+		return
+	}
+	u := service.AllService.UserService.CurUser(c)
+	opt := service.NextecAssignOptions{PeerID: f.Id, ClientID: f.ClientId, Rule: f.Rule, Interval: f.Interval, Move: f.Move, IP: nextecIP(c)}
+	if u != nil {
+		opt.UserID, opt.Username = u.Id, u.Username
+	}
+	res, err := service.NextecEnrollAssign(opt)
+	if err != nil {
+		enrollFail(c, err)
+		return
+	}
+	response.Success(c, res)
+}
+
+// Reject remove uma inscrição pendente; com block=true bloqueia o par ID+UUID
+// @Router /admin/nextec/secrets/reject [post]
+func (n *NextecEnroll) Reject(c *gin.Context) {
+	f := &nextecRejectForm{}
+	if err := c.ShouldBindJSON(f); err != nil || f.Id == "" {
+		response.Fail(c, 101, "Pedido inválido.")
+		return
+	}
+	u := service.AllService.UserService.CurUser(c)
+	var uid uint
+	var name string
+	if u != nil {
+		uid, name = u.Id, u.Username
+	}
+	if err := service.NextecEnrollReject(f.Id, f.Block, uid, name, nextecIP(c)); err != nil {
+		enrollFail(c, err)
+		return
+	}
+	response.Success(c, &gin.H{"blocked": f.Block})
+}
+
+// Unblock libera um ID bloqueado
+// @Router /admin/nextec/secrets/unblock [post]
+func (n *NextecEnroll) Unblock(c *gin.Context) {
+	f := &nextecUnblockForm{}
+	if err := c.ShouldBindJSON(f); err != nil || f.Id == "" {
+		response.Fail(c, 101, "Pedido inválido.")
+		return
+	}
+	u := service.AllService.UserService.CurUser(c)
+	var uid uint
+	var name string
+	if u != nil {
+		uid, name = u.Id, u.Username
+	}
+	removed, err := service.NextecEnrollUnblock(f.Id, f.Uuid, uid, name, nextecIP(c))
+	if err != nil {
+		enrollFail(c, err)
+		return
+	}
+	response.Success(c, &gin.H{"removed": removed})
+}
+
+// Key devolve a credencial de inscrição vigente
+// @Router /admin/nextec/enroll-key [get]
+func (n *NextecEnroll) Key(c *gin.Context) {
+	key, epoch, minEpoch, err := service.NextecEnrollKeyInfo()
+	if err != nil {
+		response.Fail(c, 101, "Não foi possível ler a credencial de inscrição.")
+		return
+	}
+	response.Success(c, &gin.H{"key": key, "epoch": epoch, "min_epoch": minEpoch})
+}
+
+// Rotate gera uma nova credencial e invalida as anteriores
+// @Router /admin/nextec/enroll-key/rotate [post]
+func (n *NextecEnroll) Rotate(c *gin.Context) {
+	key, epoch, minEpoch, err := service.NextecEnrollKeyRotate()
+	if err != nil {
+		response.Fail(c, 101, "Não foi possível girar a credencial de inscrição.")
+		return
+	}
+	service.NextecSecretAuditAdd(service.AllService.UserService.CurUser(c), "", "enroll_key_rotate", nextecIP(c), "época "+strconv.Itoa(epoch))
+	response.Success(c, &gin.H{"key": key, "epoch": epoch, "min_epoch": minEpoch})
+}
