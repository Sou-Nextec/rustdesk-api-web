diff --git a/http/controller/api/nextec_enroll.go b/http/controller/api/nextec_enroll.go
new file mode 100644
index 0000000..ec6c7c7
--- /dev/null
+++ b/http/controller/api/nextec_enroll.go
@@ -0,0 +1,51 @@
+package api
+
+import (
+	"errors"
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+)
+
+type selfEnrollForm struct {
+	EnrollKey     string `json:"enroll_key"`
+	Id            string `json:"id"`
+	Uuid          string `json:"uuid"`
+	ProposedToken string `json:"proposed_token"`
+}
+
+// SelfEnroll POST /api/nextec/agent/self-enroll {enroll_key, id, uuid, proposed_token}
+// A máquina entra como pendente: sem senha e sem acesso até o admin atribuí-la a um cliente.
+func (a *NextecAgent) SelfEnroll(c *gin.Context) {
+	f := &selfEnrollForm{}
+	if err := c.ShouldBindJSON(f); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "bad_request"})
+		return
+	}
+	res, err := service.NextecSelfEnroll(agentIP(c), f.EnrollKey, f.Id, f.Uuid, f.ProposedToken)
+	if err != nil {
+		switch {
+		case errors.Is(err, service.ErrNextecEnrollBadRequest):
+			c.JSON(http.StatusBadRequest, gin.H{"error": "bad_request"})
+		case errors.Is(err, service.ErrNextecEnrollKeyInvalid):
+			c.JSON(http.StatusUnauthorized, gin.H{"error": "enroll_key_invalid"})
+		case errors.Is(err, service.ErrNextecEnrollBlocked):
+			c.JSON(http.StatusForbidden, gin.H{"error": "blocked"})
+		case errors.Is(err, service.ErrNextecPeerNotRegistered):
+			c.JSON(http.StatusNotFound, gin.H{"error": "peer_not_registered"})
+		case errors.Is(err, service.ErrNextecIdentityConflict):
+			c.JSON(http.StatusConflict, gin.H{"error": "identity_conflict"})
+		case errors.Is(err, service.ErrNextecAlreadyEnroll):
+			c.JSON(http.StatusConflict, gin.H{"error": "already_enrolled"})
+		case errors.Is(err, service.ErrNextecTooManyFails):
+			c.JSON(http.StatusTooManyRequests, gin.H{"error": "too_many_failures"})
+		case errors.Is(err, service.ErrNextecPendingLimit):
+			c.JSON(http.StatusTooManyRequests, gin.H{"error": "pending_limit"})
+		default:
+			c.JSON(http.StatusInternalServerError, gin.H{"error": "internal_error"})
+		}
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"token": res.Token, "state": res.State})
+}
