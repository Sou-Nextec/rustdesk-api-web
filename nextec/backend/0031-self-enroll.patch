+func TestEnrollKeyRotationAndEpochs(t *testing.T) {
+	enrollSetup(t)
+	k1 := enrollKey(t)
+	if !strings.HasPrefix(k1, "nx1.1.") {
+		t.Fatalf("formato inesperado: %.8s", k1)
+	}
+	if _, ok := nextecEnrollKeyEpoch(k1); !ok {
+		t.Fatal("credencial vigente recusada")
+	}
+	k2, epoch, min, err := NextecEnrollKeyRotate()
+	if err != nil || epoch != 2 || min != 2 || k2 == k1 {
+		t.Fatalf("rotação: epoch=%d min=%d err=%v", epoch, min, err)
+	}
+	if _, ok := nextecEnrollKeyEpoch(k1); ok {
+		t.Fatal("credencial revogada aceita")
+	}
+	if _, ok := nextecEnrollKeyEpoch(k2); !ok {
+		t.Fatal("credencial nova recusada")
+	}
+	// Forjar época futura ou trocar a época mantendo o HMAC não funciona.
+	forged := "nx1.9." + strings.SplitN(k2, ".", 3)[2]
+	for _, bad := range []string{"", "x", forged, "nx1.2.", "nx1.0." + strings.SplitN(k2, ".", 3)[2], k2 + "0", strings.ToUpper(k2), "nx2.2." + strings.SplitN(k2, ".", 3)[2]} {
+		if _, ok := nextecEnrollKeyEpoch(bad); ok {
+			t.Fatalf("credencial inválida aceita: %.12q", bad)
+		}
+	}
+	// A credencial não depende só do que está no arquivo: sem a chave do cofre não se calcula.
+	if strings.Contains(k2, "enroll") {
+		t.Fatal("credencial expõe o texto base")
+	}
+	if _, err := NextecSelfEnroll("10.1.1.1", k1, enrollPeer, enrollUUID, enrollToken()); !errors.Is(err, ErrNextecEnrollKeyInvalid) {
+		t.Fatalf("self-enroll com chave revogada: %v", err)
+	}
+}
