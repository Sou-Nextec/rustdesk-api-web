diff --git a/service/nextec_enroll_umclique_test.go b/service/nextec_enroll_umclique_test.go
new file mode 100644
index 0000000..323e0bb
--- /dev/null
+++ b/service/nextec_enroll_umclique_test.go
@@ -0,0 +1,128 @@
+package service
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+)
+
+// Atribuir em um clique: Rule=group com EnableGroupRule liga a regra do cliente e atribui na mesma transação.
+
+func groupPolicy(db *gorm.DB, ref string) *model.NextecSecretPolicy {
+	p := &model.NextecSecretPolicy{}
+	if db.Where("kind = ? AND ref = ?", "group", ref).First(p).Error != nil {
+		return nil
+	}
+	return p
+}
+
+func TestAssignEnableGroupRuleOneStep(t *testing.T) {
+	db, _ := enrollPending(t, "10.40.0.1")
+	res, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "group", EnableGroupRule: true, Uuid: enrollUUID})
+	if err != nil || !res.Managed || !res.GroupRuleEnabled || res.Interval != NextecSecretDefaultInterval {
+		t.Fatalf("assign um clique: %#v %v", res, err)
+	}
+	if gp := groupPolicy(db, "7"); gp == nil || !gp.Enabled || gp.IntervalMinutes != NextecSecretDefaultInterval {
+		t.Fatalf("regra do cliente: %#v", gp)
+	}
+	if peerPolicy(db, enrollPeer) != nil {
+		t.Fatal("criou regra própria sem necessidade")
+	}
+	d := deviceRow(t, db, enrollPeer)
+	if d.AwaitingApproval || !d.ForceRotate {
+		t.Fatalf("estado da máquina: %#v", d)
+	}
+	if peerGroupOf(t, db) != 7 {
+		t.Fatal("não moveu para o cliente")
+	}
+	if auditCount(db, "client_rule_enable") != 1 || auditCount(db, "enroll_assign") != 1 {
+		t.Fatal("auditoria incompleta")
+	}
+}
+
+func TestAssignEnableGroupRuleIsIdempotent(t *testing.T) {
+	db, _ := enrollPending(t, "10.40.0.2")
+	opt := NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "group", EnableGroupRule: true, GroupInterval: 60}
+	if _, err := NextecEnrollAssign(opt); err != nil {
+		t.Fatal(err)
+	}
+	res, err := NextecEnrollAssign(opt)
+	if err != nil || !res.Already || res.GroupRuleEnabled || res.Interval != 60 {
+		t.Fatalf("repetição: %#v %v", res, err)
+	}
+	if auditCount(db, "client_rule_enable") != 1 || auditCount(db, "enroll_assign") != 1 {
+		t.Fatal("repetir auditou de novo")
+	}
+}
+
+func TestAssignWithoutFlagStillRefusedAndNothingChanges(t *testing.T) {
+	db, _ := enrollPending(t, "10.40.0.3")
+	_, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "group"})
+	if !errors.Is(err, ErrNextecNoGroupRule) {
+		t.Fatalf("esperava ErrNextecNoGroupRule: %v", err)
+	}
+	if groupPolicy(db, "7") != nil || !deviceRow(t, db, enrollPeer).AwaitingApproval {
+		t.Fatal("algo mudou sem a flag")
+	}
+}
+
+func TestAssignEnableGroupRuleIsAtomicOnIdentityFailure(t *testing.T) {
+	db, _ := enrollPending(t, "10.40.0.4")
+	_, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "group", EnableGroupRule: true, Uuid: "uuid-que-o-admin-nao-viu"})
+	if !errors.Is(err, ErrNextecIdentityConflict) {
+		t.Fatalf("esperava conflito de identidade: %v", err)
+	}
+	if groupPolicy(db, "7") != nil {
+		t.Fatal("ligou a regra do cliente apesar da identidade divergente")
+	}
+	if auditCount(db, "client_rule_enable") != 0 || !deviceRow(t, db, enrollPeer).AwaitingApproval {
+		t.Fatal("deixou rastro de um pedido recusado")
+	}
+}
+
+func TestAssignEnableGroupRuleReusesDisabledRuleInterval(t *testing.T) {
+	db, _ := enrollPending(t, "10.40.0.5")
+	if _, err := NextecSecretUpsertPolicy("group", "7", false, 90); err != nil {
+		t.Fatal(err)
+	}
+	res, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "group", EnableGroupRule: true})
+	if err != nil || !res.Managed || res.Interval != 90 || !res.GroupRuleEnabled {
+		t.Fatalf("regra desligada: %#v %v", res, err)
+	}
+	if gp := groupPolicy(db, "7"); gp == nil || !gp.Enabled || gp.IntervalMinutes != 90 {
+		t.Fatalf("regra do cliente: %#v", gp)
+	}
+}
+
+func TestAssignEnableGroupRuleKeepsExistingRuleAndRejectsBadInterval(t *testing.T) {
+	db, _ := enrollPending(t, "10.40.0.6")
+	if _, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "group", EnableGroupRule: true, GroupInterval: 5}); !errors.Is(err, ErrNextecBadInterval) {
+		t.Fatalf("intervalo ruim: %v", err)
+	}
+	if groupPolicy(db, "7") != nil {
+		t.Fatal("gravou regra com intervalo inválido")
+	}
+	if _, err := NextecSecretUpsertPolicy("group", "7", true, 45); err != nil {
+		t.Fatal(err)
+	}
+	res, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "group", EnableGroupRule: true, GroupInterval: 120})
+	if err != nil || res.GroupRuleEnabled || res.Interval != 45 {
+		t.Fatalf("regra já ligada não pode ser sobrescrita: %#v %v", res, err)
+	}
+	if auditCount(db, "client_rule_enable") != 0 {
+		t.Fatal("auditou ligação que não houve")
+	}
+}
+
+func TestAssignEnableFlagIgnoredForOtherRules(t *testing.T) {
+	db, _ := enrollPending(t, "10.40.0.7")
+	res, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "none", EnableGroupRule: true})
+	if err != nil || res.GroupRuleEnabled || res.Managed {
+		t.Fatalf("none: %#v %v", res, err)
+	}
+	if groupPolicy(db, "7") != nil {
+		t.Fatal("flag ligou regra do cliente fora de Rule=group")
+	}
+}
