@@ -0,0 +1,7 @@
+package service
+
+// NextecFailCheck e NextecFailAdd expõem o limite de tentativas inválidas por chave (IP) do cofre
+// para a rota interna do gerador, que fica fora do pacote service.
+func NextecFailCheck(key string) bool { return nextecFailCheck(key) }
+
+func NextecFailAdd(key string) { nextecFailAdd(key) }
