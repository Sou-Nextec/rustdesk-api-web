@@ -0,0 +1,51 @@
+package service
+
+import (
+	"testing"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+)
+
+func TestAgentSyncLastErrorIsStoredListedAndClearedOnSuccess(t *testing.T) {
+	db, token := stateEnrolled(t)
+	if err := db.Create(&model.NextecSecretPolicy{Kind: "peer", Ref: enrollPeer, Enabled: true, IntervalMinutes: 180}).Error; err != nil {
+		t.Fatal(err)
+	}
+	// rodada que falhou: o agente manda o código estável
+	s, err := NextecAgentSyncReport(stateSyncIP, enrollPeer, token, stateCaps, "client_settings_locked")
+	if err != nil || s.Operation == nil {
+		t.Fatalf("sync com erro: %#v %v", s, err)
+	}
+	d := stateDevice(t)
+	if d.LastError != "client_settings_locked" || d.LastErrorAt == 0 || d.AgentState != NextecAgentStateActive {
+		t.Fatalf("erro não aparece na lista: %#v", d)
+	}
+	// texto livre do cliente nunca é gravado
+	if _, err := NextecAgentSyncReport(stateSyncIP, enrollPeer, token, stateCaps, "Settings are disabled!"); err != nil {
+		t.Fatal(err)
+	}
+	if got := stateDevice(t).LastError; got != "unknown_error" {
+		t.Fatalf("código fora do formato: %q", got)
+	}
+	// rodada sem erro limpa
+	if _, err := NextecAgentSyncReport(stateSyncIP, enrollPeer, token, stateCaps, ""); err != nil {
+		t.Fatal(err)
+	}
+	if d := stateDevice(t); d.LastError != "" || d.LastErrorAt != 0 {
+		t.Fatalf("sync sem erro não limpou: %#v", d)
+	}
+	// troca confirmada também limpa
+	s, err = NextecAgentSyncReport(stateSyncIP, enrollPeer, token, stateCaps, "password_apply_failed")
+	if err != nil || s.Operation == nil {
+		t.Fatalf("sync: %#v %v", s, err)
+	}
+	if err := NextecAgentProposeTransaction(stateSyncIP, enrollPeer, token, s.Operation.OperationID, s.Operation.PendingVersion, "SenhaNova1234567890ab"); err != nil {
+		t.Fatalf("propose: %v", err)
+	}
+	if err := NextecAgentConfirmTransaction(stateSyncIP, enrollPeer, token, s.Operation.OperationID, s.Operation.PendingVersion); err != nil {
+		t.Fatalf("confirm: %v", err)
+	}
+	if d := stateDevice(t); d.LastError != "" || !d.HasPassword {
+		t.Fatalf("troca confirmada não limpou o erro: %#v", d)
+	}
+}
diff --git a/service/nextec_agent_state.go b/service/nextec_agent_state.go
new file mode 100644
index 0000000..7aacc6c
--- /dev/null
+++ b/service/nextec_agent_state.go
@@ -0,0 +1,60 @@
+package service
+
+import (
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+)
+
+// Estado do agente derivado de CONTATO REAL (consulta /agent/sync autenticada), nunca do cadastro.
+// O agente consulta o painel a cada NextecAgentSyncCycle; passados NextecAgentActiveCycles ciclos sem consulta
+// ele é tratado como parado. Quem decide é só o servidor: o painel web repete a regra apenas para o relógio da tela.
+const (
+	NextecAgentSyncCycle    = 5 * time.Minute
+	NextecAgentActiveCycles = 3
+
+	NextecAgentStateActive          = "ativo"
+	NextecAgentStateStalled         = "parado"
+	NextecAgentStatePendingApproval = "pendente_aprovacao"
+	NextecAgentStateNone            = "sem_agente"
+)
+
+var nextecAgentErrorPattern = regexp.MustCompile(`^[a-z][a-z0-9_]{0,47}$`)
+
+// NextecAgentErrorCode normaliza o código de erro que o agente manda no sync. Vazio = última tentativa sem falha.
+// Fora do formato vira "unknown_error" (nunca grava texto livre do cliente).
+func NextecAgentErrorCode(raw string) string {
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return ""
+	}
+	if !nextecAgentErrorPattern.MatchString(raw) {
+		return "unknown_error"
+	}
+	return raw
+}
+
+// NextecAgentStaleAfterSeconds é a janela (em segundos) em que uma consulta ainda conta como "ativo".
+func NextecAgentStaleAfterSeconds() int64 {
+	return int64(NextecAgentSyncCycle/time.Second) * NextecAgentActiveCycles
+}
+
+// NextecAgentStateAt classifica a linha do cofre no instante `now` (segundos).
+//   - sem_agente: sem linha ou sem token (nunca cadastrou, ou o admin removeu);
+//   - pendente_aprovacao: inscrita sozinha, aguardando o admin atribuir a um cliente;
+//   - ativo: consulta real (last_sync_at) há menos de 3 ciclos;
+//   - parado: cadastrado, mas sem consulta há mais de 3 ciclos ou sem nenhuma consulta depois do cadastro.
+func NextecAgentStateAt(d *model.NextecDeviceSecret, now int64) string {
+	if d == nil || d.TokenHash == "" {
+		return NextecAgentStateNone
+	}
+	if d.AwaitingApproval {
+		return NextecAgentStatePendingApproval
+	}
+	if d.LastSyncAt > 0 && now-d.LastSyncAt < NextecAgentStaleAfterSeconds() {
+		return NextecAgentStateActive
+	}
+	return NextecAgentStateStalled
+}
diff --git a/service/nextec_agent_state_test.go b/service/nextec_agent_state_test.go
