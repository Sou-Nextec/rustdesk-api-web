+package service
+
+import (
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+)
+
+const stateSyncIP = "10.50.0.1"
+
+var stateCaps = []string{"transaction_v1"}
+
+// stateEnrolled cria cliente, máquina e cadastra o agente por autorização individual (o fluxo do .cmd).
+func stateEnrolled(t *testing.T) (*gorm.DB, string) {
+	t.Helper()
+	db := enrollSetup(t) // já cria os clientes 7 e 8 e a máquina enrollPeer, ainda sem cliente
+	if err := db.Model(&model.Peer{}).Where("id = ?", enrollPeer).Update("group_id", 7).Error; err != nil {
+		t.Fatal(err)
+	}
+	return db, stateBootstrap(t)
+}
+
+func stateBootstrap(t *testing.T) string {
+	t.Helper()
+	code, err := NextecAgentBootstrapIssue(enrollPeer, "7", "10.50.0.9", 44)
+	if err != nil {
+		t.Fatalf("issue: %v", err)
+	}
+	token, err := NextecAgentBootstrapConsume("10.50.0.2", enrollPeer, enrollUUID, code)
+	if err != nil {
+		t.Fatalf("consume: %v", err)
+	}
+	return token
+}
+
+func stateDevice(t *testing.T) *NextecSecretDevice {
+	t.Helper()
+	for _, d := range NextecSecretDevices() {
+		if d.PeerId == enrollPeer {
+			return d
+		}
+	}
+	t.Fatal("máquina não aparece na lista")
+	return nil
+}
+
+func setLastSync(t *testing.T, db *gorm.DB, at int64) {
+	t.Helper()
+	if err := db.Model(&model.NextecDeviceSecret{}).Where("peer_id = ?", enrollPeer).Update("last_sync_at", at).Error; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestAgentStateRegistrationWithoutSyncIsStalled(t *testing.T) {
+	_, _ = stateEnrolled(t)
+	d := stateDevice(t)
+	if !d.Enrolled || d.AgentState != NextecAgentStateStalled {
+		t.Fatalf("cadastro sem consulta tem de ser parado, veio %q (enrolled=%v)", d.AgentState, d.Enrolled)
+	}
+	if d.LastSyncAt != 0 || d.LastSeenAt == 0 {
+		t.Fatalf("o cadastro grava last_seen_at e nunca last_sync_at: seen=%d sync=%d", d.LastSeenAt, d.LastSyncAt)
+	}
+}
+
+func TestAgentStateRealSyncMakesItActiveAndOldSyncStalls(t *testing.T) {
+	db, token := stateEnrolled(t)
+	if _, err := NextecAgentSyncStateWithCapabilities(stateSyncIP, enrollPeer, token, stateCaps); err != nil {
+		t.Fatal(err)
+	}
+	d := stateDevice(t)
+	if d.AgentState != NextecAgentStateActive || d.LastSyncAt == 0 {
+		t.Fatalf("depois do sync real deveria ser ativo: %#v", d)
+	}
+	now := time.Now().Unix()
+	setLastSync(t, db, now-NextecAgentStaleAfterSeconds()+30)
+	if got := stateDevice(t).AgentState; got != NextecAgentStateActive {
+		t.Fatalf("dentro dos 3 ciclos: %s", got)
+	}
+	setLastSync(t, db, now-NextecAgentStaleAfterSeconds()-30)
+	if got := stateDevice(t).AgentState; got != NextecAgentStateStalled {
+		t.Fatalf("sync antigo tem de ser parado: %s", got)
+	}
+	// last_seen_at novo (qualquer escrita) não faz parecer ativo: só a consulta real conta
+	if err := db.Model(&model.NextecDeviceSecret{}).Where("peer_id = ?", enrollPeer).Update("last_seen_at", now).Error; err != nil {
+		t.Fatal(err)
+	}
+	if got := stateDevice(t).AgentState; got != NextecAgentStateStalled {
+		t.Fatalf("last_seen_at não pode ativar: %s", got)
+	}
+}
+
+func TestAgentStateOtherStates(t *testing.T) {
+	now := time.Now().Unix()
+	cases := []struct {
+		name string
+		d    *model.NextecDeviceSecret
+		want string
+	}{
+		{"sem linha", nil, NextecAgentStateNone},
+		{"sem token (removido)", &model.NextecDeviceSecret{PeerId: "x"}, NextecAgentStateNone},
+		{"pendente", &model.NextecDeviceSecret{TokenHash: "h", AwaitingApproval: true, LastSyncAt: now}, NextecAgentStatePendingApproval},
+		{"linha antiga", &model.NextecDeviceSecret{TokenHash: "h", LastSeenAt: now}, NextecAgentStateStalled},
+		{"ativo", &model.NextecDeviceSecret{TokenHash: "h", LastSyncAt: now - 60}, NextecAgentStateActive},
+		{"parado", &model.NextecDeviceSecret{TokenHash: "h", LastSyncAt: now - 3600}, NextecAgentStateStalled},
+	}
+	for _, c := range cases {
+		if got := NextecAgentStateAt(c.d, now); got != c.want {
+			t.Errorf("%s: %s, esperado %s", c.name, got, c.want)
+		}
+	}
+}
+
+func TestBootstrapOverStalledAgentRotatesTokenAndAudits(t *testing.T) {
+	db, oldToken := stateEnrolled(t)
+	// guarda uma senha do cofre: a reinstalação não pode perdê-la
+	enc, err := vaultEncrypt("senha-da-maquina")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Model(&model.NextecDeviceSecret{}).Where("peer_id = ?", enrollPeer).
+		Updates(map[string]interface{}{"active_enc": enc, "version": 3}).Error; err != nil {
+		t.Fatal(err)
+	}
+	code, err := NextecAgentBootstrapIssue(enrollPeer, "7", "10.50.0.9", 44)
+	if err != nil {
+		t.Fatalf("agente parado deveria aceitar nova autorização: %v", err)
+	}
+	newToken, err := NextecAgentBootstrapConsume("10.50.0.3", enrollPeer, enrollUUID, code)
+	if err != nil || newToken == "" || newToken == oldToken {
+		t.Fatalf("substituição: %q %v", newToken, err)
+	}
+	if _, err := NextecAgentSyncStateWithCapabilities(stateSyncIP, enrollPeer, oldToken, stateCaps); !errors.Is(err, ErrNextecBadAgentAuth) {
+		t.Fatalf("token antigo ainda vale: %v", err)
+	}
+	if d := stateDevice(t); d.AgentState != NextecAgentStateStalled || d.LastSyncAt != 0 || !d.HasPassword || d.Version != 3 {
+		t.Fatalf("depois de substituir: parado até o primeiro sync real, com a senha guardada: %#v", d)
+	}
+	if _, err := NextecAgentSyncStateWithCapabilities(stateSyncIP, enrollPeer, newToken, stateCaps); err != nil {
+		t.Fatal(err)
+	}
+	if got := stateDevice(t).AgentState; got != NextecAgentStateActive {
+		t.Fatalf("depois do sync do agente novo: %s", got)
+	}
+	var n int64
+	db.Model(&model.NextecSecretAudit{}).Where("peer_id = ? AND action = ?", enrollPeer, "agent_replaced_stale").Count(&n)
+	if n != 1 {
+		t.Fatalf("auditoria agent_replaced_stale: %d", n)
+	}
+	var audits []model.NextecSecretAudit
+	db.Find(&audits)
+	for _, a := range audits {
+		if a.Detail != "" && (a.Detail == newToken || a.Detail == oldToken || a.Detail == code) {
+			t.Fatal("segredo na auditoria")
+		}
+	}
+}
+
+func TestBootstrapOverActiveAgentIsRefusedAndNotBurned(t *testing.T) {
+	db, token := stateEnrolled(t)
+	// código emitido enquanto estava parado...
+	code, err := NextecAgentBootstrapIssue(enrollPeer, "7", "10.50.0.9", 44)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// ...e o agente (na verdade vivo) consulta antes de o .cmd usá-lo
+	if _, err := NextecAgentSyncStateWithCapabilities(stateSyncIP, enrollPeer, token, stateCaps); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := NextecAgentBootstrapConsume("10.50.0.4", enrollPeer, enrollUUID, code); !errors.Is(err, ErrNextecAlreadyEnroll) {
+		t.Fatalf("agente ativo foi substituído: %v", err)
+	}
+	var boot model.NextecAgentBootstrap
+	if err := db.Where("token_hash = ?", sha256Hex(code)).First(&boot).Error; err != nil || boot.UsedAt != 0 {
+		t.Fatalf("autorização gasta numa recusa: %#v %v", boot, err)
+	}
+	if _, err := NextecAgentBootstrapIssue(enrollPeer, "7", "10.50.0.9", 44); !errors.Is(err, ErrNextecAlreadyEnroll) {
+		t.Fatalf("emitir sobre agente ativo: %v", err)
+	}
+	// o token ativo continua valendo
+	if _, err := NextecAgentSyncStateWithCapabilities(stateSyncIP, enrollPeer, token, stateCaps); err != nil {
+		t.Fatalf("token ativo foi trocado: %v", err)
+	}
+}
+
+func TestBootstrapKeepsRefusingPendingApprovalAndIdentityChecks(t *testing.T) {
+	db, _ := stateEnrolled(t)
+	if err := db.Model(&model.NextecDeviceSecret{}).Where("peer_id = ?", enrollPeer).Update("awaiting_approval", true).Error; err != nil {
+		t.Fatal(err)
+	}
+	if got := stateDevice(t).AgentState; got != NextecAgentStatePendingApproval {
+		t.Fatalf("pendente: %s", got)
+	}
+	if _, err := NextecAgentBootstrapIssue(enrollPeer, "7", "10.50.0.9", 44); !errors.Is(err, ErrNextecAlreadyEnroll) {
+		t.Fatalf("pendente aceitou autorização: %v", err)
+	}
+	if err := db.Model(&model.NextecDeviceSecret{}).Where("peer_id = ?", enrollPeer).Update("awaiting_approval", false).Error; err != nil {
+		t.Fatal(err)
+	}
+	code, err := NextecAgentBootstrapIssue(enrollPeer, "7", "10.50.0.9", 44)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// uuid errado continua negado mesmo com o agente parado
+	if _, err := NextecAgentBootstrapConsume("10.50.0.5", enrollPeer, "outro-uuid", code); !errors.Is(err, ErrNextecBootstrapDenied) {
+		t.Fatalf("uuid diferente aceito: %v", err)
+	}
+	// e uma máquina sem agente nenhum aparece como sem_agente
+	if err := db.Where("peer_id = ?", enrollPeer).Delete(&model.NextecDeviceSecret{}).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Create(&model.NextecSecretPolicy{Kind: "peer", Ref: enrollPeer, Enabled: true, IntervalMinutes: 180}).Error; err != nil {
+		t.Fatal(err)
+	}
+	if d := stateDevice(t); d.AgentState != NextecAgentStateNone || d.Enrolled {
+		t.Fatalf("sem agente: %#v", d)
+	}
+}
+
+func TestLastSyncAtMigrationIsAdditiveAndLegacyRowsAreStalled(t *testing.T) {
+	db := enrollSetup(t)
+	// tabela como a versão anterior criava: sem last_sync_at
+	for _, col := range []string{"last_sync_at", "last_error", "last_error_at"} {
+		if err := db.Migrator().DropColumn(&model.NextecDeviceSecret{}, col); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := db.Exec("INSERT INTO nextec_device_secrets (peer_id, token_hash, last_seen_at) VALUES (?, ?, ?)", "legacy-1", "hash", time.Now().Unix()).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&model.NextecDeviceSecret{}); err != nil {
+		t.Fatalf("migração aditiva: %v", err)
+	}
+	for _, col := range []string{"last_sync_at", "last_error", "last_error_at"} {
+		if !db.Migrator().HasColumn(&model.NextecDeviceSecret{}, col) {
+			t.Fatalf("coluna %s não criada", col)
+		}
+	}
+	var row model.NextecDeviceSecret
+	if err := db.Where("peer_id = ?", "legacy-1").First(&row).Error; err != nil {
+		t.Fatal(err)
+	}
+	if row.LastSyncAt != 0 || row.TokenHash != "hash" || row.LastSeenAt == 0 {
+		t.Fatalf("linha antiga alterada: %#v", row)
+	}
+	if got := NextecAgentStateAt(&row, time.Now().Unix()); got != NextecAgentStateStalled {
+		t.Fatalf("linha antiga cadastrada deve ser parada: %s", got)
+	}
+}
