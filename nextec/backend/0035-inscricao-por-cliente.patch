+++ b/service/nextec_client_enroll_test.go
@@ -0,0 +1,199 @@
+package service
+
+import (
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+)
+
+// Credencial por cliente (nx2): instalou, apareceu aprovada no cliente, com a senha automática ligada.
+
+func clientKey(t *testing.T, group uint) string {
+	t.Helper()
+	key, _, err := NextecClientEnrollKey(group)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return key
+}
+
+func TestClientEnrollApprovesAndEnablesRuleOnFirstMachine(t *testing.T) {
+	db := enrollSetup(t)
+	tok := enrollToken()
+	res, err := NextecSelfEnroll("10.50.0.1", clientKey(t, 7), enrollPeer, enrollUUID, tok)
+	if err != nil || res.State != NextecStateAssigned || res.Token != tok {
+		t.Fatalf("inscricao por cliente: %#v %v", res, err)
+	}
+	d := deviceRow(t, db, enrollPeer)
+	if d.AwaitingApproval || d.EnrolledVia != "self" || d.Uuid != enrollUUID || !d.ForceRotate {
+		t.Fatalf("estado da maquina: %#v", d)
+	}
+	if peerGroupOf(t, db) != 7 {
+		t.Fatal("nao entrou no cliente da credencial")
+	}
+	if gp := groupPolicy(db, "7"); gp == nil || !gp.Enabled {
+		t.Fatalf("regra do cliente nao foi ligada: %#v", gp)
+	}
+	if auditCount(db, "self_enroll") != 1 || auditCount(db, "enroll_assign") != 1 {
+		t.Fatal("auditoria incompleta")
+	}
+}
+
+func TestClientEnrollIsIdempotentAndKeepsToken(t *testing.T) {
+	db := enrollSetup(t)
+	key, tok := clientKey(t, 7), enrollToken()
+	if _, err := NextecSelfEnroll("10.50.0.2", key, enrollPeer, enrollUUID, tok); err != nil {
+		t.Fatal(err)
+	}
+	res, err := NextecSelfEnroll("10.50.0.2", key, enrollPeer, enrollUUID, tok)
+	if err != nil || res.State != NextecStateAssigned || res.Token != tok {
+		t.Fatalf("repeticao: %#v %v", res, err)
+	}
+	if auditCount(db, "self_enroll") != 1 || auditCount(db, "enroll_assign") != 1 || auditCount(db, "client_rule_enable") != 1 {
+		t.Fatal("repetir enrolou ou atribuiu de novo")
+	}
+}
+
+func TestClientEnrollKeepsExistingEnabledRuleInterval(t *testing.T) {
+	db := enrollSetup(t)
+	if err := db.Create(&model.NextecSecretPolicy{Kind: "group", Ref: "7", Enabled: true, IntervalMinutes: 60}).Error; err != nil {
+		t.Fatal(err)
+	}
+	res, err := NextecSelfEnroll("10.50.0.3", clientKey(t, 7), enrollPeer, enrollUUID, enrollToken())
+	if err != nil || res.State != NextecStateAssigned {
+		t.Fatalf("%#v %v", res, err)
+	}
+	if gp := groupPolicy(db, "7"); gp == nil || !gp.Enabled || gp.IntervalMinutes != 60 {
+		t.Fatalf("regra do cliente alterada: %#v", gp)
+	}
+	if auditCount(db, "client_rule_enable") != 0 {
+		t.Fatal("religou regra que ja estava ligada")
+	}
+}
+
+func TestClientEnrollRespectsRuleTurnedOffByAdmin(t *testing.T) {
+	db := enrollSetup(t)
+	if err := db.Create(&model.NextecSecretPolicy{Kind: "group", Ref: "7", Enabled: true, IntervalMinutes: 60}).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Model(&model.NextecSecretPolicy{}).Where("kind = ? AND ref = ?", "group", "7").Update("enabled", false).Error; err != nil {
+		t.Fatal(err)
+	}
+	res, err := NextecSelfEnroll("10.50.0.4", clientKey(t, 7), enrollPeer, enrollUUID, enrollToken())
+	if err != nil || res.State != NextecStateAssigned {
+		t.Fatalf("%#v %v", res, err)
+	}
+	if gp := groupPolicy(db, "7"); gp == nil || gp.Enabled {
+		t.Fatalf("a inscricao religou a regra que o admin desligou: %#v", gp)
+	}
+	d := deviceRow(t, db, enrollPeer)
+	if d.AwaitingApproval || d.ForceRotate {
+		t.Fatalf("maquina sem regra nao deve armar troca de senha: %#v", d)
+	}
+}
+
+func TestClientEnrollNeverMovesMachineOfAnotherClient(t *testing.T) {
+	db := enrollSetup(t)
+	if err := db.Model(&model.Peer{}).Where("id = ?", enrollPeer).Update("group_id", 8).Error; err != nil {
+		t.Fatal(err)
+	}
+	res, err := NextecSelfEnroll("10.50.0.5", clientKey(t, 7), enrollPeer, enrollUUID, enrollToken())
+	if err != nil || res.State != NextecStatePending {
+		t.Fatalf("maquina de outro cliente deve ficar pendente: %#v %v", res, err)
+	}
+	if peerGroupOf(t, db) != 8 {
+		t.Fatal("moveu a maquina de cliente sem pedido do admin")
+	}
+	if !deviceRow(t, db, enrollPeer).AwaitingApproval {
+		t.Fatal("aprovou maquina de outro cliente")
+	}
+}
+
+func TestClientEnrollBadKeys(t *testing.T) {
+	enrollSetup(t)
+	good := clientKey(t, 7)
+	parts := strings.Split(good, ".")
+	cases := map[string]string{
+		"mac alterado":       strings.Join([]string{parts[0], parts[1], parts[2], strings.Repeat("0", 64)}, "."),
+		"outro cliente":      strings.Join([]string{parts[0], "8", parts[2], parts[3]}, "."),
+		"cliente inexistente": clientKey(t, 7)[:0] + "nx2.99.1." + strings.Repeat("a", 64),
+		"epoca futura":       strings.Join([]string{parts[0], parts[1], "9", parts[3]}, "."),
+		"formato":            "nx2.7.1",
+		"zeros":              "nx2.0.1." + strings.Repeat("a", 64),
+		"global no lugar":    "nx2." + strings.TrimPrefix(enrollKeyOf(t), "nx1."),
+	}
+	for name, key := range cases {
+		_, err := NextecSelfEnroll("10.50.1.1", key, enrollPeer, enrollUUID, enrollToken())
+		if !errors.Is(err, ErrNextecEnrollKeyInvalid) {
+			t.Fatalf("%s: esperava chave invalida, veio %v", name, err)
+		}
+	}
+}
+
+func enrollKeyOf(t *testing.T) string {
+	t.Helper()
+	k, _, _, err := NextecEnrollKeyInfo()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return k
+}
+
+func TestClientEnrollRotationRevokesClientKeys(t *testing.T) {
+	enrollSetup(t)
+	old := clientKey(t, 7)
+	if _, _, _, err := NextecEnrollKeyRotate(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := NextecSelfEnroll("10.50.2.1", old, enrollPeer, enrollUUID, enrollToken()); !errors.Is(err, ErrNextecEnrollKeyInvalid) {
+		t.Fatalf("credencial de cliente anterior a rotacao ainda vale: %v", err)
+	}
+	res, err := NextecSelfEnroll("10.50.2.1", clientKey(t, 7), enrollPeer, enrollUUID, enrollToken())
+	if err != nil || res.State != NextecStateAssigned {
+		t.Fatalf("credencial nova: %#v %v", res, err)
+	}
+}
+
+func TestClientEnrollGlobalKeyStillEntersPending(t *testing.T) {
+	db := enrollSetup(t)
+	res, err := NextecSelfEnroll("10.50.3.1", enrollKeyOf(t), enrollPeer, enrollUUID, enrollToken())
+	if err != nil || res.State != NextecStatePending {
+		t.Fatalf("global: %#v %v", res, err)
+	}
+	if peerGroupOf(t, db) != 0 || !deviceRow(t, db, enrollPeer).AwaitingApproval {
+		t.Fatal("a credencial global nao pode aprovar sozinha")
+	}
+}
+
+func TestClientEnrollStillNeedsHeartbeatAndHonorsBlock(t *testing.T) {
+	db := enrollSetup(t)
+	if err := db.Model(&model.Peer{}).Where("id = ?", enrollPeer).Update("last_online_time", time.Now().Unix()-3600).Error; err != nil {
+		t.Fatal(err)
+	}
+	if _, err := NextecSelfEnroll("10.50.4.1", clientKey(t, 7), enrollPeer, enrollUUID, enrollToken()); !errors.Is(err, ErrNextecPeerNotRegistered) {
+		t.Fatalf("sem heartbeat recente: %v", err)
+	}
+	if err := db.Model(&model.Peer{}).Where("id = ?", enrollPeer).Update("last_online_time", time.Now().Unix()).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Create(&model.NextecEnrollBlock{PeerId: enrollPeer, Uuid: enrollUUID, BlockedAt: time.Now().Unix()}).Error; err != nil {
+		t.Fatal(err)
+	}
+	if _, err := NextecSelfEnroll("10.50.4.1", clientKey(t, 7), enrollPeer, enrollUUID, enrollToken()); !errors.Is(err, ErrNextecEnrollBlocked) {
+		t.Fatalf("par bloqueado: %v", err)
+	}
+}
+
+func TestClientEnrollKeyForMissingClient(t *testing.T) {
+	enrollSetup(t)
+	if _, _, err := NextecClientEnrollKey(999); !errors.Is(err, ErrNextecNoGroup) {
+		t.Fatalf("cliente inexistente: %v", err)
+	}
+	clients := NextecGenClients()
+	if len(clients) != 2 || clients[0].Name != "Cliente A" || clients[1].ID != 8 {
+		t.Fatalf("lista de clientes: %#v", clients)
+	}
+}
