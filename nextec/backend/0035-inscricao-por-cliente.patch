+package api
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+// Rotas internas do gerador para o instalador por cliente: credencial nx2 e lista de clientes.
+func TestGenClientKeyAndList(t *testing.T) {
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&model.Peer{}, &model.DeviceGroup{}, &model.NextecSecretPolicy{}, &model.NextecDeviceSecret{}, &model.NextecSecretAudit{}, &model.NextecAgentBootstrap{}, &model.NextecEnrollBlock{}); err != nil {
+		t.Fatal(err)
+	}
+	sqlDB, _ := db.DB()
+	sqlDB.SetMaxOpenConns(1)
+	oldDB, oldService := service.DB, service.AllService
+	service.DB, service.AllService = db, &service.Service{}
+	t.Setenv("NEXTEC_VAULT_KEY", base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x54}, 32)))
+	wd, _ := os.Getwd()
+	if err := os.Chdir(t.TempDir()); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chdir(wd); service.DB, service.AllService = oldDB, oldService; sqlDB.Close() })
+	if err := db.Create(&model.DeviceGroup{IdModel: model.IdModel{Id: 7}, Name: "Cliente A"}).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Create(&model.DeviceGroup{IdModel: model.IdModel{Id: 3}, Name: "Acme"}).Error; err != nil {
+		t.Fatal(err)
+	}
+
+	const sec = "segredo-compartilhado-de-teste"
+	t.Setenv(genSecretEnv, sec)
+	r := gin.New()
+	ag := &NextecAgent{}
+	r.GET("/gen", ag.GenEnrollKey)
+	r.GET("/clients", ag.GenClients)
+	call := func(path string, headers map[string]string) (int, map[string]interface{}) {
+		req := httptest.NewRequest("GET", path, nil)
+		req.RemoteAddr = "172.20.0.9:1234"
+		for k, v := range headers {
+			req.Header.Set(k, v)
+		}
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, req)
+		out := map[string]interface{}{}
+		_ = json.Unmarshal(w.Body.Bytes(), &out)
+		return w.Code, out
+	}
+	good := map[string]string{"X-Nextec-Gen-Secret": sec}
+
+	// credencial do cliente
+	code, out := call("/gen?group=7", good)
+	key, _ := out["enroll_key"].(string)
+	want, _, _ := service.NextecClientEnrollKey(7)
+	if code != 200 || key == "" || key != want || !strings.HasPrefix(key, "nx2.7.") || out["client_name"] != "Cliente A" {
+		t.Fatalf("credencial por cliente: %d %v", code, out)
+	}
+	// global continua igual sem o parametro
+	code, out = call("/gen", good)
+	if k, _ := out["enroll_key"].(string); code != 200 || !strings.HasPrefix(k, "nx1.") {
+		t.Fatalf("global: %d %v", code, out)
+	}
+	// cliente inexistente, parametro invalido
+	if code, out = call("/gen?group=999", good); code != 404 || out["error"] != "client_not_found" || out["enroll_key"] != nil {
+		t.Fatalf("cliente inexistente: %d %v", code, out)
+	}
+	for _, bad := range []string{"0", "abc", "-1", "7;drop"} {
+		if code, _ = call("/gen?group="+bad, good); code != 400 {
+			t.Fatalf("group=%s: %d", bad, code)
+		}
+	}
+	// as mesmas travas do segredo valem para os dois caminhos e para a lista
+	for _, path := range []string{"/gen?group=7", "/clients"} {
+		if code, out = call(path, nil); code != 401 || out["enroll_key"] != nil || out["clients"] != nil {
+			t.Fatalf("%s sem segredo: %d %v", path, code, out)
+		}
+		if code, out = call(path, map[string]string{"X-Nextec-Gen-Secret": sec, "CF-Ray": "abc"}); code != 403 {
+			t.Fatalf("%s pelo tunel: %d %v", path, code, out)
+		}
+	}
+	// lista de clientes ordenada por nome
+	code, out = call("/clients", good)
+	list, _ := out["clients"].([]interface{})
+	if code != 200 || len(list) != 2 {
+		t.Fatalf("lista: %d %v", code, out)
+	}
+	first, _ := list[0].(map[string]interface{})
+	if first["name"] != "Acme" || first["id"].(float64) != 3 {
+		t.Fatalf("ordem da lista: %v", list)
+	}
+}
