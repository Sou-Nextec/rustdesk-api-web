diff --git a/service/nextec_client_enroll.go b/service/nextec_client_enroll.go
new file mode 100644
index 0000000..b15254e
--- /dev/null
+++ b/service/nextec_client_enroll.go
@@ -0,0 +1,133 @@
+package service
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"crypto/subtle"
+	"encoding/hex"
+	"strconv"
+	"strings"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+)
+
+// Credencial de inscrição por cliente (Nextec): nx2.<cliente>.<época>.<HMAC-SHA256(chave do cofre, "enroll2:"+cliente+":"+época)>.
+//
+// Usa a MESMA época da credencial global: girar a chave de inscrição invalida a global e todas as de cliente de uma vez.
+// A máquina que se inscreve com ela entra APROVADA no cliente da credencial e, quando o cliente tem regra de senha
+// (ou nunca teve nenhuma), já com a senha automática ligada. Não há atribuição manual: instalou, apareceu, está pronta.
+//
+// Segurança: a credencial só aprova máquinas que já enviaram sysinfo e heartbeat ao servidor (mesmas travas da global),
+// nunca move máquina que já pertence a outro cliente (nesse caso a máquina fica pendente para o admin decidir),
+// respeita o bloqueio por id + uuid e os limites de inscrição por hora. Vazou? Gire a chave no painel.
+
+const nextecClientEnrollPrefix = "nx2"
+
+func nextecClientEnrollMac(group uint, epoch int) (string, error) {
+	k, err := vaultKey()
+	if err != nil {
+		return "", err
+	}
+	m := hmac.New(sha256.New, k)
+	m.Write([]byte("enroll2:" + strconv.FormatUint(uint64(group), 10) + ":" + strconv.Itoa(epoch)))
+	return hex.EncodeToString(m.Sum(nil)), nil
+}
+
+func nextecClientEnrollBuild(group uint, epoch int) (string, error) {
+	mac, err := nextecClientEnrollMac(group, epoch)
+	if err != nil {
+		return "", err
+	}
+	return nextecClientEnrollPrefix + "." + strconv.FormatUint(uint64(group), 10) + "." + strconv.Itoa(epoch) + "." + mac, nil
+}
+
+// NextecClientEnrollKey devolve a credencial por cliente vigente e o nome do cliente. O cliente precisa existir.
+func NextecClientEnrollKey(groupID uint) (key, name string, err error) {
+	if groupID == 0 {
+		return "", "", ErrNextecNoGroup
+	}
+	var g model.DeviceGroup
+	if e := DB.First(&g, groupID).Error; e != nil || g.Id == 0 {
+		return "", "", ErrNextecNoGroup
+	}
+	epoch, _ := nextecEnrollEpochs()
+	key, err = nextecClientEnrollBuild(groupID, epoch)
+	return key, g.Name, err
+}
+
+// nextecClientEnrollKeyParse valida em tempo constante e devolve cliente e época.
+func nextecClientEnrollKeyParse(key string) (group uint, epoch int, ok bool) {
+	cur, min := nextecEnrollEpochs()
+	parts := strings.Split(key, ".")
+	shapeOK := len(key) <= nextecEnrollKeyMaxBytes && len(parts) == 4 && parts[0] == nextecClientEnrollPrefix
+	var g uint64
+	var e int
+	if shapeOK {
+		gg, err1 := strconv.ParseUint(parts[1], 10, 32)
+		ee, err2 := strconv.Atoi(parts[2])
+		if err1 != nil || err2 != nil || gg == 0 || ee <= 0 || ee > nextecEnrollMaxEpoch ||
+			strconv.FormatUint(gg, 10) != parts[1] || strconv.Itoa(ee) != parts[2] {
+			shapeOK = false
+		} else {
+			g, e = gg, ee
+		}
+	}
+	probeGroup, probeEpoch := uint(g), e
+	if !shapeOK {
+		probeGroup, probeEpoch = 1, cur
+	}
+	want, err := nextecClientEnrollBuild(probeGroup, probeEpoch)
+	if err != nil {
+		return 0, 0, false
+	}
+	match := subtle.ConstantTimeCompare([]byte(key), []byte(want)) == 1
+	if !shapeOK || !match || e < min || e > cur {
+		return 0, 0, false
+	}
+	return uint(g), e, true
+}
+
+// nextecClientAutoAssign aprova a máquina pendente no cliente da credencial. Qualquer recusa deixa a máquina pendente
+// (nunca falha a inscrição): máquina de outro cliente, cliente apagado, identidade divergente.
+func nextecClientAutoAssign(ip, peerID, uuid string, group uint) string {
+	ref := strconv.FormatUint(uint64(group), 10)
+	var pol model.NextecSecretPolicy
+	have := DB.Where("kind = ? AND ref = ?", "group", ref).First(&pol).Error == nil
+	opt := NextecAssignOptions{PeerID: peerID, ClientID: group, Uuid: uuid, IP: ip, Username: "inscricao-por-cliente"}
+	switch {
+	case have && pol.Enabled:
+		opt.Rule = "group"
+	case !have:
+		// Cliente que nunca teve regra de senha: liga na primeira máquina (como "Atribuir" faz no painel).
+		opt.Rule, opt.EnableGroupRule = "group", true
+	default:
+		// O admin desligou a regra de propósito: a máquina entra aprovada e sem senha automática.
+		opt.Rule = "none"
+	}
+	if _, err := NextecEnrollAssign(opt); err != nil {
+		if Logger != nil {
+			Logger.Warn("nextec: inscricao por cliente ficou pendente: ", err)
+		}
+		return NextecStatePending
+	}
+	return NextecStateAssigned
+}
+
+// NextecEnrollEpoch devolve a época vigente (a mesma da credencial global).
+func NextecEnrollEpoch() (int, int) { return nextecEnrollEpochs() }
+
+type NextecGenClient struct {
+	ID   uint   `json:"id"`
+	Name string `json:"name"`
+}
+
+// NextecGenClients lista os clientes (grupos de dispositivos) por nome, no máximo 1000.
+func NextecGenClients() []NextecGenClient {
+	var rows []*model.DeviceGroup
+	DB.Order("name asc").Limit(1000).Find(&rows)
+	out := make([]NextecGenClient, 0, len(rows))
+	for _, r := range rows {
+		out = append(out, NextecGenClient{ID: r.Id, Name: r.Name})
+	}
+	return out
+}
diff --git a/service/nextec_client_enroll_test.go b/service/nextec_client_enroll_test.go
