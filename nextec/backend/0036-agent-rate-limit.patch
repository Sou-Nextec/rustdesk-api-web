@@ -0,0 +1,262 @@
+package service
+
+import (
+	"errors"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// Os testes antigos do pacote reutilizam o mesmo ID de máquina em dezenas de chamadas dentro do mesmo minuto; o limite
+// fica desligado para eles e os testes deste arquivo o ligam explicitamente (newFakeRateClock).
+func init() { nextecRateEnabled = false }
+
+// fakeRateClock substitui o relógio e o log do limitador e restaura tudo ao fim do teste.
+type fakeRateClock struct {
+	mu   sync.Mutex
+	now  time.Time
+	logs []int
+}
+
+func (c *fakeRateClock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.now
+}
+
+func (c *fakeRateClock) Advance(d time.Duration) {
+	c.mu.Lock()
+	c.now = c.now.Add(d)
+	c.mu.Unlock()
+}
+
+func (c *fakeRateClock) Logs() []int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return append([]int(nil), c.logs...)
+}
+
+func newFakeRateClock(t *testing.T) *fakeRateClock {
+	t.Helper()
+	clock := &fakeRateClock{now: time.Unix(1_800_000_000, 0)}
+	oldNow, oldLog := nextecRateNow, nextecRateLog
+	nextecRateMu.Lock()
+	nextecRateEnabled = true
+	nextecRateHits = map[string][]time.Time{}
+	nextecRateDropped = map[string]int{}
+	nextecRateLastLog = map[string]time.Time{}
+	nextecRateLastSweep = time.Time{}
+	nextecRateMu.Unlock()
+	nextecRateNow = clock.Now
+	nextecRateLog = func(peerID string, dropped int) {
+		clock.mu.Lock()
+		clock.logs = append(clock.logs, dropped)
+		clock.mu.Unlock()
+	}
+	nextecFailMu.Lock()
+	nextecFailures = map[string][]int64{}
+	nextecFailMu.Unlock()
+	t.Cleanup(func() {
+		nextecRateMu.Lock()
+		nextecRateEnabled = false
+		nextecRateMu.Unlock()
+		nextecRateNow, nextecRateLog = oldNow, oldLog
+	})
+	return clock
+}
+
+func ipFailures(ip string) int {
+	nextecFailMu.Lock()
+	defer nextecFailMu.Unlock()
+	return len(nextecFailures[ip])
+}
+
+// O ritmo do agente (uma consulta por minuto, durante horas) nunca é limitado e nunca soma ao contador de falhas do IP.
+func TestAgentOneSyncPerMinuteIsNeverLimitedNorCountedAsFailure(t *testing.T) {
+	clock := newFakeRateClock(t)
+	_, peerID, token := transactionTestDB(t, 1, 1, true)
+	ip := "rate-cadence-ip"
+	for i := 0; i < 240; i++ { // 4 horas
+		if _, err := NextecAgentSyncStateWithCapabilities(ip, peerID, token, []string{"transaction_v1"}); err != nil {
+			t.Fatalf("consulta %d bloqueada: %v", i, err)
+		}
+		clock.Advance(time.Minute)
+	}
+	if ipFailures(ip) != 0 || !nextecFailCheck(ip) {
+		t.Fatalf("consultas válidas acionaram o anti-lixo do IP: falhas=%d", ipFailures(ip))
+	}
+	if len(clock.Logs()) != 0 {
+		t.Fatalf("o ritmo normal gerou log de limite: %v", clock.Logs())
+	}
+}
+
+// Uma troca completa com repetições (sync, password x3, confirm x3, sync) cabe com folga na janela de um minuto.
+func TestAgentFullTransactionWithRetriesFitsTheLimit(t *testing.T) {
+	newFakeRateClock(t)
+	for i := 0; i < 12; i++ {
+		if ok, _ := nextecRateAllow("transaction-peer"); !ok {
+			t.Fatalf("chamada %d da transação foi limitada", i)
+		}
+	}
+}
+
+// Agente em laço: só a própria máquina leva 429, o IP não acumula falhas e as outras máquinas seguem normais.
+func TestAgentLoopIsLimitedPerMachineWithoutTouchingIPFailures(t *testing.T) {
+	clock := newFakeRateClock(t)
+	_, peerID, token := transactionTestDB(t, 1, 1, true)
+	ip := "rate-loop-ip"
+	allowed := 0
+	var limited error
+	for i := 0; i < nextecAgentRateLimit+20; i++ {
+		_, err := NextecAgentSyncStateWithCapabilities(ip, peerID, token, []string{"transaction_v1"})
+		if err == nil {
+			allowed++
+			continue
+		}
+		limited = err
+	}
+	if allowed != nextecAgentRateLimit {
+		t.Fatalf("passaram %d chamadas, esperado %d", allowed, nextecAgentRateLimit)
+	}
+	if !errors.Is(limited, ErrNextecRateLimited) || errors.Is(limited, ErrNextecTooManyFails) || errors.Is(limited, ErrNextecBadAgentAuth) {
+		t.Fatalf("erro de limite inesperado: %v", limited)
+	}
+	if seconds := NextecRetryAfterSeconds(limited); seconds < 1 || seconds > 60 {
+		t.Fatalf("Retry-After fora da janela: %d", seconds)
+	}
+	if ipFailures(ip) != 0 || !nextecFailCheck(ip) {
+		t.Fatalf("429 de máquina contou como falha do IP: falhas=%d", ipFailures(ip))
+	}
+	if ok, _ := nextecRateAllow("outra-maquina-no-mesmo-ip"); !ok {
+		t.Fatal("máquina em laço bloqueou outra máquina")
+	}
+	clock.Advance(nextecAgentRateWindow + time.Second)
+	if _, err := NextecAgentSyncStateWithCapabilities(ip, peerID, token, []string{"transaction_v1"}); err != nil {
+		t.Fatalf("a máquina não voltou ao normal depois da janela: %v", err)
+	}
+}
+
+// Credencial inválida continua sendo falha do IP e nunca ocupa a janela de uma máquina legítima.
+func TestAgentInvalidTokenStillCountsAsIPFailureAndNeverConsumesMachineWindow(t *testing.T) {
+	newFakeRateClock(t)
+	_, peerID, _ := transactionTestDB(t, 1, 1, true)
+	ip := "rate-bad-token-ip"
+	for i := 0; i < nextecFailureLimit; i++ {
+		if _, err := NextecAgentSyncStateWithCapabilities(ip, peerID, "token-errado", []string{"transaction_v1"}); !errors.Is(err, ErrNextecBadAgentAuth) {
+			t.Fatalf("tentativa %d: %v", i, err)
+		}
+	}
+	if _, err := NextecAgentSyncStateWithCapabilities(ip, peerID, "token-errado", []string{"transaction_v1"}); !errors.Is(err, ErrNextecTooManyFails) {
+		t.Fatalf("o anti-lixo do IP deixou de valer: %v", err)
+	}
+	nextecRateMu.Lock()
+	hits := len(nextecRateHits[peerID])
+	nextecRateMu.Unlock()
+	if hits != 0 {
+		t.Fatalf("tentativas inválidas ocuparam a janela da máquina: %d", hits)
+	}
+}
+
+// O log do limite não inunda: no máximo uma linha por minuto por máquina, com a contagem acumulada.
+func TestAgentRateLimitLogIsThrottled(t *testing.T) {
+	clock := newFakeRateClock(t)
+	for i := 0; i < nextecAgentRateLimit; i++ {
+		nextecRateAllow("laco")
+	}
+	for i := 0; i < 500; i++ {
+		if ok, _ := nextecRateAllow("laco"); ok {
+			t.Fatal("chamada acima do limite foi aceita")
+		}
+	}
+	if logs := clock.Logs(); len(logs) != 1 || logs[0] != 1 {
+		t.Fatalf("500 recusas no mesmo minuto geraram %v", logs)
+	}
+	// um minuto depois a janela esvaziou; enche de novo e a próxima recusa gera uma única linha nova
+	clock.Advance(nextecAgentRateLogGap + time.Second)
+	for i := 0; i < nextecAgentRateLimit; i++ {
+		nextecRateAllow("laco")
+	}
+	nextecRateAllow("laco")
+	nextecRateAllow("laco")
+	if logs := clock.Logs(); len(logs) != 2 {
+		t.Fatalf("esperava uma nova linha depois de um minuto: %v", logs)
+	}
+}
+
+// O mapa de janelas não cresce para sempre.
+func TestAgentRateLimitSweepsIdleMachines(t *testing.T) {
+	clock := newFakeRateClock(t)
+	for i := 0; i < 50; i++ {
+		nextecRateAllow("maquina-" + strconv.Itoa(i))
+	}
+	clock.Advance(nextecAgentRateSweep + nextecAgentRateWindow + time.Second)
+	nextecRateAllow("ativa")
+	nextecRateMu.Lock()
+	size := len(nextecRateHits)
+	nextecRateMu.Unlock()
+	if size != 1 {
+		t.Fatalf("máquinas ociosas não foram descartadas: %d", size)
+	}
+}
+
+// Acesso concorrente (rodar com -race): nunca passa mais que o limite por máquina.
+func TestAgentRateLimitConcurrent(t *testing.T) {
+	newFakeRateClock(t)
+	const peers, workers, calls = 8, 16, 50
+	var allowed [peers]int64
+	var wg sync.WaitGroup
+	for w := 0; w < workers; w++ {
+		wg.Add(1)
+		go func(w int) {
+			defer wg.Done()
+			for i := 0; i < calls; i++ {
+				p := (w + i) % peers
+				if ok, _ := nextecRateAllow("peer-" + strconv.Itoa(p)); ok {
+					atomic.AddInt64(&allowed[p], 1)
+				}
+			}
+		}(w)
+	}
+	wg.Wait()
+	for p := 0; p < peers; p++ {
+		if got := atomic.LoadInt64(&allowed[p]); got > nextecAgentRateLimit {
+			t.Fatalf("máquina %d passou %d chamadas (limite %d)", p, got, nextecAgentRateLimit)
+		}
+	}
+}
+
+// "Trocar agora": a primeira consulta depois do pedido (até 1 minuto) já recebe a operação de troca.
+func TestAgentRotateNowIsServedByTheNextOneMinuteSync(t *testing.T) {
+	clock := newFakeRateClock(t)
+	db, peerID, token := transactionTestDB(t, 1, 1, true)
+	ip := "rate-rotate-now-ip"
+	far := time.Now().Add(6 * time.Hour).Unix()
+	if err := db.Exec("UPDATE nextec_device_secrets SET next_rotation_at = ? WHERE peer_id = ?", far, peerID).Error; err != nil {
+		t.Fatal(err)
+	}
+	idle, err := NextecAgentSyncStateWithCapabilities(ip, peerID, token, []string{"transaction_v1"})
+	if err != nil || idle.Rotate || idle.Operation != nil {
+		t.Fatalf("antes do pedido não pode haver troca: %#v err=%v", idle, err)
+	}
+	if err := NextecSecretRotateNow(peerID); err != nil {
+		t.Fatal(err)
+	}
+	clock.Advance(time.Minute)
+	state, err := NextecAgentSyncStateWithCapabilities(ip, peerID, token, []string{"transaction_v1"})
+	if err != nil || !state.Rotate || state.Operation == nil || state.Operation.PendingVersion != 2 {
+		t.Fatalf("a consulta seguinte ao pedido não recebeu a troca: %#v err=%v", state, err)
+	}
+	if err := NextecAgentProposeTransaction(ip, peerID, token, state.Operation.OperationID, 2, "RotateNowPassword123456"); err != nil {
+		t.Fatal(err)
+	}
+	if err := NextecAgentConfirmTransaction(ip, peerID, token, state.Operation.OperationID, 2); err != nil {
+		t.Fatal(err)
+	}
+	clock.Advance(time.Minute)
+	after, err := NextecAgentSyncStateWithCapabilities(ip, peerID, token, []string{"transaction_v1"})
+	if err != nil || after.Rotate || after.Operation != nil {
+		t.Fatalf("depois de confirmar não pode haver nova troca: %#v err=%v", after, err)
+	}
+}
