+package api
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+// O sync aceita interval_seconds de forma aditiva: grava o intervalo real; sem o campo volta a 0 (legado, 5 min).
+func TestAgentSyncStoresIntervalSeconds(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&model.Peer{}, &model.DeviceGroup{}, &model.NextecSecretPolicy{}, &model.NextecDeviceSecret{}, &model.NextecSecretAudit{}, &model.NextecAgentBootstrap{}, &model.NextecEnrollBlock{}); err != nil {
+		t.Fatal(err)
+	}
+	sqlDB, _ := db.DB()
+	sqlDB.SetMaxOpenConns(1)
+	oldDB, oldService := service.DB, service.AllService
+	service.DB, service.AllService = db, &service.Service{}
+	t.Setenv("NEXTEC_VAULT_KEY", base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x54}, 32)))
+	wd, _ := os.Getwd()
+	if err := os.Chdir(t.TempDir()); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chdir(wd); service.DB, service.AllService = oldDB, oldService; sqlDB.Close() })
+
+	token := "token-http-interval"
+	sum := sha256.Sum256([]byte(token))
+	if err := db.Create(&model.NextecDeviceSecret{PeerId: "929292929", TokenHash: hex.EncodeToString(sum[:]), LastSeenAt: time.Now().Unix(), EnrolledVia: "legacy"}).Error; err != nil {
+		t.Fatal(err)
+	}
+	r := gin.New()
+	r.POST("/sync", (&NextecAgent{}).Sync)
+	call := func(body map[string]interface{}) int {
+		raw, _ := json.Marshal(body)
+		req := httptest.NewRequest("POST", "/sync", strings.NewReader(string(raw)))
+		req.Header.Set("Content-Type", "application/json")
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, req)
+		return w.Code
+	}
+	stored := func() int64 {
+		d := &model.NextecDeviceSecret{}
+		db.Where("peer_id = ?", "929292929").First(d)
+		return d.SyncIntervalSeconds
+	}
+	base := map[string]interface{}{"id": "929292929", "token": token, "capabilities": []string{"transaction_v1"}}
+	with := map[string]interface{}{"id": "929292929", "token": token, "capabilities": []string{"transaction_v1"}, "interval_seconds": 60}
+	if code := call(with); code != 200 || stored() != 60 {
+		t.Fatalf("sync com interval_seconds: %d %d", code, stored())
+	}
+	if code := call(base); code != 200 || stored() != 0 {
+		t.Fatalf("sync sem interval_seconds: %d %d", code, stored())
+	}
+}
