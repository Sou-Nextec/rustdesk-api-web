+package service
+
+import (
+	"testing"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+)
+
+func TestAgentActiveWindowFollowsTheRealInterval(t *testing.T) {
+	cases := []struct {
+		interval, want int64
+	}{
+		{0, 900},    // agente que não informa: 5 min x 3
+		{300, 900},  // legado explícito
+		{60, 180},   // agente novo de 1 minuto
+		{120, 360},  // 2 minutos
+		{30, 180},   // mínimo
+		{3600, 900}, // máximo
+	}
+	for _, c := range cases {
+		if got := NextecAgentActiveWindowSeconds(c.interval); got != c.want {
+			t.Errorf("janela(%d) = %d, esperado %d", c.interval, got, c.want)
+		}
+	}
+	for raw, want := range map[int]int64{0: 0, -5: 0, 10: 30, 60: 60, 99999: 3600} {
+		if got := NextecAgentIntervalSeconds(raw); got != want {
+			t.Errorf("intervalo(%d) = %d, esperado %d", raw, got, want)
+		}
+	}
+}
+
+// Agente novo (60 s) e legado (sem interval_seconds): o servidor decide com o intervalo real de cada um, e a lista
+// devolve agent_state e active_window_seconds para a tela só exibir. 240 s sem consulta: novo parado, legado ativo.
+func TestAgentStateUsesIntervalReportedInSync(t *testing.T) {
+	db, token := stateEnrolled(t)
+	if _, err := NextecAgentSyncWith(stateSyncIP, enrollPeer, token, stateCaps, NextecAgentReport{IntervalSeconds: 60}); err != nil {
+		t.Fatal(err)
+	}
+	d := stateDevice(t)
+	if d.AgentState != NextecAgentStateActive || d.SyncIntervalSeconds != 60 || d.ActiveWindowSeconds != 180 {
+		t.Fatalf("agente de 60 s: %#v", d)
+	}
+	now := time.Now().Unix()
+	setLastSync(t, db, now-150)
+	if got := stateDevice(t).AgentState; got != NextecAgentStateActive {
+		t.Fatalf("60 s, 150 s atrás: %s", got)
+	}
+	setLastSync(t, db, now-240)
+	if got := stateDevice(t).AgentState; got != NextecAgentStateStalled {
+		t.Fatalf("60 s, 240 s atrás tem de ser parado: %s", got)
+	}
+
+	// agente legado: sync sem interval_seconds volta a janela para 900 s
+	if _, err := NextecAgentSyncStateWithCapabilities(stateSyncIP, enrollPeer, token, stateCaps); err != nil {
+		t.Fatal(err)
+	}
+	d = stateDevice(t)
+	if d.SyncIntervalSeconds != 0 || d.ActiveWindowSeconds != 900 {
+		t.Fatalf("legado: %#v", d)
+	}
+	setLastSync(t, db, now-240)
+	if got := stateDevice(t).AgentState; got != NextecAgentStateActive {
+		t.Fatalf("legado, 240 s atrás tem de ser ativo: %s", got)
+	}
+	setLastSync(t, db, now-901)
+	if got := stateDevice(t).AgentState; got != NextecAgentStateStalled {
+		t.Fatalf("legado, 901 s atrás: %s", got)
+	}
+}
+
+func TestAgentIntervalColumnIsAdditive(t *testing.T) {
+	db := enrollSetup(t)
+	if err := db.Migrator().DropColumn(&model.NextecDeviceSecret{}, "sync_interval_seconds"); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Exec("INSERT INTO nextec_device_secrets (peer_id, token_hash, last_sync_at) VALUES (?, ?, ?)", "legacy-iv", "hash", time.Now().Unix()-240).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&model.NextecDeviceSecret{}); err != nil {
+		t.Fatal(err)
+	}
+	var row model.NextecDeviceSecret
+	if err := db.Where("peer_id = ?", "legacy-iv").First(&row).Error; err != nil {
+		t.Fatal(err)
+	}
+	if row.SyncIntervalSeconds != 0 || NextecAgentStateAt(&row, time.Now().Unix()) != NextecAgentStateActive {
+		t.Fatalf("linha antiga: %#v", row)
+	}
+}
diff --git a/service/nextec_agent_ratelimit.go b/service/nextec_agent_ratelimit.go
new file mode 100644
index 0000000..9fdeb59
--- /dev/null
+++ b/service/nextec_agent_ratelimit.go
@@ -0,0 +1,126 @@
+package service
+
+import (
+	"errors"
+	"strconv"
+	"sync"
+	"time"
+)
+
+// Limite de consultas do agente por máquina (Nextec).
+//
+// O agente consulta o painel uma vez por minuto (sync) e, só quando há troca, mais duas chamadas (password e confirm),
+// com repetições curtas na mesma execução. O limite abaixo é uma rede de segurança contra agente em laço (clone de VM com
+// o mesmo ID e token, script quebrado), não parte do fluxo normal: 30 chamadas por minuto por máquina, mais de 10 vezes
+// o pior caso legítimo.
+//
+// Diferente do contador de falhas por IP (nextecFailCheck), que só conta autenticações inválidas, este limite vale para
+// chamadas JÁ autenticadas e nunca soma ao contador de falhas: uma máquina legítima nunca aciona o anti-lixo do IP por
+// consultar com frequência, e uma máquina em laço não bloqueia as outras que compartilham o mesmo IP (NAT do cliente).
+const (
+	nextecAgentRateWindow = time.Minute
+	nextecAgentRateLimit  = 30
+	nextecAgentRateSweep  = 5 * time.Minute
+	nextecAgentRateLogGap = time.Minute
+)
+
+// ErrNextecRateLimited: limite de consultas da máquina atingido. Devolve 429 com Retry-After; não é falha de autenticação.
+var ErrNextecRateLimited = errors.New("agent rate limited")
+
+type nextecRateLimitedError struct{ retryAfter time.Duration }
+
+func (e *nextecRateLimitedError) Error() string { return ErrNextecRateLimited.Error() }
+
+func (e *nextecRateLimitedError) Is(target error) bool { return target == ErrNextecRateLimited }
+
+// NextecRetryAfterSeconds devolve em quantos segundos o agente pode tentar de novo (mínimo 1).
+func NextecRetryAfterSeconds(err error) int {
+	var limited *nextecRateLimitedError
+	if errors.As(err, &limited) {
+		seconds := int((limited.retryAfter + time.Second - 1) / time.Second)
+		if seconds < 1 {
+			seconds = 1
+		}
+		return seconds
+	}
+	return 1
+}
+
+var (
+	nextecRateMu        sync.Mutex
+	nextecRateEnabled   = true // só os testes de outras áreas do pacote desligam (init em nextec_agent_ratelimit_test.go)
+	nextecRateHits      = map[string][]time.Time{}
+	nextecRateDropped   = map[string]int{}
+	nextecRateLastLog   = map[string]time.Time{}
+	nextecRateLastSweep time.Time
+	nextecRateNow       = time.Now
+	// nextecRateLog é substituível nos testes; no servidor vai para o log da API, no máximo uma linha por minuto por máquina.
+	nextecRateLog = func(peerID string, dropped int) {
+		if Logger != nil {
+			Logger.Warn("nextec agent rate limited: peer=" + peerID + " dropped=" + strconv.Itoa(dropped) + " in the last minute")
+		}
+	}
+)
+
+// nextecRateAllow registra uma chamada autenticada da máquina e diz se ela passa. A janela é deslizante.
+func nextecRateAllow(peerID string) (bool, time.Duration) {
+	nextecRateMu.Lock()
+	if !nextecRateEnabled {
+		nextecRateMu.Unlock()
+		return true, 0
+	}
+	now := nextecRateNow()
+	nextecRateSweepLocked(now)
+	cutoff := now.Add(-nextecAgentRateWindow)
+	hits := nextecRateHits[peerID]
+	kept := hits[:0]
+	for _, t := range hits {
+		if t.After(cutoff) {
+			kept = append(kept, t)
+		}
+	}
+	if len(kept) >= nextecAgentRateLimit {
+		nextecRateHits[peerID] = kept
+		wait := kept[0].Add(nextecAgentRateWindow).Sub(now)
+		nextecRateDropped[peerID]++
+		emit := now.Sub(nextecRateLastLog[peerID]) >= nextecAgentRateLogGap
+		dropped := nextecRateDropped[peerID]
+		if emit {
+			nextecRateLastLog[peerID] = now
+			nextecRateDropped[peerID] = 0
+		}
+		nextecRateMu.Unlock()
+		if emit {
+			nextecRateLog(peerID, dropped)
+		}
+		return false, wait
+	}
+	nextecRateHits[peerID] = append(kept, now)
+	nextecRateMu.Unlock()
+	return true, 0
+}
+
+// nextecRateSweepLocked descarta máquinas sem chamadas recentes, para o mapa não crescer com o tempo.
+func nextecRateSweepLocked(now time.Time) {
+	if now.Sub(nextecRateLastSweep) < nextecAgentRateSweep {
+		return
+	}
+	nextecRateLastSweep = now
+	cutoff := now.Add(-nextecAgentRateWindow)
+	for peerID, hits := range nextecRateHits {
+		if len(hits) == 0 || !hits[len(hits)-1].After(cutoff) {
+			delete(nextecRateHits, peerID)
+			delete(nextecRateDropped, peerID)
+		}
+	}
+	for peerID, at := range nextecRateLastLog {
+		if now.Sub(at) > nextecAgentRateSweep {
+			delete(nextecRateLastLog, peerID)
+		}
+	}
+}
+
+// NextecRateLimitedErrorForTest monta o erro de limite com um Retry-After conhecido (usado pelos testes do controlador).
+func NextecRateLimitedErrorForTest(seconds int) error {
+	return &nextecRateLimitedError{retryAfter: time.Duration(seconds) * time.Second}
+}
