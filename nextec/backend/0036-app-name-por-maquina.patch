diff --git a/service/nextec_appname.go b/service/nextec_appname.go
new file mode 100644
index 0000000..30ec0d6
--- /dev/null
+++ b/service/nextec_appname.go
@@ -0,0 +1,129 @@
+package service
+
+import (
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+)
+
+// Nome do app instalado em cada máquina. O agente lê o AppName do marcador (nextec-marker.json ou registro) e envia no
+// /api/nextec/agent/sync. O RustDesk registra o protocolo do link com o nome do app em minúsculas, então o painel
+// monta o link da máquina com esse protocolo e cai no protocolo global (NextecConnectSchemeGet) quando não sabe o nome.
+
+var nextecAppNameRe = regexp.MustCompile(`^[A-Za-z0-9-]{1,64}$`)
+
+// Protocolos que o navegador trata de forma especial. Um nome de app nunca vira link com eles: o link leva a senha
+// da máquina e não pode apontar para uma página, um arquivo ou um script.
+var nextecSchemeDenied = map[string]bool{
+	"http": true, "https": true, "file": true, "ftp": true, "ftps": true, "ws": true, "wss": true,
+	"javascript": true, "vbscript": true, "data": true, "blob": true, "about": true, "mailto": true, "tel": true,
+	"sms": true, "chrome": true, "edge": true, "view-source": true, "ms-msdt": true, "search-ms": true,
+}
+
+// Janela em que o agente conta como ativo (a tela de senhas usa os mesmos 20 minutos).
+const nextecAgentActiveWindow = 20 * 60
+
+// NextecAppNameValid diz se o nome enviado pelo agente pode ser gravado.
+func NextecAppNameValid(v string) bool {
+	return nextecAppNameRe.MatchString(v)
+}
+
+// NextecSchemeFromAppName normaliza o nome do app para o protocolo (minúsculas). Vazio quando não serve de protocolo.
+func NextecSchemeFromAppName(appName string) string {
+	if !NextecAppNameValid(appName) {
+		return ""
+	}
+	s := strings.ToLower(appName)
+	if !nextecSchemeValid(s) || nextecSchemeDenied[s] {
+		return ""
+	}
+	return s
+}
+
+// nextecRecordAppName grava o nome do app da máquina autenticada pelo token. Nome inválido é ignorado (o agente
+// continua funcionando); só escreve quando mudou.
+func nextecRecordAppName(peerID, token, appName string) {
+	appName = strings.TrimSpace(appName)
+	if token == "" || !NextecAppNameValid(appName) {
+		return
+	}
+	DB.Model(&model.NextecDeviceSecret{}).
+		Where("peer_id = ? AND token_hash = ? AND app_name <> ?", peerID, sha256Hex(token), appName).
+		Update("app_name", appName)
+}
+
+// NextecAgentSyncStateWithApp é o sync do agente que também informa o nome do app instalado.
+func NextecAgentSyncStateWithApp(ip, peerID, token string, capabilities []string, appName string) (*NextecAgentSync, error) {
+	s, err := NextecAgentSyncStateWithCapabilities(ip, peerID, token, capabilities)
+	if err != nil {
+		return nil, err
+	}
+	nextecRecordAppName(peerID, token, appName)
+	return s, nil
+}
+
+// Estado da senha automática da máquina, como o botão Conectar precisa saber.
+const (
+	NextecPwNone         = "none"             // sem agente ou senha automática desligada: conexão manual
+	NextecPwPendingAgent = "pending_approval" // agente inscrito e ainda não atribuído a um cliente
+	NextecPwWaitingFirst = "waiting_first"    // agente ativo, regra ligada e a primeira senha ainda não foi aplicada
+	NextecPwReady        = "ready"            // senha vigente: o link já leva a senha
+	NextecPwRestricted   = "restricted"       // o usuário não lê o cofre: conecta digitando a senha
+
+	NextecSchemeSrcMachine = "machine"
+	NextecSchemeSrcGlobal  = "global"
+)
+
+// NextecConnectInfo é o que o painel sabe da máquina para montar e abrir o link.
+type NextecConnectInfo struct {
+	Scheme        string `json:"scheme"`
+	SchemeSource  string `json:"scheme_source"` // machine | global
+	AppName       string `json:"app_name,omitempty"`
+	AgentEnrolled bool   `json:"agent_enrolled"`
+	AgentActive   bool   `json:"agent_active"`
+	PasswordState string `json:"password_state"`
+	LastSeenAt    int64  `json:"last_seen_at,omitempty"`
+	Interval      int    `json:"interval_minutes,omitempty"`
+}
+
+// nextecConnectInfo reúne o protocolo (da máquina, com fallback ao global) e o estado do agente e da senha.
+// canReadVault: o usuário pode receber a senha do cofre desta máquina.
+func nextecConnectInfo(peerID string, canReadVault bool, now int64) *NextecConnectInfo {
+	info := &NextecConnectInfo{Scheme: NextecConnectSchemeGet(), SchemeSource: NextecSchemeSrcGlobal, PasswordState: NextecPwNone}
+	d := &model.NextecDeviceSecret{}
+	if peerID == "" || DB.Where("peer_id = ?", peerID).First(d).Error != nil || d.TokenHash == "" {
+		return info
+	}
+	info.AgentEnrolled = true
+	info.LastSeenAt = d.LastSeenAt
+	if d.AwaitingApproval {
+		info.PasswordState = NextecPwPendingAgent
+		return info
+	}
+	info.AgentActive = d.LastSeenAt > 0 && now-d.LastSeenAt < nextecAgentActiveWindow
+	// Só máquina aprovada decide o protocolo do link: uma inscrição pendente não pode mudar para onde a senha vai.
+	if s := NextecSchemeFromAppName(d.AppName); s != "" {
+		info.Scheme, info.SchemeSource, info.AppName = s, NextecSchemeSrcMachine, d.AppName
+	}
+	enabled, interval := effectivePolicy(peerID, peerGroup(peerID))
+	if !enabled {
+		return info
+	}
+	info.Interval = interval
+	switch {
+	case !canReadVault:
+		info.PasswordState = NextecPwRestricted
+	case d.ActiveEnc == "":
+		info.PasswordState = NextecPwWaitingFirst
+	default:
+		info.PasswordState = NextecPwReady
+	}
+	return info
+}
+
+// NextecConnectInfoFor devolve o estado da conexão para o usuário logado (já autorizado a ver a máquina).
+func NextecConnectInfoFor(u *model.User, peerID string) *NextecConnectInfo {
+	return nextecConnectInfo(peerID, NextecUserCanReadVault(u, peerID), time.Now().Unix())
+}
diff --git a/service/nextec_appname_test.go b/service/nextec_appname_test.go
new file mode 100644
index 0000000..b0ed38a
--- /dev/null
+++ b/service/nextec_appname_test.go
@@ -0,0 +1,186 @@
+package service
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+)
+
+func TestNextecAppNameValidationAndScheme(t *testing.T) {
+	cases := []struct{ in, scheme string }{
+		{"Client-Nextec-Connect", "client-nextec-connect"},
+		{"Nextec-Connect", "nextec-connect"},
+		{"RustDesk", "rustdesk"},
+		{"abc", "abc"},
+		{"a", ""},                     // curto demais para protocolo
+		{"1app", ""},                  // protocolo começa por letra
+		{"Nextec Connect", ""},        // espaço não é aceito
+		{"nextec_connect", ""},        // sublinhado não é aceito
+		{"nextec.connect", ""},        // ponto não é aceito no nome do app
+		{"", ""},                      // vazio
+		{strings.Repeat("a", 65), ""}, // acima de 64
+		{"https", ""}, {"HTTP", ""}, {"File", ""}, {"javascript", ""}, {"data", ""}, {"mailto", ""},
+		{"a://b", ""}, {"app\n", ""},
+	}
+	for _, c := range cases {
+		if got := NextecSchemeFromAppName(c.in); got != c.scheme {
+			t.Fatalf("NextecSchemeFromAppName(%q) = %q, esperado %q", c.in, got, c.scheme)
+		}
+	}
+	if !NextecAppNameValid(strings.Repeat("a", 64)) || NextecAppNameValid(strings.Repeat("a", 65)) {
+		t.Fatal("limite de 64 caracteres")
+	}
+}
+
+func approvedDevice(t *testing.T, db *gorm.DB, token string) *model.NextecDeviceSecret {
+	t.Helper()
+	now := time.Now().Unix()
+	d := &model.NextecDeviceSecret{PeerId: enrollPeer, TokenHash: sha256Hex(token), LastSeenAt: now, EnrolledVia: "legacy", EnrolledAt: now, ApprovedAt: now}
+	if err := db.Create(d).Error; err != nil {
+		t.Fatal(err)
+	}
+	return d
+}
+
+func TestSyncRecordsAppNameAndConnectInfoUsesMachineScheme(t *testing.T) {
+	db := enrollSetup(t)
+	token := "tok-appname-1"
+	approvedDevice(t, db, token)
+
+	// Sem nome informado: protocolo global (padrão rustdesk).
+	info := nextecConnectInfo(enrollPeer, true, time.Now().Unix())
+	if info.Scheme != "rustdesk" || info.SchemeSource != NextecSchemeSrcGlobal || info.AppName != "" {
+		t.Fatalf("sem nome: %#v", info)
+	}
+	// Admin definiu o protocolo global: é o fallback da máquina sem nome.
+	if err := NextecConnectSchemeSet("nextec-connect"); err != nil {
+		t.Fatal(err)
+	}
+	if info = nextecConnectInfo(enrollPeer, true, time.Now().Unix()); info.Scheme != "nextec-connect" || info.SchemeSource != NextecSchemeSrcGlobal {
+		t.Fatalf("fallback global: %#v", info)
+	}
+
+	if _, err := NextecAgentSyncStateWithApp("10.0.0.1", enrollPeer, token, []string{"transaction_v1"}, "Client-Nextec-Connect"); err != nil {
+		t.Fatal(err)
+	}
+	if got := deviceRow(t, db, enrollPeer).AppName; got != "Client-Nextec-Connect" {
+		t.Fatalf("app_name gravado: %q", got)
+	}
+	info = nextecConnectInfo(enrollPeer, true, time.Now().Unix())
+	if info.Scheme != "client-nextec-connect" || info.SchemeSource != NextecSchemeSrcMachine || info.AppName != "Client-Nextec-Connect" {
+		t.Fatalf("esquema da máquina: %#v", info)
+	}
+
+	// Nome inválido ou vazio não troca nada e o sync continua funcionando.
+	for _, bad := range []string{"", "has space", "x/y", strings.Repeat("a", 65), "<script>"} {
+		if _, err := NextecAgentSyncStateWithApp("10.0.0.1", enrollPeer, token, []string{"transaction_v1"}, bad); err != nil {
+			t.Fatalf("sync com app_name %q: %v", bad, err)
+		}
+		if got := deviceRow(t, db, enrollPeer).AppName; got != "Client-Nextec-Connect" {
+			t.Fatalf("app_name %q alterou o gravado para %q", bad, got)
+		}
+	}
+	// Chamada legada (sem app_name) mantém o nome já conhecido.
+	if _, err := NextecAgentSyncStateWithCapabilities("10.0.0.1", enrollPeer, token, []string{"transaction_v1"}); err != nil {
+		t.Fatal(err)
+	}
+	if got := deviceRow(t, db, enrollPeer).AppName; got != "Client-Nextec-Connect" {
+		t.Fatalf("sync legado apagou o nome: %q", got)
+	}
+	// Token errado não grava nada.
+	if _, err := NextecAgentSyncStateWithApp("10.0.0.2", enrollPeer, "outro-token", nil, "Intruso-App"); err == nil {
+		t.Fatal("token errado deveria falhar")
+	}
+	if got := deviceRow(t, db, enrollPeer).AppName; got != "Client-Nextec-Connect" {
+		t.Fatalf("token errado alterou o nome: %q", got)
+	}
+	// O app pode ser renomeado numa reinstalação.
+	if _, err := NextecAgentSyncStateWithApp("10.0.0.1", enrollPeer, token, nil, "Nextec-Suporte"); err != nil {
+		t.Fatal(err)
+	}
+	if info = nextecConnectInfo(enrollPeer, true, time.Now().Unix()); info.Scheme != "nextec-suporte" {
+		t.Fatalf("renomeado: %#v", info)
+	}
+	// A lista de máquinas do painel expõe o nome e o protocolo.
+	found := false
+	for _, dv := range NextecSecretDevices() {
+		if dv.PeerId == enrollPeer {
+			found = true
+			if dv.AppName != "Nextec-Suporte" || dv.Scheme != "nextec-suporte" || dv.SchemeSource != NextecSchemeSrcMachine {
+				t.Fatalf("lista de máquinas: %#v", dv)
+			}
+		}
+	}
+	if !found {
+		t.Fatal("máquina fora da lista")
+	}
+}
+
+func TestConnectInfoRefusesDangerousOrPendingSchemes(t *testing.T) {
+	db := enrollSetup(t)
+	token := "tok-appname-2"
+	d := approvedDevice(t, db, token)
+	// Mesmo que o nome chegue ao banco (linha antiga, edição direta), "https" nunca vira protocolo do link.
+	db.Model(d).Update("app_name", "https")
+	info := nextecConnectInfo(enrollPeer, true, time.Now().Unix())
+	if info.Scheme != "rustdesk" || info.SchemeSource != NextecSchemeSrcGlobal {
+		t.Fatalf("https aceito como protocolo: %#v", info)
+	}
+	// Inscrição pendente não decide o protocolo.
+	db.Model(d).Updates(map[string]interface{}{"app_name": "Pendente-App", "awaiting_approval": true})
+	info = nextecConnectInfo(enrollPeer, true, time.Now().Unix())
+	if info.Scheme != "rustdesk" || info.PasswordState != NextecPwPendingAgent || info.AgentActive {
+		t.Fatalf("pendente: %#v", info)
+	}
+	for _, dv := range NextecSecretDevices() {
+		if dv.PeerId == enrollPeer && (dv.Scheme != "" || dv.AppName != "") {
+			t.Fatalf("pendente expôs o protocolo: %#v", dv)
+		}
+	}
+}
+
+func TestConnectInfoPasswordStateAndAgentActivity(t *testing.T) {
+	db := enrollSetup(t)
+	now := time.Now().Unix()
+
+	// Sem agente: conexão manual, nenhum aviso.
+	info := nextecConnectInfo(enrollPeer, true, now)
+	if info.PasswordState != NextecPwNone || info.AgentEnrolled || info.AgentActive {
+		t.Fatalf("sem agente: %#v", info)
+	}
+
+	d := approvedDevice(t, db, "tok-state")
+	// Agente ativo, mas a regra está desligada: nada a esperar.
+	if info = nextecConnectInfo(enrollPeer, true, now); info.PasswordState != NextecPwNone || !info.AgentActive || !info.AgentEnrolled {
+		t.Fatalf("regra desligada: %#v", info)
+	}
+	if _, err := NextecSecretUpsertPolicy("peer", enrollPeer, true, 30); err != nil {
+		t.Fatal(err)
+	}
+	// Regra ligada e senha ainda não aplicada: aguardando a primeira troca.
+	info = nextecConnectInfo(enrollPeer, true, now)
+	if info.PasswordState != NextecPwWaitingFirst || !info.AgentActive || info.Interval != 30 || info.LastSeenAt != d.LastSeenAt {
+		t.Fatalf("aguardando primeira troca: %#v", info)
+	}
+	// Quem não lê o cofre não recebe o aviso de senha.
+	if info = nextecConnectInfo(enrollPeer, false, now); info.PasswordState != NextecPwRestricted {
+		t.Fatalf("sem acesso ao cofre: %#v", info)
+	}
+	// Senha aplicada.
+	enc, err := vaultEncrypt("SenhaDeTeste12345")
+	if err != nil {
+		t.Fatal(err)
+	}
+	db.Model(d).Update("active_enc", enc)
+	if info = nextecConnectInfo(enrollPeer, true, now); info.PasswordState != NextecPwReady {
+		t.Fatalf("senha aplicada: %#v", info)
+	}
+	// Agente sem contato há mais de 20 minutos deixa de contar como ativo.
+	db.Model(d).Update("last_seen_at", now-21*60)
+	if info = nextecConnectInfo(enrollPeer, true, now); info.AgentActive || !info.AgentEnrolled {
+		t.Fatalf("agente parado: %#v", info)
+	}
+}
