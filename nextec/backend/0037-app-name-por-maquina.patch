@@ -0,0 +1,40 @@
+package service
+
+import (
+	"testing"
+	"time"
+)
+
+// Um único sync grava contato real, intervalo, último erro e nome do app na mesma escrita; o sync seguinte sem os
+// campos opcionais limpa o erro, volta o intervalo ao legado e mantém o nome do app conhecido.
+func TestAgentSyncReportUnifiesAppNameLastErrorAndInterval(t *testing.T) {
+	db, token := stateEnrolled(t)
+	before := time.Now().Unix()
+	if _, err := NextecAgentSyncWith(stateSyncIP, enrollPeer, token, stateCaps, NextecAgentReport{
+		LastError: "client_settings_locked", IntervalSeconds: 60, AppName: "Client-Nextec-Connect",
+	}); err != nil {
+		t.Fatal(err)
+	}
+	row := deviceRow(t, db, enrollPeer)
+	if row.LastSyncAt < before || row.LastError != "client_settings_locked" || row.SyncIntervalSeconds != 60 || row.AppName != "Client-Nextec-Connect" {
+		t.Fatalf("sync unificado: %#v", row)
+	}
+	d := stateDevice(t)
+	if d.AgentState != NextecAgentStateActive || d.ActiveWindowSeconds != 180 || d.LastError != "client_settings_locked" {
+		t.Fatalf("lista: %#v", d)
+	}
+	if _, err := NextecAgentSyncStateWithCapabilities(stateSyncIP, enrollPeer, token, stateCaps); err != nil {
+		t.Fatal(err)
+	}
+	row = deviceRow(t, db, enrollPeer)
+	if row.LastError != "" || row.SyncIntervalSeconds != 0 || row.AppName != "Client-Nextec-Connect" {
+		t.Fatalf("sync sem os campos: %#v", row)
+	}
+	// nome inválido não troca o gravado, e o sync continua aceito
+	if _, err := NextecAgentSyncWith(stateSyncIP, enrollPeer, token, stateCaps, NextecAgentReport{AppName: "nome com espaco"}); err != nil {
+		t.Fatal(err)
+	}
+	if got := deviceRow(t, db, enrollPeer).AppName; got != "Client-Nextec-Connect" {
+		t.Fatalf("nome inválido gravado: %q", got)
+	}
+}
diff --git a/service/nextec_appname.go b/service/nextec_appname.go
new file mode 100644
index 0000000..903294f
--- /dev/null
+++ b/service/nextec_appname.go
@@ -0,0 +1,124 @@
+package service
+
+import (
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+)
+
+// Nome do app instalado em cada máquina. O agente lê o AppName do marcador (nextec-marker.json ou registro) e envia no
+// /api/nextec/agent/sync. O RustDesk registra o protocolo do link com o nome do app em minúsculas, mas o link abre no
+// computador de quem conecta: o protocolo do link é o global (NextecConnectSchemeGet); o nome da máquina é informativo.
+
+var nextecAppNameRe = regexp.MustCompile(`^[A-Za-z0-9-]{1,64}$`)
+
+// Protocolos que o navegador trata de forma especial. Um nome de app nunca vira link com eles: o link leva a senha
+// da máquina e não pode apontar para uma página, um arquivo ou um script.
+var nextecSchemeDenied = map[string]bool{
+	"http": true, "https": true, "file": true, "ftp": true, "ftps": true, "ws": true, "wss": true,
+	"javascript": true, "vbscript": true, "data": true, "blob": true, "about": true, "mailto": true, "tel": true,
+	"sms": true, "chrome": true, "edge": true, "view-source": true, "ms-msdt": true, "search-ms": true,
+}
+
+// NextecAppNameValid diz se o nome enviado pelo agente pode ser gravado.
+func NextecAppNameValid(v string) bool {
+	return nextecAppNameRe.MatchString(v)
+}
+
+// NextecSchemeFromAppName normaliza o nome do app para o protocolo (minúsculas). Vazio quando não serve de protocolo.
+func NextecSchemeFromAppName(appName string) string {
+	if !NextecAppNameValid(appName) {
+		return ""
+	}
+	s := strings.ToLower(appName)
+	if !nextecSchemeValid(s) || nextecSchemeDenied[s] {
+		return ""
+	}
+	return s
+}
+
+// nextecAgentAppName valida o nome enviado pelo agente no sync (espaços nas pontas ignorados).
+func nextecAgentAppName(raw string) (string, bool) {
+	name := strings.TrimSpace(raw)
+	return name, NextecAppNameValid(name)
+}
+
+// NextecAgentSyncStateWithApp é o sync do agente que também informa o nome do app instalado. O nome é gravado na
+// MESMA escrita do sync (NextecAgentSyncWith), junto de last_sync_at, last_error e interval: só com o token autenticado
+// da máquina; nome inválido ou vazio é ignorado e o agente continua funcionando.
+func NextecAgentSyncStateWithApp(ip, peerID, token string, capabilities []string, appName string) (*NextecAgentSync, error) {
+	return NextecAgentSyncWith(ip, peerID, token, capabilities, NextecAgentReport{AppName: appName})
+}
+
+// Estado da senha automática da máquina, como o botão Conectar precisa saber.
+const (
+	NextecPwNone         = "none"             // sem agente ou senha automática desligada: conexão manual
+	NextecPwPendingAgent = "pending_approval" // agente inscrito e ainda não atribuído a um cliente
+	NextecPwWaitingFirst = "waiting_first"    // agente ativo, regra ligada e a primeira senha ainda não foi aplicada
+	NextecPwReady        = "ready"            // senha vigente: o link já leva a senha
+	NextecPwRestricted   = "restricted"       // o usuário não lê o cofre: conecta digitando a senha
+
+	NextecSchemeSrcMachine = "machine"
+	NextecSchemeSrcGlobal  = "global"
+)
+
+// NextecConnectInfo é o que o painel sabe da máquina para montar e abrir o link.
+type NextecConnectInfo struct {
+	Scheme        string `json:"scheme"`
+	SchemeSource  string `json:"scheme_source"` // global | published | machine
+	AppName       string `json:"app_name,omitempty"`
+	MachineScheme string `json:"machine_scheme,omitempty"` // protocolo do app instalado na máquina remota (informativo)
+	AgentEnrolled bool   `json:"agent_enrolled"`
+	AgentActive   bool   `json:"agent_active"`
+	PasswordState string `json:"password_state"`
+	LastSeenAt    int64  `json:"last_seen_at,omitempty"`
+	LastSyncAt    int64  `json:"last_sync_at,omitempty"`
+	AgentState    string `json:"agent_state,omitempty"`
+	Interval      int    `json:"interval_minutes,omitempty"`
+}
+
+// nextecConnectInfo reúne o protocolo do link (global: o app de quem conecta) e o estado do agente e da senha.
+// canReadVault: o usuário pode receber a senha do cofre desta máquina.
+func nextecConnectInfo(peerID string, canReadVault bool, now int64) *NextecConnectInfo {
+	scheme, source := NextecConnectSchemeAuto()
+	info := &NextecConnectInfo{Scheme: scheme, SchemeSource: source, PasswordState: NextecPwNone}
+	d := &model.NextecDeviceSecret{}
+	if peerID == "" || DB.Where("peer_id = ?", peerID).First(d).Error != nil || d.TokenHash == "" {
+		return info
+	}
+	info.AgentEnrolled = true
+	info.LastSeenAt, info.LastSyncAt = d.LastSeenAt, d.LastSyncAt
+	// Fonte única do estado (0035/0036): a mesma regra da lista do cofre, com o intervalo real do agente.
+	info.AgentState = NextecAgentStateAt(d, now)
+	if d.AwaitingApproval {
+		info.PasswordState = NextecPwPendingAgent
+		return info
+	}
+	info.AgentActive = info.AgentState == NextecAgentStateActive
+	// O link é aberto no computador de QUEM CONECTA, pelo app instalado lá: vale o protocolo global do painel.
+	// O nome do app da máquina remota é só informação e nunca muda o protocolo do link.
+	if s := NextecSchemeFromAppName(d.AppName); s != "" {
+		info.AppName, info.MachineScheme = d.AppName, s
+	}
+	enabled, interval := effectivePolicy(peerID, peerGroup(peerID))
+	if !enabled {
+		return info
+	}
+	info.Interval = interval
+	switch {
+	case !canReadVault:
+		info.PasswordState = NextecPwRestricted
+	case d.ActiveEnc == "":
+		info.PasswordState = NextecPwWaitingFirst
+	default:
+		info.PasswordState = NextecPwReady
+	}
+	return info
+}
+
+// NextecConnectInfoFor devolve o estado da conexão para o usuário logado (já autorizado a ver a máquina).
+func NextecConnectInfoFor(u *model.User, peerID string) *NextecConnectInfo {
+	return nextecConnectInfo(peerID, NextecUserCanReadVault(u, peerID), time.Now().Unix())
+}
