@@ -0,0 +1,88 @@
+package api
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+// O sync aceita app_name de forma aditiva: com ou sem o campo, e com valor inválido, o agente continua funcionando.
+func TestAgentSyncAcceptsAppNameAdditively(t *testing.T) {
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&model.Peer{}, &model.DeviceGroup{}, &model.NextecSecretPolicy{}, &model.NextecDeviceSecret{}, &model.NextecSecretAudit{}, &model.NextecAgentBootstrap{}, &model.NextecEnrollBlock{}); err != nil {
+		t.Fatal(err)
+	}
+	sqlDB, _ := db.DB()
+	sqlDB.SetMaxOpenConns(1)
+	oldDB, oldService := service.DB, service.AllService
+	service.DB, service.AllService = db, &service.Service{}
+	t.Setenv("NEXTEC_VAULT_KEY", base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x52}, 32)))
+	wd, _ := os.Getwd()
+	if err := os.Chdir(t.TempDir()); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chdir(wd); service.DB, service.AllService = oldDB, oldService; sqlDB.Close() })
+
+	token := "token-http-appname"
+	sum := sha256.Sum256([]byte(token))
+	now := time.Now().Unix()
+	if err := db.Create(&model.NextecDeviceSecret{PeerId: "737373737", TokenHash: hex.EncodeToString(sum[:]), LastSeenAt: now, EnrolledVia: "legacy"}).Error; err != nil {
+		t.Fatal(err)
+	}
+	r := gin.New()
+	r.POST("/sync", (&NextecAgent{}).Sync)
+	call := func(body map[string]interface{}) int {
+		raw, _ := json.Marshal(body)
+		req := httptest.NewRequest("POST", "/sync", strings.NewReader(string(raw)))
+		req.Header.Set("Content-Type", "application/json")
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, req)
+		return w.Code
+	}
+	stored := func() string {
+		d := &model.NextecDeviceSecret{}
+		db.Where("peer_id = ?", "737373737").First(d)
+		return d.AppName
+	}
+	base := map[string]interface{}{"id": "737373737", "token": token, "capabilities": []string{"transaction_v1"}}
+	if code := call(base); code != 200 || stored() != "" {
+		t.Fatalf("sync sem app_name: %d %q", code, stored())
+	}
+	with := func(v interface{}) map[string]interface{} {
+		m := map[string]interface{}{}
+		for k, x := range base {
+			m[k] = x
+		}
+		m["app_name"] = v
+		return m
+	}
+	if code := call(with("Client-Nextec-Connect")); code != 200 || stored() != "Client-Nextec-Connect" {
+		t.Fatalf("sync com app_name: %d %q", code, stored())
+	}
+	// Valor inválido nunca troca o nome gravado (tipo errado vira 400 do bind; texto inválido é ignorado com 200).
+	for _, bad := range []interface{}{"com espaco", "../x", 42, strings.Repeat("z", 100)} {
+		if code := call(with(bad)); code != 200 && code != 400 {
+			t.Fatalf("app_name %v: %d", bad, code)
+		}
+		if stored() != "Client-Nextec-Connect" {
+			t.Fatalf("app_name %v alterou o nome gravado: %q", bad, stored())
+		}
+	}
+}
