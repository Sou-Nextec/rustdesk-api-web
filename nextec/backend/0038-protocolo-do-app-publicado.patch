+package service
+
+import (
+	"path/filepath"
+	"strings"
+
+	"github.com/lejianwen/rustdesk-api/v2/global"
+)
+
+// NextecSchemeSrcPublished: protocolo deduzido do app publicado para os analistas (o admin não definiu um).
+const NextecSchemeSrcPublished = "published"
+
+// Extensões dos instaladores publicados; o nome do app é o nome do arquivo sem elas.
+var nextecInstallerExt = map[string]bool{".msi": true, ".exe": true, ".deb": true, ".rpm": true, ".zip": true}
+
+// NextecPublishedAppScheme deduz o protocolo do app que o painel entrega aos analistas (Atualizações do app).
+// O RustDesk registra o protocolo com o nome do app em minúsculas; o gerador usa o mesmo nome para o arquivo e para o app.
+// Vazio quando nada foi publicado ou o nome não serve de protocolo.
+func NextecPublishedAppScheme() string {
+	r := NextecAvailableApp()
+	if r == nil {
+		return ""
+	}
+	name := strings.TrimSpace(r.FileName)
+	if ext := strings.ToLower(filepath.Ext(name)); nextecInstallerExt[ext] {
+		name = strings.TrimSuffix(name, filepath.Ext(name))
+	}
+	return NextecSchemeFromAppName(name)
+}
+
+// NextecConnectSchemeAuto devolve o protocolo do link e de onde veio. O link abre no computador de quem conecta:
+// vale o que o admin configurou; sem isso, o do app publicado para os analistas; sem isso, rustdesk.
+func NextecConnectSchemeAuto() (scheme, source string) {
+	if strings.TrimSpace(global.NextecSettingGet(settingConnectScheme)) != "" {
+		return NextecConnectSchemeGet(), NextecSchemeSrcGlobal
+	}
+	if s := NextecPublishedAppScheme(); s != "" {
+		return s, NextecSchemeSrcPublished
+	}
+	return NextecConnectSchemeGet(), NextecSchemeSrcGlobal
+}
