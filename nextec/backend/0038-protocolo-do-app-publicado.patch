+package service
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+)
+
+func TestConnectSchemeAutoFollowsPublishedAppUnlessAdminSetOne(t *testing.T) {
+	db := enrollSetup(t)
+	if err := db.AutoMigrate(&model.NextecAppRelease{}); err != nil {
+		t.Fatal(err)
+	}
+	// Nada configurado e nada publicado: padrão.
+	if s, src := NextecConnectSchemeAuto(); s != "rustdesk" || src != NextecSchemeSrcGlobal {
+		t.Fatalf("sem nada: %q %q", s, src)
+	}
+	// App publicado para os analistas: o protocolo vem do nome dele, sem o analista escolher nada.
+	rel := &model.NextecAppRelease{Version: "2.0.9", FileName: "Joao-da-Silva.msi", Sha256: strings.Repeat("a", 64), Internal: true, Profile: "analysts"}
+	if err := db.Create(rel).Error; err != nil {
+		t.Fatal(err)
+	}
+	if s, src := NextecConnectSchemeAuto(); s != "joao-da-silva" || src != NextecSchemeSrcPublished {
+		t.Fatalf("publicado: %q %q", s, src)
+	}
+	// O que o admin configurou vence.
+	if err := NextecConnectSchemeSet("meu-app"); err != nil {
+		t.Fatal(err)
+	}
+	if s, src := NextecConnectSchemeAuto(); s != "meu-app" || src != NextecSchemeSrcGlobal {
+		t.Fatalf("admin: %q %q", s, src)
+	}
+	// Nome publicado que não serve de protocolo é ignorado.
+	if err := NextecConnectSchemeSet(""); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Model(rel).Update("file_name", "Nome com espaco.msi").Error; err != nil {
+		t.Fatal(err)
+	}
+	if s, src := NextecConnectSchemeAuto(); s != "rustdesk" || src != NextecSchemeSrcGlobal {
+		t.Fatalf("nome inválido: %q %q", s, src)
+	}
+}
