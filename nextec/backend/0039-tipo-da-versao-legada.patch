+package admin
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/http/response"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+)
+
+type nextecProfileForm struct {
+	Version string `json:"version" binding:"required"`
+	Profile string `json:"profile" binding:"required"`
+}
+
+// SetProfile define o tipo (analysts ou default) de uma versão enviada à mão, antes de o gerador registrar o tipo.
+// @Router /admin/nextec/updates/profile [post]
+func (n *NextecUpdate) SetProfile(c *gin.Context) {
+	var form nextecProfileForm
+	if err := c.ShouldBindJSON(&form); err != nil {
+		response.Fail(c, 101, response.TranslateMsg(c, "ParamsError"))
+		return
+	}
+	if err := service.NextecReleaseSetProfile(form.Version, form.Profile); err != nil {
+		if errors.Is(err, service.ErrNextecInUse) {
+			response.Fail(c, 101, "Esta versão está publicada. Suspenda a publicação antes de definir o tipo.")
+			return
+		}
+		response.Fail(c, 101, nextecUpdateMsg(err))
+		return
+	}
+	service.NextecSecretAuditAdd(service.AllService.UserService.CurUser(c), "", "update_profile", nextecIP(c), fmt.Sprintf("%s %s", form.Version, form.Profile))
+	response.Success(c, &gin.H{"version": form.Version, "profile": form.Profile})
+}
diff --git a/service/nextec_release_profile.go b/service/nextec_release_profile.go
new file mode 100644
index 0000000..13e73b1
--- /dev/null
+++ b/service/nextec_release_profile.go
@@ -0,0 +1,62 @@
+package service
+
+import (
+	"errors"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+)
+
+// ErrNextecProfileLocked: o tipo já foi registrado (pelo gerador ou por uma definição anterior) e não muda por aqui.
+var ErrNextecProfileLocked = errors.New("O tipo desta versão já está registrado e não pode ser alterado.")
+
+// ErrNextecProfileInvalid: só Analistas ou Cliente padrão podem ser definidos à mão.
+var ErrNextecProfileInvalid = errors.New("Tipo inválido. Use Analistas ou Cliente padrão.")
+
+// nextecReleasePublished diz se a versão está em publicação (padrão ou por cliente/máquina). Mudar o tipo com a versão
+// publicada deixaria a distribuição incompatível com o tipo (Analistas exige publicação específica).
+func nextecReleasePublished(r *model.NextecAppRelease) bool {
+	if ro := NextecRolloutGet(); ro.Mode != NextecRolloutOff && ro.Version == r.Version {
+		return true
+	}
+	for _, ro := range NextecScopedRollouts() {
+		if ro.Mode != NextecRolloutOff && ro.Version == r.Version {
+			return true
+		}
+	}
+	return false
+}
+
+// NextecReleaseSetProfile define o tipo de uma versão enviada à mão (sem geração e sem tipo registrado). Versões que vieram
+// do gerador já trazem o tipo escolhido lá e não são alteradas; "Cliente específico" exige o fluxo do gerador.
+// A condição "ainda sem tipo e sem geração" é garantida na própria gravação (UPDATE condicional): duas requisições
+// simultâneas não sobrescrevem a primeira escolha, porque só uma altera uma linha.
+func NextecReleaseSetProfile(version, profile string) error {
+	if profile != "analysts" && profile != "default" {
+		return ErrNextecProfileInvalid
+	}
+	// Serializa com a publicação específica (que usa o mesmo cadeado) e confere de novo depois de gravar: a publicação
+	// padrão usa outro controle e, se entrou entre a conferência e a gravação, esta escolha é desfeita.
+	scopedRolloutMu.Lock()
+	defer scopedRolloutMu.Unlock()
+	r := NextecReleaseByVersion(version)
+	if r == nil {
+		return ErrNextecNoRelease
+	}
+	if nextecReleasePublished(r) {
+		return ErrNextecInUse
+	}
+	res := DB.Model(&model.NextecAppRelease{}).
+		Where("id = ? AND (profile = '' OR profile IS NULL) AND (generation_uuid = '' OR generation_uuid IS NULL)", r.Id).
+		Update("profile", profile)
+	if res.Error != nil {
+		return res.Error
+	}
+	if res.RowsAffected == 0 {
+		return ErrNextecProfileLocked
+	}
+	if nextecReleasePublished(r) {
+		DB.Model(&model.NextecAppRelease{}).Where("id = ? AND profile = ?", r.Id, profile).Update("profile", "")
+		return ErrNextecInUse
+	}
+	return nil
+}
diff --git a/service/nextec_release_profile_test.go b/service/nextec_release_profile_test.go
new file mode 100644
index 0000000..794b177
--- /dev/null
+++ b/service/nextec_release_profile_test.go
@@ -0,0 +1,114 @@
+package service
+
+import (
+	"encoding/json"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/lejianwen/rustdesk-api/v2/global"
+	"github.com/lejianwen/rustdesk-api/v2/model"
+)
+
+func TestReleaseSetProfileOnlyForLegacyManualUploads(t *testing.T) {
+	db := securityDB(t)
+	if err := db.AutoMigrate(&model.NextecAppRelease{}); err != nil {
+		t.Fatal(err)
+	}
+	legacy := &model.NextecAppRelease{Version: "2.0.9", FileName: "Nextec-Connect.msi", Sha256: strings.Repeat("a", 64)}
+	generated := &model.NextecAppRelease{Version: "2.3.6", FileName: "Cliente-Nextec-Connect.msi", Sha256: strings.Repeat("b", 64), GenerationUUID: "aaaaaaaa-0000-0000-0000-000000000001", Profile: "default"}
+	for _, r := range []*model.NextecAppRelease{legacy, generated} {
+		if err := db.Create(r).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := NextecReleaseSetProfile("2.0.9", "client"); err != ErrNextecProfileInvalid {
+		t.Fatalf("client deveria ser recusado: %v", err)
+	}
+	if err := NextecReleaseSetProfile("9.9.9", "analysts"); err != ErrNextecNoRelease {
+		t.Fatalf("versao inexistente: %v", err)
+	}
+	if err := NextecReleaseSetProfile("2.3.6", "analysts"); err != ErrNextecProfileLocked {
+		t.Fatalf("versao do gerador deveria ficar travada: %v", err)
+	}
+	if err := NextecReleaseSetProfile("2.0.9", "analysts"); err != nil {
+		t.Fatal(err)
+	}
+	if got := NextecReleaseByVersion("2.0.9"); got == nil || got.Profile != "analysts" {
+		t.Fatalf("tipo nao gravado: %#v", got)
+	}
+	if err := NextecReleaseSetProfile("2.0.9", "default"); err != ErrNextecProfileLocked {
+		t.Fatalf("segunda alteracao deveria ser recusada: %v", err)
+	}
+}
+
+// A trava vale na gravação: com várias requisições ao mesmo tempo, só uma define o tipo e a escolha dela permanece.
+func TestReleaseSetProfileConcurrentRequestsKeepFirstChoice(t *testing.T) {
+	db := securityDB(t)
+	if err := db.AutoMigrate(&model.NextecAppRelease{}); err != nil {
+		t.Fatal(err)
+	}
+	if sqlDB, err := db.DB(); err == nil {
+		sqlDB.SetMaxOpenConns(1) // SQLite em memoria: uma conexao, as goroutines se enfileiram; o UPDATE condicional segue sendo o que decide
+	}
+	if err := db.Create(&model.NextecAppRelease{Version: "2.0.9", FileName: "Nextec-Connect.msi", Sha256: strings.Repeat("a", 64)}).Error; err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	var wins int32
+	winner := make(chan string, 16)
+	for i := 0; i < 12; i++ {
+		profile := "analysts"
+		if i%2 == 1 {
+			profile = "default"
+		}
+		wg.Add(1)
+		go func(p string) {
+			defer wg.Done()
+			err := NextecReleaseSetProfile("2.0.9", p)
+			if err == nil {
+				atomic.AddInt32(&wins, 1)
+				winner <- p
+			} else if err != ErrNextecProfileLocked {
+				t.Errorf("erro inesperado: %v", err)
+			}
+		}(profile)
+	}
+	wg.Wait()
+	close(winner)
+	if wins != 1 {
+		t.Fatalf("esperava exatamente 1 gravacao, houve %d", wins)
+	}
+	want := <-winner
+	if got := NextecReleaseByVersion("2.0.9"); got == nil || got.Profile != want {
+		t.Fatalf("a primeira escolha foi sobrescrita: %#v (vencedor %s)", got, want)
+	}
+}
+
+// Versão em publicação (padrão ou específica) não muda de tipo; suspensa a publicação, a escolha volta a ser possível.
+func TestReleaseSetProfileRefusedWhilePublished(t *testing.T) {
+	db := securityDB(t)
+	if err := db.AutoMigrate(&model.NextecAppRelease{}); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Create(&model.NextecAppRelease{Version: "2.0.9", FileName: "Nextec-Connect.msi", Sha256: strings.Repeat("a", 64)}).Error; err != nil {
+		t.Fatal(err)
+	}
+	raw, _ := json.Marshal([]NextecRollout{{Version: "2.0.9", Mode: NextecRolloutPilot, Groups: []uint{1}, Peers: []string{}}})
+	if err := global.NextecSettingSet("app_scoped_rollouts", string(raw)); err != nil {
+		t.Fatal(err)
+	}
+	if err := NextecReleaseSetProfile("2.0.9", "analysts"); err != ErrNextecInUse {
+		t.Fatalf("versao publicada deveria recusar: %v", err)
+	}
+	if got := NextecReleaseByVersion("2.0.9"); got == nil || got.Profile != "" {
+		t.Fatalf("tipo mudou com a versao publicada: %#v", got)
+	}
+	if err := global.NextecSettingSet("app_scoped_rollouts", "[]"); err != nil {
+		t.Fatal(err)
+	}
+	if err := NextecReleaseSetProfile("2.0.9", "analysts"); err != nil {
+		t.Fatalf("sem publicacao deveria aceitar: %v", err)
+	}
+}
