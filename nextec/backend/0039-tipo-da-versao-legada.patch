@@ -0,0 +1,40 @@
+package service
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+)
+
+func TestReleaseSetProfileOnlyForLegacyManualUploads(t *testing.T) {
+	db := securityDB(t)
+	if err := db.AutoMigrate(&model.NextecAppRelease{}); err != nil {
+		t.Fatal(err)
+	}
+	legacy := &model.NextecAppRelease{Version: "2.0.9", FileName: "Nextec-Connect.msi", Sha256: strings.Repeat("a", 64)}
+	generated := &model.NextecAppRelease{Version: "2.3.6", FileName: "Cliente-Nextec-Connect.msi", Sha256: strings.Repeat("b", 64), GenerationUUID: "aaaaaaaa-0000-0000-0000-000000000001", Profile: "default"}
+	for _, r := range []*model.NextecAppRelease{legacy, generated} {
+		if err := db.Create(r).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := NextecReleaseSetProfile("2.0.9", "client"); err != ErrNextecProfileInvalid {
+		t.Fatalf("client deveria ser recusado: %v", err)
+	}
+	if err := NextecReleaseSetProfile("9.9.9", "analysts"); err != ErrNextecNoRelease {
+		t.Fatalf("versao inexistente: %v", err)
+	}
+	if err := NextecReleaseSetProfile("2.3.6", "analysts"); err != ErrNextecProfileLocked {
+		t.Fatalf("versao do gerador deveria ficar travada: %v", err)
+	}
+	if err := NextecReleaseSetProfile("2.0.9", "analysts"); err != nil {
+		t.Fatal(err)
+	}
+	if got := NextecReleaseByVersion("2.0.9"); got == nil || got.Profile != "analysts" {
+		t.Fatalf("tipo nao gravado: %#v", got)
+	}
+	if err := NextecReleaseSetProfile("2.0.9", "default"); err != ErrNextecProfileLocked {
+		t.Fatalf("segunda alteracao deveria ser recusada: %v", err)
+	}
+}
