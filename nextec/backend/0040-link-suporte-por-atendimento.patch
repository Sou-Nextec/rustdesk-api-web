+// Link vencido nunca consome a máquina de um atendimento ativo.
+func TestSupportLinkExpiredDoesNotConsumeActivePeer(t *testing.T) {
+	db := securityDB(t)
+	if err := db.AutoMigrate(&model.Peer{}); err != nil {
+		t.Fatal(err)
+	}
+	old, _ := NextecSupportLinkCreate(nil, "Antigo", "", time.Hour)
+	NextecSupportLinkMarkDownload(old.Id, "200.5.5.5")
+	db.Model(&model.NextecSupportLink{}).Where("id = ?", old.Id).Update("expires_at", time.Now().Unix()-1)
+	active, _ := NextecSupportLinkCreate(nil, "Ativo", "", time.Hour)
+	NextecSupportLinkMarkDownload(active.Id, "200.5.5.5")
+	supportTestPeer(t, db, "888888888", "200.5.5.5")
+	views, err := NextecSupportLinkList("", true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, v := range views {
+		switch v.Label {
+		case "Antigo":
+			if v.PeerId != "" || v.Status != "expired" {
+				t.Fatalf("link vencido associado: %#v", v)
+			}
+		case "Ativo":
+			if v.PeerId != "888888888" || v.MatchedBy != "ip" {
+				t.Fatalf("link ativo deveria receber a maquina: %#v", v)
+			}
+		}
+	}
+}
