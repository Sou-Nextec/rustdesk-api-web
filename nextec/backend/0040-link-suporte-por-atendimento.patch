+package my
+
+import (
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/http/response"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+)
+
+// NextecSupportLinks: links de suporte por atendimento. Qualquer usuário logado cria e vê os seus; administrador vê todos.
+type NextecSupportLinks struct{}
+
+type nextecSupportLinkForm struct {
+	Label  string `json:"label"`
+	Ticket string `json:"ticket"`
+	Hours  int    `json:"hours"`
+}
+
+type nextecSupportLinkRevokeForm struct {
+	Id uint `json:"id" binding:"required"`
+}
+
+func nextecSupportLinkIP(c *gin.Context) string {
+	if ip := c.GetHeader("CF-Connecting-IP"); ip != "" {
+		return ip
+	}
+	return c.ClientIP()
+}
+
+// List devolve os links recentes com a máquina associada
+// @Router /admin/my/support/links [get]
+func (n *NextecSupportLinks) List(c *gin.Context) {
+	u := service.AllService.UserService.CurUser(c)
+	owner := ""
+	if u != nil && !service.AllService.UserService.IsAdmin(u) {
+		owner = u.Username
+	}
+	// A associação com máquinas segue a mesma política da fila (patch 0014): desligada ou só administradores.
+	queue := service.NextecWaitingAllowed(u)
+	links, err := service.NextecSupportLinkList(owner, queue)
+	if err != nil {
+		response.Fail(c, 101, "Não foi possível listar os links.")
+		return
+	}
+	response.Success(c, &gin.H{"list": links, "has_app": service.NextecSupportAppGet() != nil, "queue_enabled": queue})
+}
+
+// Create cria um link por atendimento
+// @Router /admin/my/support/links [post]
+func (n *NextecSupportLinks) Create(c *gin.Context) {
+	var f nextecSupportLinkForm
+	if err := c.ShouldBindJSON(&f); err != nil {
+		response.Fail(c, 101, response.TranslateMsg(c, "ParamsError"))
+		return
+	}
+	if service.NextecSupportAppGet() == nil {
+		response.Fail(c, 101, "O aplicativo de suporte ainda não foi publicado. Peça a um administrador para publicá-lo.")
+		return
+	}
+	u := service.AllService.UserService.CurUser(c)
+	link, err := service.NextecSupportLinkCreate(u, f.Label, f.Ticket, time.Duration(f.Hours)*time.Hour)
+	if err != nil {
+		response.Fail(c, 101, err.Error())
+		return
+	}
+	service.NextecSecretAuditAdd(u, "", "support_link_create", nextecSupportLinkIP(c), fmt.Sprintf("%s %s", link.Token, strings.TrimSpace(link.Label)))
+	response.Success(c, link)
+}
+
+// Revoke cancela um link (o dono ou um administrador)
+// @Router /admin/my/support/links/revoke [post]
+func (n *NextecSupportLinks) Revoke(c *gin.Context) {
+	var f nextecSupportLinkRevokeForm
+	if err := c.ShouldBindJSON(&f); err != nil {
+		response.Fail(c, 101, response.TranslateMsg(c, "ParamsError"))
+		return
+	}
+	u := service.AllService.UserService.CurUser(c)
+	owner := ""
+	if u != nil && !service.AllService.UserService.IsAdmin(u) {
+		owner = u.Username
+	}
+	if err := service.NextecSupportLinkRevoke(f.Id, owner); err != nil {
+		response.Fail(c, 101, err.Error())
+		return
+	}
+	service.NextecSecretAuditAdd(u, "", "support_link_revoke", nextecSupportLinkIP(c), fmt.Sprintf("%d", f.Id))
+	response.Success(c, nil)
+}
