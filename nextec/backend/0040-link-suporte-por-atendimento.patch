+// Duas máquinas atrás do mesmo NAT (mesmo IP) e dois links baixados do mesmo IP: nada é associado por palpite,
+// qualquer que seja a ordem dos heartbeats.
+func TestSupportLinkSameIPTwoLinksTwoPeersStayPending(t *testing.T) {
+	db := securityDB(t)
+	if err := db.AutoMigrate(&model.Peer{}); err != nil {
+		t.Fatal(err)
+	}
+	a, _ := NextecSupportLinkCreate(nil, "Cliente A", "", time.Hour)
+	b, _ := NextecSupportLinkCreate(nil, "Cliente B", "", time.Hour)
+	NextecSupportLinkMarkDownload(a.Id, "200.7.7.7")
+	NextecSupportLinkMarkDownload(b.Id, "200.7.7.7")
+	supportTestPeer(t, db, "666666666", "200.7.7.7")
+	supportTestPeer(t, db, "777777777", "200.7.7.7")
+	db.Model(&model.Peer{}).Where("id = ?", "666666666").Update("last_online_time", time.Now().Unix()-30)
+	views, err := NextecSupportLinkList("", true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, v := range views {
+		if v.PeerId != "" {
+			t.Fatalf("associou por palpite com IP compartilhado: %#v", v)
+		}
+	}
+	// um link, duas máquinas livres com o mesmo IP: também fica pendente
+	db.Model(&model.NextecSupportLink{}).Where("id = ?", b.Id).Update("revoked", true)
+	views, _ = NextecSupportLinkList("", true)
+	for _, v := range views {
+		if v.PeerId != "" {
+			t.Fatalf("um link com duas maquinas do mesmo IP deveria ficar pendente: %#v", v)
+		}
+	}
+}
