+func TestSupportLinkFallsBackToTimeOnlyWhenUnambiguous(t *testing.T) {
+	db := securityDB(t)
+	if err := db.AutoMigrate(&model.Peer{}); err != nil {
+		t.Fatal(err)
+	}
+	l, _ := NextecSupportLinkCreate(nil, "Cliente C", "", time.Hour)
+	NextecSupportLinkMarkDownload(l.Id, "200.9.9.9")
+	supportTestPeer(t, db, "333333333", "10.0.0.5")
+	views, _ := NextecSupportLinkList("", true)
+	if len(views) != 1 || views[0].PeerId != "333333333" || views[0].MatchedBy != "time" || views[0].Status != "connected" {
+		t.Fatalf("fallback por horario: %#v", views)
+	}
+	// duas maquinas livres para um link: ambiguo, nao associa
+	l2, _ := NextecSupportLinkCreate(nil, "Cliente D", "", time.Hour)
+	NextecSupportLinkMarkDownload(l2.Id, "200.8.8.8")
+	for _, id := range []string{"444444444", "555555555"} {
+		supportTestPeer(t, db, id, "10.0.0.9")
+	}
+	views, _ = NextecSupportLinkList("", true)
+	for _, v := range views {
+		if v.Label == "Cliente D" && v.PeerId != "" {
+			t.Fatalf("associou de forma ambigua: %#v", v)
+		}
+	}
+}
