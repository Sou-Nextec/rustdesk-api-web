+// Sem permissão para a fila (patch 0014), a listagem não associa nem expõe máquina alguma.
+func TestSupportLinkListHidesPeersWhenQueueNotAllowed(t *testing.T) {
+	db := securityDB(t)
+	if err := db.AutoMigrate(&model.Peer{}); err != nil {
+		t.Fatal(err)
+	}
+	l, _ := NextecSupportLinkCreate(&model.User{Username: "ana"}, "Cliente E", "", time.Hour)
+	NextecSupportLinkMarkDownload(l.Id, "200.4.4.4")
+	supportTestPeer(t, db, "999999999", "200.4.4.4")
+	views, err := NextecSupportLinkList("ana", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(views) != 1 || views[0].PeerId != "" || views[0].PeerName != "" || views[0].Online || views[0].Status != "downloaded" {
+		t.Fatalf("expos maquina sem permissao da fila: %#v", views)
+	}
+	var stored model.NextecSupportLink
+	db.First(&stored, l.Id)
+	if stored.PeerId != "" {
+		t.Fatalf("associou sem permissao da fila: %#v", stored)
+	}
+	views, _ = NextecSupportLinkList("ana", true)
+	if views[0].PeerId != "999999999" {
+		t.Fatalf("com permissao deveria associar: %#v", views[0])
+	}
+}
