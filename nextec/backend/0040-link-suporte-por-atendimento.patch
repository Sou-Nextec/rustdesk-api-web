+	NextecSupportLinkMarkDownload(b.Id, "200.2.2.2")
+	mk("111111111", "200.2.2.2")
+	mk("222222222", "200.1.1.1")
+	views, err := NextecSupportLinkList("", true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]string{}
+	for _, v := range views {
