+package model
+
+// NextecSupportLink é um link de suporte por atendimento (/s/<token>): criado pelo técnico para um cliente ou chamado,
+// com validade. Quando a pessoa baixa o app, a máquina que aparece na fila é associada ao link pelo IP e pelo horário.
+type NextecSupportLink struct {
+	Id           uint   `json:"id" gorm:"primaryKey"`
+	Token        string `json:"token" gorm:"size:16;uniqueIndex;not null"`
+	Label        string `json:"label" gorm:"size:120;not null"`
+	Ticket       string `json:"ticket" gorm:"size:40"`
+	CreatedBy    string `json:"created_by" gorm:"size:64;index"`
+	CreatedAt    int64  `json:"created_at"`
+	ExpiresAt    int64  `json:"expires_at"`
+	Revoked      bool   `json:"revoked"`
+	DownloadedAt int64  `json:"downloaded_at"`
+	DownloadIP   string `json:"-" gorm:"size:64"`
+	PeerId       string `json:"peer_id" gorm:"size:64;index"`
+	MatchedBy    string `json:"matched_by" gorm:"size:8"`
+}
diff --git a/service/nextec_support_link.go b/service/nextec_support_link.go
new file mode 100644
index 0000000..57eb10a
--- /dev/null
+++ b/service/nextec_support_link.go
@@ -0,0 +1,303 @@
+package service
+
+import (
+	"crypto/rand"
+	"errors"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+)
+
+// Links de suporte por atendimento (Nextec). O técnico cria um link para um cliente ou chamado; a pessoa abre /s/<token>,
+// baixa o app de suporte e a máquina que aparece em "Aguardando atendimento" é associada ao link.
+
+const (
+	nextecSupportLinkAlphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789" // sem 0, 1, I, O: ditado por telefone sem erro
+	nextecSupportLinkLen      = 8
+	nextecSupportLinkMinTTL   = 1 * time.Hour
+	nextecSupportLinkMaxTTL   = 24 * time.Hour
+	nextecSupportLinkDefTTL   = 2 * time.Hour
+	nextecSupportLinkWindow   = int64(2 * 3600) // associa downloads das últimas 2 horas
+	nextecSupportLinkList     = 50
+)
+
+var (
+	ErrNextecSupportLinkLabel  = errors.New("Informe o cliente ou o chamado (até 120 caracteres).")
+	ErrNextecSupportLinkTicket = errors.New("Chamado inválido. Use letras, números, hífen ou sublinhado (até 40 caracteres).")
+	ErrNextecSupportLinkNone   = errors.New("Link não encontrado.")
+	ErrNextecSupportLinkTTL    = errors.New("A validade deve ficar entre 1 e 24 horas.")
+
+	nextecSupportLinkTokenRe  = regexp.MustCompile("^[A-HJ-NP-Z2-9]{8}$")
+	nextecSupportLinkTicketRe = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$`)
+
+	supportLinksMu     sync.Mutex
+	supportLinksMigrated *gorm.DB
+)
+
+// supportLinksReady cria a tabela na primeira utilização (e quando o banco muda, nos testes).
+func supportLinksReady() error {
+	supportLinksMu.Lock()
+	defer supportLinksMu.Unlock()
+	if supportLinksMigrated == DB {
+		return nil
+	}
+	if err := DB.AutoMigrate(&model.NextecSupportLink{}); err != nil {
+		return err
+	}
+	supportLinksMigrated = DB
+	return nil
+}
+
+func nextecSupportLinkToken() (string, error) {
+	raw := make([]byte, nextecSupportLinkLen)
+	if _, err := rand.Read(raw); err != nil {
+		return "", err
+	}
+	out := make([]byte, nextecSupportLinkLen)
+	for i, b := range raw {
+		out[i] = nextecSupportLinkAlphabet[int(b)%len(nextecSupportLinkAlphabet)]
+	}
+	return string(out), nil
+}
+
+// NextecSupportLinkCreate cria o link. ttl zero vale o padrão de 2 horas; fora de 1 a 24 horas é recusado.
+func NextecSupportLinkCreate(u *model.User, label, ticket string, ttl time.Duration) (*model.NextecSupportLink, error) {
+	label = strings.TrimSpace(label)
+	ticket = strings.TrimSpace(ticket)
+	if label == "" || len([]rune(label)) > 120 {
+		return nil, ErrNextecSupportLinkLabel
+	}
+	if ticket != "" && !nextecSupportLinkTicketRe.MatchString(ticket) {
+		return nil, ErrNextecSupportLinkTicket
+	}
+	if ttl == 0 {
+		ttl = nextecSupportLinkDefTTL
+	}
+	if ttl < nextecSupportLinkMinTTL || ttl > nextecSupportLinkMaxTTL {
+		return nil, ErrNextecSupportLinkTTL
+	}
+	if err := supportLinksReady(); err != nil {
+		return nil, err
+	}
+	now := time.Now()
+	link := &model.NextecSupportLink{Label: label, Ticket: ticket, CreatedAt: now.Unix(), ExpiresAt: now.Add(ttl).Unix()}
+	if u != nil {
+		link.CreatedBy = u.Username
+	}
+	for attempt := 0; attempt < 5; attempt++ {
+		token, err := nextecSupportLinkToken()
+		if err != nil {
+			return nil, err
+		}
+		link.Token = token
+		if err := DB.Create(link).Error; err == nil {
+			return link, nil
+		}
+	}
+	return nil, errors.New("Não foi possível gerar o link. Tente de novo.")
+}
+
+// NextecSupportLinkByToken devolve o link só se estiver válido (existe, não foi cancelado e não venceu).
+func NextecSupportLinkByToken(token string) *model.NextecSupportLink {
+	token = strings.ToUpper(strings.TrimSpace(token))
+	if !nextecSupportLinkTokenRe.MatchString(token) || supportLinksReady() != nil {
+		return nil
+	}
+	link := &model.NextecSupportLink{}
+	if DB.Where("token = ?", token).First(link).Error != nil {
+		return nil
+	}
+	if link.Revoked || link.ExpiresAt <= time.Now().Unix() {
+		return nil
+	}
+	return link
+}
+
+// NextecSupportLinkMarkDownload registra o download (IP e hora) para associar a máquina que vai aparecer na fila.
+func NextecSupportLinkMarkDownload(id uint, ip string) {
+	if supportLinksReady() != nil {
+		return
+	}
+	if len(ip) > 64 {
+		ip = ip[:64]
+	}
+	DB.Model(&model.NextecSupportLink{}).Where("id = ? AND peer_id = ''", id).
+		Updates(map[string]interface{}{"downloaded_at": time.Now().Unix(), "download_ip": ip})
+}
+
+// NextecSupportLinkRevoke cancela o link. Só o dono ou um administrador cancelam (onlyOwner vazio = qualquer).
+func NextecSupportLinkRevoke(id uint, onlyOwner string) error {
+	if err := supportLinksReady(); err != nil {
+		return err
+	}
+	q := DB.Model(&model.NextecSupportLink{}).Where("id = ?", id)
+	if onlyOwner != "" {
+		q = q.Where("created_by = ?", onlyOwner)
+	}
+	res := q.Update("revoked", true)
+	if res.Error != nil {
+		return res.Error
+	}
+	if res.RowsAffected == 0 {
+		return ErrNextecSupportLinkNone
+	}
+	return nil
+}
+
+// nextecSupportLinkMatch associa links válidos baixados recentemente às máquinas novas que estão online agora.
+// Só associa quando a correspondência é inequívoca: pelo IP, exatamente um link e uma máquina livre com aquele IP
+// (duas máquinas atrás do mesmo NAT ficam pendentes); senão, pelo horário, exatamente um link e uma máquina livres
+// (matched_by = "time"). Link vencido ou cancelado nunca consome uma máquina.
+func nextecSupportLinkMatch() {
+	now := time.Now().Unix()
+	var links []model.NextecSupportLink
+	DB.Where("downloaded_at > ? AND peer_id = '' AND revoked = ? AND expires_at > ?", now-nextecSupportLinkWindow, false, now).
+		Order("downloaded_at asc").Find(&links)
+	if len(links) == 0 {
+		return
+	}
+	var peers []*model.Peer
+	DB.Where("group_id = 0 AND user_id = 0 AND last_online_time >= ?", now-nextecWaitingOnlineSecs).
+		Order("last_online_time desc").Limit(200).Find(&peers)
+	var taken []string
+	DB.Model(&model.NextecSupportLink{}).Where("peer_id <> ''").Pluck("peer_id", &taken)
+	used := map[string]bool{}
+	for _, id := range taken {
+		used[id] = true
+	}
+	free := make([]*model.Peer, 0, len(peers))
+	for _, p := range peers {
+		created := time.Time(p.CreatedAt)
+		if used[p.Id] || created.IsZero() || now-created.Unix() > int64(nextecWaitingMaxAge/time.Second) {
+			continue
+		}
+		free = append(free, p)
+	}
+	assigned := map[uint]bool{}
+	assign := func(link *model.NextecSupportLink, peer *model.Peer, how string) {
+		res := DB.Model(&model.NextecSupportLink{}).Where("id = ? AND peer_id = ''", link.Id).
+			Updates(map[string]interface{}{"peer_id": peer.Id, "matched_by": how})
+		if res.Error == nil && res.RowsAffected > 0 {
+			used[peer.Id] = true
+			assigned[link.Id] = true
+		}
+	}
+	createdAfter := func(p *model.Peer, l *model.NextecSupportLink) bool {
+		return time.Time(p.CreatedAt).Unix() >= l.DownloadedAt-60
+	}
+
+	// 1) pelo IP, só quando há um único link e uma única máquina livre com aquele IP
+	byIP := map[string][]*model.NextecSupportLink{}
+	for i := range links {
+		if links[i].DownloadIP != "" {
+			byIP[links[i].DownloadIP] = append(byIP[links[i].DownloadIP], &links[i])
+		}
+	}
+	for ip, group := range byIP {
+		if len(group) != 1 {
+			continue
+		}
+		var candidates []*model.Peer
+		for _, p := range free {
+			if !used[p.Id] && p.LastOnlineIp == ip && createdAfter(p, group[0]) {
+				candidates = append(candidates, p)
+			}
+		}
+		if len(candidates) == 1 {
+			assign(group[0], candidates[0], "ip")
+		}
+	}
+
+	// 2) pelo horário, só quando sobrou exatamente um link e exatamente uma máquina livre
+	var pendingLinks []*model.NextecSupportLink
+	for i := range links {
+		if !assigned[links[i].Id] {
+			pendingLinks = append(pendingLinks, &links[i])
+		}
+	}
+	if len(pendingLinks) != 1 {
+		return
+	}
+	var freePeers []*model.Peer
+	for _, p := range free {
+		if !used[p.Id] && createdAfter(p, pendingLinks[0]) {
+			freePeers = append(freePeers, p)
+		}
+	}
+	if len(freePeers) == 1 {
+		assign(pendingLinks[0], freePeers[0], "time")
+	}
+}
+
+// NextecSupportLinkView é o link como o painel mostra, com a máquina associada (quando já abriu o app).
+type NextecSupportLinkView struct {
+	model.NextecSupportLink
+	Status   string `json:"status"` // waiting | downloaded | connected | expired | revoked
+	PeerName string `json:"peer_name,omitempty"`
+	Online   bool   `json:"online"`
+}
+
+// NextecSupportLinkList lista os links recentes (do usuário; admin vê todos). withPeers é a política da fila
+// "Aguardando atendimento" (NextecWaitingAllowed): sem ela não se associa nem se expõe nenhuma máquina.
+func NextecSupportLinkList(owner string, withPeers bool) ([]NextecSupportLinkView, error) {
+	if err := supportLinksReady(); err != nil {
+		return nil, err
+	}
+	if withPeers {
+		nextecSupportLinkMatch()
+	}
+	var links []model.NextecSupportLink
+	q := DB.Order("id desc").Limit(nextecSupportLinkList)
+	if owner != "" {
+		q = q.Where("created_by = ?", owner)
+	}
+	if err := q.Find(&links).Error; err != nil {
+		return nil, err
+	}
+	now := time.Now().Unix()
+	peerByID := map[string]*model.Peer{}
+	if withPeers {
+		var ids []string
+		for _, l := range links {
+			if l.PeerId != "" {
+				ids = append(ids, l.PeerId)
+			}
+		}
+		if len(ids) > 0 {
+			var peers []*model.Peer
+			DB.Where("id IN ?", ids).Find(&peers)
+			for _, p := range peers {
+				peerByID[p.Id] = p
+			}
+		}
+	}
+	out := make([]NextecSupportLinkView, 0, len(links))
+	for _, l := range links {
+		if !withPeers {
+			l.PeerId, l.MatchedBy = "", ""
+		}
+		v := NextecSupportLinkView{NextecSupportLink: l}
+		switch {
+		case l.Revoked:
+			v.Status = "revoked"
+		case l.PeerId != "":
+			v.Status = "connected"
+		case l.ExpiresAt <= now:
+			v.Status = "expired"
+		case l.DownloadedAt > 0:
+			v.Status = "downloaded"
+		default:
+			v.Status = "waiting"
+		}
+		if p := peerByID[l.PeerId]; p != nil {
+			v.PeerName = p.Hostname
+			v.Online = p.LastOnlineTime >= now-nextecWaitingOnlineSecs
+		}
+		out = append(out, v)
+	}
+	return out, nil
+}
diff --git a/service/nextec_support_link_test.go b/service/nextec_support_link_test.go
new file mode 100644
index 0000000..29902b8
--- /dev/null
+++ b/service/nextec_support_link_test.go
@@ -0,0 +1,219 @@
+package service
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+)
+
+// supportTestPeer cria uma máquina nova, online agora, sem cliente nem dono (como a que acabou de abrir o app de suporte).
+func supportTestPeer(t *testing.T, db *gorm.DB, id, ip string) {
+	t.Helper()
+	p := &model.Peer{Id: id, Hostname: "PC-" + id, LastOnlineTime: time.Now().Unix(), LastOnlineIp: ip}
+	if err := db.Create(p).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Model(&model.Peer{}).Where("id = ?", id).UpdateColumn("created_at", time.Now()).Error; err != nil {
+		t.Fatal(err)
+	}
+}
