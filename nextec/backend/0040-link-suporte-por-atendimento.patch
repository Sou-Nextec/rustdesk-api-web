+)
+
+// NextecSupportLinkPublic: página pública de um link de suporte por atendimento (/s/<token>) e o download do app.
+type NextecSupportLinkPublic struct{}
+
+const supportLinkPageReady = `<p class="eyebrow">Atendimento remoto</p>
+<h1 id="titulo">Vamos atender você à distância</h1>
+<p class="who">Atendimento para <strong>{{WHO}}</strong></p>
+<a class="btn" href="/s/{{TOKEN}}/baixar" download>
+<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="M7 11l5 5 5-5"/><path d="M5 20h14"/></svg>
+Baixar aplicativo de suporte</a>
+<p class="meta">Para Windows 10 ou 11 &middot; {{SIZE}} &middot; Suporte-Nextec.exe</p>
+<h2>Como funciona</h2>
+<ol class="steps">
+<li><strong>Abra o arquivo baixado</strong><span>Procure Suporte-Nextec.exe na pasta Downloads e dê dois cliques.</span></li>
+<li><strong>Deixe a janela aberta</strong><span>A Nextec vê que o aplicativo abriu e pede a conexão sozinha.</span></li>
+<li><strong>Aceite a conexão</strong><span>Quando o técnico pedir, clique em Aceitar na janela do aplicativo.</span></li>
+</ol>
+<details>
+<summary>O Windows mostrou um aviso?</summary>
+<p>É normal para programas que não vêm da loja do Windows. Clique em <strong>Mais informações</strong> e depois em <strong>Executar assim mesmo</strong>.</p>
+</details>
+<div class="note">
+<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
+<div><strong>Você está no controle.</strong> Ninguém entra no seu computador sem você aceitar. Para encerrar o atendimento, feche o aplicativo.</div>
+</div>`
+
+const supportLinkPageGone = `<div class="empty">
+<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v6"/><path d="M12 16.5v.5"/></svg>
+<h1 id="titulo">Este link venceu ou foi cancelado</h1>
+<p class="lead">Peça um novo link ao técnico da Nextec que está atendendo você. Leva só um instante.</p>
+</div>`
+
+func supportLinkIP(c *gin.Context) string {
+	if ip := c.GetHeader("CF-Connecting-IP"); ip != "" {
+		return ip
+	}
+	return c.ClientIP()
+}
+
+func supportLinkRender(c *gin.Context, status int, body string) {
+	page := strings.NewReplacer("{{LOGO}}", supportLogo, "{{BODY}}", body).Replace(supportPageTpl)
+	c.Data(status, "text/html; charset=utf-8", []byte(page))
+}
+
+// Page GET /s/:token
+func (s *NextecSupportLinkPublic) Page(c *gin.Context) {
+	supportHeaders(c)
+	link := service.NextecSupportLinkByToken(c.Param("token"))
+	app := service.NextecSupportAppGet()
+	if link == nil || app == nil {
+		supportLinkRender(c, http.StatusNotFound, supportLinkPageGone)
+		return
+	}
+	body := strings.NewReplacer(
+		"{{WHO}}", html.EscapeString(link.Label),
+		"{{TOKEN}}", link.Token,
+		"{{SIZE}}", supportMB(app.Size),
+	).Replace(supportLinkPageReady)
+	supportLinkRender(c, http.StatusOK, body)
+}
+
+// Download GET /s/:token/baixar: registra o download (IP e hora) para associar a máquina que vai aparecer na fila.
+func (s *NextecSupportLinkPublic) Download(c *gin.Context) {
+	supportHeaders(c)
+	link := service.NextecSupportLinkByToken(c.Param("token"))
+	if link == nil || service.NextecSupportAppGet() == nil {
+		c.Status(http.StatusNotFound)
+		return
+	}
+	service.NextecSupportLinkMarkDownload(link.Id, supportLinkIP(c))
+	c.FileAttachment(service.NextecSupportPath(), service.NextecSupportDownload)
+}
