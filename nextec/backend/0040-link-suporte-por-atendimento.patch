+func TestSupportLinkCreateValidatesAndTokenIsPhoneFriendly(t *testing.T) {
+	securityDB(t)
+	if _, err := NextecSupportLinkCreate(nil, "  ", "", time.Hour); err != ErrNextecSupportLinkLabel {
+		t.Fatalf("label vazio: %v", err)
+	}
+	if _, err := NextecSupportLinkCreate(nil, "Cliente", "x y", time.Hour); err != ErrNextecSupportLinkTicket {
+		t.Fatalf("chamado invalido: %v", err)
+	}
+	l, err := NextecSupportLinkCreate(&model.User{Username: "ana"}, "Cartório Mariinha", "CBQ-REQ-6054", time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !nextecSupportLinkTokenRe.MatchString(l.Token) || strings.ContainsAny(l.Token, "01IO") {
+		t.Fatalf("token fora do padrao: %q", l.Token)
+	}
+	if got := NextecSupportLinkByToken(strings.ToLower(l.Token)); got == nil || got.Id != l.Id {
+		t.Fatal("token minusculo deveria resolver")
+	}
+	if NextecSupportLinkByToken("ZZZZZZZZ") != nil || NextecSupportLinkByToken("../etc") != nil {
+		t.Fatal("token inexistente ou invalido resolveu")
+	}
+	if l2, err := NextecSupportLinkCreate(nil, "X", "", 0); err != nil || l2.ExpiresAt-l2.CreatedAt != int64(nextecSupportLinkDefTTL/time.Second) {
+		t.Fatal("ttl zero deveria virar o padrao de 2 horas")
+	}
+	for _, bad := range []time.Duration{10 * time.Second, 30 * time.Minute, 25 * time.Hour, 72 * time.Hour} {
+		if _, err := NextecSupportLinkCreate(nil, "X", "", bad); err != ErrNextecSupportLinkTTL {
+			t.Fatalf("validade %v deveria ser recusada: %v", bad, err)
+		}
+	}
+	if l3, err := NextecSupportLinkCreate(nil, "X", "", 24*time.Hour); err != nil || l3 == nil {
+		t.Fatalf("24 horas deveria valer: %v", err)
+	}
+}
