+	if NextecInviteByCode(c.Code) != nil {
+		t.Fatal("link sem vagas ainda resolve")
+	}
+}
+
+func TestInviteBatchCreatesOneSingleUseInvitePerLineAllOrNothing(t *testing.T) {
+	enrollSetup(t)
+	base := inviteBase()
+	base.Alias, base.Label = "", ""
+	items := []NextecInviteBatchItem{{Label: "Mesa 1", Alias: "PC-01"}, {Label: "Mesa 2", Alias: "PC-02"}}
+	out, err := NextecInviteCreateBatch(nil, base, items)
+	if err != nil || len(out) != 2 || out[0].Code == out[1].Code || out[0].Invite.MaxUses != 1 {
+		t.Fatalf("lote: %#v err=%v", out, err)
+	}
+	if _, err := NextecInviteCreateBatch(nil, base, []NextecInviteBatchItem{{Label: "Ok"}, {Label: ""}}); err == nil || !strings.Contains(err.Error(), "linha 2") {
+		t.Fatalf("linha invalida deveria falhar o lote: %v", err)
+	}
+	views, _ := NextecInviteList()
+	if len(views) != 2 {
+		t.Fatalf("lote falho nao deveria deixar convites: %d", len(views))
+	}
+	if _, err := NextecInviteCreateBatch(nil, base, nil); err != ErrNextecInviteBatch {
+		t.Fatalf("lote vazio: %v", err)
+	}
+}
+
+func TestInviteListPurgesLongExpired(t *testing.T) {
+	db := enrollSetup(t)
+	c, _ := NextecInviteCreate(nil, inviteBase())
+	db.Model(&model.NextecInstallInvite{}).Where("id = ?", c.Invite.Id).Update("expires_at", time.Now().Unix()-nextecInviteKeepExpired-10)
+	keep, _ := NextecInviteCreate(nil, inviteBase())
+	db.Model(&model.NextecInstallInvite{}).Where("id = ?", keep.Invite.Id).Update("expires_at", time.Now().Unix()-3600)
+	views, err := NextecInviteList()
+	if err != nil || len(views) != 1 || views[0].Id != keep.Invite.Id || views[0].Status != "expired" || views[0].Code != "" {
+		t.Fatalf("purga: %#v err=%v", views, err)
+	}
+}
