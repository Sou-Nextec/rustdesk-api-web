+package api
+
+import (
+	"errors"
+	"net/http"
+	"strconv"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+)
+
+type inviteClaimForm struct {
+	Id    string `json:"id"`
+	Token string `json:"token"`
+	Code  string `json:"code"`
+}
+
+// InviteClaim POST /api/nextec/agent/invite {id, token, code}
+// O agente já inscrito apresenta o código do convite (vindo do nome do MSI); a máquina é atribuída ao cliente do convite.
+func (a *NextecAgent) InviteClaim(c *gin.Context) {
+	f := &inviteClaimForm{}
+	if err := c.ShouldBindJSON(f); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "bad_request"})
+		return
+	}
+	res, err := service.NextecInviteClaim(agentIP(c), f.Id, f.Token, f.Code)
+	if err != nil {
+		switch {
+		case errors.Is(err, service.ErrNextecInviteInvalid):
+			c.JSON(http.StatusForbidden, gin.H{"error": "invite_invalid"})
+		case errors.Is(err, service.ErrNextecClientConflict):
+			c.JSON(http.StatusConflict, gin.H{"error": "client_conflict"})
+		case errors.Is(err, service.ErrNextecIdentityConflict):
+			c.JSON(http.StatusConflict, gin.H{"error": "identity_conflict"})
+		case errors.Is(err, service.ErrNextecTooManyFails):
+			c.JSON(http.StatusTooManyRequests, gin.H{"error": "too_many_failures"})
+		case errors.Is(err, service.ErrNextecRateLimited):
+			// limite por máquina (compartilhado com os outros endpoints do agente): 429 com Retry-After, não é erro interno
+			c.Header("Retry-After", strconv.Itoa(service.NextecRetryAfterSeconds(err)))
+			c.JSON(http.StatusTooManyRequests, gin.H{"error": "rate_limited"})
+		case errors.Is(err, service.ErrNextecBadAgentAuth):
+			c.JSON(http.StatusUnauthorized, gin.H{"error": "unauthorized"})
+		default:
+			c.JSON(http.StatusInternalServerError, gin.H{"error": "internal_error"})
+		}
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"state": res.State, "client_id": res.ClientID, "managed": res.Managed, "interval_minutes": res.Interval})
+}
