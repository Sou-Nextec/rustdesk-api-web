+package model
+
+// NextecInstallInvite é um convite de instalação: o MSI baixado pelo link /i/<código> (ou instalado pelo comando
+// PowerShell) leva o código no nome do arquivo; o agente o apresenta na inscrição e a máquina já nasce no cliente certo,
+// com apelido e regra de senha. O código nunca é guardado em claro para busca (só o hash); a cópia cifrada serve para
+// o administrador copiar o link de novo.
+type NextecInstallInvite struct {
+	Id        uint   `json:"id" gorm:"primaryKey"`
+	CodeHash  string `json:"-" gorm:"size:64;uniqueIndex;not null"`
+	CodeEnc   string `json:"-" gorm:"size:512"`
+	Hint      string `json:"hint" gorm:"size:4"`
+	Label     string `json:"label" gorm:"size:120;not null"`
+	Alias     string `json:"alias" gorm:"size:64"`
+	ClientId  uint   `json:"client_id" gorm:"index"`
+	Kind      string `json:"kind" gorm:"size:12"`
+	Rule      string `json:"rule" gorm:"size:8"`
+	Interval  int    `json:"interval_minutes"`
+	Mode      string `json:"mode" gorm:"size:8"`
+	Version   string `json:"version" gorm:"size:32"` // versão do MSI fixada no convite (a publicada para todos na criação)
+	MaxUses   int    `json:"max_uses"`
+	Uses      int    `json:"uses"`
+	ExpiresAt int64  `json:"expires_at" gorm:"index"`
+	Revoked   bool   `json:"revoked"`
+	CreatedBy string `json:"created_by" gorm:"size:64"`
+	CreatedAt int64  `json:"created_at"`
+}
+
+// NextecInstallInviteUse registra cada máquina que consumiu um convite.
+type NextecInstallInviteUse struct {
+	Id       uint   `json:"id" gorm:"primaryKey"`
+	InviteId uint   `json:"invite_id" gorm:"uniqueIndex:ux_nextec_invite_peer"`
+	PeerId   string `json:"peer_id" gorm:"size:64;uniqueIndex:ux_nextec_invite_peer"`
+	At       int64  `json:"at"`
+	Ip       string `json:"ip" gorm:"size:64"`
+}
diff --git a/service/nextec_install_invite.go b/service/nextec_install_invite.go
new file mode 100644
index 0000000..390a369
--- /dev/null
+++ b/service/nextec_install_invite.go
@@ -0,0 +1,467 @@
+package service
+
+import (
+	"crypto/rand"
+	"errors"
+	"fmt"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// Convites de instalação (Nextec). O administrador cria o convite (cliente, apelido, tipo, regra de senha, validade, usos);
+// o MSI do convite leva o código no nome do arquivo e o agente o apresenta na inscrição. Atribuição sem palpite: o código é
+// o que prova de qual convite a máquina veio.
+
+const (
+	nextecInviteCodeLen     = 20
+	nextecInviteMinTTL      = 1 * time.Hour
+	nextecInviteMaxTTL      = 7 * 24 * time.Hour
+	nextecInviteDefTTL      = 24 * time.Hour
+	nextecInviteMaxUses     = 100
+	nextecInviteBatchMax    = 200
+	nextecInviteKeepExpired = int64(7 * 24 * 3600) // vencido some da lista depois de 7 dias
+	nextecInviteListLimit   = 200
+)
+
+var (
+	ErrNextecInviteInvalid = errors.New("Convite inválido, vencido, cancelado ou já usado.")
+	ErrNextecInviteLabel   = errors.New("Informe o cliente ou a descrição do convite (até 120 caracteres).")
+	ErrNextecInviteAlias   = errors.New("Apelido inválido. Use letras, números, espaço, ponto, hífen ou sublinhado (até 64 caracteres).")
+	ErrNextecInviteClient  = errors.New("Escolha um cliente existente.")
+	ErrNextecInviteKind    = errors.New("Tipo inválido. Use servidor ou estação.")
+	ErrNextecInviteMode    = errors.New("Uso inválido. Escolha uso único ou link do cliente.")
+	ErrNextecInviteUses    = errors.New("Limite de usos inválido (1 a 100).")
+	ErrNextecInviteTTL     = errors.New("A validade deve ficar entre 1 hora e 7 dias.")
+	ErrNextecInviteBatch   = errors.New("Informe de 1 a 200 itens no lote.")
+	ErrNextecInviteNone    = errors.New("Convite não encontrado.")
+	ErrNextecInviteRelease = errors.New("Nenhuma versão está publicada para todos. Publique uma versão em Atualizações do app antes de criar convites.")
+
+	nextecInviteCodeRe  = regexp.MustCompile("^[A-HJ-NP-Z2-9]{20}$")
+	nextecInviteAliasRe = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9 ._-]{0,63}$`)
+
+	invitesMu       sync.Mutex
+	invitesMigrated *gorm.DB
+)
+
+func invitesReady() error {
+	invitesMu.Lock()
+	defer invitesMu.Unlock()
+	if invitesMigrated == DB {
+		return nil
+	}
+	if err := DB.AutoMigrate(&model.NextecInstallInvite{}, &model.NextecInstallInviteUse{}); err != nil {
+		return err
+	}
+	invitesMigrated = DB
+	return nil
+}
+
+func nextecInviteNewCode() (string, error) {
+	raw := make([]byte, nextecInviteCodeLen)
+	if _, err := rand.Read(raw); err != nil {
+		return "", err
+	}
+	out := make([]byte, nextecInviteCodeLen)
+	for i, b := range raw {
+		out[i] = nextecSupportLinkAlphabet[int(b)%len(nextecSupportLinkAlphabet)]
+	}
+	return string(out), nil
+}
+
+// NextecInviteInput são os campos escolhidos ao criar um convite. TTL zero vale 24 horas.
+type NextecInviteInput struct {
+	Label        string
+	Alias        string
+	ClientID     uint
+	Kind         string // server | workstation
+	AutoPassword bool
+	Interval     int // minutos; 0 vale o padrão do cofre
+	Mode         string // single | client
+	MaxUses      int
+	TTL          time.Duration
+	Version      string // versão publicada para todos que o convite entrega (fixada na criação)
+}
+
+// NextecInviteCreated devolve o convite e o código em claro (mostrado ao administrador; depois só pela cópia cifrada).
+type NextecInviteCreated struct {
+	Invite *model.NextecInstallInvite
+	Code   string
+}
+
+func nextecInviteValidate(in *NextecInviteInput) error {
+	in.Label = strings.TrimSpace(in.Label)
+	in.Alias = strings.TrimSpace(in.Alias)
+	in.Version = strings.TrimSpace(in.Version)
+	if in.Version == "" || len(in.Version) > 32 {
+		return ErrNextecInviteRelease
+	}
+	if in.Label == "" || len([]rune(in.Label)) > 120 {
+		return ErrNextecInviteLabel
+	}
+	if in.Alias != "" && !nextecInviteAliasRe.MatchString(in.Alias) {
+		return ErrNextecInviteAlias
+	}
+	if in.Kind == "" {
+		in.Kind = "workstation"
+	}
+	if in.Kind != "server" && in.Kind != "workstation" {
+		return ErrNextecInviteKind
+	}
+	if in.Mode == "" {
+		in.Mode = "single"
+	}
+	if in.Mode != "single" && in.Mode != "client" {
+		return ErrNextecInviteMode
+	}
+	if in.Mode == "single" {
+		in.MaxUses = 1
+	} else {
+		if in.MaxUses == 0 {
+			in.MaxUses = 10
+		}
+		if in.MaxUses < 1 || in.MaxUses > nextecInviteMaxUses {
+			return ErrNextecInviteUses
+		}
+	}
+	if in.TTL == 0 {
+		in.TTL = nextecInviteDefTTL
+	}
+	if in.TTL < nextecInviteMinTTL || in.TTL > nextecInviteMaxTTL {
+		return ErrNextecInviteTTL
+	}
+	if in.AutoPassword {
+		if in.Interval == 0 {
+			in.Interval = NextecSecretDefaultInterval
+		}
+		if in.Interval < NextecSecretMinInterval || in.Interval > NextecSecretMaxInterval {
+			return ErrNextecBadInterval
+		}
+	} else {
+		in.Interval = 0
+	}
+	return nil
+}
+
+func nextecInviteCreateTx(tx *gorm.DB, creator string, in NextecInviteInput) (*NextecInviteCreated, error) {
+	var group model.DeviceGroup
+	if in.ClientID == 0 || tx.First(&group, in.ClientID).Error != nil || group.Id == 0 {
+		return nil, ErrNextecInviteClient
+	}
+	rule := "none"
+	if in.AutoPassword {
+		rule = "peer"
+	}
+	now := time.Now()
+	for attempt := 0; attempt < 5; attempt++ {
+		code, err := nextecInviteNewCode()
+		if err != nil {
+			return nil, err
+		}
+		enc, err := vaultEncrypt(code)
+		if err != nil {
+			return nil, err
+		}
+		inv := &model.NextecInstallInvite{
+			CodeHash: sha256Hex(code), CodeEnc: enc, Hint: code[len(code)-4:], Label: in.Label, Alias: in.Alias,
+			ClientId: in.ClientID, Kind: in.Kind, Rule: rule, Interval: in.Interval, Mode: in.Mode, MaxUses: in.MaxUses, Version: in.Version,
+			ExpiresAt: now.Add(in.TTL).Unix(), CreatedBy: creator, CreatedAt: now.Unix(),
+		}
+		if err := tx.Create(inv).Error; err == nil {
+			return &NextecInviteCreated{Invite: inv, Code: code}, nil
+		}
+	}
+	return nil, errors.New("Não foi possível gerar o convite. Tente de novo.")
+}
+
+// NextecInviteCreate cria um convite.
+func NextecInviteCreate(u *model.User, in NextecInviteInput) (*NextecInviteCreated, error) {
+	if err := nextecInviteValidate(&in); err != nil {
+		return nil, err
+	}
+	if err := invitesReady(); err != nil {
+		return nil, err
+	}
+	creator := ""
+	if u != nil {
+		creator = u.Username
+	}
+	return nextecInviteCreateTx(DB, creator, in)
+}
+
+// NextecInviteBatchItem é uma linha do lote: descrição e apelido próprios; o resto vem do modelo comum.
+type NextecInviteBatchItem struct {
+	Label string
+	Alias string
+}
+
+// NextecInviteCreateBatch cria um convite de uso único por linha, tudo ou nada.
+func NextecInviteCreateBatch(u *model.User, base NextecInviteInput, items []NextecInviteBatchItem) ([]*NextecInviteCreated, error) {
+	if len(items) == 0 || len(items) > nextecInviteBatchMax {
+		return nil, ErrNextecInviteBatch
+	}
+	if err := invitesReady(); err != nil {
+		return nil, err
+	}
+	creator := ""
+	if u != nil {
+		creator = u.Username
+	}
+	out := make([]*NextecInviteCreated, 0, len(items))
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		for i, it := range items {
+			in := base
+			in.Label, in.Alias = it.Label, it.Alias
+			in.Mode, in.MaxUses = "single", 1
+			if err := nextecInviteValidate(&in); err != nil {
+				return fmt.Errorf("linha %d: %w", i+1, err)
+			}
+			created, err := nextecInviteCreateTx(tx, creator, in)
+			if err != nil {
+				return fmt.Errorf("linha %d: %w", i+1, err)
+			}
+			out = append(out, created)
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+// NextecInviteByCode devolve o convite só se estiver válido (existe, não cancelado, não vencido e com vaga).
+func NextecInviteByCode(code string) *model.NextecInstallInvite {
+	code = strings.ToUpper(strings.TrimSpace(code))
+	if !nextecInviteCodeRe.MatchString(code) || invitesReady() != nil {
+		return nil
+	}
+	inv := &model.NextecInstallInvite{}
+	if DB.Where("code_hash = ?", sha256Hex(code)).First(inv).Error != nil {
+		return nil
+	}
+	if inv.Revoked || inv.ExpiresAt <= time.Now().Unix() || inv.Uses >= inv.MaxUses {
+		return nil
+	}
+	return inv
+}
+
+// NextecInviteRevoke cancela o convite.
+func NextecInviteRevoke(id uint) error {
+	if err := invitesReady(); err != nil {
+		return err
+	}
+	res := DB.Model(&model.NextecInstallInvite{}).Where("id = ?", id).Update("revoked", true)
+	if res.Error != nil {
+		return res.Error
+	}
+	if res.RowsAffected == 0 {
+		return ErrNextecInviteNone
+	}
+	return nil
+}
+
+// NextecInviteView é o convite como o painel mostra.
+type NextecInviteView struct {
+	model.NextecInstallInvite
+	Code       string   `json:"code"`
+	ClientName string   `json:"client_name"`
+	Status     string   `json:"status"` // active | used | expired | revoked
+	PeerIds    []string `json:"peer_ids"`
+	// Release é o MSI fixado no convite: o hash do comando copiado é o dele, mesmo que outra versão seja publicada depois.
+	Release *NextecInviteReleaseInfo `json:"release"`
+}
+
+// NextecInviteReleaseInfo descreve o MSI de um convite (nunca o caminho no disco).
+type NextecInviteReleaseInfo struct {
+	Version  string `json:"version"`
+	FileName string `json:"file_name"`
+	Sha256   string `json:"sha256"`
+	Size     int64  `json:"size"`
+}
+
+// NextecInviteReleaseInfoOf resume uma versão; nil se não há.
+func NextecInviteReleaseInfoOf(r *model.NextecAppRelease) *NextecInviteReleaseInfo {
+	if r == nil {
+		return nil
+	}
+	return &NextecInviteReleaseInfo{Version: r.Version, FileName: r.FileName, Sha256: r.Sha256, Size: r.Size}
+}
+
+// NextecInviteList lista os convites (vencidos há mais de 7 dias são apagados). O código vem da cópia cifrada.
+func NextecInviteList() ([]NextecInviteView, error) {
+	if err := invitesReady(); err != nil {
+		return nil, err
+	}
+	now := time.Now().Unix()
+	cutoff := now - nextecInviteKeepExpired
+	var old []uint
+	DB.Model(&model.NextecInstallInvite{}).Where("expires_at < ?", cutoff).Pluck("id", &old)
+	if len(old) > 0 {
+		DB.Where("invite_id IN ?", old).Delete(&model.NextecInstallInviteUse{})
+		DB.Where("id IN ?", old).Delete(&model.NextecInstallInvite{})
+	}
+	var invites []model.NextecInstallInvite
+	if err := DB.Order("id desc").Limit(nextecInviteListLimit).Find(&invites).Error; err != nil {
+		return nil, err
+	}
+	ids := make([]uint, 0, len(invites))
+	clientIDs := make([]uint, 0, len(invites))
+	for _, inv := range invites {
+		ids = append(ids, inv.Id)
+		clientIDs = append(clientIDs, inv.ClientId)
+	}
+	usesBy := map[uint][]string{}
+	if len(ids) > 0 {
+		var uses []model.NextecInstallInviteUse
+		DB.Where("invite_id IN ?", ids).Order("id asc").Find(&uses)
+		for _, u := range uses {
+			usesBy[u.InviteId] = append(usesBy[u.InviteId], u.PeerId)
+		}
+	}
+	names := map[uint]string{}
+	if len(clientIDs) > 0 {
+		var groups []model.DeviceGroup
+		DB.Where("id IN ?", clientIDs).Find(&groups)
+		for _, g := range groups {
+			names[g.Id] = g.Name
+		}
+	}
+	out := make([]NextecInviteView, 0, len(invites))
+	releases := map[string]*NextecInviteReleaseInfo{}
+	for _, inv := range invites {
+		v := NextecInviteView{NextecInstallInvite: inv, ClientName: names[inv.ClientId], PeerIds: usesBy[inv.Id]}
+		if _, ok := releases[inv.Version]; !ok {
+			ref := inv
+			releases[inv.Version] = NextecInviteReleaseInfoOf(NextecInviteReleaseOf(&ref))
+		}
+		v.Release = releases[inv.Version]
+		if v.PeerIds == nil {
+			v.PeerIds = []string{}
+		}
+		switch {
+		case inv.Revoked:
+			v.Status = "revoked"
+		case inv.ExpiresAt <= now:
+			v.Status = "expired"
+		case inv.Uses >= inv.MaxUses:
+			v.Status = "used"
+		default:
+			v.Status = "active"
+		}
+		if v.Status == "active" && inv.CodeEnc != "" {
+			if code, err := vaultDecrypt(inv.CodeEnc); err == nil {
+				v.Code = code
+			}
+		}
+		v.CodeEnc = ""
+		out = append(out, v)
+	}
+	return out, nil
+}
+
+// nextecInviteRolloutOK: só a versão publicada para TODOS vira convite; piloto e desligado nunca chegam a um cliente avulso.
+func nextecInviteRolloutOK(ro NextecRollout) bool {
+	return ro.Mode == NextecRolloutAll && ro.Version != ""
+}
+
+// NextecInviteRelease é a versão que um convite NOVO entrega: a publicada para todos (padrão). Nil se não há.
+func NextecInviteRelease() *model.NextecAppRelease {
+	ro := NextecRolloutGet()
+	if !nextecInviteRolloutOK(ro) {
+		return nil
+	}
+	return NextecReleaseByVersion(ro.Version)
+}
+
+// NextecInviteReleaseOf é a versão fixada no convite: o link e o comando copiado entregam sempre o mesmo MSI.
+func NextecInviteReleaseOf(inv *model.NextecInstallInvite) *model.NextecAppRelease {
+	if inv == nil || inv.Version == "" {
+		return nil
+	}
+	return NextecReleaseByVersion(inv.Version)
+}
+
+// NextecInviteClaim: o agente, já inscrito (com o token dele), apresenta o código do convite. A máquina é atribuída ao
+// cliente do convite com a regra de senha escolhida e recebe o apelido. Repetir com a mesma máquina é idempotente; uma
+// vaga só é gasta quando a atribuição dá certo.
+func NextecInviteClaim(ip, peerID, token, code string) (*NextecAssignResult, error) {
+	if _, err := agentAuth(ip, peerID, token); err != nil {
+		return nil, err
+	}
+	code = strings.ToUpper(strings.TrimSpace(code))
+	if !nextecInviteCodeRe.MatchString(code) {
+		nextecFailAdd(ip)
+		return nil, ErrNextecInviteInvalid
+	}
+	if err := invitesReady(); err != nil {
+		return nil, err
+	}
+	var inv model.NextecInstallInvite
+	if DB.Where("code_hash = ?", sha256Hex(code)).First(&inv).Error != nil {
+		nextecFailAdd(ip)
+		return nil, ErrNextecInviteInvalid
+	}
+	now := time.Now().Unix()
+	if inv.Revoked || inv.ExpiresAt <= now {
+		return nil, ErrNextecInviteInvalid
+	}
+	assign := func() (*NextecAssignResult, error) {
+		return NextecEnrollAssign(NextecAssignOptions{
+			PeerID: peerID, ClientID: inv.ClientId, Rule: inv.Rule, Interval: inv.Interval, IP: nextecBootstrapAuditIP(ip),
+			Username: "convite " + inv.Hint,
+		})
+	}
+	// A vaga é gasta de forma atômica: o registro de uso (único por convite e máquina) e o contador andam na mesma
+	// transação. Uma repetição da mesma máquina, mesmo simultânea, cai no conflito e não gasta outra vaga.
+	use := &model.NextecInstallInviteUse{InviteId: inv.Id, PeerId: peerID, At: now, Ip: nextecBootstrapAuditIP(ip)}
+	already := false
+	if err := DB.Transaction(func(tx *gorm.DB) error {
+		ins := tx.Clauses(clause.OnConflict{DoNothing: true}).Create(use)
+		if ins.Error != nil {
+			return ins.Error
+		}
+		if ins.RowsAffected == 0 {
+			already = true
+			return nil
+		}
+		res := tx.Model(&model.NextecInstallInvite{}).
+			Where("id = ? AND uses < max_uses AND revoked = ? AND expires_at > ?", inv.Id, false, now).
+			UpdateColumn("uses", gorm.Expr("uses + 1"))
+		if res.Error != nil {
+			return res.Error
+		}
+		if res.RowsAffected == 0 {
+			return ErrNextecInviteInvalid
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	if already {
+		return assign()
+	}
+	out, err := assign()
+	if err != nil {
+		// atribuição falhou: devolve a vaga (e o registro de uso) para a máquina poder tentar de novo
+		DB.Delete(&model.NextecInstallInviteUse{}, use.Id)
+		DB.Model(&model.NextecInstallInvite{}).Where("id = ? AND uses > 0", inv.Id).UpdateColumn("uses", gorm.Expr("uses - 1"))
+		return nil, err
+	}
+	if inv.Alias != "" {
+		alias := inv.Alias
+		if inv.MaxUses > 1 {
+			var n int64
+			DB.Model(&model.NextecInstallInviteUse{}).Where("invite_id = ?", inv.Id).Count(&n)
+			alias = fmt.Sprintf("%s %d", inv.Alias, n)
+		}
+		DB.Model(&model.Peer{}).Where("id = ? AND (alias = '' OR alias IS NULL)", peerID).Update("alias", alias)
+	}
+	NextecSecretAuditAdd(nil, peerID, "invite_claim", nextecBootstrapAuditIP(ip), fmt.Sprintf("convite %s cliente %d", inv.Hint, inv.ClientId))
+	return out, nil
+}
