+<div>Este link vale até <strong>{{UNTIL}}</strong> e foi feito para esta instalação. Não o compartilhe.</div>
+</div>`
+
+const supportInvitePageGone = `<div class="empty">
+<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v6"/><path d="M12 16.5v.5"/></svg>
+<h1 id="titulo">Este link de instalação não está disponível</h1>
+<p class="lead">Ele venceu, foi cancelado ou já foi usado. Peça um novo link a quem enviou este.</p>
+</div>`
+
+func supportInviteRender(c *gin.Context, status int, body string) {
+	page := strings.NewReplacer("{{LOGO}}", supportLogo, "{{BODY}}", body).Replace(supportPageTpl)
+	c.Data(status, "text/html; charset=utf-8", []byte(page))
+}
+
+// Page GET /i/:code
+func (s *NextecInvitePublic) Page(c *gin.Context) {
+	supportHeaders(c)
+	code := strings.ToUpper(strings.TrimSpace(c.Param("code")))
+	inv := service.NextecInviteByCode(code)
+	rel := service.NextecInviteReleaseOf(inv)
+	if inv == nil || rel == nil {
+		supportInviteRender(c, http.StatusNotFound, supportInvitePageGone)
+		return
+	}
+	body := strings.NewReplacer(
+		"{{WHO}}", html.EscapeString(inv.Label),
+		"{{CODE}}", code,
+		"{{VERSION}}", html.EscapeString(rel.Version),
+		"{{SIZE}}", supportMB(rel.Size),
+		"{{UNTIL}}", time.Unix(inv.ExpiresAt, 0).Format("02/01/2006 15:04"),
+	).Replace(supportInvitePageReady)
+	supportInviteRender(c, http.StatusOK, body)
+}
+
+// Download GET /i/:code/baixar
+func (s *NextecInvitePublic) Download(c *gin.Context) {
+	supportHeaders(c)
+	code := strings.ToUpper(strings.TrimSpace(c.Param("code")))
+	inv := service.NextecInviteByCode(code)
+	rel := service.NextecInviteReleaseOf(inv)
+	if inv == nil || rel == nil {
+		c.Status(http.StatusNotFound)
+		return
+	}
+	base := strings.TrimSuffix(rel.FileName, filepath.Ext(rel.FileName))
+	c.FileAttachment(service.NextecReleasePath(rel), base+"-"+code+".msi")
+}
