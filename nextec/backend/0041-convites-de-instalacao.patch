+package admin
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/http/response"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+)
+
+// NextecInvites: convites de instalação (somente admin): criar, listar, cancelar e criar em lote.
+type NextecInvites struct{}
+
+type nextecInviteForm struct {
+	Label        string `json:"label"`
+	Alias        string `json:"alias"`
+	ClientId     uint   `json:"client_id"`
+	Kind         string `json:"kind"`
+	AutoPassword bool   `json:"auto_password"`
+	Interval     int    `json:"interval_minutes"`
+	Mode         string `json:"mode"`
+	MaxUses      int    `json:"max_uses"`
+	Hours        int    `json:"hours"`
+}
+
+type nextecInviteBatchForm struct {
+	nextecInviteForm
+	Items []struct {
+		Label string `json:"label"`
+		Alias string `json:"alias"`
+	} `json:"items"`
+}
+
+type nextecInviteRevokeForm struct {
+	Id uint `json:"id" binding:"required"`
+}
+
+func (f nextecInviteForm) input() service.NextecInviteInput {
+	return service.NextecInviteInput{
+		Label: f.Label, Alias: f.Alias, ClientID: f.ClientId, Kind: f.Kind, AutoPassword: f.AutoPassword, Interval: f.Interval,
+		Mode: f.Mode, MaxUses: f.MaxUses, TTL: time.Duration(f.Hours) * time.Hour,
+	}
+}
+
+func nextecInviteRelease() gin.H {
+	r := service.NextecInviteRelease()
+	if r == nil {
+		return nil
+	}
+	return gin.H{"version": r.Version, "file_name": r.FileName, "sha256": r.Sha256, "size": r.Size}
+}
+
+// List devolve os convites e a versão do MSI que eles entregam
+// @Router /admin/nextec/invites [get]
+func (n *NextecInvites) List(c *gin.Context) {
+	list, err := service.NextecInviteList()
+	if err != nil {
+		response.Fail(c, 101, "Não foi possível listar os convites.")
+		return
+	}
+	response.Success(c, &gin.H{"list": list, "release": nextecInviteRelease()})
+}
+
+// Create cria um convite
+// @Router /admin/nextec/invites [post]
+func (n *NextecInvites) Create(c *gin.Context) {
+	var f nextecInviteForm
+	if err := c.ShouldBindJSON(&f); err != nil {
+		response.Fail(c, 101, response.TranslateMsg(c, "ParamsError"))
+		return
+	}
+	rel := service.NextecInviteRelease()
+	if rel == nil {
+		response.Fail(c, 101, service.ErrNextecInviteRelease.Error())
+		return
+	}
+	u := service.AllService.UserService.CurUser(c)
+	in := f.input()
+	in.Version = rel.Version
+	created, err := service.NextecInviteCreate(u, in)
+	if err != nil {
+		response.Fail(c, 101, err.Error())
+		return
+	}
+	service.NextecSecretAuditAdd(u, "", "invite_create", nextecIP(c), fmt.Sprintf("%s cliente %d", created.Invite.Hint, created.Invite.ClientId))
+	response.Success(c, &gin.H{"invite": created.Invite, "code": created.Code, "release": service.NextecInviteReleaseInfoOf(rel)})
+}
+
+// Batch cria um convite de uso único por linha
+// @Router /admin/nextec/invites/batch [post]
+func (n *NextecInvites) Batch(c *gin.Context) {
+	var f nextecInviteBatchForm
+	if err := c.ShouldBindJSON(&f); err != nil {
+		response.Fail(c, 101, response.TranslateMsg(c, "ParamsError"))
+		return
+	}
+	rel := service.NextecInviteRelease()
+	if rel == nil {
+		response.Fail(c, 101, service.ErrNextecInviteRelease.Error())
+		return
+	}
+	items := make([]service.NextecInviteBatchItem, 0, len(f.Items))
+	for _, it := range f.Items {
+		items = append(items, service.NextecInviteBatchItem{Label: it.Label, Alias: it.Alias})
+	}
+	u := service.AllService.UserService.CurUser(c)
+	in := f.input()
+	in.Version = rel.Version
+	created, err := service.NextecInviteCreateBatch(u, in, items)
+	if err != nil {
+		response.Fail(c, 101, err.Error())
+		return
+	}
+	out := make([]gin.H, 0, len(created))
+	for _, cr := range created {
+		out = append(out, gin.H{"invite": cr.Invite, "code": cr.Code})
+	}
+	service.NextecSecretAuditAdd(u, "", "invite_batch", nextecIP(c), fmt.Sprintf("%d convites cliente %d", len(out), f.ClientId))
+	response.Success(c, &gin.H{"list": out, "release": service.NextecInviteReleaseInfoOf(rel)})
+}
+
+// Revoke cancela um convite
+// @Router /admin/nextec/invites/revoke [post]
+func (n *NextecInvites) Revoke(c *gin.Context) {
+	var f nextecInviteRevokeForm
+	if err := c.ShouldBindJSON(&f); err != nil {
+		response.Fail(c, 101, response.TranslateMsg(c, "ParamsError"))
+		return
+	}
+	if err := service.NextecInviteRevoke(f.Id); err != nil {
+		response.Fail(c, 101, err.Error())
+		return
+	}
+	service.NextecSecretAuditAdd(service.AllService.UserService.CurUser(c), "", "invite_revoke", nextecIP(c), fmt.Sprintf("%d", f.Id))
+	response.Success(c, nil)
+}
