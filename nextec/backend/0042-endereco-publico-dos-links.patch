+package admin
+
+import (
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/http/response"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+)
+
+type nextecPublicURLForm struct {
+	PublicURL string `json:"public_url"`
+}
+
+// PublicURL define o endereço público dos links de instalador e atendimento (vazio = endereço do painel)
+// @Router /admin/nextec/support/public-url [post]
+func (n *NextecSupport) PublicURL(c *gin.Context) {
+	f := &nextecPublicURLForm{}
+	if err := c.ShouldBindJSON(f); err != nil {
+		response.Fail(c, 101, response.TranslateMsg(c, "ParamsError"))
+		return
+	}
+	value, err := service.NextecSupportPublicURLSet(f.PublicURL)
+	if err != nil {
+		response.Fail(c, 101, err.Error())
+		return
+	}
+	service.NextecSecretAuditAdd(service.AllService.UserService.CurUser(c), "", "support_public_url", nextecIP(c), value)
+	response.Success(c, &gin.H{"public_url": value})
+}
diff --git a/service/nextec_support_public_url.go b/service/nextec_support_public_url.go
new file mode 100644
index 0000000..e4c0875
--- /dev/null
+++ b/service/nextec_support_public_url.go
@@ -0,0 +1,64 @@
+package service
+
+import (
+	"errors"
+	"net/url"
+	"regexp"
+	"strings"
+
+	"github.com/lejianwen/rustdesk-api/v2/global"
+)
+
+// Endereço público dos links de instalador (/instalador/<código>) e de atendimento (/atendimento/<código>).
+// O administrador define o domínio no painel (ex.: https://suporte.nex.tec.br); vazio = o endereço em que o painel foi aberto.
+// Só o domínio é configurável: os caminhos são fixos, para o proxy poder repassar apenas esses prefixos ao painel.
+
+const settingSupportPublicURL = "support_public_url"
+
+var (
+	ErrNextecPublicURL = errors.New("Endereço inválido. Use https://dominio, sem porta, caminho ou parâmetros (ex.: https://suporte.empresa.com.br).")
+
+	nextecPublicHostRe = regexp.MustCompile(`^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$`)
+)
+
+// NextecPublicURLNormalize valida e normaliza o endereço público. Vazio é válido (usa o endereço do painel).
+func NextecPublicURLNormalize(raw string) (string, error) {
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return "", nil
+	}
+	if len(raw) > 200 {
+		return "", ErrNextecPublicURL
+	}
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme != "https" || u.Opaque != "" || u.User != nil || u.RawQuery != "" || u.ForceQuery || u.Fragment != "" ||
+		(u.Path != "" && u.Path != "/") || u.Port() != "" {
+		return "", ErrNextecPublicURL
+	}
+	host := strings.ToLower(u.Hostname())
+	if len(host) > 253 || !nextecPublicHostRe.MatchString(host) {
+		return "", ErrNextecPublicURL
+	}
+	return "https://" + host, nil
+}
+
+// NextecSupportPublicURL devolve o endereço público configurado ("" = usar o endereço em que o painel foi aberto).
+func NextecSupportPublicURL() string {
+	v, err := NextecPublicURLNormalize(global.NextecSettingGet(settingSupportPublicURL))
+	if err != nil {
+		return ""
+	}
+	return v
+}
+
+// NextecSupportPublicURLSet grava o endereço público (vazio limpa) e devolve o valor normalizado.
+func NextecSupportPublicURLSet(raw string) (string, error) {
+	v, err := NextecPublicURLNormalize(raw)
+	if err != nil {
+		return "", err
+	}
+	if err := global.NextecSettingSet(settingSupportPublicURL, v); err != nil {
+		return "", err
+	}
+	return v, nil
+}
