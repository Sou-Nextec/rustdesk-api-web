@@ -0,0 +1,29 @@
+package service
+
+import "testing"
+
+func TestNextecPublicURLNormalize(t *testing.T) {
+	ok := map[string]string{
+		"":                                "",
+		"   ":                             "",
+		"https://suporte.nex.tec.br":      "https://suporte.nex.tec.br",
+		"https://Suporte.Nex.Tec.br/":     "https://suporte.nex.tec.br",
+		"  https://suporte.nex.tec.br  ":  "https://suporte.nex.tec.br",
+		"https://a-b.exemplo.com.br":      "https://a-b.exemplo.com.br",
+	}
+	for in, want := range ok {
+		got, err := NextecPublicURLNormalize(in)
+		if err != nil || got != want {
+			t.Fatalf("%q: got %q err=%v, want %q", in, got, err, want)
+		}
+	}
+	for _, in := range []string{
+		"http://suporte.nex.tec.br", "suporte.nex.tec.br", "https://suporte.nex.tec.br/instalador", "https://suporte.nex.tec.br:8443",
+		"https://suporte.nex.tec.br?x=1", "https://suporte.nex.tec.br#a", "https://user:pw@suporte.nex.tec.br", "https://localhost",
+		"https://-ruim.nex.tec.br", "javascript:alert(1)", "https://a b.com", "//suporte.nex.tec.br",
+	} {
+		if got, err := NextecPublicURLNormalize(in); err == nil {
+			t.Fatalf("%q deveria ser recusado (veio %q)", in, got)
+		}
+	}
+}
