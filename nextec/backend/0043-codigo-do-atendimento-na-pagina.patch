Codigo curto do atendimento na pagina publica

Nextec 0043: a pagina /s/<token> (e /atendimento/<token>) mostra o codigo curto do atendimento (ex.: 482-913), tirado do
rotulo do link; rotulo sem codigo aparece inteiro. Usado pelo patch 0040.

diff --git a/http/controller/api/nextec_support_code.go b/http/controller/api/nextec_support_code.go
new file mode 100644
index 0000000000000000000000000000000000000000..9053187d34c62f57e87dfbff0f9569a6774ba3b2
--- /dev/null
+++ b/http/controller/api/nextec_support_code.go
@@ -0,0 +1,16 @@
+package api
+
+import "regexp"
+
+// supportLinkCodeRe é o código curto do atendimento (ex.: 482-913) que o painel grava no rótulo do link.
+var supportLinkCodeRe = regexp.MustCompile(`\b\d{3}-\d{3}\b`)
+
+// supportLinkCode devolve o código curto do atendimento guardado no rótulo ("Atendimento 482-913" ou
+// "chamado 1234 (482-913)"). Rótulo sem código (link criado pelo formulário de Suporte avulso) volta inteiro.
+func supportLinkCode(label string) string {
+	all := supportLinkCodeRe.FindAllString(label, -1)
+	if len(all) == 0 {
+		return label
+	}
+	return all[len(all)-1]
+}
diff --git a/http/controller/api/nextec_support_code_test.go b/http/controller/api/nextec_support_code_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..d9fb2088011f192b473ee266e1f559cc3d11c0bf
--- /dev/null
+++ b/http/controller/api/nextec_support_code_test.go
@@ -0,0 +1,20 @@
+package api
+
+import "testing"
+
+func TestSupportLinkCode(t *testing.T) {
+	cases := map[string]string{
+		"Atendimento 482-913":         "482-913",
+		"chamado 1234 (482-913)":      "482-913",
+		"Cartório Mariinha":           "Cartório Mariinha",
+		"Fila 100-200 e 300-400":      "300-400",
+		"ID 123456789 (987-654)":      "987-654",
+		"":                            "",
+		"Atendimento 1234-567 padrão": "Atendimento 1234-567 padrão",
+	}
+	for in, want := range cases {
+		if got := supportLinkCode(in); got != want {
+			t.Fatalf("%q: got %q, want %q", in, got, want)
+		}
+	}
+}
