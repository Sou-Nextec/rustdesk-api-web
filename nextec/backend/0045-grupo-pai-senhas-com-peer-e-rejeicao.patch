+const nextecSecretPeerChunk = 400
+
+// nextecSecretPeers lê os Peers dos ids dados e dos grupos com regra ligada, em blocos. Mantém uma linha por ID
+// (a mais recente, igual à listagem de Dispositivos quando há duplicados).
+func nextecSecretPeers(ids []string, groupIDs []uint) []*model.Peer {
+	var out []*model.Peer
+	seen := map[uint]bool{}
+	collect := func(q *gorm.DB) {
+		var rows []*model.Peer
+		if err := q.Find(&rows).Error; err != nil {
+			if Logger != nil {
+				Logger.Warn("nextec senhas: leitura de Peer falhou: ", err)
+			}
+			return
+		}
+		for _, p := range rows {
+			if !seen[p.RowId] {
+				seen[p.RowId] = true
+				out = append(out, p)
+			}
+		}
+	}
+	for i := 0; i < len(ids); i += nextecSecretPeerChunk {
+		end := i + nextecSecretPeerChunk
+		if end > len(ids) {
+			end = len(ids)
+		}
+		collect(DB.Model(&model.Peer{}).Where("id in ?", ids[i:end]))
+	}
+	for i := 0; i < len(groupIDs); i += nextecSecretPeerChunk {
+		end := i + nextecSecretPeerChunk
+		if end > len(groupIDs) {
+			end = len(groupIDs)
+		}
+		collect(DB.Model(&model.Peer{}).Where("group_id in ?", groupIDs[i:end]))
+	}
+	return out
+}
+
+// nextecSecretPeersByCleanId acha o Peer de IDs que o cofre tem sem espaço mas a tabela Peer ainda guarda com espaço
+// (ID digitado à mão; o NextecNormalizeIds só corrige quando não há conflito). Devolve cópias com o ID do cofre.
+func nextecSecretPeersByCleanId(ids []string, found []*model.Peer) []*model.Peer {
+	have := make(map[string]bool, len(found))
+	for _, p := range found {
+		have[NextecCleanId(p.Id)] = true
+	}
+	missing := []string{}
+	for _, id := range ids {
+		if !have[id] {
+			missing = append(missing, id)
+		}
+	}
+	var out []*model.Peer
+	for i := 0; i < len(missing); i += nextecSecretPeerChunk {
+		end := i + nextecSecretPeerChunk
+		if end > len(missing) {
+			end = len(missing)
+		}
+		var rows []*model.Peer
+		if err := DB.Model(&model.Peer{}).Where("REPLACE(REPLACE(id, ' ', ''), ?, '') IN ?", "\u00a0", missing[i:end]).Find(&rows).Error; err != nil {
+			if Logger != nil {
+				Logger.Warn("nextec senhas: leitura de Peer por ID limpo falhou: ", err)
+			}
+			continue
+		}
+		for _, p := range rows {
+			cp := *p
+			cp.Id = NextecCleanId(p.Id)
+			if !have[cp.Id] {
+				have[cp.Id] = true
+				out = append(out, &cp)
+			}
+		}
+	}
+	return out
+}
+
+// nextecEnrollRejectsByPeer devolve a rejeição mais recente de cada ID.
+func nextecEnrollRejectsByPeer() map[string]*model.NextecEnrollReject {
+	var rows []*model.NextecEnrollReject
+	out := map[string]*model.NextecEnrollReject{}
+	if err := DB.Order("rejected_at asc").Find(&rows).Error; err != nil {
+		return out
+	}
+	for _, r := range rows {
+		out[r.PeerId] = r
+	}
+	return out
+}
