diff --git a/service/nextec_group.go b/service/nextec_group.go
new file mode 100644
index 0000000..a7c2d13
--- /dev/null
+++ b/service/nextec_group.go
@@ -0,0 +1,166 @@
+package service
+
+import (
+	"strings"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+)
+
+// Cliente = DeviceGroup raiz; subgrupo = DeviceGroup com parent_id apontando para o cliente. O nome continua
+// "Cliente / Sub" por compatibilidade com o painel e com listas antigas.
+
+const (
+	nextecGroupSep      = " / "
+	nextecGroupMaxDepth = 8
+)
+
+// nextecGroupParentName devolve os nomes candidatos ao pai de "A / B / C", do mais longo ao mais curto
+// ("A / B", depois "A").
+func nextecGroupParentNames(name string) []string {
+	parts := strings.Split(name, nextecGroupSep)
+	out := []string{}
+	for i := len(parts) - 1; i >= 1; i-- {
+		p := strings.TrimSpace(strings.Join(parts[:i], nextecGroupSep))
+		if p != "" {
+			out = append(out, p)
+		}
+	}
+	return out
+}
+
+// nextecGroupParentFromName procura o grupo pai pelo nome "A / B" (0 = nenhum). Ignora o próprio grupo.
+func nextecGroupParentFromName(tx *gorm.DB, selfID uint, name string) uint {
+	for _, cand := range nextecGroupParentNames(name) {
+		var g model.DeviceGroup
+		q := tx.Where("name = ?", cand)
+		if selfID != 0 {
+			q = q.Where("id <> ?", selfID)
+		}
+		if q.Order("id").First(&g).Error == nil && g.Id != 0 {
+			return g.Id
+		}
+	}
+	return 0
+}
+
+// NextecBackfillGroupParents preenche parent_id dos grupos "A / B" existentes. Idempotente: só toca em quem
+// ainda não tem pai e cujo pai existe. Devolve quantos grupos foram ligados.
+func NextecBackfillGroupParents() int {
+	var groups []*model.DeviceGroup
+	if err := DB.Where("parent_id = ?", 0).Find(&groups).Error; err != nil {
+		if Logger != nil {
+			Logger.Warn("nextec group parents: ", err)
+		}
+		return 0
+	}
+	linked := 0
+	for _, g := range groups {
+		if !strings.Contains(g.Name, nextecGroupSep) {
+			continue
+		}
+		pid := nextecGroupParentFromName(DB, g.Id, g.Name)
+		if pid == 0 || pid == g.Id || nextecGroupWouldLoop(DB, g.Id, pid) {
+			continue
+		}
+		if err := DB.Model(&model.DeviceGroup{}).Where("id = ? AND parent_id = ?", g.Id, 0).Update("parent_id", pid).Error; err == nil {
+			linked++
+		}
+	}
+	if linked > 0 && Logger != nil {
+		Logger.Info("nextec group parents: ", linked, " subgrupo(s) ligados ao cliente pelo nome")
+	}
+	return linked
+}
+
+// nextecGroupWouldLoop diz se ligar selfID como filho de parentID criaria ciclo.
+func nextecGroupWouldLoop(tx *gorm.DB, selfID, parentID uint) bool {
+	for _, id := range nextecGroupChainTx(tx, parentID) {
+		if id == selfID {
+			return true
+		}
+	}
+	return false
+}
+
+// nextecGroupChain devolve o grupo e os ancestrais, do subgrupo ao cliente: [sub, cliente]. Grupo 0 ou inexistente
+// devolve vazio. Protegido contra ciclo e profundidade absurda.
+func nextecGroupChain(groupID uint) []uint {
+	return nextecGroupChainTx(DB, groupID)
+}
+
+func nextecGroupChainTx(tx *gorm.DB, groupID uint) []uint {
+	chain := []uint{}
+	seen := map[uint]bool{}
+	cur := groupID
+	for cur != 0 && !seen[cur] && len(chain) < nextecGroupMaxDepth {
+		var g model.DeviceGroup
+		if tx.Select("id", "parent_id").Where("id = ?", cur).Limit(1).Find(&g).Error != nil || g.Id == 0 {
+			break
+		}
+		seen[cur] = true
+		chain = append(chain, g.Id)
+		cur = g.ParentId
+	}
+	return chain
+}
+
+// NextecGroupChain é a versão exportada de nextecGroupChain, para política, visibilidade e senhas.
+func NextecGroupChain(groupID uint) []uint { return nextecGroupChain(groupID) }
+
+// NextecFillGroupPaths preenche Path (raiz primeiro, separado por " / ") usando todos os grupos de uma vez.
+func NextecFillGroupPaths(groups []*model.DeviceGroup) {
+	if len(groups) == 0 {
+		return
+	}
+	var all []*model.DeviceGroup
+	if DB.Select("id", "name", "parent_id").Find(&all).Error != nil {
+		return
+	}
+	byID := make(map[uint]*model.DeviceGroup, len(all))
+	for _, g := range all {
+		byID[g.Id] = g
+	}
+	for _, g := range groups {
+		names := []string{}
+		seen := map[uint]bool{}
+		for cur := byID[g.Id]; cur != nil && !seen[cur.Id] && len(names) < nextecGroupMaxDepth; cur = byID[cur.ParentId] {
+			seen[cur.Id] = true
+			names = append([]string{nextecGroupLeaf(cur, byID)}, names...)
+		}
+		if len(names) == 0 {
+			g.Path = g.Name
+			continue
+		}
+		g.Path = strings.Join(names, nextecGroupSep)
+	}
+}
+
+// nextecGroupLeaf: o nome antigo "A / B" já carrega o pai; com parent_id, o segmento próprio é só o que vem
+// depois do prefixo do pai.
+func nextecGroupLeaf(g *model.DeviceGroup, byID map[uint]*model.DeviceGroup) string {
+	if p := byID[g.ParentId]; p != nil && strings.HasPrefix(g.Name, p.Name+nextecGroupSep) {
+		return strings.TrimPrefix(g.Name, p.Name+nextecGroupSep)
+	}
+	return g.Name
+}
+
+// NextecGroupValidateParent confere o pai de um grupo: existe, não é o próprio grupo e não cria ciclo.
+func NextecGroupValidateParent(selfID, parentID uint) bool {
+	if parentID == 0 {
+		return true
+	}
+	if parentID == selfID {
+		return false
+	}
+	var n int64
+	if DB.Model(&model.DeviceGroup{}).Where("id = ?", parentID).Count(&n).Error != nil || n == 0 {
+		return false
+	}
+	return selfID == 0 || !nextecGroupWouldLoop(DB, selfID, parentID)
+}
+
+// NextecGroupParentFromName é o derivador usado quando o painel antigo cria "A / B" sem parent_id.
+func NextecGroupParentFromName(selfID uint, name string) uint {
+	return nextecGroupParentFromName(DB, selfID, name)
+}
