+	for _, x := range NextecSecretDevices() {
+		if x.PeerId == enrollPeer {
+			dv = x
+		}
+	}
+	if dv == nil || !dv.AfterReject {
+		t.Fatalf("lista sem a marca: %+v", dv)
+	}
+	// Identidade nova (UUID diferente) no mesmo ID, dentro da carência: abre solicitação nova, marcada.
+	if err := NextecEnrollRejectReason(enrollPeer, "", false, "", 1, "admin", ""); err != nil {
+		t.Fatal(err)
+	}
+	db.Model(&model.Peer{}).Where("id = ?", enrollPeer).Update("uuid", "uuid-outro")
+	if _, err := NextecSelfEnroll("10.7.0.1", key, enrollPeer, enrollUUID, enrollToken()); !errors.Is(err, ErrNextecEnrollRejected) {
+		t.Fatalf("uuid antigo não é mais do peer, mas a carência vale: %v", err)
+	}
+	if _, err := NextecSelfEnroll("10.7.0.1", key, enrollPeer, "uuid-outro", enrollToken()); err != nil {
+		t.Fatalf("identidade nova: %v", err)
+	}
+	if !deviceRow(t, db, enrollPeer).AfterReject {
+		t.Fatal("identidade nova sem marca")
+	}
+}
