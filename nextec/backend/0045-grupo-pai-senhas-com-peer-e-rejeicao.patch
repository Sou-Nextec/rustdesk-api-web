+func TestSecretDevicesAlwaysJoinPeer(t *testing.T) {
+	db := enrollSetup(t)
+	db.Model(&model.Peer{}).Where("id = ?", enrollPeer).Updates(map[string]interface{}{"alias": "Caixa 1", "group_id": 7, "hostname": "PC-CAIXA"})
