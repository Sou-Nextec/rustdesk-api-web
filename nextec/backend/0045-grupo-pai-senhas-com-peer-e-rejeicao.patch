+// ---------- rejeição com carência ----------
+
+func nextecEnrollRejectGrace() time.Duration {
+	if n, err := strconv.Atoi(global.NextecSettingGet(settingEnrollRejectGraceHours)); err == nil && n >= 1 && n <= 8760 {
+		return time.Duration(n) * time.Hour
+	}
+	return nextecEnrollRejectGraceHours * time.Hour
+}
+
+// nextecEnrollRejectedActive: o par ID+UUID foi rejeitado e ainda está dentro da carência.
+func nextecEnrollRejectedActive(db *gorm.DB, peerID, uuid string, now int64) bool {
+	var n int64
+	return db.Model(&model.NextecEnrollReject{}).Where("peer_id = ? AND uuid = ? AND until > ?", peerID, uuid, now).Count(&n).Error != nil || n > 0
+}
+
+// nextecEnrollRejectedBefore: o ID já teve alguma rejeição (de qualquer identidade, vencida ou não).
+func nextecEnrollRejectedBefore(db *gorm.DB, peerID string) bool {
+	var n int64
+	return db.Model(&model.NextecEnrollReject{}).Where("peer_id = ?", peerID).Count(&n).Error == nil && n > 0
+}
+
+func nextecEnrollCleanReason(s string) string {
+	s = strings.Map(func(r rune) rune {
+		if r < 0x20 || r == 0x7f {
+			return ' '
+		}
+		return r
+	}, s)
+	s = strings.TrimSpace(s)
+	if r := []rune(s); len(r) > nextecEnrollRejectReasonMax {
+		s = string(r[:nextecEnrollRejectReasonMax])
+	}
+	return s
+}
