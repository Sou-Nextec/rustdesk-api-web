+	const total = 1300
+	peers := make([]*model.Peer, 0, total)
+	rows := make([]*model.NextecDeviceSecret, 0, total)
+	for i := 0; i < total; i++ {
+		id := strconv.Itoa(500000000 + i)
+		peers = append(peers, &model.Peer{Id: id, Uuid: "u" + id, Alias: "Apelido " + id, Hostname: "H" + id, GroupId: 8})
+		rows = append(rows, &model.NextecDeviceSecret{PeerId: id, TokenHash: "h" + id, Uuid: "u" + id})
+	}
+	if err := db.CreateInBatches(peers, 200).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.CreateInBatches(rows, 200).Error; err != nil {
+		t.Fatal(err)
+	}
+	if _, err := NextecSelfEnroll("10.7.0.1", enrollKey(t), enrollPeer, enrollUUID, enrollToken()); err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]*NextecSecretDevice{}
+	for _, d := range NextecSecretDevices() {
+		got[d.PeerId] = d
+	}
+	if len(got) != total+1 {
+		t.Fatalf("máquinas = %d", len(got))
+	}
+	for _, p := range peers {
+		d := got[p.Id]
+		if d == nil || d.Alias != p.Alias || d.Hostname != p.Hostname || d.GroupId != 8 {
+			t.Fatalf("%s sem junção com Peer: %+v", p.Id, d)
+		}
+	}
+	if d := got[enrollPeer]; d.Alias != "Caixa 1" || d.Hostname != "PC-CAIXA" || d.GroupId != 7 || d.State != NextecStatePending {
+		t.Fatalf("pendente: %+v", d)
+	}
+}
