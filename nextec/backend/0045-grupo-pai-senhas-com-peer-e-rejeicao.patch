+// ---------- Fase 0: parent_id e nextecGroupChain ----------
+
+func TestGroupParentBackfillFromName(t *testing.T) {
+	db := enrollSetup(t) // cria "Cliente A" (7) e "Cliente B" (8)
+	mk := func(id uint, name string) {
+		if err := db.Create(&model.DeviceGroup{IdModel: model.IdModel{Id: id}, Name: name}).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	mk(21, "Cliente A / Filial")
+	mk(22, "Cliente A / Filial / Caixa")
+	mk(23, "Sem Pai / Sub") // o pai não existe: continua raiz
+	mk(24, "Cliente B")
+
+	if n := NextecBackfillGroupParents(); n != 2 {
+		t.Fatalf("ligados = %d, esperado 2", n)
+	}
+	want := map[uint]uint{7: 0, 8: 0, 21: 7, 22: 21, 23: 0, 24: 0}
+	for id, parent := range want {
+		var g model.DeviceGroup
+		if err := db.First(&g, id).Error; err != nil {
+			t.Fatal(err)
+		}
+		if g.ParentId != parent {
+			t.Fatalf("grupo %d: parent_id = %d, esperado %d", id, g.ParentId, parent)
+		}
+	}
+	// Idempotente.
+	if n := NextecBackfillGroupParents(); n != 0 {
+		t.Fatalf("segunda passada ligou %d", n)
+	}
+}
+
+func TestGroupChainSubToClientAndGuards(t *testing.T) {
+	db := enrollSetup(t)
+	db.Create(&model.DeviceGroup{IdModel: model.IdModel{Id: 21}, Name: "Cliente A / Filial", ParentId: 7})
+	db.Create(&model.DeviceGroup{IdModel: model.IdModel{Id: 22}, Name: "Cliente A / Filial / Caixa", ParentId: 21})
+
+	if got := nextecGroupChain(22); !reflect.DeepEqual(got, []uint{22, 21, 7}) {
+		t.Fatalf("cadeia = %v", got)
+	}
+	if got := nextecGroupChain(7); !reflect.DeepEqual(got, []uint{7}) {
+		t.Fatalf("cadeia do cliente = %v", got)
+	}
+	if got := nextecGroupChain(0); len(got) != 0 {
+		t.Fatalf("grupo 0 = %v", got)
+	}
+	if got := nextecGroupChain(999); len(got) != 0 {
+		t.Fatalf("grupo inexistente = %v", got)
+	}
+	// Pai que não existe mais: a cadeia termina no último grupo válido.
+	db.Create(&model.DeviceGroup{IdModel: model.IdModel{Id: 30}, Name: "Órfão", ParentId: 404})
+	if got := nextecGroupChain(30); !reflect.DeepEqual(got, []uint{30}) {
+		t.Fatalf("órfão = %v", got)
+	}
+	// Ciclo no banco não trava: corta na primeira repetição.
+	db.Model(&model.DeviceGroup{}).Where("id = ?", 7).Update("parent_id", 22)
+	if got := nextecGroupChain(22); len(got) != 3 {
+		t.Fatalf("ciclo = %v", got)
+	}
+	// Validação do pai: não aceita ciclo, o próprio grupo nem pai inexistente.
+	db.Model(&model.DeviceGroup{}).Where("id = ?", 7).Update("parent_id", 0)
+	if NextecGroupValidateParent(7, 22) {
+		t.Fatal("aceitou ciclo")
+	}
+	if NextecGroupValidateParent(7, 7) || NextecGroupValidateParent(7, 999) {
+		t.Fatal("aceitou pai inválido")
+	}
+	if !NextecGroupValidateParent(22, 8) || !NextecGroupValidateParent(22, 0) {
+		t.Fatal("recusou pai válido")
+	}
+}
+
