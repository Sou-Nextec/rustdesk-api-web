 // NextecApplyPendingAssign aplica a atribuição guardada quando a máquina finalmente se registra (chamado após o sysinfo).
+// O prazo é conferido antes de qualquer mudança e a pendência só some junto com a atribuição (mesma transação): uma falha
+// ao gravar não perde a pendência, e uma vencida é descartada com auditoria em vez de atribuir.
 func NextecApplyPendingAssign(peerID string) {
 	row := &model.NextecPendingAssign{}
 	if DB.First(row, "peer_id = ?", peerID).Error != nil {
 		return
 	}
-	DB.Delete(row)
 	if row.ExpiresAt < time.Now().Unix() {
+		DB.Delete(row)
+		NextecSecretAuditAdd(nil, peerID, "assign_pending_expired", "", "chave de instalação vencida, grupo "+nextecGroupPathTx(DB, row.GroupId))
+		return
+	}
+	applied := false
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		// só atribui se ainda não tem cliente
+		res := tx.Model(&model.Peer{}).Where("id = ? AND group_id = 0", peerID).Update("group_id", row.GroupId)
+		if res.Error != nil {
+			return res.Error
+		}
+		applied = res.RowsAffected > 0
+		return tx.Delete(&model.NextecPendingAssign{}, "peer_id = ?", peerID).Error
+	})
+	if err != nil {
+		if Logger != nil {
+			Logger.Warn("nextec: atribuição pendente não aplicada, fica para a próxima: ", err)
+		}
 		return
 	}
-	// só atribui se ainda não tem cliente
-	DB.Model(&model.Peer{}).Where("id = ? AND group_id = 0", peerID).Update("group_id", row.GroupId)
+	if applied {
+		NextecSecretAuditAdd(nil, peerID, "assign_pending_applied", "", "chave de instalação, grupo "+nextecGroupPathTx(DB, row.GroupId))
+	}
 }
diff --git a/service/nextec_bug8_test.go b/service/nextec_bug8_test.go
new file mode 100644
index 0000000..470b070
--- /dev/null
+++ b/service/nextec_bug8_test.go
@@ -0,0 +1,190 @@
+package service
+
+import (
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+)
+
+// bug8Groups cria dois subgrupos do Cliente A (7): 9 "Filial" e 10 "Loja".
+func bug8Groups(t *testing.T, db *gorm.DB) {
+	t.Helper()
+	for _, g := range []model.DeviceGroup{
+		{IdModel: model.IdModel{Id: 9}, Name: "Cliente A / Filial", ParentId: 7},
+		{IdModel: model.IdModel{Id: 10}, Name: "Cliente A / Loja", ParentId: 7},
+	} {
+		g := g
+		if err := db.Create(&g).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func setPeerGroup(t *testing.T, db *gorm.DB, g uint) {
+	t.Helper()
+	if err := db.Model(&model.Peer{}).Where("id = ?", enrollPeer).Update("group_id", g).Error; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func bug8Audit(db *gorm.DB, action string) int64 {
+	var n int64
+	db.Model(&model.NextecSecretAudit{}).Where("action = ?", action).Count(&n)
+	return n
+}
+
+func TestPendingAssignValidatesTTLBeforeDeletingAndAudits(t *testing.T) {
+	db := enrollSetup(t)
+	if err := db.AutoMigrate(&model.NextecPendingAssign{}); err != nil {
+		t.Fatal(err)
+	}
+	// vencida: não atribui, a pendência some e fica auditado
+	db.Create(&model.NextecPendingAssign{PeerId: enrollPeer, GroupId: 8, ExpiresAt: time.Now().Add(-time.Minute).Unix()})
+	NextecApplyPendingAssign(enrollPeer)
+	if g := peerGroupOf(t, db); g != 0 {
+		t.Fatalf("pendência vencida atribuiu o grupo %d", g)
+	}
+	var left int64
+	db.Model(&model.NextecPendingAssign{}).Count(&left)
+	if left != 0 || bug8Audit(db, "assign_pending_expired") != 1 {
+		t.Fatalf("vencida: sobrou %d, auditoria %d", left, bug8Audit(db, "assign_pending_expired"))
+	}
+	// válida: atribui, a pendência some e fica auditado
+	db.Create(&model.NextecPendingAssign{PeerId: enrollPeer, GroupId: 8, ExpiresAt: time.Now().Add(time.Hour).Unix()})
+	NextecApplyPendingAssign(enrollPeer)
+	db.Model(&model.NextecPendingAssign{}).Count(&left)
+	if g := peerGroupOf(t, db); g != 8 || left != 0 || bug8Audit(db, "assign_pending_applied") != 1 {
+		t.Fatalf("válida: grupo %d, sobrou %d, auditoria %d", g, left, bug8Audit(db, "assign_pending_applied"))
+	}
+	// máquina que já tem cliente não é movida pela pendência
+	db.Create(&model.NextecPendingAssign{PeerId: enrollPeer, GroupId: 7, ExpiresAt: time.Now().Add(time.Hour).Unix()})
+	NextecApplyPendingAssign(enrollPeer)
+	if g := peerGroupOf(t, db); g != 8 {
+		t.Fatalf("pendência moveu máquina que já tinha cliente: %d", g)
+	}
+	db.Model(&model.NextecPendingAssign{}).Count(&left)
+	if left != 0 {
+		t.Fatal("pendência obsoleta ficou na tabela")
+	}
+}
+
+func TestInstallKeyAcceptsSubgroupAndReportsConflict(t *testing.T) {
+	db := enrollSetup(t)
+	bug8Groups(t, db)
+	tokenOf := func(g uint) string {
+		tk, err := NextecAssignToken(g)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return tk
+	}
+	// chave do subgrupo vale e coloca a máquina sem cliente direto no subgrupo
+	info, err := NextecAssignApplyInfo("10.5.0.1", enrollPeer, 9, tokenOf(9))
+	if err != nil || info.State != "assigned" || peerGroupOf(t, db) != 9 {
+		t.Fatalf("subgrupo: %+v %v grupo %d", info, err, peerGroupOf(t, db))
+	}
+	// chave do cliente (pai) com a máquina já no subgrupo dele: nada muda, sem conflito
+	info, err = NextecAssignApplyInfo("10.5.0.1", enrollPeer, 7, tokenOf(7))
+	if err != nil || info.State != "kept" || info.Current != "" || peerGroupOf(t, db) != 9 {
+		t.Fatalf("pai com a máquina no subgrupo: %+v %v grupo %d", info, err, peerGroupOf(t, db))
+	}
+	// chave de outro subgrupo do mesmo cliente: a máquina não é movida entre subgrupos, e isso é conflito de verdade
+	info, err = NextecAssignApplyInfo("10.5.0.1", enrollPeer, 10, tokenOf(10))
+	if err != nil || info.State != "kept" || info.Current != "Cliente A / Filial" || peerGroupOf(t, db) != 9 {
+		t.Fatalf("outro subgrupo: %+v %v grupo %d", info, err, peerGroupOf(t, db))
+	}
+	// máquina na raiz do cliente desce para o subgrupo da chave
+	setPeerGroup(t, db, 7)
+	info, err = NextecAssignApplyInfo("10.5.0.1", enrollPeer, 10, tokenOf(10))
+	if err != nil || info.State != "assigned" || peerGroupOf(t, db) != 10 {
+		t.Fatalf("raiz para subgrupo: %+v %v grupo %d", info, err, peerGroupOf(t, db))
+	}
+	// máquina de outro cliente: continua onde está, devolve o nome e audita
+	setPeerGroup(t, db, 8)
+	info, err = NextecAssignApplyInfo("10.5.0.1", enrollPeer, 9, tokenOf(9))
+	if err != nil || info.State != "kept" || info.Current != "Cliente B" || peerGroupOf(t, db) != 8 {
+		t.Fatalf("outro cliente: %+v %v grupo %d", info, err, peerGroupOf(t, db))
+	}
+	if bug8Audit(db, "assign_install_conflict") < 1 || bug8Audit(db, "assign_install_key") != 2 {
+		t.Fatalf("auditoria: conflito %d, chave %d", bug8Audit(db, "assign_install_conflict"), bug8Audit(db, "assign_install_key"))
+	}
+	// chave de outro cliente não vale para este grupo
+	if _, err := NextecAssignApplyInfo("10.5.0.2", enrollPeer, 9, tokenOf(8)); !errors.Is(err, ErrNextecBadAgentAuth) {
+		t.Fatalf("chave trocada: %v", err)
+	}
+}
+
+func TestInviteClaimConflictIsRecordedAndListedAndRetryWorks(t *testing.T) {
+	db, token := enrollPending(t, "10.7.8.1")
+	bug8Groups(t, db)
+	c, err := NextecInviteCreate(nil, inviteBase())
+	if err != nil {
+		t.Fatal(err)
+	}
+	// máquina de outro cliente: 409 com o nome, nada gasto, resultado e auditoria gravados
+	setPeerGroup(t, db, 8)
+	_, err = NextecInviteClaim("10.7.8.1", enrollPeer, token, c.Code)
+	if !errors.Is(err, ErrNextecClientConflict) || NextecClientConflictCurrent(err) != "Cliente B" {
+		t.Fatalf("conflito: %v atual %q", err, NextecClientConflictCurrent(err))
+	}
+	views, _ := NextecInviteList()
+	var res []NextecInviteTryView
+	for _, v := range views {
+		if v.Id == c.Invite.Id {
+			res = v.Results
+		}
+	}
+	if len(res) != 1 || res[0].Result != "conflict" || !strings.Contains(res[0].Detail, "Cliente B") || res[0].PeerId != enrollPeer {
+		t.Fatalf("resultado no painel: %+v", res)
+	}
+	if bug8Audit(db, "invite_conflict") != 1 {
+		t.Fatal("conflito sem auditoria")
+	}
+	// o admin libera a máquina; a nova tentativa vincula e atualiza o resultado (uma linha por convite e máquina)
+	setPeerGroup(t, db, 0)
+	if _, err := NextecInviteClaim("10.7.8.1", enrollPeer, token, c.Code); err != nil {
+		t.Fatal(err)
+	}
+	views, _ = NextecInviteList()
+	for _, v := range views {
+		if v.Id == c.Invite.Id {
+			res = v.Results
+		}
+	}
+	if len(res) != 1 || res[0].Result != "linked" || !strings.Contains(res[0].Detail, "Cliente A") {
+		t.Fatalf("resultado após vincular: %+v", res)
+	}
+}
+
+func TestInviteClaimToParentClientKeepsMachineInSubgroup(t *testing.T) {
+	db, token := enrollPending(t, "10.7.8.2")
+	bug8Groups(t, db)
+	setPeerGroup(t, db, 9)
+	c, _ := NextecInviteCreate(nil, inviteBase()) // cliente 7
+	res, err := NextecInviteClaim("10.7.8.2", enrollPeer, token, c.Code)
+	if err != nil || peerGroupOf(t, db) != 9 || res.Moved {
+		t.Fatalf("convite do cliente com a máquina no subgrupo dele: %+v %v grupo %d", res, err, peerGroupOf(t, db))
+	}
+}
+
+func TestInviteClaimRevokedIsRecordedAsInvalid(t *testing.T) {
+	db, token := enrollPending(t, "10.7.8.3")
+	c, _ := NextecInviteCreate(nil, inviteBase())
+	if err := NextecInviteRevoke(c.Invite.Id); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := NextecInviteClaim("10.7.8.3", enrollPeer, token, c.Code); !errors.Is(err, ErrNextecInviteInvalid) {
+		t.Fatalf("revogado: %v", err)
+	}
+	var tr model.NextecInstallInviteTry
+	if err := db.Where("invite_id = ?", c.Invite.Id).First(&tr).Error; err != nil || tr.Result != "invalid" || tr.Detail != "convite cancelado" {
+		t.Fatalf("resultado: %+v %v", tr, err)
+	}
+	if bug8Audit(db, "invite_invalid") != 1 {
+		t.Fatal("convite inválido sem auditoria")
+	}
+}
