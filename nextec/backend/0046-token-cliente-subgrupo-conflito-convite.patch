-			return "kept", nil
+		switch rel := nextecGroupRelationTx(DB, p.GroupId, group); rel {
+		case nextecRelNone, nextecRelRefine:
+			if err := DB.Model(&model.Peer{}).Where("row_id = ?", p.RowId).Update("group_id", group).Error; err != nil {
+				return nil, err
+			}
+			NextecSecretAuditAdd(nil, peerID, "assign_install_key", nextecBootstrapAuditIP(ip), "chave de instalação, grupo "+nextecGroupPathTx(DB, group))
+			return &NextecAssignInfo{State: "assigned"}, nil
+		case nextecRelOther:
+			cur := nextecGroupPathTx(DB, p.GroupId)
+			NextecSecretAuditAdd(nil, peerID, "assign_install_conflict", nextecBootstrapAuditIP(ip),
+				"chave de instalação de "+nextecGroupPathTx(DB, group)+", máquina já pertence a "+cur)
