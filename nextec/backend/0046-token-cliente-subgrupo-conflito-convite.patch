+
+// NextecAssignApplyInfo é chamado pelo script de instalação. Estado "assigned", "pending" (a máquina ainda não se registrou)
+// ou "kept" (já tinha cliente, nada muda). A chave pode ser de um cliente ou de um subgrupo: a máquina na raiz do cliente
+// desce para o subgrupo da chave; a que já está num subgrupo do cliente fica; a de outro cliente nunca é movida e o
+// conflito é auditado, com o nome do cliente atual na resposta.
+func NextecAssignApplyInfo(ip, peerID string, group uint, token string) (*NextecAssignInfo, error) {
