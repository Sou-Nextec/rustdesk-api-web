+// nextecInviteTry grava (ou atualiza) o resultado da máquina com o convite, para o painel mostrar na tela de instalação.
+func nextecInviteTry(inviteID uint, peerID, result, detail string) {
+	if len(detail) > 200 {
+		detail = detail[:200]
+	}
+	row := &model.NextecInstallInviteTry{InviteId: inviteID, PeerId: peerID, Result: result, Detail: detail, At: time.Now().Unix()}
+	if err := DB.Clauses(clause.OnConflict{
+		Columns:   []clause.Column{{Name: "invite_id"}, {Name: "peer_id"}},
+		DoUpdates: clause.AssignmentColumns([]string{"result", "detail", "at"}),
+	}).Create(row).Error; err != nil && Logger != nil {
+		Logger.Warn("nextec convite: resultado não gravado: ", err)
+	}
+}
