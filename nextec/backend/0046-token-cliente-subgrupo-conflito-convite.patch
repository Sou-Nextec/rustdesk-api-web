@@ -164,3 +164,54 @@ func NextecGroupValidateParent(selfID, parentID uint) bool {
 func NextecGroupParentFromName(selfID uint, name string) uint {
 	return nextecGroupParentFromName(DB, selfID, name)
 }
+
+// Relações entre o grupo atual da máquina e o grupo pedido (cliente ou subgrupo).
+const (
+	nextecRelNone   = "none"   // a máquina ainda não tem grupo
+	nextecRelSame   = "same"   // é o mesmo grupo
+	nextecRelInside = "inside" // a máquina já está dentro do pedido (subgrupo do cliente pedido): nada muda
+	nextecRelRefine = "refine" // a máquina está no pai do pedido (raiz do cliente): pode descer para o subgrupo
+	nextecRelOther  = "other"  // outro cliente: conflito
+)
+
+func nextecGroupRelationTx(tx *gorm.DB, current, target uint) string {
+	switch {
+	case current == 0:
+		return nextecRelNone
+	case current == target:
+		return nextecRelSame
+	}
+	for _, id := range nextecGroupChainTx(tx, current) {
+		if id == target {
+			return nextecRelInside
+		}
+	}
+	for _, id := range nextecGroupChainTx(tx, target) {
+		if id == current {
+			return nextecRelRefine
+		}
+	}
+	return nextecRelOther
+}
+
+// nextecGroupPathTx devolve "Cliente / Sub" (raiz primeiro) para mensagens e auditoria; vazio se o grupo não existe.
+func nextecGroupPathTx(tx *gorm.DB, groupID uint) string {
+	chain := nextecGroupChainTx(tx, groupID)
+	byID := make(map[uint]*model.DeviceGroup, len(chain))
+	for _, id := range chain {
+		g := &model.DeviceGroup{}
+		if tx.Select("id", "name", "parent_id").Where("id = ?", id).Limit(1).Find(g).Error == nil && g.Id != 0 {
+			byID[id] = g
+		}
+	}
+	names := make([]string, 0, len(chain))
+	for i := len(chain) - 1; i >= 0; i-- {
+		if g := byID[chain[i]]; g != nil {
+			names = append(names, nextecGroupLeaf(g, byID))
+		}
+	}
+	return strings.Join(names, nextecGroupSep)
+}
+
+// NextecGroupPath é o caminho "Cliente / Sub" do grupo, para mensagens e telas.
+func NextecGroupPath(groupID uint) string { return nextecGroupPathTx(DB, groupID) }
