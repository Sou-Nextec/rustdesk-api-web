+package admin
+
+import (
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/http/response"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+)
+
+// NextecClientLists: sincroniza as listas "Cliente: X" com os dispositivos do cliente e dos subgrupos (somente admin).
+type NextecClientLists struct{}
+
+// Sync deixa cada lista igual ao grupo (inclui o que falta e remove o que sobra)
+// @Router /admin/nextec/client-lists/sync [post]
+func (n *NextecClientLists) Sync(c *gin.Context) {
+	var f struct {
+		CollectionIds []uint `json:"collection_ids"`
+	}
+	if err := c.ShouldBindJSON(&f); err != nil || len(f.CollectionIds) == 0 || len(f.CollectionIds) > 500 {
+		response.Fail(c, 101, response.TranslateMsg(c, "ParamsError"))
+		return
+	}
+	u := service.AllService.UserService.CurUser(c)
+	out := make([]*service.NextecClientListSyncResult, 0, len(f.CollectionIds))
+	for _, id := range f.CollectionIds {
+		r, err := service.NextecReconcileClientList(u, nextecIP(c), id)
+		if err != nil {
+			response.Fail(c, 101, err.Error())
+			return
+		}
+		out = append(out, r)
+	}
+	response.Success(c, &gin.H{"results": out})
+}
