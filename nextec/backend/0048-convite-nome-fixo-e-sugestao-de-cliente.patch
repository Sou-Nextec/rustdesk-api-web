diff --git a/service/nextec_invite_suggest.go b/service/nextec_invite_suggest.go
new file mode 100644
index 0000000..c3bdcc6
--- /dev/null
+++ b/service/nextec_invite_suggest.go
@@ -0,0 +1,89 @@
+package service
+
+import (
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+)
+
+const (
+	nextecInviteDownloadKeep   = int64(7 * 24 * 3600) // downloads antigos são descartados
+	nextecInviteSuggestWindow  = int64(72 * 3600)     // download recente o bastante para sugerir cliente
+	nextecInviteDownloadsLimit = 5000
+)
+
+// NextecInviteMarkDownload registra o download do MSI de um convite (IP e hora) e apaga os registros antigos.
+func NextecInviteMarkDownload(inviteID uint, ip string) {
+	if invitesReady() != nil || inviteID == 0 || ip == "" {
+		return
+	}
+	now := time.Now().Unix()
+	DB.Where("at < ?", now-nextecInviteDownloadKeep).Delete(&model.NextecInviteDownload{})
+	var n int64
+	DB.Model(&model.NextecInviteDownload{}).Count(&n)
+	if n >= nextecInviteDownloadsLimit {
+		return
+	}
+	if err := DB.Create(&model.NextecInviteDownload{InviteId: inviteID, Ip: ip, At: now}).Error; err != nil && Logger != nil {
+		Logger.Warn("nextec convite: download não registrado: ", err)
+	}
+}
+
+// NextecClientSuggestion é o cliente que o painel sugere para uma máquina pendente. É só uma sugestão: quem atribui é o admin.
+type NextecClientSuggestion struct {
+	ClientId uint   `json:"client_id"`
+	Client   string `json:"client"`
+	Source   string `json:"source"` // convite (código apresentado mas não aceito) | download (mesmo IP do download do convite)
+	Invite   string `json:"invite"` // descrição do convite
+	Reason   string `json:"reason"`
+}
+
+// NextecSuggestClient sugere um cliente para a máquina pendente sem exigir o código do convite:
+//  1. o agente apresentou um código que o servidor não aceitou (convite cancelado, vencido ou esgotado): sugere o cliente do convite;
+//  2. o IP de origem da máquina é o de um download de convite nas últimas 72 h, e todos esses downloads são do mesmo cliente.
+//
+// Dois clientes diferentes no mesmo IP não geram sugestão (evita palpite errado em rede compartilhada).
+func NextecSuggestClient(peerID, ip string) *NextecClientSuggestion {
+	if invitesReady() != nil || peerID == "" {
+		return nil
+	}
+	var tr model.NextecInstallInviteTry
+	if DB.Where("peer_id = ? AND result = ?", peerID, "invalid").Order("at desc").Limit(1).Find(&tr).Error == nil && tr.Id != 0 {
+		var inv model.NextecInstallInvite
+		if DB.Where("id = ?", tr.InviteId).Limit(1).Find(&inv).Error == nil && inv.Id != 0 {
+			if s := nextecSuggestionFor(&inv, "convite", "o agente apresentou o convite \""+inv.Label+"\", que o servidor não aceitou"); s != nil {
+				return s
+			}
+		}
+	}
+	if ip == "" {
+		return nil
+	}
+	var dls []model.NextecInviteDownload
+	DB.Where("ip = ? AND at >= ?", ip, time.Now().Unix()-nextecInviteSuggestWindow).Order("at desc").Find(&dls)
+	var pick *model.NextecInstallInvite
+	for _, d := range dls {
+		var inv model.NextecInstallInvite
+		if DB.Where("id = ?", d.InviteId).Limit(1).Find(&inv).Error != nil || inv.Id == 0 {
+			continue
+		}
+		if pick == nil {
+			c := inv
+			pick = &c
+		} else if inv.ClientId != pick.ClientId {
+			return nil
+		}
+	}
+	if pick == nil {
+		return nil
+	}
+	return nextecSuggestionFor(pick, "download", "o convite \""+pick.Label+"\" foi baixado deste mesmo IP nas últimas 72 horas")
+}
+
+func nextecSuggestionFor(inv *model.NextecInstallInvite, source, reason string) *NextecClientSuggestion {
+	g := AllService.GroupService.DeviceGroupInfoById(inv.ClientId)
+	if g.Id == 0 {
+		return nil
+	}
+	return &NextecClientSuggestion{ClientId: g.Id, Client: NextecGroupPath(g.Id), Source: source, Invite: inv.Label, Reason: reason}
+}
diff --git a/service/nextec_invite_suggest_test.go b/service/nextec_invite_suggest_test.go
new file mode 100644
index 0000000..b9f5195
--- /dev/null
+++ b/service/nextec_invite_suggest_test.go
@@ -0,0 +1,72 @@
+package service
+
+import (
+	"testing"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+)
+
+func TestInviteSuggestsClientFromDownloadIPAndInvalidCode(t *testing.T) {
+	db, token := enrollPending(t, "10.9.0.1")
+	inv7, err := NextecInviteCreate(nil, inviteBase()) // cliente 7
+	if err != nil {
+		t.Fatal(err)
+	}
+	in8 := inviteBase()
+	in8.ClientID, in8.Label = 8, "Filial B"
+	inv8, err := NextecInviteCreate(nil, in8)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s := NextecSuggestClient(enrollPeer, "200.1.1.1"); s != nil {
+		t.Fatalf("sem download nem convite não há sugestão: %+v", s)
+	}
+	// download do convite do cliente A no mesmo IP: sugere o cliente A
+	NextecInviteMarkDownload(inv7.Invite.Id, "200.1.1.1")
+	s := NextecSuggestClient(enrollPeer, "200.1.1.1")
+	if s == nil || s.ClientId != 7 || s.Source != "download" || s.Client != "Cliente A" {
+		t.Fatalf("download: %+v", s)
+	}
+	if NextecSuggestClient(enrollPeer, "200.9.9.9") != nil {
+		t.Fatal("outro IP não deveria sugerir")
+	}
+	// dois clientes diferentes no mesmo IP: ambíguo, sem sugestão
+	NextecInviteMarkDownload(inv8.Invite.Id, "200.1.1.1")
+	if s := NextecSuggestClient(enrollPeer, "200.1.1.1"); s != nil {
+		t.Fatalf("IP com dois clientes deveria ficar sem sugestão: %+v", s)
+	}
+	// download vencido (mais de 72 h) não conta
+	db.Model(&model.NextecInviteDownload{}).Where("1 = 1").Update("at", time.Now().Unix()-80*3600)
+	if s := NextecSuggestClient(enrollPeer, "200.1.1.1"); s != nil {
+		t.Fatalf("download antigo não deveria sugerir: %+v", s)
+	}
+	// o agente apresentou um código que o servidor não aceitou: sugere o cliente do convite, qualquer que seja o IP
+	if err := NextecInviteRevoke(inv8.Invite.Id); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := NextecInviteClaim("10.9.0.1", enrollPeer, token, inv8.Code); err == nil {
+		t.Fatal("convite cancelado deveria falhar")
+	}
+	s = NextecSuggestClient(enrollPeer, "")
+	if s == nil || s.ClientId != 8 || s.Source != "convite" || s.Invite != "Filial B" {
+		t.Fatalf("convite recusado: %+v", s)
+	}
+	// aparece na lista de Senhas do servidor só para quem está pendente e sem cliente
+	db.Model(&model.Peer{}).Where("id = ?", enrollPeer).Update("last_online_ip", "200.1.1.1")
+	var got *NextecSecretDevice
+	for _, d := range NextecSecretDevices() {
+		if d.PeerId == enrollPeer {
+			got = d
+		}
+	}
+	if got == nil || got.Suggested == nil || got.Suggested.ClientId != 8 {
+		t.Fatalf("lista de pendentes sem a sugestão: %+v", got)
+	}
+	setPeerGroup(t, db, 7)
+	for _, d := range NextecSecretDevices() {
+		if d.PeerId == enrollPeer && d.Suggested != nil {
+			t.Fatal("máquina que já tem cliente não recebe sugestão")
+		}
+	}
+}
