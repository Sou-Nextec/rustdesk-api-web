diff --git a/service/nextec_inherit_test.go b/service/nextec_inherit_test.go
new file mode 100644
index 0000000..f230e23
--- /dev/null
+++ b/service/nextec_inherit_test.go
@@ -0,0 +1,299 @@
+package service
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+)
+
+// Itens 3 e 11a: herança global > cliente > subgrupo > dispositivo, origem da regra e aprovação automática.
+// Árvore: Cliente A (7) > Filial (9) > Caixa (11); Cliente A > Loja (10); Cliente B (8) sem filhos.
+
+func inheritSetup(t *testing.T) *gorm.DB {
+	t.Helper()
+	db := enrollSetup(t)
+	if err := db.AutoMigrate(&model.NextecAppPolicy{}); err != nil {
+		t.Fatal(err)
+	}
+	for _, g := range []model.DeviceGroup{
+		{IdModel: model.IdModel{Id: 9}, Name: "Cliente A / Filial", ParentId: 7},
+		{IdModel: model.IdModel{Id: 10}, Name: "Cliente A / Loja", ParentId: 7},
+		{IdModel: model.IdModel{Id: 11}, Name: "Cliente A / Filial / Caixa", ParentId: 9},
+	} {
+		g := g
+		if err := db.Create(&g).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	return db
+}
+
+func secretRule(t *testing.T, kind, ref string, enabled bool, interval int, auto *bool) {
+	t.Helper()
+	if _, err := NextecSecretUpsertPolicyOpts(kind, ref, enabled, interval, auto); err != nil {
+		t.Fatalf("regra %s/%s: %v", kind, ref, err)
+	}
+}
+
+func boolp(b bool) *bool { return &b }
+
+func TestSecretRuleInheritanceOrderAndOrigin(t *testing.T) {
+	inheritSetup(t)
+	check := func(label, peer string, group uint, wantOrigin string, wantEnabled bool, wantInterval int, wantGroup uint) {
+		t.Helper()
+		r := NextecSecretEffective(peer, group)
+		if r.Origin != wantOrigin || r.Enabled != wantEnabled || r.Interval != wantInterval || r.OriginGroupID != wantGroup {
+			t.Fatalf("%s: %+v (esperado %s enabled=%v %d grupo %d)", label, r, wantOrigin, wantEnabled, wantInterval, wantGroup)
+		}
+		en, iv := effectivePolicy(peer, group)
+		if wantOrigin == NextecOriginNone {
+			en, iv = false, 0
+		}
+		if en != wantEnabled && wantOrigin != NextecOriginNone {
+			t.Fatalf("%s: effectivePolicy diverge: %v %d", label, en, iv)
+		}
+	}
+	check("sem nenhuma regra", enrollPeer, 11, NextecOriginNone, false, 0, 0)
+
+	secretRule(t, NextecKindGlobal, "qualquer", true, 240, nil)
+	check("global vale para quem tem cliente", enrollPeer, 11, NextecOriginGlobal, true, 240, 0)
+	check("global vale para quem não tem cliente", enrollPeer, 0, NextecOriginGlobal, true, 240, 0)
+
+	secretRule(t, "group", "7", true, 60, nil)
+	check("cliente vence a global", enrollPeer, 8, NextecOriginGlobal, true, 240, 0) // outro cliente: segue a global
+	check("subgrupo herda do cliente", enrollPeer, 10, NextecOriginGroup, true, 60, 7)
+	check("sub-subgrupo herda do cliente", enrollPeer, 11, NextecOriginGroup, true, 60, 7)
+
+	secretRule(t, "group", "9", true, 30, nil)
+	check("subgrupo vence o cliente", enrollPeer, 9, NextecOriginGroup, true, 30, 9)
+	check("sub-subgrupo herda do subgrupo, não do cliente", enrollPeer, 11, NextecOriginGroup, true, 30, 9)
+	check("irmão do subgrupo continua com o cliente", enrollPeer, 10, NextecOriginGroup, true, 60, 7)
+
+	secretRule(t, "group", "9", false, 30, nil)
+	check("subgrupo desligado vence o cliente ligado", enrollPeer, 11, NextecOriginGroup, false, 30, 9)
+
+	secretRule(t, "peer", enrollPeer, true, 15, nil)
+	check("dispositivo vence tudo", enrollPeer, 11, NextecOriginPeer, true, 15, 0)
+	secretRule(t, "peer", enrollPeer, false, 15, nil)
+	check("dispositivo desligado vence tudo", enrollPeer, 10, NextecOriginPeer, false, 15, 0)
+
+	if r := NextecSecretEffective(enrollPeer, 10); r.OriginName != "" {
+		t.Fatalf("nome de origem só vale para grupo: %+v", r)
+	}
+	if r := NextecSecretEffective("999", 11); r.OriginName != "Cliente A / Filial" || r.Origin != NextecOriginGroup {
+		t.Fatalf("nome da origem: %+v", r)
+	}
+}
+
+func TestSecretPolicyUpsertGlobalAndAutoApproveValidation(t *testing.T) {
+	db := inheritSetup(t)
+	if _, err := NextecSecretUpsertPolicyOpts("tudo", "x", true, 60, nil); err == nil {
+		t.Fatal("kind desconhecido aceito")
+	}
+	if _, err := NextecSecretUpsertPolicyOpts("peer", enrollPeer, true, 60, boolp(true)); err == nil {
+		t.Fatal("aprovar sozinho em máquina deveria ser recusado")
+	}
+	p, err := NextecSecretUpsertPolicyOpts(NextecKindGlobal, "lixo", true, 60, boolp(true))
+	if err != nil || p.Ref != NextecGlobalRef || !p.AutoApprove {
+		t.Fatalf("global: %+v %v", p, err)
+	}
+	// uma só regra global, mesmo chamando com refs diferentes; nil mantém o valor
+	if _, err := NextecSecretUpsertPolicyOpts(NextecKindGlobal, "outro", true, 90, nil); err != nil {
+		t.Fatal(err)
+	}
+	var n int64
+	db.Model(&model.NextecSecretPolicy{}).Where("kind = ?", NextecKindGlobal).Count(&n)
+	g := NextecSecretPolicyGet(NextecKindGlobal, "x")
+	if n != 1 || g == nil || g.IntervalMinutes != 90 || !g.AutoApprove {
+		t.Fatalf("global duplicada ou perdeu auto_approve: n=%d %+v", n, g)
+	}
+	if _, err := NextecSecretUpsertPolicyOpts(NextecKindGlobal, "x", true, 90, boolp(false)); err != nil {
+		t.Fatal(err)
+	}
+	if g := NextecSecretPolicyGet(NextecKindGlobal, "x"); g.AutoApprove {
+		t.Fatal("auto_approve não desligou")
+	}
+	if err := NextecSecretDeletePolicy(NextecKindGlobal, "y"); err != nil || NextecSecretPolicyGet(NextecKindGlobal, "z") != nil {
+		t.Fatalf("remover global: %v", err)
+	}
+	if !strings.Contains(NextecSecretPolicyText(&model.NextecSecretPolicy{Enabled: true, IntervalMinutes: 30, AutoApprove: true}), "aprova sozinho") ||
+		NextecSecretPolicyText(nil) != "sem regra" {
+		t.Fatal("texto de auditoria")
+	}
+}
+
+func TestAppPolicyInheritanceOrderAndOrigin(t *testing.T) {
+	db := inheritSetup(t)
+	mk := func(kind, ref string, enabled bool, opts string) {
+		t.Helper()
+		p := &model.NextecAppPolicy{Kind: kind, Ref: ref, Options: opts, ModifiedAt: 1}
+		if err := db.Create(p).Error; err != nil {
+			t.Fatal(err)
+		}
+		if enabled {
+			db.Model(p).Update("enabled", true)
+		}
+	}
+	if _, err := NextecPolicyUpsert(NextecKindGlobal, "x", true, map[string]string{"enable-clipboard": "N"}); err != nil {
+		t.Fatal(err)
+	}
+	r := NextecAppEffective(enrollPeer, 11)
+	if r.Policy == nil || r.Origin != NextecOriginGlobal || nextecEffectivePolicy(enrollPeer, 11) == nil {
+		t.Fatalf("global: %+v", r)
+	}
+	mk("group", "7", true, `{"enable-file-transfer":"N"}`)
+	r = NextecAppEffective(enrollPeer, 11)
+	if r.Origin != NextecOriginGroup || r.OriginGroupID != 7 || !strings.Contains(r.Policy.Options, "file-transfer") {
+		t.Fatalf("cliente: %+v", r)
+	}
+	mk("group", "9", false, `{"enable-audio":"N"}`) // desligada na política do app: ignorada, a busca continua
+	if r = NextecAppEffective(enrollPeer, 11); r.OriginGroupID != 7 {
+		t.Fatalf("subgrupo desligado deveria ser ignorado: %+v", r)
+	}
+	db.Model(&model.NextecAppPolicy{}).Where("kind = ? AND ref = ?", "group", "9").Update("enabled", true)
+	if r = NextecAppEffective(enrollPeer, 11); r.OriginGroupID != 9 || r.OriginName != "Cliente A / Filial" {
+		t.Fatalf("subgrupo: %+v", r)
+	}
+	mk("peer", enrollPeer, true, `{"enable-tunnel":"N"}`)
+	if r = NextecAppEffective(enrollPeer, 11); r.Origin != NextecOriginPeer {
+		t.Fatalf("máquina: %+v", r)
+	}
+	if r = NextecAppEffective("999", 8); r.Origin != NextecOriginGlobal {
+		t.Fatalf("outro cliente cai na global: %+v", r)
+	}
+	if _, err := NextecPolicyUpsert("tudo", "x", true, nil); err == nil {
+		t.Fatal("kind desconhecido aceito")
+	}
+	if g := NextecPolicyGet(NextecKindGlobal, "x"); g == nil || NextecAppPolicyText(g) == "" {
+		t.Fatal("NextecPolicyGet global")
+	}
+}
+
+func TestSelfEnrollAutoApprovesOnlyUnderInheritedAutoRule(t *testing.T) {
+	db := inheritSetup(t)
+	enroll := func() *NextecSelfEnrollResult {
+		t.Helper()
+		res, err := NextecSelfEnroll("10.9.0.1", enrollKey(t), enrollPeer, enrollUUID, enrollToken())
+		if err != nil {
+			t.Fatal(err)
+		}
+		return res
+	}
+	reset := func(group uint) {
+		t.Helper()
+		db.Where("peer_id = ?", enrollPeer).Delete(&model.NextecDeviceSecret{})
+		db.Model(&model.Peer{}).Where("id = ?", enrollPeer).Update("group_id", group)
+	}
+	// regra do cliente sem "aprovar sozinho": continua pendente
+	secretRule(t, "group", "7", true, 60, nil)
+	reset(9)
+	if res := enroll(); res.State != NextecStatePending || !deviceRow(t, db, enrollPeer).AwaitingApproval {
+		t.Fatalf("sem auto_approve deveria ficar pendente: %+v", res)
+	}
+	// com "aprovar sozinho" no cliente, a máquina do subgrupo entra aprovada, sem pendência
+	secretRule(t, "group", "7", true, 60, boolp(true))
+	reset(9)
+	res := enroll()
+	d := deviceRow(t, db, enrollPeer)
+	if res.State != NextecStateAssigned || d.AwaitingApproval || d.ApprovedAt == 0 || d.ApprovedBy != 0 || !d.ForceRotate || NextecEnrollPendingCount() != 0 {
+		t.Fatalf("aprovação automática: %+v %+v pendentes=%d", res, d, NextecEnrollPendingCount())
+	}
+	if auditCount(db, "enroll_auto_approved") != 1 {
+		t.Fatal("aprovação automática sem auditoria")
+	}
+	var a model.NextecSecretAudit
+	db.Where("action = ?", "enroll_auto_approved").First(&a)
+	if !strings.Contains(a.Detail, "Cliente A") || !strings.Contains(a.Detail, "Cliente A / Filial") {
+		t.Fatalf("auditoria deveria dizer de onde herdou e o cliente: %q", a.Detail)
+	}
+	// sem cliente a máquina nunca entra sozinha, mesmo com regra global que aprova
+	secretRule(t, NextecKindGlobal, "g", true, 60, boolp(true))
+	reset(0)
+	if res := enroll(); res.State != NextecStatePending {
+		t.Fatalf("máquina sem cliente não pode entrar sozinha: %+v", res)
+	}
+	// com cliente e só a regra global que aprova, entra
+	reset(8)
+	if res := enroll(); res.State != NextecStateAssigned {
+		t.Fatalf("global com auto_approve e máquina com cliente: %+v", res)
+	}
+	// regra do subgrupo SEM auto_approve vence a do cliente que aprova
+	secretRule(t, "group", "9", true, 30, boolp(false))
+	reset(11)
+	if res := enroll(); res.State != NextecStatePending {
+		t.Fatalf("a regra mais próxima (subgrupo, sem auto) deveria valer: %+v", res)
+	}
+	// linha sem agente (token vazio) é reaproveitada pela mesma regra
+	secretRule(t, "group", "9", true, 30, boolp(true))
+	reset(9)
+	db.Create(&model.NextecDeviceSecret{PeerId: enrollPeer, TokenHash: ""})
+	if res := enroll(); res.State != NextecStateAssigned || deviceRow(t, db, enrollPeer).AwaitingApproval {
+		t.Fatalf("linha sem agente reaproveitada: %+v", res)
+	}
+}
+
+func TestSecretDevicesListIncludesSubgroupsAndGlobalWithOrigin(t *testing.T) {
+	db := inheritSetup(t)
+	mk := func(id string, group uint) {
+		db.Create(&model.Peer{Id: id, Uuid: "u-" + id, Hostname: "H" + id, GroupId: group})
+	}
+	mk("200000001", 9)  // subgrupo Filial
+	mk("200000002", 11) // sub-subgrupo
+	mk("200000003", 8)  // outro cliente
+	secretRule(t, "group", "7", true, 60, nil)
+	find := func(list []*NextecSecretDevice, id string) *NextecSecretDevice {
+		for _, d := range list {
+			if d.PeerId == id {
+				return d
+			}
+		}
+		return nil
+	}
+	list := NextecSecretDevices()
+	a, b := find(list, "200000001"), find(list, "200000002")
+	if a == nil || b == nil || !a.Managed || !b.Managed || a.RuleOrigin != "group" || a.RuleOriginName != "Cliente A" || a.IntervalMin != 60 {
+		t.Fatalf("subgrupos deveriam herdar a regra do cliente: %+v %+v", a, b)
+	}
+	if find(list, "200000003") != nil {
+		t.Fatal("máquina de outro cliente apareceu sem regra aplicável")
+	}
+	secretRule(t, NextecKindGlobal, "g", true, 240, nil)
+	list = NextecSecretDevices()
+	c := find(list, "200000003")
+	if c == nil || !c.Managed || c.RuleOrigin != "global" || c.IntervalMin != 240 {
+		t.Fatalf("a regra global deveria alcançar todas as máquinas: %+v", c)
+	}
+	if a2 := find(list, "200000001"); a2.RuleOrigin != "group" || a2.IntervalMin != 60 {
+		t.Fatalf("a regra do cliente continua valendo sobre a global: %+v", a2)
+	}
+	_ = db
+}
+
+func TestPolicyScopesShowEffectiveRuleAndOriginPerGroup(t *testing.T) {
+	db := inheritSetup(t)
+	db.Create(&model.Peer{Id: "300000001", Uuid: "u1", GroupId: 9})
+	secretRule(t, "group", "7", true, 60, nil)
+	secretRule(t, "group", "11", true, 20, nil)
+	db.Create(&model.NextecAppPolicy{Kind: "group", Ref: "7", Enabled: true, Options: `{"enable-audio":"N"}`})
+	rows := map[uint]*NextecPolicyScopeRow{}
+	for _, r := range NextecPolicyScopes() {
+		rows[r.GroupID] = r
+	}
+	if len(rows) != 5 {
+		t.Fatalf("grupos: %d", len(rows))
+	}
+	if r := rows[7]; !r.OwnSecret || r.Secret.Origin != "group" || r.Secret.OriginGroupID != 7 || !r.OwnApp || !r.AppEnabled {
+		t.Fatalf("cliente: %+v", r)
+	}
+	if r := rows[9]; r.OwnSecret || r.Secret.OriginGroupID != 7 || r.Secret.OriginName != "Cliente A" || r.Devices != 1 || r.AppOrigin.OriginName != "Cliente A" || r.AppOptions["enable-audio"] != "N" {
+		t.Fatalf("subgrupo herdando: %+v", r)
+	}
+	if r := rows[11]; !r.OwnSecret || r.Secret.Interval != 20 || r.Path != "Cliente A / Filial / Caixa" {
+		t.Fatalf("sub-subgrupo com regra própria: %+v", r)
+	}
+	if r := rows[8]; r.Secret.Origin != "none" || r.AppEnabled || r.AppOrigin.Origin != "none" {
+		t.Fatalf("outro cliente isolado: %+v", r)
+	}
+}
