diff --git a/service/nextec_policy_inherit.go b/service/nextec_policy_inherit.go
new file mode 100644
index 0000000..83e2584
--- /dev/null
+++ b/service/nextec_policy_inherit.go
@@ -0,0 +1,299 @@
+package service
+
+import (
+	"encoding/json"
+	"sort"
+	"strconv"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+)
+
+// Herança de regras: global, cliente, subgrupo e dispositivo. Vale a regra MAIS PRÓXIMA da máquina, inteira
+// (dispositivo > subgrupo > cliente > global). Na regra de senha, uma regra de grupo desligada também vale e encerra a
+// busca (exceção deliberada); na política do app, uma regra desligada é ignorada e a busca continua.
+
+const (
+	NextecKindGlobal = "global"
+	NextecGlobalRef  = "global"
+
+	NextecOriginPeer   = "peer"
+	NextecOriginGroup  = "group"
+	NextecOriginGlobal = "global"
+	NextecOriginNone   = "none"
+)
+
+// NextecRuleOrigin diz de onde vem a regra efetiva de uma máquina (ou de um grupo).
+type NextecRuleOrigin struct {
+	Origin        string `json:"origin"`                    // peer | group | global | none
+	OriginGroupID uint   `json:"origin_group_id,omitempty"` // grupo da regra quando Origin == group
+	OriginName    string `json:"origin_name,omitempty"`     // "Cliente / Sub" quando Origin == group
+}
+
+// NextecSecretRule é a regra efetiva de troca de senha.
+type NextecSecretRule struct {
+	Enabled     bool `json:"enabled"`
+	Interval    int  `json:"interval_minutes"`
+	AutoApprove bool `json:"auto_approve"`
+	NextecRuleOrigin
+}
+
+func nextecNormalizePolicyRef(kind, ref string) string {
+	if kind == NextecKindGlobal {
+		return NextecGlobalRef
+	}
+	return ref
+}
+
+// nextecResolveSecret é a regra pura: recebe as regras já lidas.
+func nextecResolveSecret(own *model.NextecSecretPolicy, chain []uint, byGroup map[uint]*model.NextecSecretPolicy, global *model.NextecSecretPolicy) NextecSecretRule {
+	if own != nil {
+		return NextecSecretRule{Enabled: own.Enabled, Interval: own.IntervalMinutes, NextecRuleOrigin: NextecRuleOrigin{Origin: NextecOriginPeer}}
+	}
+	for _, id := range chain {
+		if p := byGroup[id]; p != nil {
+			return NextecSecretRule{Enabled: p.Enabled, Interval: p.IntervalMinutes, AutoApprove: p.AutoApprove,
+				NextecRuleOrigin: NextecRuleOrigin{Origin: NextecOriginGroup, OriginGroupID: id}}
+		}
+	}
+	if global != nil {
+		return NextecSecretRule{Enabled: global.Enabled, Interval: global.IntervalMinutes, AutoApprove: global.AutoApprove,
+			NextecRuleOrigin: NextecRuleOrigin{Origin: NextecOriginGlobal}}
+	}
+	return NextecSecretRule{NextecRuleOrigin: NextecRuleOrigin{Origin: NextecOriginNone}}
+}
+
+func nextecSecretEffectiveTx(tx *gorm.DB, peerID string, groupID uint) NextecSecretRule {
+	var own *model.NextecSecretPolicy
+	if peerID != "" {
+		p := &model.NextecSecretPolicy{}
+		if tx.Where("kind = ? and ref = ?", "peer", peerID).Limit(1).Find(p).Error == nil && p.Id != 0 {
+			own = p
+		}
+	}
+	chain := nextecGroupChainTx(tx, groupID)
+	byGroup := map[uint]*model.NextecSecretPolicy{}
+	if len(chain) > 0 {
+		refs := make([]string, len(chain))
+		for i, id := range chain {
+			refs[i] = strconv.FormatUint(uint64(id), 10)
+		}
+		var rows []*model.NextecSecretPolicy
+		tx.Where("kind = ? and ref in ?", "group", refs).Find(&rows)
+		for _, r := range rows {
+			if id, err := strconv.ParseUint(r.Ref, 10, 64); err == nil {
+				byGroup[uint(id)] = r
+			}
+		}
+	}
+	var global *model.NextecSecretPolicy
+	g := &model.NextecSecretPolicy{}
+	if tx.Where("kind = ? and ref = ?", NextecKindGlobal, NextecGlobalRef).Limit(1).Find(g).Error == nil && g.Id != 0 {
+		global = g
+	}
+	rule := nextecResolveSecret(own, chain, byGroup, global)
+	if rule.Origin == NextecOriginGroup {
+		rule.OriginName = nextecGroupPathTx(tx, rule.OriginGroupID)
+	}
+	return rule
+}
+
+// NextecSecretEffective é a regra de senha efetiva de uma máquina, com a origem.
+func NextecSecretEffective(peerID string, groupID uint) NextecSecretRule {
+	return nextecSecretEffectiveTx(DB, peerID, groupID)
+}
+
+// NextecAppRule é a política efetiva do app (opções) com a origem. Policy nulo: nenhuma regra ligada vale.
+type NextecAppRule struct {
+	Policy *model.NextecAppPolicy
+	NextecRuleOrigin
+}
+
+func nextecResolveApp(own *model.NextecAppPolicy, chain []uint, byGroup map[uint]*model.NextecAppPolicy, global *model.NextecAppPolicy) NextecAppRule {
+	if own != nil && own.Enabled {
+		return NextecAppRule{Policy: own, NextecRuleOrigin: NextecRuleOrigin{Origin: NextecOriginPeer}}
+	}
+	for _, id := range chain {
+		if p := byGroup[id]; p != nil && p.Enabled {
+			return NextecAppRule{Policy: p, NextecRuleOrigin: NextecRuleOrigin{Origin: NextecOriginGroup, OriginGroupID: id}}
+		}
+	}
+	if global != nil && global.Enabled {
+		return NextecAppRule{Policy: global, NextecRuleOrigin: NextecRuleOrigin{Origin: NextecOriginGlobal}}
+	}
+	return NextecAppRule{NextecRuleOrigin: NextecRuleOrigin{Origin: NextecOriginNone}}
+}
+
+func nextecAppEffectiveTx(tx *gorm.DB, peerID string, groupID uint) NextecAppRule {
+	var own *model.NextecAppPolicy
+	if peerID != "" {
+		p := &model.NextecAppPolicy{}
+		if tx.Where("kind = ? AND ref = ?", "peer", peerID).Limit(1).Find(p).Error == nil && p.Id != 0 {
+			own = p
+		}
+	}
+	chain := nextecGroupChainTx(tx, groupID)
+	byGroup := map[uint]*model.NextecAppPolicy{}
+	if len(chain) > 0 {
+		refs := make([]string, len(chain))
+		for i, id := range chain {
+			refs[i] = strconv.FormatUint(uint64(id), 10)
+		}
+		var rows []*model.NextecAppPolicy
+		tx.Where("kind = ? AND ref IN ?", "group", refs).Find(&rows)
+		for _, r := range rows {
+			if id, err := strconv.ParseUint(r.Ref, 10, 64); err == nil {
+				byGroup[uint(id)] = r
+			}
+		}
+	}
+	var global *model.NextecAppPolicy
+	g := &model.NextecAppPolicy{}
+	if tx.Where("kind = ? AND ref = ?", NextecKindGlobal, NextecGlobalRef).Limit(1).Find(g).Error == nil && g.Id != 0 {
+		global = g
+	}
+	rule := nextecResolveApp(own, chain, byGroup, global)
+	if rule.Origin == NextecOriginGroup {
+		rule.OriginName = nextecGroupPathTx(tx, rule.OriginGroupID)
+	}
+	return rule
+}
+
+// NextecAppEffective é a política do app efetiva de uma máquina, com a origem.
+func NextecAppEffective(peerID string, groupID uint) NextecAppRule {
+	return nextecAppEffectiveTx(DB, peerID, groupID)
+}
+
+// ---------- visão por cliente e subgrupo (tela Políticas) ----------
+
+type NextecPolicyScopeRow struct {
+	GroupID    uint              `json:"group_id"`
+	Name       string            `json:"name"`
+	Path       string            `json:"path"`
+	ParentID   uint              `json:"parent_id"`
+	Devices    int               `json:"devices"`
+	OwnSecret  bool              `json:"own_secret"`
+	OwnApp     bool              `json:"own_app"`
+	Secret     NextecSecretRule  `json:"secret"`
+	AppEnabled bool              `json:"app_enabled"`
+	AppOptions map[string]string `json:"app_options,omitempty"`
+	AppOrigin  NextecRuleOrigin  `json:"app_origin"`
+}
+
+// NextecPolicyScopes devolve, para cada cliente e subgrupo, a regra efetiva (própria ou herdada) e a origem.
+// Lê grupos e regras uma vez só; sem consulta por grupo.
+func NextecPolicyScopes() []*NextecPolicyScopeRow {
+	var groups []*model.DeviceGroup
+	DB.Order("id").Find(&groups)
+	NextecFillGroupPaths(groups)
+	byID := map[uint]*model.DeviceGroup{}
+	for _, g := range groups {
+		byID[g.Id] = g
+	}
+	chainOf := func(id uint) []uint {
+		chain := []uint{}
+		seen := map[uint]bool{}
+		for cur := id; cur != 0 && !seen[cur] && len(chain) < nextecGroupMaxDepth; {
+			g := byID[cur]
+			if g == nil {
+				break
+			}
+			seen[cur] = true
+			chain = append(chain, cur)
+			cur = g.ParentId
+		}
+		return chain
+	}
+	var secrets []*model.NextecSecretPolicy
+	DB.Find(&secrets)
+	secByGroup := map[uint]*model.NextecSecretPolicy{}
+	var secGlobal *model.NextecSecretPolicy
+	for _, p := range secrets {
+		switch p.Kind {
+		case "group":
+			if id, err := strconv.ParseUint(p.Ref, 10, 64); err == nil {
+				secByGroup[uint(id)] = p
+			}
+		case NextecKindGlobal:
+			secGlobal = p
+		}
+	}
+	var apps []*model.NextecAppPolicy
+	DB.Find(&apps)
+	appByGroup := map[uint]*model.NextecAppPolicy{}
+	var appGlobal *model.NextecAppPolicy
+	for _, p := range apps {
+		switch p.Kind {
+		case "group":
+			if id, err := strconv.ParseUint(p.Ref, 10, 64); err == nil {
+				appByGroup[uint(id)] = p
+			}
+		case NextecKindGlobal:
+			appGlobal = p
+		}
+	}
+	counts := map[uint]int{}
+	var cs []struct {
+		GroupId uint
+		N       int
+	}
+	DB.Model(&model.Peer{}).Select("group_id, count(*) as n").Group("group_id").Scan(&cs)
+	for _, c := range cs {
+		counts[c.GroupId] = c.N
+	}
+	out := make([]*NextecPolicyScopeRow, 0, len(groups))
+	for _, g := range groups {
+		chain := chainOf(g.Id)
+		row := &NextecPolicyScopeRow{GroupID: g.Id, Name: g.Name, Path: g.Path, ParentID: g.ParentId, Devices: counts[g.Id],
+			OwnSecret: secByGroup[g.Id] != nil, OwnApp: appByGroup[g.Id] != nil && appByGroup[g.Id].Enabled}
+		row.Secret = nextecResolveSecret(nil, chain, secByGroup, secGlobal)
+		if row.Secret.Origin == NextecOriginGroup {
+			if og := byID[row.Secret.OriginGroupID]; og != nil {
+				row.Secret.OriginName = og.Path
+			}
+		}
+		app := nextecResolveApp(nil, chain, appByGroup, appGlobal)
+		row.AppOrigin = app.NextecRuleOrigin
+		if app.Origin == NextecOriginGroup {
+			if og := byID[app.OriginGroupID]; og != nil {
+				row.AppOrigin.OriginName = og.Path
+			}
+		}
+		if app.Policy != nil {
+			row.AppEnabled = true
+			opts := map[string]string{}
+			_ = json.Unmarshal([]byte(app.Policy.Options), &opts)
+			row.AppOptions = opts
+		}
+		out = append(out, row)
+	}
+	sort.SliceStable(out, func(i, j int) bool { return out[i].Path < out[j].Path })
+	return out
+}
+
+// NextecSecretPolicyText descreve uma regra de senha para a auditoria ("sem regra" quando nula).
+func NextecSecretPolicyText(p *model.NextecSecretPolicy) string {
+	if p == nil {
+		return "sem regra"
+	}
+	if !p.Enabled {
+		return "desligada"
+	}
+	t := "ligada, troca a cada " + strconv.Itoa(p.IntervalMinutes) + " min"
+	if p.AutoApprove {
+		t += ", aprova sozinho"
+	}
+	return t
+}
+
+// NextecAppPolicyText descreve uma política do app para a auditoria ("sem regra" quando nula).
+func NextecAppPolicyText(p *model.NextecAppPolicy) string {
+	if p == nil {
+		return "sem regra"
+	}
+	state := "desligada"
+	if p.Enabled {
+		state = "ligada"
+	}
+	return state + " " + p.Options
+}
