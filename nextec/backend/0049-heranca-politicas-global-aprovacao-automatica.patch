+		response.Fail(c, 101, response.TranslateMsg(c, "ParamsError"))
+		return
+	}
+	pr := &model.Peer{}
+	if service.DB.Where("id = ?", peerID).Limit(1).Find(pr).Error != nil || pr.Id == "" {
+		response.Fail(c, 101, response.TranslateMsg(c, "ItemNotFound"))
+		return
+	}
+	secret := service.NextecSecretEffective(peerID, pr.GroupId)
+	app := service.NextecAppEffective(peerID, pr.GroupId)
+	opts := map[string]string{}
+	if app.Policy != nil {
+		_ = json.Unmarshal([]byte(app.Policy.Options), &opts)
+	}
+	response.Success(c, &gin.H{
+		"peer_id": peerID, "group_id": pr.GroupId, "group_path": service.NextecGroupPath(pr.GroupId),
+		"secret": secret,
+		"app":    gin.H{"enabled": app.Policy != nil, "options": opts, "origin": app.NextecRuleOrigin},
+	})
+}
