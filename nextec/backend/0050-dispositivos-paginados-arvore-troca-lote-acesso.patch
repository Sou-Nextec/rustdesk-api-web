diff --git a/service/nextec_access.go b/service/nextec_access.go
new file mode 100644
index 0000000..5fce471
--- /dev/null
+++ b/service/nextec_access.go
@@ -0,0 +1,365 @@
+package service
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+)
+
+// Acesso por equipe ou pessoa a clientes (listas "Cliente: X") e a máquinas avulsas (listas "Máquina: nome (id)").
+// As mesmas regras da tela Acesso dos clientes: a lista pertence ao admin que concede, e a regra liga a lista à equipe
+// (type 2) ou à pessoa (type 1). O acesso de uma pessoa é a soma da regra dela com a da equipe dela.
+
+const (
+	NextecMachineListPrefix = "Máquina: "
+	nextecScopeClient       = "client"
+	nextecScopeMachine      = "machine"
+)
+
+type NextecAccessGrantReq struct {
+	TargetType int    // 1 = pessoa, 2 = equipe
+	TargetID   uint   //
+	Scope      string // client | machine
+	GroupID    uint   // cliente ou subgrupo (scope client)
+	PeerID     string // máquina (scope machine)
+	Rule       int    // 1 = só ver, 2 = ver e editar
+	Remove     bool   // tira o acesso
+}
+
+type NextecAccessGrantResult struct {
+	CollectionID uint   `json:"collection_id"`
+	Name         string `json:"name"`
+	Created      bool   `json:"created"`
+	Changed      bool   `json:"changed"` // false = já estava assim
+}
+
+func nextecTargetName(tx *gorm.DB, typ int, id uint) (string, error) {
+	switch typ {
+	case model.ShareAddressBookRuleTypePersonal:
+		var u model.User
+		if tx.Where("id = ?", id).Limit(1).Find(&u).Error != nil || u.Id == 0 {
+			return "", errors.New("pessoa não encontrada")
+		}
+		return u.Username, nil
+	case model.ShareAddressBookRuleTypeGroup:
+		var g model.Group
+		if tx.Where("id = ?", id).Limit(1).Find(&g).Error != nil || g.Id == 0 {
+			return "", errors.New("equipe não encontrada")
+		}
+		return g.Name, nil
+	}
+	return "", errors.New("tipo de destino inválido")
+}
+
+func nextecMachineLabel(p *model.Peer) string {
+	label := p.Alias
+	if label == "" {
+		label = p.Hostname
+	}
+	if label == "" {
+		label = p.Id
+	}
+	return fmt.Sprintf("%s%s (%s)", NextecMachineListPrefix, label, p.Id)
+}
+
+// nextecFindMachineList acha a lista avulsa da máquina (nome termina com "(id)") do mesmo dono.
+func nextecFindMachineList(tx *gorm.DB, owner uint, peerID string) *model.AddressBookCollection {
+	var cols []model.AddressBookCollection
+	tx.Where("user_id = ? AND name LIKE ?", owner, NextecMachineListPrefix+"%").Find(&cols)
+	suffix := "(" + peerID + ")"
+	for i := range cols {
+		if strings.HasSuffix(cols[i].Name, suffix) {
+			return &cols[i]
+		}
+	}
+	return nil
+}
+
+// NextecAccessGrant concede, altera ou tira o acesso de uma equipe/pessoa a um cliente ou a uma máquina avulsa.
+// owner é o admin que concede (dono das listas).
+func NextecAccessGrant(u *model.User, ip string, r *NextecAccessGrantReq) (*NextecAccessGrantResult, error) {
+	if u == nil || u.Id == 0 {
+		return nil, errors.New("sem usuário")
+	}
+	if !r.Remove && (r.Rule < model.ShareAddressBookRuleRuleRead || r.Rule > model.ShareAddressBookRuleRuleReadWrite) {
+		return nil, errors.New("nível de acesso inválido")
+	}
+	res := &NextecAccessGrantResult{}
+	var targetName, scopeName, auditPeer string
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		var e error
+		if targetName, e = nextecTargetName(tx, r.TargetType, r.TargetID); e != nil {
+			return e
+		}
+		var col *model.AddressBookCollection
+		switch r.Scope {
+		case nextecScopeClient:
+			var g model.DeviceGroup
+			if tx.Where("id = ?", r.GroupID).Limit(1).Find(&g).Error != nil || g.Id == 0 {
+				return errors.New("cliente ou subgrupo não encontrado")
+			}
+			scopeName = g.Name
+			want := NextecClientListPrefix + g.Name
+			var cols []model.AddressBookCollection
+			tx.Where("user_id = ?", u.Id).Find(&cols)
+			for i := range cols {
+				if strings.EqualFold(cols[i].Name, want) {
+					col = &cols[i]
+					break
+				}
+			}
+			if col == nil && !r.Remove {
+				col = &model.AddressBookCollection{UserId: u.Id, Name: want}
+				if e := tx.Create(col).Error; e != nil {
+					return e
+				}
+				res.Created = true
+			}
+		case nextecScopeMachine:
+			var p model.Peer
+			if tx.Where("id = ?", NextecCleanId(r.PeerID)).Limit(1).Find(&p).Error != nil || p.RowId == 0 {
+				return errors.New("máquina não encontrada")
+			}
+			auditPeer = p.Id
+			scopeName = nextecMachineLabel(&p)
+			col = nextecFindMachineList(tx, u.Id, p.Id)
+			if col == nil && !r.Remove {
+				col = &model.AddressBookCollection{UserId: u.Id, Name: scopeName}
+				if e := tx.Create(col).Error; e != nil {
+					return e
+				}
+				res.Created = true
+			}
+			if col != nil && !r.Remove {
+				var n int64
+				tx.Model(&model.AddressBook{}).Where("collection_id = ? AND id = ?", col.Id, p.Id).Count(&n)
+				if n == 0 {
+					if e := tx.Create(nextecEntryFromPeer(&p, u.Id, col.Id)).Error; e != nil {
+						return e
+					}
+				}
+			}
+		default:
+			return errors.New("escopo inválido")
+		}
+		if col == nil { // tirar acesso de uma lista que nunca existiu
+			return nil
+		}
+		res.CollectionID, res.Name = col.Id, col.Name
+		var rule model.AddressBookCollectionRule
+		found := tx.Where("collection_id = ? AND type = ? AND to_id = ?", col.Id, r.TargetType, r.TargetID).Limit(1).Find(&rule).Error == nil && rule.Id != 0
+		switch {
+		case r.Remove && found:
+			res.Changed = true
+			return tx.Delete(&model.AddressBookCollectionRule{}, "id = ?", rule.Id).Error
+		case r.Remove:
+			return nil
+		case found && rule.Rule == r.Rule:
+			return nil
+		case found:
+			res.Changed = true
+			return tx.Model(&model.AddressBookCollectionRule{}).Where("id = ?", rule.Id).Update("rule", r.Rule).Error
+		}
+		res.Changed = true
+		return tx.Create(&model.AddressBookCollectionRule{UserId: u.Id, CollectionId: col.Id, Rule: r.Rule, Type: r.TargetType, ToId: r.TargetID}).Error
+	})
+	if err != nil {
+		return nil, err
+	}
+	// a lista de cliente nova nasce vazia: deixa igual ao cliente (máquinas dos subgrupos incluídas)
+	if res.Created && r.Scope == nextecScopeClient {
+		if _, e := NextecReconcileClientList(u, ip, res.CollectionID); e != nil {
+			return res, fmt.Errorf("acesso concedido, mas a lista não foi preenchida: %w", e)
+		}
+	}
+	if res.Changed || res.Created {
+		who := "equipe"
+		if r.TargetType == model.ShareAddressBookRuleTypePersonal {
+			who = "pessoa"
+		}
+		level := map[int]string{1: "só ver", 2: "ver e editar"}[r.Rule]
+		action, detail := "access_grant", fmt.Sprintf("%s %s ganha %s (%s)", who, targetName, scopeName, level)
+		if r.Remove {
+			action, detail = "access_revoke", fmt.Sprintf("%s %s perde %s", who, targetName, scopeName)
+		}
+		NextecSecretAuditAdd(u, auditPeer, action, ip, detail)
+	}
+	return res, nil
+}
+
+// NextecAccessItem é um acesso que a pessoa tem, com a origem.
+type NextecAccessItem struct {
+	CollectionID uint   `json:"collection_id"`
+	Kind         string `json:"kind"`  // client | machine | other
+	Label        string `json:"label"` // "Cliente / Sub" ou "Servidor (123456789)"
+	PeerID       string `json:"peer_id,omitempty"`
+	GroupID      uint   `json:"group_id,omitempty"`
+	Rule         int    `json:"rule"`   // maior nível entre as origens
+	Origin       string `json:"origin"` // direto | equipe | direto e equipe
+	Team         string `json:"team,omitempty"`
+	Machines     int    `json:"machines"`
+}
+
+type NextecAccessUser struct {
+	UserID   uint                `json:"user_id"`
+	Username string              `json:"username"`
+	Nickname string              `json:"nickname"`
+	IsAdmin  bool                `json:"is_admin"`
+	Status   int                 `json:"status"`
+	TeamID   uint                `json:"team_id"`
+	Team     string              `json:"team"`
+	Clients  int                 `json:"clients"`
+	Machines int                 `json:"machines"` // listas avulsas
+	Items    []*NextecAccessItem `json:"items,omitempty"`
+}
+
+// nextecAccessFor monta o acesso efetivo de uma pessoa: regras dela e da equipe dela, sobre listas de clientes e avulsas.
+func nextecAccessFor(u *model.User, teamName string, withItems bool) *NextecAccessUser {
+	out := &NextecAccessUser{UserID: u.Id, Username: u.Username, Nickname: u.Nickname, IsAdmin: u.IsAdmin != nil && *u.IsAdmin, Status: int(u.Status), TeamID: u.GroupId, Team: teamName}
+	var rules []model.AddressBookCollectionRule
+	DB.Where("rule > 0 AND ((type = ? AND to_id = ?) OR (type = ? AND to_id = ?))",
+		model.ShareAddressBookRuleTypePersonal, u.Id, model.ShareAddressBookRuleTypeGroup, u.GroupId).Find(&rules)
+	if u.GroupId == 0 { // sem equipe: a regra de equipe 0 não existe
+		kept := rules[:0]
+		for _, r := range rules {
+			if r.Type == model.ShareAddressBookRuleTypePersonal {
+				kept = append(kept, r)
+			}
+		}
+		rules = kept
+	}
+	items := nextecAccessItems(rules, teamName)
+	for _, it := range items {
+		switch it.Kind {
+		case "client":
+			out.Clients++
+		case "machine":
+			out.Machines++
+		}
+	}
+	if withItems {
+		out.Items = items
+	}
+	return out
+}
+
+// nextecAccessItems junta as regras em itens (um por lista), com o maior nível e a origem.
+func nextecAccessItems(rules []model.AddressBookCollectionRule, teamName string) []*NextecAccessItem {
+	byCol := map[uint]*NextecAccessItem{}
+	for _, r := range rules {
+		it := byCol[r.CollectionId]
+		if it == nil {
+			var col model.AddressBookCollection
+			if DB.Where("id = ?", r.CollectionId).Limit(1).Find(&col).Error != nil || col.Id == 0 {
+				continue
+			}
+			it = &NextecAccessItem{CollectionID: col.Id, Kind: "other", Label: col.Name}
+			switch {
+			case strings.HasPrefix(col.Name, NextecClientListPrefix):
+				it.Kind, it.Label = "client", strings.TrimPrefix(col.Name, NextecClientListPrefix)
+				var g model.DeviceGroup
+				names := []model.DeviceGroup{}
+				DB.Find(&names)
+				for _, c := range names {
+					if strings.EqualFold(c.Name, it.Label) {
+						g = c
+						break
+					}
+				}
+				it.GroupID = g.Id
+			case strings.HasPrefix(col.Name, NextecMachineListPrefix):
+				it.Kind, it.Label = "machine", strings.TrimPrefix(col.Name, NextecMachineListPrefix)
+				if i := strings.LastIndex(it.Label, "("); i >= 0 && strings.HasSuffix(it.Label, ")") {
+					it.PeerID = it.Label[i+1 : len(it.Label)-1]
+				}
+			}
+			var n int64
+			DB.Model(&model.AddressBook{}).Where("collection_id = ?", col.Id).Count(&n)
+			it.Machines = int(n)
+			byCol[r.CollectionId] = it
+		}
+		if r.Rule > it.Rule {
+			it.Rule = r.Rule
+		}
+		switch {
+		case r.Type == model.ShareAddressBookRuleTypePersonal && it.Origin == "equipe":
+			it.Origin = "direto e equipe"
+		case r.Type == model.ShareAddressBookRuleTypePersonal && it.Origin == "":
+			it.Origin = "direto"
+		case r.Type == model.ShareAddressBookRuleTypeGroup && it.Origin == "direto":
+			it.Origin, it.Team = "direto e equipe", teamName
+		case r.Type == model.ShareAddressBookRuleTypeGroup && it.Origin == "":
+			it.Origin, it.Team = "equipe", teamName
+		}
+		if r.Type == model.ShareAddressBookRuleTypeGroup {
+			it.Team = teamName
+		}
+	}
+	items := make([]*NextecAccessItem, 0, len(byCol))
+	for _, it := range byCol {
+		items = append(items, it)
+	}
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].Kind != items[j].Kind {
+			return items[i].Kind < items[j].Kind
+		}
+		return strings.ToLower(items[i].Label) < strings.ToLower(items[j].Label)
+	})
+	return items
+}
+
+// NextecAccessUsers resume o acesso de todas as pessoas (sem os itens, para a lista).
+func NextecAccessUsers() []*NextecAccessUser {
+	var users []model.User
+	DB.Order("username").Find(&users)
+	var groups []model.Group
+	DB.Find(&groups)
+	team := map[uint]string{}
+	for _, g := range groups {
+		team[g.Id] = g.Name
+	}
+	out := make([]*NextecAccessUser, 0, len(users))
+	for i := range users {
+		out = append(out, nextecAccessFor(&users[i], team[users[i].GroupId], false))
+	}
+	return out
+}
+
+// NextecAccessUser devolve o acesso detalhado de uma pessoa.
+func NextecAccessOfUser(userID uint) (*NextecAccessUser, error) {
+	var u model.User
+	if DB.Where("id = ?", userID).Limit(1).Find(&u).Error != nil || u.Id == 0 {
+		return nil, errors.New("pessoa não encontrada")
+	}
+	team := ""
+	if u.GroupId != 0 {
+		var g model.Group
+		DB.Where("id = ?", u.GroupId).Limit(1).Find(&g)
+		team = g.Name
+	}
+	return nextecAccessFor(&u, team, true), nil
+}
+
+// NextecAccessOfTeam devolve o que a equipe acessa (clientes e máquinas avulsas), para a tela de equipes.
+func NextecAccessOfTeam(teamID uint) (*NextecAccessTeam, error) {
+	var g model.Group
+	if DB.Where("id = ?", teamID).Limit(1).Find(&g).Error != nil || g.Id == 0 {
+		return nil, errors.New("equipe não encontrada")
+	}
+	var rules []model.AddressBookCollectionRule
+	DB.Where("rule > 0 AND type = ? AND to_id = ?", model.ShareAddressBookRuleTypeGroup, teamID).Find(&rules)
+	var members int64
+	DB.Model(&model.User{}).Where("group_id = ?", teamID).Count(&members)
+	return &NextecAccessTeam{TeamID: g.Id, Name: g.Name, Members: int(members), Items: nextecAccessItems(rules, g.Name)}, nil
+}
+
+type NextecAccessTeam struct {
+	TeamID  uint                `json:"team_id"`
+	Name    string              `json:"name"`
+	Members int                 `json:"members"`
+	Items   []*NextecAccessItem `json:"items"`
+}
diff --git a/service/nextec_devices.go b/service/nextec_devices.go
new file mode 100644
index 0000000..b81e4b3
--- /dev/null
+++ b/service/nextec_devices.go
@@ -0,0 +1,274 @@
+package service
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/lejianwen/rustdesk-api/v2/model"
+	"gorm.io/gorm"
+)
+
+// Lista de dispositivos paginada no servidor: a tela não baixa mais todas as máquinas para filtrar no navegador.
+
+const (
+	nextecDevicesMaxPage = 200 // itens por página
+	nextecDevicesMaxMove = 500 // máquinas por troca em lote
+	// uma máquina conta como online se falou com o servidor nos últimos 60 s (mesma regra da tela)
+	nextecOnlineSeconds = 60
+)
+
+type NextecDeviceQuery struct {
+	Page, PageSize uint
+	Q              string // id, apelido, nome, usuário, IP ou nome do cliente
+	Ids            string // ids separados por vírgula (favoritos); no máximo 500
+	ClientID       uint   // cliente: inclui as máquinas dos subgrupos
+	SubID          uint   // subgrupo exato
+	NoClient       bool   // só as sem cliente
+	Status         string // online | offline
+	Sort           string // online | recent | client | name
+}
+
+type NextecDeviceList struct {
+	List     []*model.Peer `json:"list"`
+	Total    int64         `json:"total"`
+	Online   int64         `json:"online"` // quantas do filtro estão online
+	Page     int64         `json:"page"`
+	PageSize int64         `json:"page_size"`
+}
+
+func nextecLike(s string) string {
+	s = strings.ReplaceAll(s, `\`, `\\`)
+	s = strings.ReplaceAll(s, "%", `\%`)
+	s = strings.ReplaceAll(s, "_", `\_`)
+	return "%" + strings.ToLower(s) + "%"
+}
+
+func nextecDevicesFilter(tx *gorm.DB, q *NextecDeviceQuery, now int64) *gorm.DB {
+	switch {
+	case q.NoClient:
+		tx = tx.Where("peers.group_id = 0")
+	case q.SubID > 0:
+		tx = tx.Where("peers.group_id = ?", q.SubID)
+	case q.ClientID > 0:
+		tx = tx.Where("peers.group_id IN ?", nextecSubtree(DB, q.ClientID))
+	}
+	switch q.Status {
+	case "online":
+		tx = tx.Where("peers.last_online_time > ?", now-nextecOnlineSeconds)
+	case "offline":
+		tx = tx.Where("peers.last_online_time <= ?", now-nextecOnlineSeconds)
+	}
+	if q.Ids != "" {
+		list := []string{}
+		for _, id := range strings.Split(q.Ids, ",") {
+			if id = NextecCleanId(strings.TrimSpace(id)); id != "" && len(list) < nextecDevicesMaxMove {
+				list = append(list, id)
+			}
+		}
+		tx = tx.Where("peers.id IN ?", list)
+	}
+	if term := strings.TrimSpace(q.Q); term != "" {
+		like := nextecLike(term)
+		var gids []uint
+		DB.Model(&model.DeviceGroup{}).Where(`lower(name) LIKE ? ESCAPE '\'`, like).Pluck("id", &gids)
+		cond := `lower(peers.id) LIKE ? ESCAPE '\' OR lower(peers.alias) LIKE ? ESCAPE '\' OR lower(peers.hostname) LIKE ? ESCAPE '\' OR lower(peers.username) LIKE ? ESCAPE '\' OR lower(peers.last_online_ip) LIKE ? ESCAPE '\'`
+		args := []interface{}{like, like, like, like, like}
+		if len(gids) > 0 {
+			cond += " OR peers.group_id IN ?"
+			args = append(args, gids)
+		}
+		tx = tx.Where(cond, args...)
+	}
+	return tx
+}
+
+// NextecDevicesList devolve uma página já filtrada e ordenada. O total e o número de online valem para o filtro inteiro.
+func NextecDevicesList(q *NextecDeviceQuery) (*NextecDeviceList, error) {
+	if q.Page == 0 {
+		q.Page = 1
+	}
+	if q.PageSize == 0 {
+		q.PageSize = 20
+	}
+	if q.PageSize > nextecDevicesMaxPage {
+		q.PageSize = nextecDevicesMaxPage
+	}
+	now := time.Now().Unix()
+	res := &NextecDeviceList{Page: int64(q.Page), PageSize: int64(q.PageSize), List: []*model.Peer{}}
+	base := func() *gorm.DB { return nextecDevicesFilter(DB.Model(&model.Peer{}), q, now) }
+	if err := base().Count(&res.Total).Error; err != nil {
+		return nil, err
+	}
+	if err := base().Where("peers.last_online_time > ?", now-nextecOnlineSeconds).Count(&res.Online).Error; err != nil {
+		return nil, err
+	}
+	name := "lower(coalesce(nullif(peers.alias,''), nullif(peers.hostname,''), peers.id))"
+	tx := base().Select("peers.*")
+	switch q.Sort {
+	case "name":
+		tx = tx.Order(name)
+	case "client":
+		tx = tx.Joins("LEFT JOIN device_groups dg ON dg.id = peers.group_id").
+			Order("CASE WHEN dg.id IS NULL THEN 1 ELSE 0 END").Order("lower(dg.name)").Order(name)
+	case "recent":
+		tx = tx.Order("peers.last_online_time DESC").Order(name)
+	default: // online primeiro
+		tx = tx.Order(gorm.Expr("CASE WHEN peers.last_online_time > ? THEN 0 ELSE 1 END", now-nextecOnlineSeconds)).Order("peers.last_online_time DESC").Order(name)
+	}
+	if err := tx.Offset(int((q.Page - 1) * q.PageSize)).Limit(int(q.PageSize)).Find(&res.List).Error; err != nil {
+		return nil, err
+	}
+	return res, nil
+}
+
+// NextecDeviceTreeNode é um cliente ou subgrupo com a contagem de máquinas (diretas e com os subgrupos).
+type NextecDeviceTreeNode struct {
+	GroupID  uint   `json:"group_id"`
+	ParentID uint   `json:"parent_id"`
+	Name     string `json:"name"`
+	Path     string `json:"path"`
+	Devices  int    `json:"devices"` // direto no grupo
+	Total    int    `json:"total"`   // com os subgrupos
+	Online   int    `json:"online"`  // online, com os subgrupos
+}
+
+type NextecDeviceTree struct {
+	Nodes    []*NextecDeviceTreeNode `json:"nodes"`
+	NoClient int                     `json:"no_client"`
+	All      int                     `json:"all"`
+	Online   int                     `json:"online"`
+}
+
+// NextecDevicesTree resume clientes e subgrupos em uma consulta de contagem (sem trazer as máquinas).
+func NextecDevicesTree() (*NextecDeviceTree, error) {
+	now := time.Now().Unix()
+	type cnt struct {
+		GroupID uint
+		N       int
+		Online  int
+	}
+	var counts []cnt
+	if err := DB.Model(&model.Peer{}).
+		Select("group_id AS group_id, count(*) AS n, sum(CASE WHEN last_online_time > ? THEN 1 ELSE 0 END) AS online", now-nextecOnlineSeconds).
+		Group("group_id").Scan(&counts).Error; err != nil {
+		return nil, err
+	}
+	var groups []*model.DeviceGroup
+	if err := DB.Order("id").Find(&groups).Error; err != nil {
+		return nil, err
+	}
+	NextecFillGroupPaths(groups)
+	byID := map[uint]*NextecDeviceTreeNode{}
+	tree := &NextecDeviceTree{Nodes: []*NextecDeviceTreeNode{}}
+	for _, g := range groups {
+		n := &NextecDeviceTreeNode{GroupID: g.Id, ParentID: g.ParentId, Name: g.Name, Path: g.Path}
+		byID[g.Id] = n
+		tree.Nodes = append(tree.Nodes, n)
+	}
+	for _, c := range counts {
+		tree.All += c.N
+		tree.Online += c.Online
+		if c.GroupID == 0 {
+			tree.NoClient += c.N
+			continue
+		}
+		// soma no grupo e em todos os ancestrais
+		seen := map[uint]bool{}
+		for id := c.GroupID; id != 0 && !seen[id] && byID[id] != nil; id = byID[id].ParentID {
+			seen[id] = true
+			byID[id].Total += c.N
+			byID[id].Online += c.Online
+			if id == c.GroupID {
+				byID[id].Devices += c.N
+			}
+		}
+	}
+	return tree, nil
+}
+
+type NextecDevicesMoveResult struct {
+	Moved   int `json:"moved"`
+	Skipped int `json:"skipped"` // já estavam no grupo
+	Removed int `json:"lists_removed"`
+	Added   int `json:"lists_added"`
+}
+
+// NextecDevicesMove muda várias máquinas de cliente/subgrupo em uma transação só (ou todas, ou nenhuma), mantendo as listas
+// "Cliente: X" e gravando uma linha de auditoria por máquina.
+func NextecDevicesMove(u *model.User, ip string, rowIDs []uint, groupID uint) (*NextecDevicesMoveResult, error) {
+	if len(rowIDs) == 0 {
+		return nil, errors.New("nenhuma máquina escolhida")
+	}
+	if len(rowIDs) > nextecDevicesMaxMove {
+		return nil, fmt.Errorf("no máximo %d máquinas por vez", nextecDevicesMaxMove)
+	}
+	if groupID != 0 {
+		var n int64
+		DB.Model(&model.DeviceGroup{}).Where("id = ?", groupID).Count(&n)
+		if n == 0 {
+			return nil, errors.New("o cliente ou subgrupo não existe")
+		}
+	}
+	type audit struct{ peer, detail string }
+	var lines []audit
+	res := &NextecDevicesMoveResult{}
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		var peers []*model.Peer
+		if err := tx.Where("row_id IN ?", rowIDs).Find(&peers).Error; err != nil {
+			return err
+		}
+		if len(peers) != len(uniqueUint(rowIDs)) {
+			return errors.New("alguma máquina escolhida não existe mais; atualize a lista")
+		}
+		for _, p := range peers {
+			if p.GroupId == groupID {
+				res.Skipped++
+				continue
+			}
+			old := p.GroupId
+			if err := tx.Model(&model.Peer{}).Where("row_id = ?", p.RowId).Update("group_id", groupID).Error; err != nil {
+				return err
+			}
+			rm, ad, err := NextecSyncClientListsTx(tx, p.Id, old, groupID)
+			if err != nil {
+				return err
+			}
+			res.Removed += rm
+			res.Added += ad
+			res.Moved++
+			lines = append(lines, audit{p.Id, fmt.Sprintf("de %s para %s (troca em lote)", nextecGroupPathOrRootTx(tx, old), nextecGroupPathOrRootTx(tx, groupID))})
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	for _, l := range lines {
+		NextecSecretAuditAdd(u, l.peer, "device_move", ip, l.detail)
+	}
+	return res, nil
+}
+
+func uniqueUint(in []uint) []uint {
+	seen := map[uint]bool{}
+	out := []uint{}
+	for _, v := range in {
+		if !seen[v] {
+			seen[v] = true
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+func nextecGroupPathOrRootTx(tx *gorm.DB, id uint) string {
+	if id == 0 {
+		return "sem cliente"
+	}
+	if p := nextecGroupPathTx(tx, id); p != "" {
+		return p
+	}
+	return fmt.Sprintf("grupo %d", id)
+}
