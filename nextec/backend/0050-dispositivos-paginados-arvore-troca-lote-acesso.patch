+	if ub.Machines != 1 || ub.Items[0].Kind != "machine" || ub.Items[0].PeerID != "4001" || ub.Items[0].Origin != "direto" || ub.Items[0].Machines != 1 || ub.Items[0].Rule != 2 {
+		t.Fatalf("acesso da Bia: %+v", ub.Items)
+	}
+	if !inList(db, m.CollectionID, "4001") || inList(db, m.CollectionID, "4002") {
+		t.Fatal("a lista avulsa deve ter só a máquina escolhida")
+	}
+	// Ana (equipe) também ganha a mesma máquina direto: origem passa a ser "direto e equipe" se ela já tinha por equipe
+	NextecAccessGrant(admin, "x", &NextecAccessGrantReq{TargetType: 2, TargetID: team.Id, Scope: "machine", PeerID: "4001", Rule: 1})
+	NextecAccessGrant(admin, "x", &NextecAccessGrantReq{TargetType: 1, TargetID: ana.Id, Scope: "machine", PeerID: "4001", Rule: 2})
+	ua, _ = NextecAccessOfUser(ana.Id)
+	var machine *NextecAccessItem
+	for _, it := range ua.Items {
+		if it.Kind == "machine" {
+			machine = it
+		}
+	}
+	if machine == nil || machine.Origin != "direto e equipe" || machine.Rule != 2 || machine.Team != "Suporte N1" {
+		t.Fatalf("origem combinada: %+v", machine)
+	}
+	if ua.Machines != 1 {
+		t.Fatalf("a mesma lista conta uma vez: %d", ua.Machines)
+	}
+
+	// tirar o acesso
+	rm, err := NextecAccessGrant(admin, "x", &NextecAccessGrantReq{TargetType: 1, TargetID: bia.Id, Scope: "machine", PeerID: "4001", Remove: true})
+	if err != nil || !rm.Changed {
+		t.Fatalf("tirar: %+v %v", rm, err)
+	}
+	ub, _ = NextecAccessOfUser(bia.Id)
+	if len(ub.Items) != 0 {
+		t.Fatalf("a Bia não deveria ter mais nada: %+v", ub.Items)
+	}
+	// validações
+	for name, req := range map[string]*NextecAccessGrantReq{
+		"pessoa inexistente":  {TargetType: 1, TargetID: 999, Scope: "client", GroupID: 7, Rule: 1},
+		"equipe inexistente":  {TargetType: 2, TargetID: 999, Scope: "client", GroupID: 7, Rule: 1},
+		"cliente inexistente": {TargetType: 2, TargetID: team.Id, Scope: "client", GroupID: 999, Rule: 1},
+		"máquina inexistente": {TargetType: 1, TargetID: ana.Id, Scope: "machine", PeerID: "000", Rule: 1},
+		"nível inválido":      {TargetType: 1, TargetID: ana.Id, Scope: "client", GroupID: 7, Rule: 3},
+		"escopo inválido":     {TargetType: 1, TargetID: ana.Id, Scope: "tudo", Rule: 1},
+	} {
+		if _, err := NextecAccessGrant(admin, "x", req); err == nil {
+			t.Fatalf("%s deveria falhar", name)
+		}
+	}
+	// auditoria
+	var n int64
+	db.Model(&model.NextecSecretAudit{}).Where("action IN ?", []string{"access_grant", "access_revoke"}).Count(&n)
+	if n < 5 {
+		t.Fatalf("auditoria de acesso incompleta: %d", n)
+	}
+	// o resumo de todas as pessoas
+	users := NextecAccessUsers()
+	if len(users) != 3 {
+		t.Fatalf("resumo: %d pessoas", len(users))
+	}
+}
