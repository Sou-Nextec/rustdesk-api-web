+++ b/http/controller/admin/nextec_devices.go
@@ -0,0 +1,126 @@
+package admin
+
+import (
+	"strconv"
+
+	"github.com/gin-gonic/gin"
+	"github.com/lejianwen/rustdesk-api/v2/http/response"
+	"github.com/lejianwen/rustdesk-api/v2/service"
+)
+
+// NextecDevices: lista de dispositivos paginada no servidor, árvore de clientes e troca em lote (somente admin).
+type NextecDevices struct{}
+
+func qUint(c *gin.Context, key string) uint {
+	v, _ := strconv.ParseUint(c.Query(key), 10, 32)
+	return uint(v)
+}
+
+// List devolve uma página filtrada: ?page=&page_size=&q=&client_id=&sub_id=&no_client=1&status=online|offline&ids=&sort=online|recent|client|name
+// @Router /admin/nextec/devices [get]
+func (n *NextecDevices) List(c *gin.Context) {
+	q := &service.NextecDeviceQuery{
+		Page: qUint(c, "page"), PageSize: qUint(c, "page_size"), Q: c.Query("q"),
+		ClientID: qUint(c, "client_id"), SubID: qUint(c, "sub_id"), NoClient: c.Query("no_client") == "1",
+		Status: c.Query("status"), Sort: c.Query("sort"), Ids: c.Query("ids"),
+	}
+	if len(q.Q) > 100 {
+		q.Q = q.Q[:100]
+	}
+	res, err := service.NextecDevicesList(q)
+	if err != nil {
+		response.Fail(c, 101, response.TranslateMsg(c, "OperationFailed")+err.Error())
+		return
+	}
+	response.Success(c, res)
+}
+
+// Tree devolve clientes e subgrupos com a contagem de máquinas e de online (sem trazer as máquinas)
+// @Router /admin/nextec/devices/tree [get]
+func (n *NextecDevices) Tree(c *gin.Context) {
+	res, err := service.NextecDevicesTree()
+	if err != nil {
+		response.Fail(c, 101, response.TranslateMsg(c, "OperationFailed")+err.Error())
+		return
+	}
+	response.Success(c, res)
+}
+
+type nextecMoveForm struct {
+	RowIds  []uint `json:"row_ids" binding:"required"`
+	GroupId uint   `json:"group_id"` // 0 = sem cliente
+}
+
+// Move muda várias máquinas de cliente/subgrupo em uma chamada só
+// @Router /admin/nextec/devices/move [post]
+func (n *NextecDevices) Move(c *gin.Context) {
+	f := &nextecMoveForm{}
+	if err := c.ShouldBindJSON(f); err != nil {
+		response.Fail(c, 101, response.TranslateMsg(c, "ParamsError")+err.Error())
+		return
+	}
+	res, err := service.NextecDevicesMove(service.AllService.UserService.CurUser(c), nextecIP(c), f.RowIds, f.GroupId)
+	if err != nil {
+		response.Fail(c, 101, err.Error())
+		return
+	}
+	response.Success(c, res)
+}
+
+// ---------- acesso por equipe e pessoa ----------
+
+type nextecGrantForm struct {
+	TargetType int    `json:"target_type" binding:"required"` // 1 pessoa, 2 equipe
+	TargetId   uint   `json:"target_id" binding:"required"`
+	Scope      string `json:"scope" binding:"required"` // client | machine
+	GroupId    uint   `json:"group_id"`
+	PeerId     string `json:"peer_id"`
+	Rule       int    `json:"rule"`
+	Remove     bool   `json:"remove"`
+}
+
+// AccessGrant concede, altera ou tira o acesso de uma equipe/pessoa a um cliente ou a uma máquina avulsa
+// @Router /admin/nextec/access/grant [post]
+func (n *NextecDevices) AccessGrant(c *gin.Context) {
+	f := &nextecGrantForm{}
+	if err := c.ShouldBindJSON(f); err != nil {
+		response.Fail(c, 101, response.TranslateMsg(c, "ParamsError")+err.Error())
+		return
+	}
+	res, err := service.NextecAccessGrant(service.AllService.UserService.CurUser(c), nextecIP(c), &service.NextecAccessGrantReq{
+		TargetType: f.TargetType, TargetID: f.TargetId, Scope: f.Scope, GroupID: f.GroupId, PeerID: f.PeerId, Rule: f.Rule, Remove: f.Remove,
+	})
+	if err != nil {
+		response.Fail(c, 101, err.Error())
+		return
+	}
+	response.Success(c, res)
+}
+
+// AccessUsers resume o acesso de cada pessoa
+// @Router /admin/nextec/access/users [get]
+func (n *NextecDevices) AccessUsers(c *gin.Context) {
+	response.Success(c, &gin.H{"list": service.NextecAccessUsers()})
+}
+
+// AccessUser devolve o acesso efetivo de uma pessoa, com a origem de cada item
+// @Router /admin/nextec/access/user [get]
+func (n *NextecDevices) AccessUser(c *gin.Context) {
+	res, err := service.NextecAccessOfUser(qUint(c, "user_id"))
+	if err != nil {
+		response.Fail(c, 101, err.Error())
+		return
+	}
+	response.Success(c, res)
+}
+
+// AccessTeam devolve o que uma equipe acessa (clientes e máquinas avulsas)
+// @Router /admin/nextec/access/team [get]
+func (n *NextecDevices) AccessTeam(c *gin.Context) {
+	res, err := service.NextecAccessOfTeam(qUint(c, "team_id"))
+	if err != nil {
+		response.Fail(c, 101, err.Error())
+		return
+	}
+	response.Success(c, res)
+}
