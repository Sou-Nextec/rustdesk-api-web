+// Achado do Codex (P1): usuário comum com coleção pessoal "Cliente: X" não pode receber nem perder entradas, nem ser reconciliada.
+func TestClientListsIgnoreNonAdminCollectionWithSameName(t *testing.T) {
+	db, c := listsSetup(t)
+	mine := &model.AddressBookCollection{UserId: 2, Name: "Cliente: Cliente A"}
+	db.Create(mine)
+	db.Create(&model.AddressBook{Id: "555000111", UserId: 2, CollectionId: mine.Id, Alias: "meu"})
+	setPeerGroup(t, db, 9)
+	if err := NextecSyncClientLists(nil, "", enrollPeer, 0, 9); err != nil {
+		t.Fatal(err)
+	}
+	if inList(db, mine.Id, enrollPeer) {
+		t.Fatal("a máquina vazou para a coleção pessoal de um usuário comum")
+	}
+	if !inList(db, c["A"], enrollPeer) {
+		t.Fatal("a lista do administrador deixou de acompanhar o cliente")
+	}
+	setPeerGroup(t, db, 8)
+	if err := NextecSyncClientLists(nil, "", enrollPeer, 9, 8); err != nil {
+		t.Fatal(err)
+	}
+	if !inList(db, mine.Id, "555000111") {
+		t.Fatal("entrada da coleção pessoal foi apagada pela sincronização")
+	}
+	admin := &model.User{IdModel: model.IdModel{Id: 1}, Username: "admin"}
+	if _, err := NextecReconcileClientList(admin, "x", mine.Id); err == nil {
+		t.Fatal("reconciliar coleção de usuário comum deveria ser recusado")
+	}
+	if !inList(db, mine.Id, "555000111") {
+		t.Fatal("a reconciliação mexeu na coleção pessoal")
+	}
+}
