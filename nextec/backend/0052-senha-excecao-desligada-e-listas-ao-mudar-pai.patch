diff --git a/service/nextec_client_lists.go b/service/nextec_client_lists.go
index be1c894..96dcfa7 100644
--- a/service/nextec_client_lists.go
+++ b/service/nextec_client_lists.go
@@ -73,7 +73,12 @@ func NextecSyncClientListsTx(tx *gorm.DB, peerID string, oldGroup, newGroup uint
 	if oldGroup == newGroup {
 		return 0, 0, nil
 	}
-	oldChain, newChain := nextecGroupChainTx(tx, oldGroup), nextecGroupChainTx(tx, newGroup)
+	return nextecSyncChainsTx(tx, peerID, nextecGroupChainTx(tx, oldGroup), nextecGroupChainTx(tx, newGroup))
+}
+
+// nextecSyncChainsTx faz a troca de listas a partir das cadeias (grupo e ancestrais) de antes e de depois. Serve também para
+// quando é o grupo que muda de pai: a máquina fica onde está, mas a cadeia dela mudou.
+func nextecSyncChainsTx(tx *gorm.DB, peerID string, oldChain, newChain []uint) (removed, added int, err error) {
 	leave := nextecClientListsFor(tx, nextecDiffIDs(oldChain, newChain))
 	join := nextecClientListsFor(tx, nextecDiffIDs(newChain, oldChain))
 	if len(leave) > 0 {
@@ -237,3 +242,40 @@ func NextecReconcileClientList(u *model.User, ip string, collectionID uint) (*Ne
 	NextecSecretAuditAdd(u, "", "client_list_reconcile", ip, fmt.Sprintf("%s: %d incluída(s), %d removida(s)", res.Name, res.Added, res.Removed))
 	return res, nil
 }
+
+// NextecGroupUpdateSync grava os campos do grupo e, se o pai mudou, ressincroniza as listas "Cliente: X" de todas as
+// máquinas da subárvore: saem das listas dos ancestrais antigos e entram nas dos novos (só listas de administrador).
+// Tudo em uma transação. Devolve quantas entradas saíram e entraram.
+func NextecGroupUpdateSync(u *model.User, ip string, g *model.DeviceGroup, fields ...string) (removed, added int, err error) {
+	err = DB.Transaction(func(tx *gorm.DB) error {
+		subtree := nextecSubtree(tx, g.Id)
+		before := map[uint][]uint{}
+		for _, id := range subtree {
+			before[id] = nextecGroupChainTx(tx, id)
+		}
+		if e := tx.Model(g).Select(fields).Updates(g).Error; e != nil {
+			return e
+		}
+		var peers []model.Peer
+		if e := tx.Select("id", "group_id").Where("group_id IN ?", subtree).Find(&peers).Error; e != nil {
+			return e
+		}
+		after := map[uint][]uint{}
+		for _, p := range peers {
+			if _, ok := after[p.GroupId]; !ok {
+				after[p.GroupId] = nextecGroupChainTx(tx, p.GroupId)
+			}
+			r, a, e := nextecSyncChainsTx(tx, p.Id, before[p.GroupId], after[p.GroupId])
+			if e != nil {
+				return e
+			}
+			removed, added = removed+r, added+a
+		}
+		return nil
+	})
+	if err == nil && removed+added > 0 {
+		NextecSecretAuditAdd(u, "", "client_lists_sync", ip,
+			fmt.Sprintf("grupo %s mudou de pai: %d entrada(s) removida(s), %d incluída(s)", nextecGroupPathOrRoot(g.Id), removed, added))
+	}
+	return removed, added, err
+}
