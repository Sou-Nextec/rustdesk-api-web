+// Achado de revisão (P1): "sem senha automática" com regra herdada (global ou de cliente-pai) precisa de exceção desligada explícita.
+func TestAssignNoneCreatesDisabledExceptionOverInheritedRule(t *testing.T) {
+	cases := []struct {
+		name   string
+		setup  func(t *testing.T)
+		client uint
+	}{
+		{"global", func(t *testing.T) { secretRule(t, NextecKindGlobal, NextecGlobalRef, true, 120, nil) }, 7},
+		{"cliente-pai", func(t *testing.T) { secretRule(t, "group", "7", true, 60, nil) }, 9},
+	}
+	for i, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			db, _ := enrollPending(t, "10.30.1."+string(rune('1'+i)))
+			bug8Groups(t, db)
+			tc.setup(t)
+			if r := NextecSecretEffective(enrollPeer, tc.client); !r.Enabled {
+				t.Fatalf("pré-condição: a regra herdada deveria estar ligada: %#v", r)
+			}
+			res, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: tc.client, Rule: "none"})
+			if err != nil || res.Managed || res.Interval != 0 {
+				t.Fatalf("assign none: %#v %v", res, err)
+			}
+			r := NextecSecretEffective(enrollPeer, tc.client)
+			if r.Enabled || r.Origin != NextecOriginPeer {
+				t.Fatalf("regra efetiva deveria ser desligada com origem exceção da máquina: %#v", r)
+			}
+			if p := peerPolicy(db, enrollPeer); p == nil || p.Enabled {
+				t.Fatalf("faltou a exceção desligada explícita na máquina: %#v", p)
+			}
+			if d := deviceRow(t, db, enrollPeer); d.ForceRotate {
+				t.Fatal("none não pode armar troca de senha")
+			}
+		})
+	}
+}
