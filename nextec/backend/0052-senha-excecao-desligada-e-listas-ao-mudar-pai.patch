 }
+
+// Achado de revisão (P1): mudar o pai de um subgrupo precisa mover as máquinas entre as listas dos clientes.
+func TestClientListsFollowSubgroupReparent(t *testing.T) {
+	db, c := listsSetup(t)
+	mine := &model.AddressBookCollection{UserId: 2, Name: "Cliente: Cliente B"} // pessoal de usuário comum: não entra
+	db.Create(mine)
+	db.Create(&model.Peer{Id: "777000111", Uuid: "u-stay", GroupId: 7})
+	setPeerGroup(t, db, 9)
+	for _, col := range []uint{c["A"], c["F"]} {
+		db.Create(&model.AddressBook{Id: enrollPeer, UserId: 1, CollectionId: col})
+	}
+	db.Create(&model.AddressBook{Id: "777000111", UserId: 1, CollectionId: c["A"]})
+
+	removed, added, err := NextecGroupUpdateSync(nil, "x", &model.DeviceGroup{IdModel: model.IdModel{Id: 9}, ParentId: 8}, "parent_id")
+	if err != nil || removed != 1 || added != 1 {
+		t.Fatalf("reparent: removed=%d added=%d err=%v", removed, added, err)
+	}
+	if inList(db, c["A"], enrollPeer) {
+		t.Fatal("o cliente antigo continuou vendo a máquina do subgrupo que saiu")
+	}
+	if !inList(db, c["B"], enrollPeer) {
+		t.Fatal("o cliente novo não recebeu a máquina do subgrupo")
+	}
+	if !inList(db, c["F"], enrollPeer) {
+		t.Fatal("a lista do próprio subgrupo perdeu a máquina")
+	}
+	if !inList(db, c["A"], "777000111") {
+		t.Fatal("máquina que não é do subgrupo foi mexida")
+	}
+	if inList(db, mine.Id, enrollPeer) {
+		t.Fatal("a máquina vazou para a coleção pessoal de usuário comum")
+	}
+	if auditCount(db, "client_lists_sync") == 0 {
+		t.Fatal("faltou auditoria da ressincronização")
+	}
+	// repetir não muda nada
+	if r, a, err := NextecGroupUpdateSync(nil, "x", &model.DeviceGroup{IdModel: model.IdModel{Id: 9}, ParentId: 8}, "parent_id"); err != nil || r+a != 0 {
+		t.Fatalf("repetição mexeu nas listas: %d %d %v", r, a, err)
+	}
+}
