+func groupRulePolicy(db *gorm.DB, ref string) *model.NextecSecretPolicy {
+	p := &model.NextecSecretPolicy{}
+	if db.Where("kind = ? AND ref = ?", "group", ref).Limit(1).Find(p).Error != nil || p.Id == 0 {
+		return nil
+	}
+	return p
+}
+
+// Revisão (P1): a máquina fica no subgrupo; a exceção "sem senha automática" é decidida pela regra efetiva desse escopo.
+func TestAssignNoneUsesEffectiveRuleOfMachineSubgroup(t *testing.T) {
+	cases := []struct {
+		name  string
+		setup func(t *testing.T)
+	}{
+		{"regra só no subgrupo", func(t *testing.T) { secretRule(t, "group", "9", true, 45, nil) }},
+		{"regra só no cliente", func(t *testing.T) { secretRule(t, "group", "7", true, 60, nil) }},
+	}
+	for i, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			db, _ := enrollPending(t, "10.30.2."+string(rune('1'+i)))
+			bug8Groups(t, db)
+			setPeerGroup(t, db, 9) // a máquina já está no subgrupo Filial do Cliente A
+			tc.setup(t)
+			if r := NextecSecretEffective(enrollPeer, 9); !r.Enabled {
+				t.Fatalf("pré-condição: regra herdada ligada: %#v", r)
+			}
+			res, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "none"})
+			if err != nil || res.Managed || res.Interval != 0 {
+				t.Fatalf("assign none: %#v %v", res, err)
+			}
+			if got := peerGroupOf(t, db); got != 9 {
+				t.Fatalf("a máquina deveria ficar no subgrupo: %d", got)
+			}
+			r := NextecSecretEffective(enrollPeer, 9)
+			if r.Enabled || r.Origin != NextecOriginPeer {
+				t.Fatalf("regra efetiva deveria ser desligada, origem exceção: %#v", r)
+			}
+			if p := peerPolicy(db, enrollPeer); p == nil || p.Enabled {
+				t.Fatalf("faltou a exceção desligada: %#v", p)
+			}
+			if d := deviceRow(t, db, enrollPeer); d.ForceRotate {
+				t.Fatal("none não pode armar troca")
+			}
+		})
+	}
+}
