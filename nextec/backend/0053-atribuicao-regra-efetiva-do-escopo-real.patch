+// Revisão (P2): ao aprovar seguindo a regra do cliente, regra herdada manda; só sem nenhuma é que se cria a do cliente.
+func TestAssignGroupFollowsInheritedRuleAndCreatesOnlyWhenNone(t *testing.T) {
+	t.Run("global", func(t *testing.T) {
+		db, _ := enrollPending(t, "10.30.3.1")
+		bug8Groups(t, db)
+		secretRule(t, NextecKindGlobal, NextecGlobalRef, true, 120, nil)
+		res, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "group", EnableGroupRule: true})
+		if err != nil || !res.Managed || res.Interval != 120 || res.GroupRuleEnabled {
+			t.Fatalf("assign group com global: %#v %v", res, err)
+		}
+		if groupRulePolicy(db, "7") != nil || peerPolicy(db, enrollPeer) != nil {
+			t.Fatal("a aprovação criou regra própria por cima da herdada")
+		}
+	})
+	t.Run("cliente-pai", func(t *testing.T) {
+		db, _ := enrollPending(t, "10.30.3.2")
+		bug8Groups(t, db)
+		secretRule(t, "group", "7", true, 60, nil)
+		res, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 9, Rule: "group", EnableGroupRule: true})
+		if err != nil || !res.Managed || res.Interval != 60 || res.GroupRuleEnabled {
+			t.Fatalf("assign group no subgrupo: %#v %v", res, err)
+		}
+		if groupRulePolicy(db, "9") != nil || peerPolicy(db, enrollPeer) != nil {
+			t.Fatal("a aprovação criou regra no subgrupo ou na máquina por cima da do cliente-pai")
+		}
+	})
+	t.Run("nenhuma", func(t *testing.T) {
+		db, _ := enrollPending(t, "10.30.3.3")
+		bug8Groups(t, db)
+		res, err := NextecEnrollAssign(NextecAssignOptions{PeerID: enrollPeer, ClientID: 7, Rule: "group", EnableGroupRule: true})
+		if err != nil || !res.Managed || res.Interval != NextecSecretDefaultInterval || !res.GroupRuleEnabled {
+			t.Fatalf("assign group sem regra: %#v %v", res, err)
+		}
+		if p := groupRulePolicy(db, "7"); p == nil || !p.Enabled {
+			t.Fatalf("sem regra nenhuma, a regra do cliente deveria ser criada: %#v", p)
+		}
+	})
+}
